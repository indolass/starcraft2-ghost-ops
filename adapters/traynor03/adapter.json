    }
  ],
  "extra_hooks": [
    {
      "function": "gt_VictoryHoldOutCompleted_Func",
      "before": "TriggerEnable(TriggerGetCurrent(), false);",
      "call": "if (GhostOps_ZH_Gate()) { return true; }"
    },
    {
      "function": "gt_VictoryHoldOutCompleted_Func",
      "after": "gv_gameOver = true;",
      "call": "GhostOps_Tac_OnVictory();"
    },
    {
      "function": "gt_DefeatBaseDead_Func",
      "after": "gv_gameOver = true;",
      "call": "GhostOps_Tac_OnDefeat();"
    },
    {
      "function": "gt_RebelMarines01Intro_Func",
      "after": "libNtve_gf_ShowHideUnit(gv_rebelMarinesBeacon01, true);",
      "call": "GhostOps_ZH_OnRebelCall();"
    },
    {
      "function": "gt_RebelMarines02Intro_Func",
      "after": "libNtve_gf_ShowHideUnit(gv_rebelMarinesBeacon02, true);",
      "call": "GhostOps_ZH_OnRebelCall();"
    },
    {
      "function": "gt_RebelMarines03Intro_Func",
      "after": "libNtve_gf_ShowHideUnit(gv_rebelMarinesBeacon03, true);",
      "call": "GhostOps_ZH_OnRebelCall();"
    },
    {
      "function": "gt_RebelMarines01Rescued_Func",
      "after": "gv_rebelFightersRescued += 1;",
      "call": "GhostOps_ZH_OnRescue();"
    },
    {
      "function": "gt_RebelMarines02Rescued_Func",
      "after": "gv_rebelFightersRescued += 1;",
      "call": "GhostOps_ZH_OnRescue();"
    },
    {
      "function": "gt_RebelMarines03Rescued_Func",
      "after": "gv_rebelFightersRescued += 1;",
      "call": "GhostOps_ZH_OnRescue();"
    }
  ],
  "campaign_hooks": [
    {
      "function": "gt_IntroSequence_Func",
      "after": "TriggerExecute(gt_StartGame, true, false);",
      "call": "GhostOps_Camp_Start();"
    },
    {
      "function": "gt_VictoryHoldOutCompleted_Func",
      "after": "gv_gameOver = true;",
      "call": "GhostOps_Camp_OnVictory();"
