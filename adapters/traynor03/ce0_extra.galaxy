// CE-0 probe: TRaynor03 specific state and commands (development only; compiled only with the config key "ce0").
string GhostOps_Ce0_Extra () {
    string lv_s;

    lv_s = "zh dead=" + IntToString(go_zhDead) + "/" + IntToString(go_zhTargetCount) + " timer=" + IntToString(GhostOps_Ce0_B(go_zhTimerDone));
    lv_s = lv_s + " victory=" + IntToString(GhostOps_Ce0_B(go_zhVictoryDone)) + " scene=" + IntToString(go_zhSceneStage);
    lv_s = lv_s + " tac state=" + IntToString(go_tacState) + " launches=" + IntToString(go_tacLaunches) + " nukes=" + IntToString(TechTreeUnitCount(1, "Nuke", c_techCountCompleteOnly));
    return lv_s;
}

void GhostOps_Ce0_MissionStart () {
}

// DEV: the orders a player gives when he organises the defence (no healing, no invulnerability, no extra resources): Marines into the bunkers (2 per bunker),
// the five stock SCVs mine, the extra SCVs repair damaged structures, the Ghosts leave the base. Losses are logged with the killer.
unit go_gsLast;

trigger go_dfTick;
trigger go_dfDied;
int go_dfLoss;
int go_dfRepairOrders;

bool GhostOps_Ce0_DefDied (bool lp_test, bool lp_run) {
    unit lv_u;
    unit lv_k;
    string lv_t;

    if (!lp_run) {
        return true;
    }

    lv_u = EventUnit();
    if ((UnitGetOwner(lv_u) != 1) || (UnitGetType(lv_u) == "Nuke") || (UnitGetType(lv_u) == "Zergling")) {
        return true;
    }

    go_dfLoss += 1;
    lv_k = EventUnitDamageSourceUnit();
    lv_t = "LOSS " + UnitGetType(lv_u) + " at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 0);
    if (lv_k != null) {
        lv_t = lv_t + " killer " + UnitGetType(lv_k) + " of player " + IntToString(UnitGetOwner(lv_k)) + " at " + FixedToString(PointGetX(UnitGetPosition(lv_k)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_k)), 0);
    }

    GhostOps_Ce0_Write("j", lv_t);
    return true;
}

unit GhostOps_Ce0_DamagedStructure () {
    unitgroup lv_g;
    int lv_n;
    int lv_i;
    unit lv_u;
    unit lv_best;
    fixed lv_bestP;
    fixed lv_p;

    lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n = UnitGroupCount(lv_g, c_unitCountAll);
    lv_best = null;
    lv_bestP = 99.0;
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        lv_p = UnitGetPropertyFixed(lv_u, c_unitPropLifePercent, c_unitPropCurrent);
        if ((lv_p < lv_bestP) && (lv_p < 99.0) && (UnitGetType(lv_u) != "GhostAcademy")) {
            lv_bestP = lv_p;
            lv_best = lv_u;
        }

        lv_i += 1;
    }

    return lv_best;
}

bool GhostOps_Ce0_DefTick (bool lp_test, bool lp_run) {
    unitgroup lv_g;
    int lv_n;
    int lv_i;
    unit lv_s;
    unit lv_t;
    unit lv_m;

    if (!lp_run) {
        return true;
    }

    lv_g = UnitGroup("SCV", 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0);
    lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_s = UnitGroupUnit(lv_g, lv_i);
        if (UnitOrderCount(lv_s) == 0) {
            if (lv_i <= 5) {
                lv_m = UnitGroupClosestToPoint(UnitGroup("MineralField", 0, RegionEntireMap(), GhostOps_Ce0_Live(), 0), UnitGetPosition(lv_s));
                if (lv_m != null) {
                    UnitIssueOrder(lv_s, OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), lv_m), c_orderQueueReplace);
                }
            }
            else {
                lv_t = GhostOps_Ce0_DamagedStructure();
                if (lv_t != null) {
                    UnitIssueOrder(lv_s, OrderTargetingUnit(AbilityCommand("Repair", 0), lv_t), c_orderQueueReplace);
                    go_dfRepairOrders += 1;
                }
            }
        }

        lv_i += 1;
    }

    return true;
}

// DEV: trace of the enemy fighters (players 2, 3, 4): all, near the defence zone, at the gather point of the post-timer waves, nearest one to the zone centre.
trigger go_wvTick;
trigger go_wvpTick;
unitgroup go_frG;
unit go_frBld;
unit go_szD;
trigger go_nofoeTick;
unitgroup go_dumG;

bool GhostOps_Ce0_NofoeTick (bool lp_test, bool lp_run) {
    int lv_p;
    unitgroup lv_g;

    if (!lp_run) {
        return true;
    }

    lv_p = 2;
    while (lv_p <= 5) {
        lv_g = UnitGroup(null, lv_p, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            if ((UnitGroupLoopCurrent() != go_szD) && !UnitGroupHasUnit(go_dumG, UnitGroupLoopCurrent())) {
                UnitRemove(UnitGroupLoopCurrent());
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        lv_p += 1;
    }

    return true;
}

bool GhostOps_Ce0_WvpTick (bool lp_test, bool lp_run) {
    int lv_p;
    int lv_i;
    int lv_n;
    int lv_zone;
    int lv_hatch;
    unitgroup lv_g;
    string lv_t;

    if (!lp_run) {
        return true;
    }

    lv_t = "WVP";
    lv_p = 2;
    while (lv_p <= 4) {
        lv_g = UnitGroup(null, lv_p, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
        lv_zone = 0;
        lv_i = 1;
        while (lv_i <= lv_n) {
            if (DistanceBetweenPoints(UnitGetPosition(UnitGroupUnit(lv_g, lv_i)), Point(go_tacZoneX, go_tacZoneY)) < 40.0) {
                lv_zone += 1;
            }

            lv_i += 1;
        }

        lv_hatch = UnitGroupCount(UnitGroup("Hatchery", lv_p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
        lv_hatch += UnitGroupCount(UnitGroup("Lair", lv_p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
        lv_t = lv_t + " P" + IntToString(lv_p) + " units " + IntToString(lv_n) + " near " + IntToString(lv_zone) + " hatch " + IntToString(lv_hatch) + " |";
        lv_p += 1;
    }

    GhostOps_Ce0_Write("j", lv_t);
    return true;
}

bool GhostOps_Ce0_WvTick (bool lp_test, bool lp_run) {
    int lv_p;
    int lv_total;
    int lv_zone;
    int lv_gather;
    int lv_i;
    int lv_n;
    unitgroup lv_g;
    unit lv_u;
    fixed lv_d;
    fixed lv_best;
    point lv_bestPos;

    if (!lp_run) {
        return true;
    }

    lv_total = 0;
    lv_zone = 0;
    lv_gather = 0;
    lv_best = 9999.0;
    lv_bestPos = Point(0.0, 0.0);
    lv_p = 2;
    while (lv_p <= 4) {
        lv_g = UnitGroup(null, lv_p, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
        lv_total += lv_n;
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), Point(go_tacZoneX, go_tacZoneY));
            if (lv_d < 32.0) {
                lv_zone += 1;
            }

            if (DistanceBetweenPoints(UnitGetPosition(lv_u), PointFromId(264)) < 14.0) {
                lv_gather += 1;
            }

            if (lv_d < lv_best) {
                lv_best = lv_d;
                lv_bestPos = UnitGetPosition(lv_u);
            }

            lv_i += 1;
        }

        lv_p += 1;
    }

    GhostOps_Ce0_Write("j", "WV total=" + IntToString(lv_total) + " zone32=" + IntToString(lv_zone) + " gather14=" + IntToString(lv_gather) + " nearest=" + FixedToString(lv_best, 0) + " at " + FixedToString(PointGetX(lv_bestPos), 0) + "," + FixedToString(PointGetY(lv_bestPos), 0) + " gather=" + FixedToString(PointGetX(PointFromId(264)), 0) + "," + FixedToString(PointGetY(PointFromId(264)), 0));
    return true;
}

unitgroup go_szG;
unit go_szOwn;
unit go_szOv;

// the defence-variant probe commands (a separate function: one very long command function does not compile)
bool GhostOps_Ce0_DefCmd (string lp_cmd, string lp_a, string lp_b) {
    string lv_t;
    int lv_i;
    int lv_k;
    unit lv_u;
    unitgroup lv_g;
    point lv_p;
    order lv_o;

    if (lp_cmd == "dst") {
        lv_t = "DST defence " + IntToString(GhostOps_Ce0_B(go_defEnabled)) + " kits left B " + IntToString(GhostOps_DEF_KitsLeft(1)) + " T " + IntToString(GhostOps_DEF_KitsLeft(2));
        lv_t = lv_t + " | spent B " + IntToString(go_defSpentB) + " T " + IntToString(go_defSpentT) + " consumed B " + IntToString(go_defConsumedB) + " T " + IntToString(go_defConsumedT);
        lv_t = lv_t + " reserved B " + IntToString(GhostOps_DEF_Reserved(1)) + " T " + IntToString(GhostOps_DEF_Reserved(2));
        GhostOps_Ce0_Write("j", lv_t);
        lv_t = "DST2 landing " + IntToString(go_defLandSt[0]) + IntToString(go_defLandSt[1]) + IntToString(go_defLandSt[2]);
        lv_t = lv_t + " marines " + IntToString(UnitGroupCount(UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0), c_unitCountAlive));
        lv_t = lv_t + " ghosts " + IntToString(UnitGroupCount(UnitGroup("Ghost", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0), c_unitCountAlive));
        lv_t = lv_t + " | salvo " + IntToString(GhostOps_Ce0_B(go_defSalvoOn)) + " scene " + IntToString(GhostOps_Ce0_B(go_defSalvoScene)) + " swannAt " + FixedToString(go_defSwannAt, 1);
        GhostOps_Ce0_Write("j", lv_t);
        lv_t = "DST3 groups dead " + IntToString(go_defGrpDead[0]) + "/" + IntToString(go_defGrpDead[1]) + "/" + IntToString(go_defGrpDead[2]);
        lv_t = lv_t + " of " + IntToString(go_defGrpTotal[0]) + "/" + IntToString(go_defGrpTotal[1]) + "/" + IntToString(go_defGrpTotal[2]);
        lv_t = lv_t + " | waves sent " + IntToString(go_defWvSent) + " skipped " + IntToString(go_defWvSkipped) + " | t0 " + FixedToString(go_defT0, 1) + " now " + FixedToString(GameGetMissionTime(), 1);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "cat") {
        // catalog field of the ability TerranBuild (a = field path) or of a unit (b = unit id, a = field)
        if (lp_b == "") {
            GhostOps_Ce0_Write("j", "CAT TerranBuild " + lp_a + " = " + CatalogFieldValueGet(c_gameCatalogAbil, "TerranBuild", lp_a, 1));
        }
        else {
            GhostOps_Ce0_Write("j", "CAT unit " + lp_b + " " + lp_a + " = " + CatalogFieldValueGet(c_gameCatalogUnit, lp_b, lp_a, 1));
        }

        return true;
    }

    if (lp_cmd == "catab") {
        lv_t = "CATAB " + lp_a + " " + lp_b + " = " + CatalogFieldValueGet(c_gameCatalogAbil, lp_a, lp_b, 1);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "uae") {
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitAbilityEnable(UnitGroupLoopCurrent(), "GhostOpsTurretSalvo", true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        lv_u = UnitGroupUnit(lv_g, 1);
        lv_t = "UAE turrets " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive));
        lv_t = lv_t + " valid at 6 cells " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)))));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "x1") {
        CatalogFieldValueSet(c_gameCatalogAbil, "GhostOpsTurretSalvo", "Flags[RequireTargetVision]", 1, "0");
        return true;
    }

    if (lp_cmd == "x2") {
        CatalogFieldValueSet(c_gameCatalogAbil, "GhostOpsTurretSalvo", "Effect[0]", 1, "GhostOpsSalvoLaunch");
        return true;
    }

    if (lp_cmd == "x3") {
        CatalogFieldValueSet(c_gameCatalogAbil, "GhostOpsTurretSalvo", "Cost[0].Cooldown.TimeUse", 1, "0");
        return true;
    }

    if (lp_cmd == "chkg") {
        lv_u = GhostOps_SquadUnit(0);
        lv_t = "CHKG ghost valid(-6) " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)))));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "chkc") {
        lv_u = UnitFromId(23);
        lv_t = "CHKC cc valid(-6) " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)))));
        GhostOps_Ce0_Write("j", lv_t);
        UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "CHKC orders after issue " + IntToString(UnitOrderCount(lv_u)));
        return true;
    }

    if (lp_cmd == "chk") {
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        lv_t = "CHK turrets " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive));
        lv_t = lv_t + " valid(-6) " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)))));
        lv_t = lv_t + " snipe-like attack valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("attack", 0), PointWithOffset(UnitGetPosition(lv_u), -6.0, 0.0)))));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "allow") {
        lv_t = "ALLOW Bunker " + IntToString(GhostOps_Ce0_B(TechTreeUnitIsAllowed(1, "Bunker"))) + " turret " + IntToString(GhostOps_Ce0_B(TechTreeUnitIsAllowed(1, "MissileTurret")));
        lv_t = lv_t + " Barracks " + IntToString(GhostOps_Ce0_B(TechTreeUnitIsAllowed(1, "Barracks"))) + " requirement-has-barracks " + IntToString(TechTreeUnitCount(1, "Barracks", c_techCountCompleteOnly));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ucon") {
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_t = "UCON structures of the player:";
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            lv_t = lv_t + " " + UnitGetType(UnitGroupLoopCurrent()) + IntToString(GhostOps_Ce0_B(UnitTestState(UnitGroupLoopCurrent(), c_unitStateUnderConstruction))) + "/" + IntToString(UnitOrderCount(UnitGroupLoopCurrent()));
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "szl") {
        // 6 Zerglings of player 2 at the offset (a, b) from the first turret; an own Marine 1.5 cells away; b2 = "1": the Zerglings walk away east
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        lv_p = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b));
        UnitCreate(6, "Zergling", 0, 2, lv_p, 270.0);
        go_szG = UnitGroupCopy(UnitLastCreatedGroup());
        UnitGroupLoopBegin(go_szG);
        while (UnitGroupLoopCurrent() != null) {
            UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 200.0);
            UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 200.0);
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        UnitCreate(1, "SCV", 0, 1, PointWithOffset(lv_p, 1.5, 0.0), 270.0);
        go_szOwn = UnitLastCreated();
        libNtve_gf_PauseUnit(go_szOwn, true);
        UnitSetPropertyFixed(go_szOwn, c_unitPropLifeMax, 300.0);
        UnitSetPropertyFixed(go_szOwn, c_unitPropLife, 300.0);
        GhostOps_Ce0_Write("j", "SZL 6 zerglings (200 life) + own SCV (300) at " + FixedToString(PointGetX(lv_p), 1) + "," + FixedToString(PointGetY(lv_p), 1));
        return true;
    }

    if (lp_cmd == "szmove") {
        UnitGroupLoopBegin(go_szG);
        while (UnitGroupLoopCurrent() != null) {
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), false);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        UnitGroupIssueOrder(go_szG, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(UnitGroupUnit(go_szG, 1)), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        return true;
    }

    if (lp_cmd == "szr") {
        lv_t = "SZR zerglings alive " + IntToString(UnitGroupCount(go_szG, c_unitCountAlive)) + " lives";
        UnitGroupLoopBegin(go_szG);
        while (UnitGroupLoopCurrent() != null) {
            if (UnitIsAlive(UnitGroupLoopCurrent())) {
                lv_t = lv_t + " " + FixedToString(UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent), 0);
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        lv_t = lv_t + " | own SCV " + FixedToString(UnitGetPropertyFixed(go_szOwn, c_unitPropLife, c_unitPropCurrent), 0);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "salvon") {
        go_defSalvoOn = true;
        GhostOps_DEF_SalvoApply();
        GhostOps_Ce0_Write("j", "SALVON ground salvo switched on by the probe");
        return true;
    }

    if (lp_cmd == "vis") {
        lv_t = "VIS targets visible now:";
        lv_i = 0;
        while (lv_i < go_zhTargetCount) {
            lv_t = lv_t + " " + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, go_defTgtPos[lv_i])));
            lv_i += 1;
        }

        lv_t = lv_t + " | revealDone " + IntToString(GhostOps_Ce0_B(go_defRevealDone));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "revnow") {
        go_defRevealDone = false;
        go_defRevealSec = StringToFixed(lp_a);
        GhostOps_DEF_RevealTargets();
        return true;
    }

    if (lp_cmd == "mattnow") {
        TriggerExecute(TriggerCreate("GhostOps_DEF_MattMsg"), true, false);
        return true;
    }

    if (lp_cmd == "sov") {
        // an enemy Overlord (air, 200 life, paused) at the offset (a, b) from the first turret: the stock anti-air fire must go on
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        UnitCreate(1, "Overlord", 0, 2, PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        go_szOv = UnitLastCreated();
        UnitSetPropertyFixed(go_szOv, c_unitPropLifeMax, 400.0);
        UnitSetPropertyFixed(go_szOv, c_unitPropLife, 400.0);
        libNtve_gf_PauseUnit(go_szOv, true);
        return true;
    }

    if (lp_cmd == "sovr") {
        lv_t = "SOVR overlord life " + FixedToString(UnitGetPropertyFixed(go_szOv, c_unitPropLife, c_unitPropCurrent), 0);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "sv") {
        // the salvo of ONE turret (index a, 1-based) at the offset (b = dx) from it, dy 0
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, StringToInt(lp_a));
        lv_p = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_b), 0.0);
        lv_o = OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), lv_p);
        lv_t = "SV turret " + lp_a + " valid before " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, lv_o)));
        UnitIssueOrder(lv_u, lv_o, c_orderQueueReplace);
        GhostOps_Ce0_Write("j", lv_t + " minerals " + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals)));
        return true;
    }

    if (lp_cmd == "bld") {
        // an SCV builds (a = 7 Bunker, 6 Missile Turret) at x = 86 + b, y = 46
        lv_u = UnitGroupRandomUnit(UnitGroup("SCV", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0), c_unitCountAlive);
        lv_p = Point(86.0 + StringToFixed(lp_b), 46.0);
        lv_o = OrderTargetingPoint(AbilityCommand("TerranBuild", StringToInt(lp_a)), lv_p);
        UnitIssueOrder(lv_u, lv_o, c_orderQueueReplace);
        lv_t = "BLD order: build index " + lp_a + " at x " + FixedToString(PointGetX(lv_p), 1);
        lv_t = lv_t + " valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, lv_o)));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "bcancel") {
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            if (UnitTestState(UnitGroupLoopCurrent(), c_unitStateUnderConstruction)) {
                UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("BuildInProgress", StringToInt(lp_a))), c_orderQueueReplace);
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "BCANCEL cancel ordered for every unfinished structure");
        return true;
    }

    if (lp_cmd == "bdmg") {
        // damages every unfinished structure of the player (as an enemy would): life to 1
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            if (UnitTestState(UnitGroupLoopCurrent(), c_unitStateUnderConstruction)) {
                UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1.0);
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        return true;
    }

    if (lp_cmd == "bdk") {
        // an enemy-like destruction of the unfinished Bunker: damage first, a second later the kill
        GhostOps_Ce0_Write("j", "BDK damage");
        GhostOps_Ce0_DefCmd("bdmg", "", "");
        Wait(1.0, c_timeGame);
        GhostOps_Ce0_DefCmd("bkill", "Bunker", "");
        return true;
    }

    if (lp_cmd == "bkill") {
        // kills the player's structures of the type a (finished or not)
        lv_g = UnitGroup(lp_a, 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "BKILL killed all " + lp_a);
        return true;
    }

    if (lp_cmd == "bfin") {
        // finishes the construction of every structure at once (dev): sets the progress by finishing the unit's construction state
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            if (UnitTestState(UnitGroupLoopCurrent(), c_unitStateUnderConstruction)) {
                UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, c_unitPropCurrent));
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        return true;
    }

    if (lp_cmd == "land") {
        GhostOps_DEF_StartLanding(StringToInt(lp_a));
        GhostOps_Ce0_Write("j", "LAND forced slot " + lp_a);
        return true;
    }

    if (lp_cmd == "salvo") {
        // every Missile Turret of the player casts the salvo at the offset (a, b) from the first turret
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_i = UnitGroupCount(lv_g, c_unitCountAlive);
        if (lv_i > 0) {
            lv_u = UnitGroupUnit(lv_g, 1);
            lv_p = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b));
            lv_o = OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), lv_p);
            lv_t = "SALVO pre-check valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, lv_o))) + " allowed " + IntToString(GhostOps_Ce0_B(go_defSalvoOn)) + " visible " + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, lv_p))) + " dist " + FixedToString(DistanceBetweenPoints(UnitGetPosition(lv_u), lv_p), 1);
            GhostOps_Ce0_Write("j", lv_t);
            UnitGroupIssueOrder(lv_g, lv_o, c_orderQueueReplace);
            lv_t = "SALVO ordered to " + IntToString(lv_i) + " turrets at offset " + lp_a + "," + lp_b;
            lv_t = lv_t + " valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, lv_o))) + " minerals " + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals));
            GhostOps_Ce0_Write("j", lv_t);
        }

        return true;
    }

    if (lp_cmd == "kg") {
        // kill the marked Hatcheries of the group (Zerg player a = 2, 3, 4)
        lv_i = 0;
        while (lv_i < go_zhTargetCount) {
            if (UnitGetOwner(UnitFromId(go_zhTargetId[lv_i])) == StringToInt(lp_a)) {
                UnitKill(UnitFromId(go_zhTargetId[lv_i]));
                if (lp_b == "1") {
                    lv_i = 999;
                }
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "KG killed targets of player " + lp_a + " (b=" + lp_b + ")");
        return true;
    }

    if (lp_cmd == "wvp") {
        go_wvpTick = TriggerCreate("GhostOps_Ce0_WvpTick");
        TriggerAddEventTimePeriodic(go_wvpTick, 15.0, c_timeGame);
        return true;
    }

    if (lp_cmd == "fr") {
        // own units in the area of a salvo, no enemies: 2 SCV, 3 Marine, 1 Barracks (finished) at the offset (a, b) from the first turret; fr1 = lives at once
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        lv_p = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b));
        go_frG = UnitGroupEmpty();
        UnitCreate(2, "SCV", 0, 1, lv_p, 270.0);
        UnitGroupAddUnitGroup(go_frG, UnitLastCreatedGroup());
        UnitCreate(3, "Marine", 0, 1, PointWithOffset(lv_p, 1.0, 1.0), 270.0);
        UnitGroupAddUnitGroup(go_frG, UnitLastCreatedGroup());
        UnitCreate(1, "SupplyDepot", 0, 1, PointWithOffset(lv_p, -1.0, -1.0), 270.0);
        go_frBld = UnitLastCreated();
        UnitGroupAdd(go_frG, go_frBld);
        UnitGroupLoopBegin(go_frG);
        while (UnitGroupLoopCurrent() != null) {
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "FR placed " + IntToString(UnitGroupCount(go_frG, c_unitCountAlive)) + " own units at " + FixedToString(PointGetX(lv_p), 1) + "," + FixedToString(PointGetY(lv_p), 1) + " enemies near " + IntToString(UnitGroupCount(UnitGroup(null, 2, RegionCircle(lv_p, 12.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) + UnitGroupCount(UnitGroup(null, 3, RegionCircle(lv_p, 12.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) + UnitGroupCount(UnitGroup(null, 4, RegionCircle(lv_p, 12.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "szd") {
        // one enemy dummy (Zergling, 3000 life, paused) at the offset (a, b) from the first turret; every own Marine is paused so nothing else shoots
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        lv_p = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b));
        UnitCreate(1, "Zergling", 0, 2, lv_p, 270.0);
        go_szD = UnitLastCreated();
        UnitSetPropertyFixed(go_szD, c_unitPropLifeMax, 3000.0);
        UnitSetPropertyFixed(go_szD, c_unitPropLife, 3000.0);
        libNtve_gf_PauseUnit(go_szD, true);
        lv_g = UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "SZD dummy placed at " + FixedToString(PointGetX(lv_p), 1) + "," + FixedToString(PointGetY(lv_p), 1) + " life " + FixedToString(UnitGetPropertyFixed(go_szD, c_unitPropLife, c_unitPropCurrent), 0));
        return true;
    }

    if (lp_cmd == "szdr") {
        GhostOps_Ce0_Write("j", "SZDR dummy life " + FixedToString(UnitGetPropertyFixed(go_szD, c_unitPropLife, c_unitPropCurrent), 0));
        return true;
    }

    if (lp_cmd == "nofoe") {
        // every 0.25 s all enemy non-structure units (except the dummy) are removed: nothing but the salvo can hurt the own units
        if (go_dumG == null) {
            go_dumG = UnitGroupEmpty();
        }

        go_nofoeTick = TriggerCreate("GhostOps_Ce0_NofoeTick");
        TriggerAddEventTimePeriodic(go_nofoeTick, 0.25, c_timeGame);
        GhostOps_Ce0_Write("j", "NOFOE running");
        return true;
    }

    if (lp_cmd == "cleane") {
        // kills every non-structure unit of the Zerg players 2..5 (an enemy-free scene)
        lv_i = 2;
        while (lv_i <= 5) {
            lv_g = UnitGroup(null, lv_i, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0);
            UnitGroupLoopBegin(lv_g);
            while (UnitGroupLoopCurrent() != null) {
                UnitRemove(UnitGroupLoopCurrent());
                UnitGroupLoopStep();
            }

            UnitGroupLoopEnd();
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "CLEANE enemy units removed");
        return true;
    }

    if (lp_cmd == "frr") {
        lv_i = 0;
        lv_k = 2;
        while (lv_k <= 5) {
            lv_i += UnitGroupCount(UnitGroup(null, lv_k, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
            lv_k += 1;
        }

        lv_t = "FRR enemyUnitsOnMap " + IntToString(lv_i) + " |";
        UnitGroupLoopBegin(go_frG);
        while (UnitGroupLoopCurrent() != null) {
            lv_t = lv_t + " " + UnitGetType(UnitGroupLoopCurrent()) + "=" + FixedToString(UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent), 0) + "/" + FixedToString(UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, c_unitPropCurrent), 0);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "wvn") {
        // trace the waves: every 10 s the number of fighters of the three Zerg players near our base and the sums sent
        go_wvTick = TriggerCreate("GhostOps_Ce0_WvTick");
        TriggerAddEventTimePeriodic(go_wvTick, 10.0, c_timeGame);
        return true;
    }

    if (lp_cmd == "mins") {
        GhostOps_Ce0_Write("j", "MINS minerals " + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals)));
        return true;
    }

    return false;
}

// the aimed-salvo probe commands (area, impact points, friendly units, anti-air during the salvo): separate function, see DefCmd
point go_amP;
unitgroup go_amG;
unitgroup go_amMov;
unit go_amOv;
trigger go_amTick;
int go_amN;
fixed go_amT0;

bool GhostOps_Ce0_AmTick (bool lp_test, bool lp_run) {
    int lv_hit;
    int lv_dmg;
    fixed lv_l;
    string lv_t;

    if (!lp_run) {
        return true;
    }

    lv_hit = 0;
    lv_dmg = 0;
    UnitGroupLoopBegin(go_amG);
    while (UnitGroupLoopCurrent() != null) {
        lv_l = UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent);
        if (lv_l < 2999.5) {
            lv_hit += 1;
            lv_dmg += FixedToInt(3000.0 - lv_l);
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    lv_t = "AML t=" + FixedToString(GameGetMissionTime() - go_amT0, 1) + " grid hit " + IntToString(lv_hit) + " dmg " + IntToString(lv_dmg);
    if (go_amOv != null) {
        lv_t = lv_t + " overlord " + FixedToString(UnitGetPropertyFixed(go_amOv, c_unitPropLife, c_unitPropCurrent), 0);
    }

    GhostOps_Ce0_Write("j", lv_t);
    go_amN += 1;
    if (go_amN >= 24) {
        TriggerDestroy(TriggerGetCurrent());
    }

    return true;
}

bool GhostOps_Ce0_AimCmd (string lp_cmd, string lp_a, string lp_b) {
    string lv_t;
    int lv_i;
    int lv_j;
    int lv_n;
    int lv_hit;
    int lv_dmg;
    int lv_out;
    int lv_in;
    fixed lv_d;
    fixed lv_maxd;
    fixed lv_l;
    fixed lv_x;
    fixed lv_y;
    unit lv_u;
    unitgroup lv_g;

    if (lp_cmd == "amset") {
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        go_amP = PointWithOffset(UnitGetPosition(UnitGroupUnit(lv_g, 1)), StringToFixed(lp_a), StringToFixed(lp_b));
        GhostOps_Ce0_Write("j", "AMSET aim point " + FixedToString(PointGetX(go_amP), 2) + "," + FixedToString(PointGetY(go_amP), 2) + " turrets " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "amgrid") {
        // enemy dummies (Zergling, 3000 life, paused) on a 0.75 grid inside the radius a around the aim point: where the damage lands and where it does not
        go_amG = UnitGroupEmpty();
        go_dumG = UnitGroupEmpty();
        lv_x = -6.0;
        while (lv_x <= 6.01) {
            lv_y = -6.0;
            while (lv_y <= 6.01) {
                if (SquareRoot((lv_x * lv_x) + (lv_y * lv_y)) <= StringToFixed(lp_a)) {
                    UnitCreate(1, "Zergling", 0, 2, PointWithOffset(go_amP, lv_x, lv_y), 270.0);
                    lv_u = UnitLastCreated();
                    UnitSetPropertyFixed(lv_u, c_unitPropLifeMax, 3000.0);
                    UnitSetPropertyFixed(lv_u, c_unitPropLife, 3000.0);
                    libNtve_gf_PauseUnit(lv_u, true);
                    UnitGroupAdd(go_amG, lv_u);
                    UnitGroupAdd(go_dumG, lv_u);
                }

                lv_y += 0.75;
            }

            lv_x += 0.75;
        }

        GhostOps_Ce0_Write("j", "AMGRID dummies " + IntToString(UnitGroupCount(go_amG, c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "amr") {
        // report: a = the whole radius the pointer shows; counts of damaged dummies, total damage, farthest damaged dummy, damaged beyond the radius, undamaged inside it
        lv_hit = 0;
        lv_dmg = 0;
        lv_out = 0;
        lv_in = 0;
        lv_maxd = 0.0;
        lv_n = 0;
        UnitGroupLoopBegin(go_amG);
        while (UnitGroupLoopCurrent() != null) {
            lv_l = UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent);
            lv_d = DistanceBetweenPoints(UnitGetPosition(UnitGroupLoopCurrent()), go_amP);
            if (lv_l < 2999.5) {
                lv_hit += 1;
                lv_dmg += FixedToInt(3000.0 - lv_l);
                if (lv_d > lv_maxd) {
                    lv_maxd = lv_d;
                }

                if (lv_d > StringToFixed(lp_a)) {
                    lv_out += 1;
                }
            }
            else {
                if (lv_d <= StringToFixed(lp_a)) {
                    lv_in += 1;
                }
            }

            lv_n += 1;
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "AMR dummies " + IntToString(lv_n) + " damaged " + IntToString(lv_hit) + " totaldmg " + IntToString(lv_dmg) + " farthest damaged " + FixedToString(lv_maxd, 2) + " damaged beyond " + lp_a + ": " + IntToString(lv_out) + " undamaged inside: " + IntToString(lv_in));
        return true;
    }

    if (lp_cmd == "amhist") {
        // how many dummies took 30 / 60 / 90 / 120 / 150 damage (missile hits)
        lv_t = "AMHIST";
        lv_j = 1;
        while (lv_j <= 6) {
            lv_n = 0;
            UnitGroupLoopBegin(go_amG);
            while (UnitGroupLoopCurrent() != null) {
                lv_dmg = FixedToInt(3000.0 - UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent) + 0.5);
                if (lv_dmg == (30 * lv_j)) {
                    lv_n += 1;
                }

                UnitGroupLoopStep();
            }

            UnitGroupLoopEnd();
            lv_t = lv_t + " x" + IntToString(lv_j) + "=" + IntToString(lv_n);
            lv_j += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "amsv") {
        // the salvo of turret a (1-based) at the aim point
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, StringToInt(lp_a));
        lv_t = "AMSV turret " + lp_a + " valid before " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), go_amP)))) + " distance " + FixedToString(DistanceBetweenPoints(UnitGetPosition(lv_u), go_amP), 1);
        UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), go_amP), c_orderQueueReplace);
        go_amT0 = GameGetMissionTime();
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "amov") {
        // an enemy Overlord (air, 3000 life, paused) at the offset (a, b) from the first turret
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitCreate(1, "Overlord", 0, 2, PointWithOffset(UnitGetPosition(UnitGroupUnit(lv_g, 1)), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        go_amOv = UnitLastCreated();
        UnitSetPropertyFixed(go_amOv, c_unitPropLifeMax, 3000.0);
        UnitSetPropertyFixed(go_amOv, c_unitPropLife, 3000.0);
        libNtve_gf_PauseUnit(go_amOv, true);
        UnitGroupAdd(go_dumG, go_amOv);
        GhostOps_Ce0_Write("j", "AMOV overlord placed life 3000");
        return true;
    }

    if (lp_cmd == "amlog") {
        // samples the dummies (and the overlord) every 0.4 s, 24 times: the timeline of the salvo
        go_amN = 0;
        go_amTick = TriggerCreate("GhostOps_Ce0_AmTick");
        TriggerAddEventTimePeriodic(go_amTick, 0.4, c_timeGame);
        return true;
    }

    if (lp_cmd == "ammov") {
        // 6 enemy Zerglings (3000 life) at the aim point that start walking away (east, 16 cells) at once
        go_amMov = UnitGroupEmpty();
        lv_i = 0;
        while (lv_i < 6) {
            UnitCreate(1, "Zergling", 0, 2, PointWithOffset(go_amP, 0.0, (IntToFixed(lv_i) * 0.5) - 1.25), 270.0);
            lv_u = UnitLastCreated();
            UnitSetPropertyFixed(lv_u, c_unitPropLifeMax, 3000.0);
            UnitSetPropertyFixed(lv_u, c_unitPropLife, 3000.0);
            UnitGroupAdd(go_amMov, lv_u);
            UnitGroupAdd(go_dumG, lv_u);
            lv_i += 1;
        }

        UnitGroupIssueOrder(go_amMov, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(go_amP, 16.0, 0.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "AMMOV 6 moving dummies");
        return true;
    }

    if (lp_cmd == "ammr") {
        lv_t = "AMMR moving dummies life";
        UnitGroupLoopBegin(go_amMov);
        while (UnitGroupLoopCurrent() != null) {
            lv_t = lv_t + " " + FixedToString(UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, c_unitPropCurrent), 0) + "@" + FixedToString(DistanceBetweenPoints(UnitGetPosition(UnitGroupLoopCurrent()), go_amP), 1);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "amval") {
        // validity of the salvo order of turret a (1-based) at the aim point WITHOUT issuing it (cooldown state: 0 = cooling down or locked, 1 = ready)
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, StringToInt(lp_a));
        GhostOps_Ce0_Write("j", "AMVAL turret " + lp_a + " ready " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), go_amP)))) + " game time " + FixedToString(GameGetMissionTime(), 1));
        return true;
    }

    if (lp_cmd == "selt") {
        // selects turret a (1-based) of the player and puts the camera over it (the pointer test needs the turret selected)
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, StringToInt(lp_a));
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELT turret " + lp_a + " selected, camera on it");
        return true;
    }

    if (lp_cmd == "selm") {
        // selects one own Marine (a = Marine, b is ignored) or one Ghost (a = Ghost): the panel of other units must be unchanged
        lv_g = UnitGroup(lp_a, 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELM " + lp_a + " selected");
        return true;
    }

    if (lp_cmd == "selall") {
        // selects every Missile Turret of the player
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupSelect(lv_g, 1, true);
        CameraPan(1, UnitGetPosition(UnitGroupUnit(lv_g, 1)), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELALL " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " turrets selected");
        return true;
    }

    if (lp_cmd == "amsvall") {
        // ONE group order of all turrets at the aim point (what a command given to several selected turrets does)
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupIssueOrder(lv_g, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), go_amP), c_orderQueueReplace);
        go_amT0 = GameGetMissionTime();
        GhostOps_Ce0_Write("j", "AMSVALL group order given to " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " turrets");
        return true;
    }

    if (lp_cmd == "pausem") {
        lv_g = UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "PAUSEM own marines paused");
        return true;
    }

    return false;
}

// the detector-analysis probes (dev only): enemy detectors near the Ghosts, the radar buff, the real detection by an enemy Zergling, selections
unit[6] go_dtU;
int go_dtN;
unit go_dtZ;
trigger go_dtTick;
int go_dtCount;

unit GhostOps_Ce0_Ghost1 () {
    return UnitGroupUnit(UnitGroup("Ghost", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0), 1);
}

bool GhostOps_Ce0_DtTick (bool lp_test, bool lp_run) {
    int lv_i;
    string lv_t;
    unit lv_g;

    if (!lp_run) {
        return true;
    }

    lv_g = GhostOps_Ce0_Ghost1();
    lv_t = "DTL t=" + FixedToString(GameGetMissionTime(), 1) + " ghostLife " + FixedToString(UnitGetPropertyFixed(lv_g, c_unitPropLife, c_unitPropCurrent), 0);
    lv_t = lv_t + " gsel " + IntToString(GhostOps_Ce0_B(UnitIsSelected(lv_g, 1))) + " radar " + IntToString(UnitBehaviorCount(lv_g, "HeroDetectorRadar"));
    lv_i = 0;
    while (lv_i < go_dtN) {
        if ((go_dtU[lv_i] != null) && UnitIsAlive(go_dtU[lv_i])) {
            lv_t = lv_t + " | " + UnitGetType(go_dtU[lv_i]) + " d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dtU[lv_i]), UnitGetPosition(lv_g)), 1) + " vis=" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, UnitGetPosition(go_dtU[lv_i])))) + " buff=" + IntToString(UnitBehaviorCount(go_dtU[lv_i], "HeroDetectorRadarDetected"));
        }
        else {
            lv_t = lv_t + " | dead";
        }

        lv_i += 1;
    }

    GhostOps_Ce0_Write("j", lv_t);
    go_dtCount += 1;
    if (go_dtCount >= 150) {
        TriggerDestroy(TriggerGetCurrent());
    }

    return true;
}

bool GhostOps_Ce0_DetCmd (string lp_cmd, string lp_a, string lp_b) {
    unit lv_g;
    unit lv_u;
    unitgroup lv_grp;

    if ((lp_cmd == "dtsp") || (lp_cmd == "dtov")) {
        // an enemy (player 2) Spore Crawler / Overseer at the offset (a, b) from the first Ghost
        lv_g = GhostOps_Ce0_Ghost1();
        if (lp_cmd == "dtsp") {
            UnitCreate(1, "SporeCrawler", 0, 5, PointWithOffset(UnitGetPosition(lv_g), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        }
        else {
            UnitCreate(1, "Overseer", 0, 5, PointWithOffset(UnitGetPosition(lv_g), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        }

        lv_u = UnitLastCreated();
        if (lp_cmd == "dtov") {
            libNtve_gf_PauseUnit(lv_u, true);
        }

        if (go_dtN < 6) {
            go_dtU[go_dtN] = lv_u;
            go_dtN += 1;
        }

        if (go_dumG != null) {
            UnitGroupAdd(go_dumG, lv_u);
        }

        GhostOps_Ce0_Write("j", "DT placed " + UnitGetType(lv_u) + " index " + IntToString(go_dtN - 1) + " owner " + IntToString(UnitGetOwner(lv_u)));
        return true;
    }

    if (lp_cmd == "dtmv") {
        // the detector with the index a walks (flies) to the offset b-th... : (a = index, b = dx; dy = 0) relative to the first Ghost
        lv_g = GhostOps_Ce0_Ghost1();
        libNtve_gf_PauseUnit(go_dtU[StringToInt(lp_a)], false);
        UnitIssueOrder(go_dtU[StringToInt(lp_a)], OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(lv_g), StringToFixed(lp_b), 0.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "DTMV detector " + lp_a + " moves to dx " + lp_b);
        return true;
    }

    if (lp_cmd == "dtkill") {
        UnitKill(go_dtU[StringToInt(lp_a)]);
        GhostOps_Ce0_Write("j", "DTKILL detector " + lp_a);
        return true;
    }

    if (lp_cmd == "dtlog") {
        go_dtCount = 0;
        go_dtTick = TriggerCreate("GhostOps_Ce0_DtTick");
        TriggerAddEventTimePeriodic(go_dtTick, 0.4, c_timeGame);
        return true;
    }

    if (lp_cmd == "dtz") {
        // an enemy Zergling (player 2) at the offset (a, b) from the first Ghost: it attacks the Ghost only when the Ghost is DETECTED
        lv_g = GhostOps_Ce0_Ghost1();
        UnitCreate(1, "Zergling", 0, 2, PointWithOffset(UnitGetPosition(lv_g), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        go_dtZ = UnitLastCreated();
        UnitSetPropertyFixed(go_dtZ, c_unitPropLifeMax, 3000.0);
        UnitSetPropertyFixed(go_dtZ, c_unitPropLife, 3000.0);
        // the Ghost can take the bites for the whole test (the life LOST is the measure of the detection); the Zergling is sent at the Ghost's place
        UnitSetPropertyFixed(lv_g, c_unitPropLifeMax, 2000.0);
        UnitSetPropertyFixed(lv_g, c_unitPropLife, 2000.0);
        UnitIssueOrder(go_dtZ, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(lv_g)), c_orderQueueReplace);
        if (go_dumG != null) {
            UnitGroupAdd(go_dumG, go_dtZ);
        }

        GhostOps_Ce0_Write("j", "DTZ zergling placed");
        return true;
    }

    if (lp_cmd == "selghosts") {
        lv_grp = UnitGroup("Ghost", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupSelect(lv_grp, 1, true);
        CameraPan(1, UnitGetPosition(UnitGroupUnit(lv_grp, 1)), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELGHOSTS " + IntToString(UnitGroupCount(lv_grp, c_unitCountAlive)) + " selected");
        return true;
    }

    if (lp_cmd == "selmix") {
        lv_grp = UnitGroup("Ghost", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitGroupAddUnitGroup(lv_grp, UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_DEF_Live(), 3));
        UnitGroupSelect(lv_grp, 1, true);
        CameraPan(1, UnitGetPosition(GhostOps_Ce0_Ghost1()), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELMIX " + IntToString(UnitGroupCount(lv_grp, c_unitCountAlive)) + " selected");
        return true;
    }

    if (lp_cmd == "mku") {
        // creates one unit of the type a for the player at the offset (b, 0) from the first Ghost and selects it (does the type exist in the data of this map?)
        lv_g = GhostOps_Ce0_Ghost1();
        UnitCreate(1, lp_a, 0, 1, PointWithOffset(UnitGetPosition(lv_g), StringToFixed(lp_b), 0.0), 270.0);
        lv_u = UnitLastCreated();
        if (lv_u == null) {
            GhostOps_Ce0_Write("j", "MKU " + lp_a + " NOT created");
        }
        else {
            UnitSelect(lv_u, 1, true);
            GhostOps_Ce0_Write("j", "MKU " + lp_a + " created and selected: " + UnitGetType(lv_u));
        }

        return true;
    }

    if (lp_cmd == "ghold") {
        // the Ghosts hold their position (they do not wander after enemies): a stable scene for the screenshots
        lv_grp = UnitGroup("Ghost", 1, RegionEntireMap(), GhostOps_DEF_Live(), 0);
        UnitSetPosition(UnitGroupUnit(lv_grp, 1), Point(90.0, 48.0), false);
        UnitSetPosition(UnitGroupUnit(lv_grp, 2), Point(91.5, 48.0), false);
        UnitGroupIssueOrder(lv_grp, Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "GHOLD " + IntToString(UnitGroupCount(lv_grp, c_unitCountAlive)) + " ghosts hold position at " + FixedToString(PointGetX(UnitGetPosition(GhostOps_Ce0_Ghost1())), 1) + "," + FixedToString(PointGetY(UnitGetPosition(GhostOps_Ce0_Ghost1())), 1));
        return true;
    }

    if (lp_cmd == "selonly") {
        // only the first unit of the type a is selected (the selection is replaced)
        UnitClearSelection(1);
        lv_u = UnitGroupUnit(UnitGroup(lp_a, 1, RegionEntireMap(), GhostOps_DEF_Live(), 0), 1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(GhostOps_Ce0_Ghost1()), 0.0, -1, 10.0, false);
        GhostOps_Ce0_Write("j", "SELONLY " + lp_a + " selected alone");
        return true;
    }

    if (lp_cmd == "dtbuff") {
        lv_g = GhostOps_Ce0_Ghost1();
        GhostOps_Ce0_Write("j", "DTBUFF ghost has radar behavior " + IntToString(UnitBehaviorCount(lv_g, "HeroDetectorRadar")));
        return true;
    }

    return false;
}

// ---- revision 3 probes (the nuclear counter, the grenade launchers of both Ghosts, the marks, the size of the strike) ----
unit[16] go_r3Dum;
fixed[16] go_r3Life;
string[16] go_r3Tag;
int go_r3N;

void GhostOps_Ce0_R3Add (string lp_type, int lp_owner, point lp_pos, string lp_tag) {
    UnitCreate(1, lp_type, c_unitCreateIgnorePlacement, lp_owner, lp_pos, 270.0);
    go_r3Dum[go_r3N] = UnitLastCreated();
    if (lp_type == "Ultralisk") {
        // a big life: a hit that would kill an ordinary Ultralisk is still MEASURED (the life lost tells the damage of the zone)
        UnitSetPropertyFixed(UnitLastCreated(), c_unitPropLifeMax, 4000.0);
        UnitSetPropertyFixed(UnitLastCreated(), c_unitPropLife, 4000.0);
    }

    go_r3Life[go_r3N] = UnitGetPropertyFixed(UnitLastCreated(), c_unitPropLife, c_unitPropCurrent);
    go_r3Tag[go_r3N] = lp_tag;
    if (go_dumG != null) {
        UnitGroupAdd(go_dumG, UnitLastCreated());
    }

    libNtve_gf_PauseUnit(UnitLastCreated(), true);
    go_r3N += 1;
}

// rebdmg: a Marine handed over like a rescued one (the hook) and a plain Marine each fight their own paused Ultralisk for 8 s; the life lost shows the rebel damage multiplier
void GhostOps_Ce0_RebDmg (string lp_swap) {
    unit lv_a;
    unit lv_b;
    unit lv_ua;
    unit lv_ub;
    unit lv_o;
    fixed lv_la;
    fixed lv_lb;

    lv_o = UnitFromId(23);
    UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_o), -6.0, -6.0), 270.0);
    lv_a = UnitLastCreated();
    UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_o), -6.0, -12.0), 270.0);
    lv_b = UnitLastCreated();
    if (lp_swap == "1") {
        GhostOps_Tac_OnRescue(lv_b);
    }
    else {
        GhostOps_Tac_OnRescue(lv_a);
    }

    UnitCreate(2, "Ultralisk", c_unitCreateIgnorePlacement, 2, PointWithOffset(UnitGetPosition(lv_a), 4.0, 0.0), 270.0);
    lv_ua = UnitLastCreated();
    UnitCreate(2, "Ultralisk", c_unitCreateIgnorePlacement, 2, PointWithOffset(UnitGetPosition(lv_b), 4.0, 0.0), 270.0);
    lv_ub = UnitLastCreated();
    libNtve_gf_PauseUnit(lv_ua, true);
    libNtve_gf_PauseUnit(lv_ub, true);
    UnitIssueOrder(lv_a, OrderTargetingUnit(AbilityCommand("attack", 0), lv_ua), c_orderQueueReplace);
    UnitIssueOrder(lv_b, OrderTargetingUnit(AbilityCommand("attack", 0), lv_ub), c_orderQueueReplace);
    Wait(8.0, c_timeGame);
    lv_la = UnitGetPropertyFixed(lv_ua, c_unitPropLifeMax, c_unitPropCurrent) - UnitGetPropertyFixed(lv_ua, c_unitPropLife, c_unitPropCurrent);
    lv_lb = UnitGetPropertyFixed(lv_ub, c_unitPropLifeMax, c_unitPropCurrent) - UnitGetPropertyFixed(lv_ub, c_unitPropLife, c_unitPropCurrent);
    GhostOps_Ce0_Write("j", "REBDMG swap " + lp_swap + ": Marine A dealt " + FixedToString(lv_la, 1) + ", Marine B dealt " + FixedToString(lv_lb, 1) + " in 8 s; rebel behavior A " + IntToString(UnitBehaviorCount(lv_a, "GhostOpsRebelDamage")) + " B " + IntToString(UnitBehaviorCount(lv_b, "GhostOpsRebelDamage")) + " target life A-side " + FixedToString(UnitGetPropertyFixed(lv_ua, c_unitPropLife, c_unitPropCurrent), 0));
    UnitRemove(lv_a);
    UnitRemove(lv_b);
    UnitRemove(lv_ua);
    UnitRemove(lv_ub);
}

// refstat: the geysers near the player's SCVs, the Refineries of the player, gas and minerals; refcam <n>: the camera centres on the geyser n (a real click then builds there)
unit GhostOps_Ce0_Geyser (int lp_n) {
    unitgroup lv_g;
    unit lv_u;
    unit lv_s;
    int lv_k;

    lv_s = UnitGroupUnit(UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), 1);
    lv_g = UnitGroup(null, c_playerAny, RegionCircle(UnitGetPosition(lv_s), 40.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_k = 0;
    UnitGroupLoopBegin(lv_g);
    while (UnitGroupLoopCurrent() != null) {
        lv_u = UnitGroupLoopCurrent();
        if ((StringFind(UnitGetType(lv_u), "Geyser", c_stringNoCase) > 0) || (StringFind(UnitGetType(lv_u), "Vespene", c_stringNoCase) > 0)) {
            lv_k += 1;
            if (lv_k == lp_n) {
                UnitGroupLoopEnd();
                return lv_u;
            }
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    return null;
}

void GhostOps_Ce0_RefStat () {
    unit lv_g;
    int lv_n;
    string lv_t;
    string lv_g2;

    lv_g2 = "";
    lv_n = 1;
    while (lv_n <= 4) {
        lv_g = GhostOps_Ce0_Geyser(lv_n);
        if (lv_g != null) {
            lv_g2 = lv_g2 + UnitGetType(lv_g) + "@" + FixedToString(PointGetX(UnitGetPosition(lv_g)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_g)), 1) + " ";
        }

        lv_n += 1;
    }

    lv_t = "REFSTAT scvs " + IntToString(UnitGroupCount(UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive));
    lv_t = lv_t + " refineries " + IntToString(UnitGroupCount(UnitGroup("Refinery", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive));
    lv_t = lv_t + " gas " + IntToString(PlayerGetPropertyInt(1, c_playerPropVespene)) + " minerals " + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals));
    GhostOps_Ce0_Write("j", lv_t + " | geysers " + lv_g2);
}

// fpstat: the final push state (timer left, warning, waves fired, the enemy units near the landing point, the Hatcheries left); fpt <s>: the evacuation timer restarts with s seconds left
void GhostOps_Ce0_FpStat () {
    string lv_t;
    int lv_p;

    lv_t = "FPSTAT on " + IntToString(GhostOps_Ce0_B(go_defFpOn)) + " left " + FixedToString(TimerGetRemaining(go_defTimer), 0) + " warned " + IntToString(GhostOps_Ce0_B(go_defFpWarned)) + " fired " + IntToString(GhostOps_Ce0_B(go_defFpDone[0])) + IntToString(GhostOps_Ce0_B(go_defFpDone[1])) + IntToString(GhostOps_Ce0_B(go_defFpDone[2]));
    lv_p = 2;
    while (lv_p <= 4) {
        lv_t = lv_t + " | P" + IntToString(lv_p) + " units " + IntToString(UnitGroupCount(UnitGroup(null, lv_p, RegionCircle(Point(go_defLandX, go_defLandY), 70.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive));
        lv_t = lv_t + " hatch " + IntToString(UnitGroupCount(UnitGroup("Hatchery", lv_p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) + UnitGroupCount(UnitGroup("Lair", lv_p, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive));
        lv_p += 1;
    }

    GhostOps_Ce0_Write("j", lv_t);
}

bool GhostOps_Ce0_R3Cmd (string lp_cmd, string lp_a, string lp_b) {
    int lv_i;
    unitgroup lv_g;
    unit lv_u;
    string lv_t;
    fixed lv_x;
    fixed lv_y;
    fixed lv_d;
    fixed lv_ang;

    if (lp_cmd == "tstat") {
        lv_t = "TSTAT tac state " + IntToString(go_tacState) + " launches " + IntToString(go_tacLaunches) + "/" + IntToString(go_tacNukeCount) + " | grenades " + IntToString(go_tacGrenAmmo[0]) + "," + IntToString(go_tacGrenAmmo[1]) + " | marks persist " + IntToString(GhostOps_Ce0_B(go_zhMarksPersist)) + " shown " + IntToString(GhostOps_Ce0_B(go_zhMarksShown)) + " dead " + IntToString(go_zhDead) + "/" + IntToString(go_zhTargetCount) + " ping ids";
        lv_i = 0;
        while (lv_i < go_zhTargetCount) {
            lv_t = lv_t + " " + IntToString(go_zhPingId[lv_i]);
            lv_i += 1;
        }

        lv_t = lv_t + " | ghosts alive " + IntToString(GhostOps_Ce0_B(UnitIsAlive(GhostOps_SquadUnit(0)))) + IntToString(GhostOps_Ce0_B(UnitIsAlive(GhostOps_SquadUnit(1)))) + " | labels " + IntToString(go_tacRebCount) + " rescued " + IntToString(UnitGroupCount(go_tacRescued, c_unitCountAlive)) + " | nuke ability range " + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Range[0]", 1);
        lv_t = lv_t + " | gren abil exists " + IntToString(GhostOps_Ce0_B(UnitAbilityExists(go_tacSpotter, "GhostOpsArmorPiercing"))) + IntToString(GhostOps_Ce0_B(UnitAbilityExists(go_tacOperative, "GhostOpsArmorPiercing"))) + " enabled " + IntToString(GhostOps_Ce0_B(UnitAbilityCheck(go_tacSpotter, "GhostOpsArmorPiercing", true))) + IntToString(GhostOps_Ce0_B(UnitAbilityCheck(go_tacOperative, "GhostOpsArmorPiercing", true))) + " grenade flags " + IntToString(GhostOps_Ce0_B(go_tacGrenade)) + IntToString(GhostOps_Ce0_B(go_tacGrenBoth));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if ((lp_cmd == "gsel1") || (lp_cmd == "gsel2")) {
        // gsel1 / gsel2 <x> <y>: the Ghost goes to the point, is the only selected unit, the camera is on him
        if (lp_cmd == "gsel1") {
            lv_u = GhostOps_SquadUnit(0);
        }
        else {
            lv_u = GhostOps_SquadUnit(1);
        }

        UnitSetPosition(lv_u, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
        UnitClearSelection(1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "GSEL " + lp_cmd + " at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "tlife") {
        lv_u = UnitFromId(StringToInt(lp_a));
        if ((lv_u != null) && UnitIsAlive(lv_u)) {
            GhostOps_Ce0_Write("j", "TLIFE " + lp_a + " " + UnitGetType(lv_u) + " life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1));
        }
        else {
            GhostOps_Ce0_Write("j", "TLIFE " + lp_a + " dead");
        }

        return true;
    }

    if (lp_cmd == "gdum") {
        // gdum <id>: the targets of the grenade test around the building <id>: a paused enemy Zergling (ordinary biological fighter), a paused enemy Mutalisk (air), an own Marine
        lv_u = UnitFromId(StringToInt(lp_a));
        go_r3N = 0;
        GhostOps_Ce0_R3Add("Zergling", 2, PointWithOffset(UnitGetPosition(lv_u), 2.5, 0.0), "zergling");
        GhostOps_Ce0_R3Add("Mutalisk", 2, PointWithOffset(UnitGetPosition(lv_u), 0.0, 2.5), "mutalisk(air)");
        GhostOps_Ce0_R3Add("Marine", 1, PointWithOffset(UnitGetPosition(lv_u), -2.5, 0.0), "own marine");
        GhostOps_Ce0_R3Add("Roach", 2, PointWithOffset(UnitGetPosition(lv_u), 0.0, -2.5), "roach");
        GhostOps_Ce0_Write("j", "GDUM 4 dummies around the building " + lp_a);
        return true;
    }

    if (lp_cmd == "ndum") {
        // ndum <x> <y>: the meter of the strike: paused enemy Ultralisks (life 500) and enemy Hatcheries at growing distances from the point, in different directions
        go_r3N = 0;
        lv_d = 0.0;
        while (go_r3N < 8) {
            lv_d = IntToFixed(go_r3N) * 2.5;
            if (go_r3N == 0) {
                lv_d = 0.0;
            }

            lv_ang = IntToFixed(go_r3N) * 47.0;
            lv_x = StringToFixed(lp_a) + lv_d * Cos(lv_ang);
            lv_y = StringToFixed(lp_b) + lv_d * Sin(lv_ang);
            GhostOps_Ce0_R3Add("Ultralisk", 2, Point(lv_x, lv_y), "ultra d=" + FixedToString(lv_d, 1));
        }

        lv_i = 0;
        while (lv_i < 4) {
            lv_d = IntToFixed(lv_i) * 6.0 + 4.0;
            lv_ang = 200.0 + IntToFixed(lv_i) * 40.0;
            lv_x = StringToFixed(lp_a) + lv_d * Cos(lv_ang);
            lv_y = StringToFixed(lp_b) + lv_d * Sin(lv_ang);
            GhostOps_Ce0_R3Add("Hatchery", 2, Point(lv_x, lv_y), "hatch d=" + FixedToString(lv_d, 1));
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "NDUM " + IntToString(go_r3N) + " meter units around " + lp_a + "," + lp_b);
        return true;
    }

    if ((lp_cmd == "gdumr") || (lp_cmd == "ndumr")) {
        lv_t = "";
        lv_i = 0;
        while (lv_i < go_r3N) {
            if (UnitIsAlive(go_r3Dum[lv_i])) {
                lv_t = lv_t + go_r3Tag[lv_i] + ":" + FixedToString(go_r3Life[lv_i] - UnitGetPropertyFixed(go_r3Dum[lv_i], c_unitPropLife, c_unitPropCurrent), 0) + " ";
            }
            else {
                lv_t = lv_t + go_r3Tag[lv_i] + ":dead ";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "R3 lost life " + lv_t);
        return true;
    }

    if (lp_cmd == "gallow") {
        // gallow: the tech tree allowance and the enabling of the grenade ability are applied AGAIN (is the grey button a question of the moment?)
        TechTreeAbilityAllow(1, AbilityCommand("GhostOpsArmorPiercing", 0), true);
        UnitAbilityEnable(GhostOps_SquadUnit(0), "GhostOpsArmorPiercing", true);
        UnitAbilityEnable(GhostOps_SquadUnit(1), "GhostOpsArmorPiercing", true);
        GhostOps_Ce0_Write("j", "GALLOW applied");
        return true;
    }

    if (lp_cmd == "slow") {
        // slow <scale>: the whole game runs at that time scale (dev only: the frames of a projectile / a blast are caught by the screenshots)
        GameSetGlobalTimeScale(StringToFixed(lp_a));
        GhostOps_Ce0_Write("j", "SLOW time scale " + lp_a);
        return true;
    }

    if (lp_cmd == "gorder") {
        // gorder <dx> <dy>: Ghost 1 is ORDERED to throw the grenade at the offset (does the order go through the tech / requirements, apart from the button?)
        lv_u = GhostOps_SquadUnit(0);
        UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "GORDER issued, orders " + IntToString(UnitOrderCount(lv_u)));
        Wait(2.0, c_timeGame);
        GhostOps_Ce0_Write("j", "GORDER after 2 s: orders " + IntToString(UnitOrderCount(lv_u)) + " charges " + IntToString(go_tacGrenAmmo[0]) + "," + IntToString(go_tacGrenAmmo[1]) + " tech count " + IntToString(TechTreeAbilityCount(1, "GhostOpsArmorPiercing", c_techCountCompleteOnly)));
        return true;
    }

    if (lp_cmd == "ddet") {
        // ddet: the detector analysis of the moment: the radar behavior on every Ghost, the selection, and for every placed detector the distance, the visibility to the player,
        // the stock buff that makes the circle appear (HeroDetectorRadarDetected) and the life of the first Ghost (a detected Ghost is attacked by the Zergling of dtz)
        lv_t = "DDET sel(ghost1) " + IntToString(GhostOps_Ce0_B(UnitIsSelected(GhostOps_SquadUnit(0), 1))) + " sel(ghost2) " + IntToString(GhostOps_Ce0_B(UnitIsSelected(GhostOps_SquadUnit(1), 1))) + " radar1 " + IntToString(UnitBehaviorCount(GhostOps_SquadUnit(0), "HeroDetectorRadar")) + " radar2 " + IntToString(UnitBehaviorCount(GhostOps_SquadUnit(1), "HeroDetectorRadar")) + " ghost1 life " + FixedToString(UnitGetPropertyFixed(GhostOps_SquadUnit(0), c_unitPropLife, c_unitPropCurrent), 0);
        lv_i = 0;
        while (lv_i < go_dtN) {
            if ((go_dtU[lv_i] != null) && UnitIsAlive(go_dtU[lv_i])) {
                lv_t = lv_t + " | " + UnitGetType(go_dtU[lv_i]) + "#" + IntToString(lv_i) + " d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dtU[lv_i]), UnitGetPosition(GhostOps_SquadUnit(0))), 1) + " vis=" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, UnitGetPosition(go_dtU[lv_i])))) + " circleBuff=" + IntToString(UnitBehaviorCount(go_dtU[lv_i], "HeroDetectorRadarDetected"));
            }
            else {
                lv_t = lv_t + " | #" + IntToString(lv_i) + " dead";
            }

            lv_i += 1;
        }

        if (go_dtZ != null) {
            if (UnitIsAlive(go_dtZ)) {
                lv_t = lv_t + " | zergling life " + FixedToString(UnitGetPropertyFixed(go_dtZ, c_unitPropLife, c_unitPropCurrent), 0) + " d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dtZ), UnitGetPosition(GhostOps_SquadUnit(0))), 1) + " orders " + IntToString(UnitOrderCount(go_dtZ));
            }
            else {
                lv_t = lv_t + " | zergling dead";
            }
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "tord") {
        // tord <1|2>: the first order of the Ghost: the ability and the target point (where a real click on the minimap landed)
        lv_u = GhostOps_SquadUnit(StringToInt(lp_a) - 1);
        if (UnitOrderCount(lv_u) > 0) {
            GhostOps_Ce0_Write("j", "TORD ghost " + lp_a + " orders " + IntToString(UnitOrderCount(lv_u)) + " ability " + AbilityCommandGetAbility(OrderGetAbilityCommand(UnitOrder(lv_u, 0))) + " target " + FixedToString(PointGetX(OrderGetTargetPosition(UnitOrder(lv_u, 0))), 1) + "," + FixedToString(PointGetY(OrderGetTargetPosition(UnitOrder(lv_u, 0))), 1) + " at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1) + " tac state " + IntToString(go_tacState));
        }
        else {
            GhostOps_Ce0_Write("j", "TORD ghost " + lp_a + " no order, tac state " + IntToString(go_tacState) + " launches " + IntToString(go_tacLaunches));
        }

        return true;
    }

    if (lp_cmd == "ztx") {
        // ztx in|out: the garrison weapon against a paused enemy Ultralisk (500 life, armor 2) for 8 seconds: the life LOST tells the damage multiplier (x1: about 6.5 per second)
        lv_ang = 0.0;
        if (lp_a == "out") {
            go_tacZoneX = 400.0;
        }
        else {
            go_tacZoneX = 86.0;
        }

        Wait(1.5, c_timeGame);
        lv_u = UnitGroupUnit(UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), 1);
        // every other unit of the player is paused: the damage measured is the one of this Marine alone
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            if (UnitGroupLoopCurrent() != lv_u) {
                libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, 2, PointWithOffset(UnitGetPosition(lv_u), 3.0, 0.0), 270.0);
        go_r3Dum[0] = UnitLastCreated();
        libNtve_gf_PauseUnit(go_r3Dum[0], true);
        UnitIssueOrder(lv_u, OrderTargetingUnit(AbilityCommand("attack", 0), go_r3Dum[0]), c_orderQueueReplace);
        Wait(8.0, c_timeGame);
        if (!UnitIsAlive(go_r3Dum[0])) {
            GhostOps_Ce0_Write("j", "ZTX " + lp_a + ": the Ultralisk was killed in 8 s");
        }
        else {
            GhostOps_Ce0_Write("j", "ZTX " + lp_a + ": the Ultralisk lost " + FixedToString(UnitGetPropertyFixed(go_r3Dum[0], c_unitPropLifeMax, c_unitPropCurrent) - UnitGetPropertyFixed(go_r3Dum[0], c_unitPropLife, c_unitPropCurrent), 1) + " of " + FixedToString(UnitGetPropertyFixed(go_r3Dum[0], c_unitPropLifeMax, c_unitPropCurrent), 0) + " in 8 s, multiplier now " + IntToString(go_tacGrenAmmo[0] * 0 + 1));
        }
        UnitRemove(go_r3Dum[0]);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), false);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        go_tacZoneX = 86.0;
        return true;
    }

    if (lp_cmd == "tpause") {
        // tpause: every structure of the enemy players 2..5 is paused (the spines and the spores cannot shoot): a quiet scene for the tests at an enemy base; the buildings still take damage
        lv_d = 0.0;
        lv_i = 2;
        while (lv_i <= 5) {
            lv_g = UnitGroup(null, lv_i, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
            UnitGroupLoopBegin(lv_g);
            while (UnitGroupLoopCurrent() != null) {
                libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
                lv_d += 1.0;
                UnitGroupLoopStep();
            }

            UnitGroupLoopEnd();
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "TPAUSE " + FixedToString(lv_d, 0) + " enemy structures paused");
        return true;
    }

    if (lp_cmd == "trebel") {
        // trebel <1|2|3>: the ORIGINAL intro of that rebel group runs (the group is created for the rebel player), then Ghost 1 walks into the rescue region: the original rescue hands the group over
        // and calls the hook that gives the labels
        if (lp_a == "1") {
            TriggerExecute(TriggerCreate("gt_RebelMarines01Intro_Func"), true, false);
        }
        else if (lp_a == "2") {
            TriggerExecute(TriggerCreate("gt_RebelMarines02Intro_Func"), true, false);
        }
        else {
            TriggerExecute(TriggerCreate("gt_RebelMarines03Intro_Func"), true, false);
        }

        Wait(6.0, c_timeGame);
        if (lp_a == "1") {
            UnitSetPosition(GhostOps_SquadUnit(0), RegionGetCenter(RegionFromId(72)), false);
        }
        else if (lp_a == "2") {
            UnitSetPosition(GhostOps_SquadUnit(0), RegionGetCenter(RegionFromId(3)), false);
        }
        else {
            UnitSetPosition(GhostOps_SquadUnit(0), RegionGetCenter(RegionFromId(71)), false);
        }

        GhostOps_Ce0_Write("j", "TREBEL group " + lp_a + " intro done, Ghost 1 in the rescue region");
        return true;
    }

    if (lp_cmd == "fpstat") {
        GhostOps_Ce0_FpStat();
        return true;
    }

    if (lp_cmd == "fpt") {
        TimerStart(go_defTimer, StringToFixed(lp_a), false, c_timeGame);
        GhostOps_Ce0_Write("j", "FPT timer restarted with " + lp_a + " s left");
        return true;
    }

    if (lp_cmd == "refstat") {
        GhostOps_Ce0_RefStat();
        return true;
    }

    if (lp_cmd == "refcam") {
        lv_u = GhostOps_Ce0_Geyser(StringToInt(lp_a));
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1, 10.0, false);
        UnitClearSelection(1);
        UnitSelect(UnitGroupUnit(UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), 1), 1, true);
        GhostOps_Ce0_Write("j", "REFCAM geyser " + lp_a + " " + UnitGetType(lv_u));
        return true;
    }

    if (lp_cmd == "rebdmg") {
        GhostOps_Ce0_RebDmg(lp_a);
        return true;
    }

    if (lp_cmd == "rebstat") {
        lv_t = "";
        lv_i = 0;
        while (lv_i < go_tacRebCount) {
            lv_t = lv_t + UnitGetType(go_tacRebUnit[lv_i]) + ":" + IntToString(GhostOps_Ce0_B(UnitIsAlive(go_tacRebUnit[lv_i]))) + " ";
            lv_i += 1;
        }

        if (go_tacRebCount > 0) {
            CameraPan(1, UnitGetPosition(go_tacRebUnit[0]), 0.0, -1.0, 10.0, false);
        }

        GhostOps_Ce0_Write("j", "REBSTAT labels " + IntToString(go_tacRebCount) + " rescued alive " + IntToString(UnitGroupCount(go_tacRescued, c_unitCountAlive)) + " | " + lv_t);
        return true;
    }

    if (lp_cmd == "trescue") {
        // trescue: two Marines and a Medic of the player appear at the base and are reported as rescued (the hook the original rescue calls for every unit it hands over)
        lv_u = UnitFromId(23);
        UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_u), -6.0, -6.0), 270.0);
        GhostOps_Tac_OnRescue(UnitLastCreated());
        UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_u), -8.0, -6.0), 270.0);
        GhostOps_Tac_OnRescue(UnitLastCreated());
        UnitCreate(1, "Medic", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_u), -10.0, -6.0), 270.0);
        GhostOps_Tac_OnRescue(UnitLastCreated());
        UnitCreate(1, "Bunker", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_u), -12.0, -9.0), 270.0);
        GhostOps_Tac_OnRescue(UnitLastCreated());
        CameraPan(1, PointWithOffset(UnitGetPosition(lv_u), -8.0, -6.0), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "TRESCUE 2 Marines, a Medic and a Bunker (a building: must get no label) reported as rescued");
        return true;
    }

    if ((lp_cmd == "tnuke1") || (lp_cmd == "tnuke2")) {
        // tnuke1 / tnuke2 <x> <y>: the Ghost is ordered to aim the strike at the point (the ordinary ability order)
        if (lp_cmd == "tnuke1") {
            lv_u = GhostOps_SquadUnit(0);
        }
        else {
            lv_u = GhostOps_SquadUnit(1);
        }

        UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), Point(StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "TNUKE " + lp_cmd + " ordered at " + lp_a + "," + lp_b + " valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), Point(StringToFixed(lp_a), StringToFixed(lp_b)))))));
        return true;
    }

    return false;
}

// the controlled detector scene (dev only): an enemy Hydralisk (invulnerable, ranged) next to the Ghost, an own Marine as the VISIBLE control target, an enemy Overseer at a chosen distance.
// The Hydralisk shoots the Marine whenever it can; it shoots the Ghost only when the Ghost is DETECTED: the life lost by the Ghost in a window is the measure of the real detection.
unit go_dsG;
unit go_dsH;
unit go_dsM;
unit go_dsO;
fixed go_dsGl;
fixed go_dsMl;
int go_dsTick;
trigger go_dsTrig;

string GhostOps_Ce0_Beacons () {
    // the "beacons" field of the DSM / DSMV lines: the stock radar buff on the Overseer (it carries the circle) and whether the player sees the Overseer's cell
    return "radarbuff " + IntToString(UnitBehaviorCount(go_dsO, "HeroDetectorRadarDetected"));
}

bool GhostOps_Ce0_DsTick (bool lp_test, bool lp_run) {
    if (!lp_run) {
        return true;
    }

    go_dsTick += 1;
    GhostOps_Ce0_Write("j", "DSMV t=" + FixedToString(GameGetMissionTime(), 1) + " d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)), 2) + " ghost lost " + FixedToString(go_dsGl - UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent), 0) + " bunker lost " + FixedToString(go_dsMl - UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent), 0) + " vis " + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, UnitGetPosition(go_dsO)))) + " " + GhostOps_Ce0_Beacons());
    UnitSetPropertyFixed(go_dsG, c_unitPropLife, UnitGetPropertyFixed(go_dsG, c_unitPropLifeMax, c_unitPropCurrent));
    UnitSetPropertyFixed(go_dsM, c_unitPropLife, UnitGetPropertyFixed(go_dsM, c_unitPropLifeMax, c_unitPropCurrent));
    go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
    go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
    if (go_dsTick >= 48) {
        TriggerDestroy(go_dsTrig);
    }

    return true;
}

int GhostOps_Ce0_DsAround () {
    int lv_i;
    int lv_n;

    lv_n = 0;
    lv_i = 2;
    while (lv_i <= 5) {
        lv_n += UnitGroupCount(UnitGroup(null, lv_i, RegionCircle(UnitGetPosition(go_dsG), 14.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
        lv_i += 1;
    }

    return lv_n;
}

fixed DsOff (int lp_i) {
    if (lp_i == 0) { return 0.0; }
    if (lp_i == 1) { return 1.0; }
    if (lp_i == 2) { return 1.5; }
    if (lp_i == 3) { return 2.0; }
    if (lp_i == 4) { return 2.5; }
    if (lp_i == 5) { return 3.0; }
    return 4.0;
}

bool GhostOps_Ce0_DsCmd (string lp_cmd, string lp_a, string lp_b) {
    point lv_p;
    unit lv_u;
    string lv_t;
    int lv_i;

    if (lp_cmd == "dsc") {
        // dsc <dx>: the scene; the Ghost 0 is the subject (its life 3000), the Hydralisk is paused until dsgo
        go_dsG = GhostOps_SquadUnit(0);
        lv_p = UnitGetPosition(go_dsG);
        UnitCreate(1, "Hydralisk", c_unitCreateIgnorePlacement, 2, PointWithOffset(lv_p, 0.0, -3.0), 270.0);
        go_dsH = UnitLastCreated();
        UnitSetState(go_dsH, c_unitStateInvulnerable, true);
        libNtve_gf_PauseUnit(go_dsH, true);
        UnitCreate(1, "Marine", c_unitCreateIgnorePlacement, 1, PointWithOffset(lv_p, 0.0, -9.0), 270.0);
        go_dsM = UnitLastCreated();
        libNtve_gf_PauseUnit(go_dsM, true);
        UnitCreate(1, "Overseer", c_unitCreateIgnorePlacement, 2, PointWithOffset(lv_p, StringToFixed(lp_a), 0.0), 270.0);
        go_dsO = UnitLastCreated();
        UnitIssueOrder(go_dsO, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        if (go_dumG != null) {
            UnitGroupAdd(go_dumG, go_dsH);
            UnitGroupAdd(go_dumG, go_dsO);
        }

        go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
        go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
        GhostOps_Ce0_Write("j", "DSC scene: ghost " + FixedToString(PointGetX(lv_p), 1) + "," + FixedToString(PointGetY(lv_p), 1) + " hydra 3 N, marine 9 N, overseer " + lp_a + " E, radar " + IntToString(UnitBehaviorCount(go_dsG, "HeroDetectorRadar")));
        return true;
    }

    if (lp_cmd == "dsact") {
        // dsact: the Overseer is an ACTIVE detector (not paused); it stays where it is
        libNtve_gf_PauseUnit(go_dsO, false);
        UnitIssueOrder(go_dsO, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "DSACT overseer active");
        return true;
    }

    if (lp_cmd == "dsgo") {
        libNtve_gf_PauseUnit(go_dsH, false);
        UnitIssueOrder(go_dsH, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(go_dsG)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "DSGO hydralisk released");
        return true;
    }

    if (lp_cmd == "dspause") {
        libNtve_gf_PauseUnit(go_dsH, true);
        GhostOps_Ce0_Write("j", "DSPAUSE hydralisk paused");
        return true;
    }

    if (lp_cmd == "dsheal") {
        // the Ghost and the bunker are restored to full life and the baselines are reset (a window must never kill the subject)
        UnitSetPropertyFixed(go_dsG, c_unitPropLife, UnitGetPropertyFixed(go_dsG, c_unitPropLifeMax, c_unitPropCurrent));
        UnitSetPropertyFixed(go_dsM, c_unitPropLife, UnitGetPropertyFixed(go_dsM, c_unitPropLifeMax, c_unitPropCurrent));
        go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
        go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
        GhostOps_Ce0_Write("j", "DSHEAL restored: ghost " + FixedToString(go_dsGl, 0) + " bunker " + FixedToString(go_dsMl, 0));
        return true;
    }

    if (lp_cmd == "dsmv") {
        // dsmv <dx>: the Overseer is put at dx cells east of the Ghost (paused), the baselines are reset
        UnitSetPosition(go_dsO, PointWithOffset(UnitGetPosition(go_dsG), StringToFixed(lp_a), 0.0), false);
        UnitIssueOrder(go_dsO, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
        go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
        GhostOps_Ce0_Write("j", "DSMV overseer at d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)), 2));
        return true;
    }

    if (lp_cmd == "dsm") {
        // dsm: the life lost since the last reset by the Ghost and by the control Marine; the distance of the Overseer; the radar
        GhostOps_Ce0_Write("j", "DSM d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)), 2) + " ghost lost " + FixedToString(go_dsGl - UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent), 0) + " bunker lost " + FixedToString(go_dsMl - UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent), 0) + " radar " + IntToString(UnitBehaviorCount(go_dsG, "HeroDetectorRadar")) + " circle " + IntToString(UnitBehaviorCount(go_dsO, "HeroDetectorRadarDetected")) + " | vis " + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, UnitGetPosition(go_dsO)))) + " " + GhostOps_Ce0_Beacons() + " | ghost alive " + IntToString(GhostOps_Ce0_B(UnitIsAlive(go_dsG))) + " bunker alive " + IntToString(GhostOps_Ce0_B(UnitIsAlive(go_dsM))) + " hydra orders " + IntToString(UnitOrderCount(go_dsH)) + " enemy units within 14: " + IntToString(GhostOps_Ce0_DsAround()));
        go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
        go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
        return true;
    }

    if (lp_cmd == "daedbg") {
        // daedbg: why the early-warning module does (not) see the Overseer: filter, behaviors, the module trigger
        GhostOps_Ce0_Write("j", "DAEDBG enemy-filter " + IntToString(GhostOps_Ce0_B(UnitFilterMatch(go_dsO, 1, UnitFilterStr("Enemy;Dead,Hidden,Stasis")))) + " enemy+detector-filter " + IntToString(GhostOps_Ce0_B(UnitFilterMatch(go_dsO, 1, UnitFilterStr("Enemy,Detector;Dead,Hidden,Stasis")))));
        GhostOps_Ce0_Write("j", "DAEDBG det10/11/12 " + IntToString(UnitBehaviorCount(go_dsO, "Detector10")) + IntToString(UnitBehaviorCount(go_dsO, "Detector11")) + IntToString(UnitBehaviorCount(go_dsO, "Detector12")) + " owner " + IntToString(UnitGetOwner(go_dsO)) + " alive " + IntToString(GhostOps_Ce0_B(UnitIsAlive(go_dsO))));
        GhostOps_Ce0_Write("j", "DAEDBG ticks " + IntToString(go_daeTicks) + " ghosts " + IntToString(go_daeGhosts) + " found " + IntToString(go_daeFound) + " trig " + IntToString(GhostOps_Ce0_B(go_daeTrig != null)) + " margin " + FixedToString(go_daeMargin, 1));
        GhostOps_Ce0_Write("j", "DAEDBG dist " + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)), 2) + " " + GhostOps_Ce0_Beacons());
        return true;
    }

    if (lp_cmd == "dsvis") {
        // dsvis: how much around the revealed detector the player sees: the cell of the Overseer and points at 0 / 1 / 1.5 / 2 / 2.5 / 3 / 4 cells, and two real enemy Zerglings at 1.5 and 4 cells
        lv_t = "DSVIS d=" + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)), 1) + " points";
        lv_i = 0;
        while (lv_i < 7) {
            lv_t = lv_t + " " + IntToString(lv_i) + ":" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, PointWithOffset(UnitGetPosition(go_dsO), 0.0, DsOff(lv_i)))));
            lv_i += 1;
        }

        UnitCreate(1, "Zergling", c_unitCreateIgnorePlacement, 2, PointWithOffset(UnitGetPosition(go_dsO), 0.0, 1.5), 270.0);
        lv_u = UnitLastCreated();
        libNtve_gf_PauseUnit(lv_u, true);
        GhostOps_Ce0_Write("j", lv_t);
        GhostOps_Ce0_Write("j", "DSVIS zergling at 1.5 visible " + IntToString(GhostOps_Ce0_B(UnitFilterMatch(lv_u, 1, UnitFilterStr("Enemy,Visible")))));
        UnitRemove(lv_u);
        UnitCreate(1, "Zergling", c_unitCreateIgnorePlacement, 2, PointWithOffset(UnitGetPosition(go_dsO), 0.0, 4.0), 270.0);
        lv_u = UnitLastCreated();
        libNtve_gf_PauseUnit(lv_u, true);
        GhostOps_Ce0_Write("j", "DSVIS zergling at 4 visible " + IntToString(GhostOps_Ce0_B(UnitFilterMatch(lv_u, 1, UnitFilterStr("Enemy,Visible")))));
        UnitRemove(lv_u);
        return true;
    }

    if (lp_cmd == "dscam") {
        // dscam: the camera between the Ghost and the Overseer (both in the picture)
        CameraPan(1, PointWithOffset(UnitGetPosition(go_dsG), DistanceBetweenPoints(UnitGetPosition(go_dsO), UnitGetPosition(go_dsG)) / 2.0, 0.0), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "DSCAM camera between the Ghost and the Overseer");
        return true;
    }

    if (lp_cmd == "dsmove") {
        // dsmove <dx>: the Overseer starts dx cells east, FLIES to the Ghost; every 0.25 s the distance and the lives are logged (12 s)
        UnitSetPosition(go_dsO, PointWithOffset(UnitGetPosition(go_dsG), StringToFixed(lp_a), 0.0), false);
        go_dsGl = 3000.0;
        go_dsMl = 3000.0;
        go_dsGl = UnitGetPropertyFixed(go_dsG, c_unitPropLife, c_unitPropCurrent);
        go_dsMl = UnitGetPropertyFixed(go_dsM, c_unitPropLife, c_unitPropCurrent);
        UnitIssueOrder(go_dsO, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(go_dsG), -2.0, 0.0)), c_orderQueueReplace);
        go_dsTick = 0;
        go_dsTrig = TriggerCreate("GhostOps_Ce0_DsTick");
        TriggerAddEventTimePeriodic(go_dsTrig, 0.25, c_timeGame);
        GhostOps_Ce0_Write("j", "DSMOVE overseer flying from " + lp_a);
        return true;
    }

    return false;
}

bool GhostOps_Ce0_GDie (bool lp_test, bool lp_run) {
    unit lv_u;
    unit lv_k;
    string lv_ks;

    if (!lp_run) {
        return true;
    }

    lv_u = EventUnit();
    if ((lv_u == null) || (UnitGetType(lv_u) != "Ghost")) {
        return true;
    }

    lv_k = EventUnitDamageSourceUnit();
    lv_ks = "none";
    if (lv_k != null) {
        lv_ks = UnitGetType(lv_k) + " owner " + IntToString(UnitGetOwner(lv_k));
    }

    GhostOps_Ce0_Write("j", "GDIE a Ghost died at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1) + " t=" + FixedToString(GameGetMissionTime(), 1) + " killer: " + lv_ks + " state " + IntToString(go_tacState) + " launches " + IntToString(go_tacLaunches));
    return true;
}

bool GhostOps_Ce0_MissionCmd (string lp_cmd, string lp_a, string lp_b) {
    int lv_i;
    unit lv_g1;
    unit lv_z;
    unit lv_u;
    unitgroup lv_g;

    if (GhostOps_FoldTest_Cmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (GhostOps_Ce0_DefCmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (GhostOps_Ce0_R3Cmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (GhostOps_Ce0_DsCmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (lp_cmd == "gwatch") {
        TriggerAddEventUnitDied(TriggerCreate("GhostOps_Ce0_GDie"), null);
        GhostOps_Ce0_Write("j", "GWATCH watching the deaths of Ghosts");
        return true;
    }

    if (GhostOps_Ce0_AimCmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (GhostOps_Ce0_TraceCmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (GhostOps_Ce0_DetCmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (lp_cmd == "defend") {
        lv_g1 = UnitFromId(23);
        lv_i = 1;
        while (lv_i <= 16) {
            lv_z = UnitGroupUnit(UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0), lv_i);
            if (lv_z != null) {
                if (((lv_i - 1) % 4) == 0) {
                    UnitIssueOrder(UnitFromId(4), OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), lv_z), c_orderQueueAddToEnd);
                }
                else if (((lv_i - 1) % 4) == 1) {
                    UnitIssueOrder(UnitFromId(13), OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), lv_z), c_orderQueueAddToEnd);
                }
                else if (((lv_i - 1) % 4) == 2) {
                    UnitIssueOrder(UnitFromId(291), OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), lv_z), c_orderQueueAddToEnd);
                }
                else {
                    UnitIssueOrder(UnitFromId(298), OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), lv_z), c_orderQueueAddToEnd);
                }
            }

            lv_i += 1;
        }

        UnitIssueOrder(GhostOps_SquadUnit(0), OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(lv_g1), 12.0, 4.0)), c_orderQueueReplace);
        UnitIssueOrder(GhostOps_SquadUnit(1), OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(lv_g1), 14.0, 2.0)), c_orderQueueReplace);
        go_dfTick = TriggerCreate("GhostOps_Ce0_DefTick");
        TriggerAddEventTimePeriodic(go_dfTick, 2.0, c_timeGame);
        go_dfDied = TriggerCreate("GhostOps_Ce0_DefDied");
        TriggerAddEventUnitDied(go_dfDied, null);
        GhostOps_Ce0_Write("j", "DEFEND set: marines to the bunkers, 5 SCVs mine, the other SCVs repair, Ghosts away from the base; bunker order valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(UnitFromId(4), OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), UnitGroupUnit(UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0), 1))))));
        return true;
    }

    if (lp_cmd == "defstat") {
        GhostOps_Ce0_Write("j", "DEFSTAT repair orders given " + IntToString(go_dfRepairOrders) + " losses " + IntToString(go_dfLoss) + " bunker cargo " + IntToString(UnitGroupCount(UnitCargoGroup(UnitFromId(4)), c_unitCountAll)) + "," + IntToString(UnitGroupCount(UnitCargoGroup(UnitFromId(13)), c_unitCountAll)) + "," + IntToString(UnitGroupCount(UnitCargoGroup(UnitFromId(291)), c_unitCountAll)) + "," + IntToString(UnitGroupCount(UnitCargoGroup(UnitFromId(298)), c_unitCountAll)));
        return true;
    }

    if (lp_cmd == "wv") {
        go_wvTick = TriggerCreate("GhostOps_Ce0_WvTick");
        TriggerAddEventTimePeriodic(go_wvTick, 10.0, c_timeGame);
        GhostOps_Ce0_Write("j", "WV trace on (every 10 s)");
        return true;
    }

    if (lp_cmd == "sel") {
        UnitClearSelection(1);
        UnitSelect(GhostOps_SquadUnit(StringToInt(lp_a) - 1), 1, true);
        GhostOps_Ce0_Write("j", "SELECTED ghost " + lp_a);
        return true;
    }

    if (lp_cmd == "gs") {
        lv_i = 1;
        while (lv_i <= 2) {
            lv_g1 = GhostOps_SquadUnit(lv_i - 1);
            if (lv_g1 != null) {
                GhostOps_Ce0_Write("j", "GS " + IntToString(lv_i) + " energy=" + FixedToString(UnitGetPropertyFixed(lv_g1, c_unitPropEnergy, c_unitPropCurrent), 1) + " cloaked=" + IntToString(GhostOps_Ce0_B(UnitTestState(lv_g1, c_unitStateCloaked))) + " life=" + FixedToString(UnitGetPropertyFixed(lv_g1, c_unitPropLife, c_unitPropCurrent), 1));
            }

            lv_i += 1;
        }

        return true;
    }

    if (lp_cmd == "spawn") {
        lv_g1 = GhostOps_SquadUnit(0);
        UnitGroupLoopBegin(UnitCreate(1, lp_a, 0, 2, PointWithOffset(UnitGetPosition(lv_g1), StringToFixed(lp_b), 0.0), 0.0));
        while (UnitGroupLoopCurrent() != null) {
            go_gsLast = UnitGroupLoopCurrent();
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "SPAWNED " + lp_a + " of player 2 at dx " + lp_b);
        return true;
    }

    if (lp_cmd == "snipe") {
        UnitIssueOrder(GhostOps_SquadUnit(StringToInt(lp_a) - 1), OrderTargetingUnit(AbilityCommand("Snipe", 0), go_gsLast), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "SNIPE ordered by ghost " + lp_a);
        return true;
    }

    if (lp_cmd == "snipetest") {
        lv_g1 = GhostOps_SquadUnit(0);
        UnitSetPropertyFixed(lv_g1, c_unitPropEnergy, 9.0);
        lv_i = GhostOps_Ce0_B(UnitOrderIsValid(lv_g1, OrderTargetingUnit(AbilityCommand("Snipe", 0), go_gsLast)));
        UnitSetPropertyFixed(lv_g1, c_unitPropEnergy, 10.0);
        GhostOps_Ce0_Write("j", "SNIPETEST valid at 9 energy=" + IntToString(lv_i) + ", valid at 10 energy=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_g1, OrderTargetingUnit(AbilityCommand("Snipe", 0), go_gsLast)))) + ", catalog cost " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Vital[Energy]", 1) + ", cloak buff energy regen mod " + CatalogFieldValueGet(c_gameCatalogBehavior, "GhostCloak", "Modification.VitalRegenArray[Energy]", 1) + ", unit regen " + CatalogFieldValueGet(c_gameCatalogUnit, "Ghost", "EnergyRegenRate", 1));
        return true;
    }

    if (lp_cmd == "srebel") {
        go_zhRebelCallSaid = false;
        GhostOps_ZH_OnRebelCall(StringToInt(lp_a));
        return true;
    }

    if (lp_cmd == "srescue") {
        go_zhRescueSaid = false;
        GhostOps_ZH_OnRescue(StringToInt(lp_a));
        return true;
    }

    if (lp_cmd == "portrait") {
        TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_a), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", null, null, null, 4.0, c_transmissionDurationSet, true);
        GhostOps_Ce0_Write("j", "PORTRAIT " + lp_a);
        return true;
    }

    if (lp_cmd == "zt") {
        // zt out|in: garrison weapon test. out = the zone is moved far away (every garrison Marine is outside), in = back to the real zone. A paused enemy Zergling next to the
        // first Marine of the player is attacked by him for 5 seconds; its life tells whether the weapon works.
        if (lp_a == "out") {
            go_tacZoneX = 400.0;
        }
        else {
            go_tacZoneX = 86.0;
        }

        Wait(1.5, c_timeGame);
        lv_g1 = UnitGroupUnit(UnitGroup("Marine", 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0), 1);
        UnitCreate(1, "Zergling", 0, 2, PointWithOffset(UnitGetPosition(lv_g1), 2.0, 0.0), 270.0);
        lv_z = UnitLastCreated();
        libNtve_gf_PauseUnit(lv_z, true);
        UnitIssueOrder(lv_g1, OrderTargetingUnit(AbilityCommand("attack", 0), lv_z), c_orderQueueReplace);
        Wait(5.0, c_timeGame);
        GhostOps_Ce0_Write("j", "ZONE TEST " + lp_a + ": zergling life " + FixedToString(UnitGetPropertyFixed(lv_z, c_unitPropLife, c_unitPropCurrent), 1) + " of " + FixedToString(UnitGetPropertyFixed(lv_z, c_unitPropLifeMax, c_unitPropCurrent), 1) + " marine pos " + FixedToString(PointGetX(UnitGetPosition(lv_g1)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_g1)), 0));
        UnitRemove(lv_z);
        go_tacZoneX = 86.0;
        return true;
    }

    if (lp_cmd == "timer") {
        // the original timer reaching zero: the original victory function is started (our gate decides)
        GhostOps_Ce0_Write("j", "TIMER simulated (the original victory function is run)");
        TriggerExecute(TriggerCreate("gt_VictoryHoldOutCompleted_Func"), false, false);
        return true;
    }

    if (lp_cmd == "killtargets") {
        // kill n targets (default all)
        lv_i = 0;
        while (lv_i < go_zhTargetCount) {
            if ((lp_a == "") || (lv_i < StringToInt(lp_a))) {
                UnitKill(UnitFromId(go_zhTargetId[lv_i]));
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "TARGETS killed " + lp_a);
        return true;
    }

    if (lp_cmd == "aim") {
        // the n-th Ghost (a = 1 or 2) aims 11 cells north of himself
        lv_g1 = GhostOps_SquadUnit(StringToInt(lp_a) - 1);
        UnitIssueOrder(lv_g1, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), PointWithOffset(UnitGetPosition(lv_g1), 0.0, 11.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "AIM ordered by ghost " + lp_a);
        return true;
    }

    if (lp_cmd == "cancel") {
        UnitIssueOrder(GhostOps_SquadUnit(StringToInt(lp_a) - 1), Order(AbilityCommand("TacNukeStrike", 1)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "CANCEL ordered by ghost " + lp_a);
        return true;
    }

    return false;
}
