// CE-0 probe: THanson02 specific state and commands (development only; compiled only with the config key "ce0").
// Commands are typed into the chat of the test window (the queue scenarios do it). Nothing here is part of a playable build.
unit[24] go_ce0Dum;
fixed[24] go_ce0DumLife;
int go_ce0DumN;
point go_ce0Aim;
unit go_ce0Air;
int go_ce0ScvN;
unit[4] go_ce0Sq;               // the four marines of the raid squad (set by egather)

unit GhostOps_Ce0_First (string lp_type) {
    return UnitGroupUnit(UnitGroup(lp_type, 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), 1);
}

string GhostOps_Ce0_Extra () {
    string lv_s;
    int lv_i;
    int lv_alive;
    int lv_dry;

    lv_alive = 0;
    lv_dry = 0;
    lv_i = 0;
    while (lv_i < go_eHellN) {
        if (UnitIsAlive(go_eHell[lv_i])) {
            lv_alive += 1;
            if (go_eHellDry[lv_i]) {
                lv_dry += 1;
            }
        }

        lv_i += 1;
    }

    lv_s = "epi stage=" + IntToString(go_eStage) + " night=" + IntToString(BoolToInt(go_eIsNight)) + "/" + IntToString(go_eNightNo) + " hell=" + IntToString(lv_alive) + " dry=" + IntToString(lv_dry);
    lv_s = lv_s + " kits=" + IntToString(GhostOps_Hanson_KitsLeft());
    return lv_s;
}

void GhostOps_Ce0_MissionStart () {
}

string GhostOps_Ce0_Pt (point lp_p) {
    return FixedToString(PointGetX(lp_p), 1) + "," + FixedToString(PointGetY(lp_p), 1);
}

string GhostOps_Ce0_TypeOf (string lp_cmd) {
    string lv_k;

    lv_k = StringSub(lp_cmd, 4, 4);
    if (lv_k == "h") {
        return "Hellion";
    }

    if (lv_k == "m") {
        return "Marine";
    }

    if (lv_k == "g") {
        return "Ghost";
    }

    if (lv_k == "f") {
        return "Firebat";
    }

    return "TankerTruck";
}

void GhostOps_Ce0_Move (string lp_cmd, bool lp_teleport, string lp_x, string lp_y) {
    unitgroup lv_g;
    unit lv_u;
    point lv_p;
    int lv_i;
    int lv_n;

    lv_g = UnitGroup(GhostOps_Ce0_TypeOf(lp_cmd), 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n = UnitGroupCount(lv_g, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        lv_p = Point(StringToFixed(lp_x) + (IntToFixed(lv_i % 4) * 1.2), StringToFixed(lp_y) + (IntToFixed(lv_i / 4) * 1.2));
        if (lp_teleport) {
            UnitSetPosition(lv_u, lv_p, false);
        }
        else {
            UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("move", 0), lv_p), c_orderQueueReplace);
        }

        lv_i += 1;
    }

    GhostOps_Ce0_Write("j", "EMOVE " + lp_cmd + " " + IntToString(lv_n) + " units to " + lp_x + "," + lp_y);
}

bool GhostOps_Ce0_MissionCmd (string lp_cmd, string lp_a, string lp_b) {
    unitgroup lv_g;
    unit lv_u;
    unit lv_k;
    point lv_p;
    int lv_i;
    int lv_j;
    int lv_n;
    int lv_c;
    string lv_t;

    if (GhostOps_FoldTest_Cmd(lp_cmd, lp_a, lp_b)) {
        return true;
    }

    if (lp_cmd == "epath") {
        // ground path cost from the Command Center to the area centers and to a grid of passable points (the place of the gas truck is chosen from this)
        lv_t = "EPATH areas";
        lv_p = Point(28.8, 139.7);
        lv_t = lv_t + " A1=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(49.3, 154.9);
        lv_t = lv_t + " A2=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(108.3, 152.1);
        lv_t = lv_t + " A4=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(124.7, 114.5);
        lv_t = lv_t + " A5=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(126.7, 83.7);
        lv_t = lv_t + " A6=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(103.6, 63.0);
        lv_t = lv_t + " A7=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(115.6, 35.0);
        lv_t = lv_t + " A8=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(58.3, 29.4);
        lv_t = lv_t + " A9=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(28.2, 47.8);
        lv_t = lv_t + " A10=" + IntToString(PointPathingCost(go_eBase, lv_p));
        lv_p = Point(67.9, 52.7);
        lv_t = lv_t + " A11=" + IntToString(PointPathingCost(go_eBase, lv_p));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ebasemap") {
        // ebasemap: the real geometry of the original base (measurement of the supply zone): rows y = 120 .. 62 (step 2), x = 40 .. 112 (step 2): '#' not passable, '.' passable and connected with the Command Center, 'o' passable but cut off
        lv_j = 120;
        while (lv_j >= 62) {
            lv_t = "EBM " + IntToString(lv_j) + " ";
            lv_i = 40;
            while (lv_i <= 112) {
                lv_p = Point(IntToFixed(lv_i), IntToFixed(lv_j));
                if (!PointPathingPassable(lv_p)) {
                    lv_t = lv_t + "#";
                }
                else if (PointPathingIsConnected(lv_p, go_eBase)) {
                    lv_t = lv_t + ".";
                }
                else {
                    lv_t = lv_t + "o";
                }

                lv_i += 2;
            }

            GhostOps_Ce0_Write("j", lv_t);
            lv_j -= 2;
        }

        return true;
    }

    if (lp_cmd == "ebasestr") {
        // ebasestr: every structure of the player (1) and of the neutral player 0 / 4 in the area x 40..112, y 62..120: type and position
        lv_g = UnitGroup(null, 1, RegionRect(40.0, 62.0, 112.0, 120.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_t = "EBS player1 " + IntToString(lv_n) + ":";
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + " " + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
            if ((lv_i % 6) == 0) {
                GhostOps_Ce0_Write("j", lv_t);
                lv_t = "EBS +";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        lv_g = UnitGroup(null, 4, RegionRect(40.0, 62.0, 112.0, 120.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_t = "EBS player4 " + IntToString(lv_n) + ":";
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + " " + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
            if ((lv_i % 6) == 0) {
                GhostOps_Ce0_Write("j", lv_t);
                lv_t = "EBS +";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        lv_g = UnitGroup(null, 3, RegionRect(40.0, 62.0, 112.0, 120.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_t = "EBS enemy structures " + IntToString(lv_n) + ":";
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + " " + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
            if ((lv_i % 6) == 0) {
                GhostOps_Ce0_Write("j", lv_t);
                lv_t = "EBS +";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "egrid") {
        // egrid <y0>: one row (y0) of the grid x = 56..136 step 4: "x:cost" for passable points, cost relative to the base
        lv_t = "EGRID y=" + lp_a;
        lv_i = 56;
        while (lv_i <= 136) {
            lv_p = Point(IntToFixed(lv_i), StringToFixed(lp_a));
            if (PointPathingPassable(lv_p)) {
                lv_t = lv_t + " " + IntToString(lv_i) + ":" + IntToString(PointPathingCost(go_eBase, lv_p));
            }

            lv_i += 4;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ecand") {
        // ecand <y>: a row of candidate places for the gas truck (x = 80..120 step 4): "x:base/A5/A4/A2" ground path costs of the passable points
        lv_t = "ECAND y=" + lp_a;
        lv_i = 80;
        while (lv_i <= 120) {
            lv_p = Point(IntToFixed(lv_i), StringToFixed(lp_a));
            if (PointPathingPassable(lv_p)) {
                lv_t = lv_t + " " + IntToString(lv_i) + ":" + IntToString(PointPathingCost(go_eBase, lv_p)) + "/" + IntToString(PointPathingCost(Point(124.7, 114.5), lv_p)) + "/" + IntToString(PointPathingCost(Point(108.3, 152.1), lv_p)) + "/" + IntToString(PointPathingCost(Point(49.3, 154.9), lv_p));
            }

            lv_i += 4;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "etr") {
        // etr: the way out of the truck's place: passable, ground path cost to the base and to every hellion (65536 = no way)
        lv_t = "ETR truck at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eTruck)) + " owner " + IntToString(UnitGetOwner(go_eTruck)) + " seen " + IntToString(BoolToInt(go_eTruckSeen)) + " stage " + IntToString(go_eStage) + " pass " + IntToString(BoolToInt(PointPathingPassable(UnitGetPosition(go_eTruck)))) + " costBase " + IntToString(PointPathingCost(UnitGetPosition(go_eTruck), go_eBase)) + " hellions";
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                lv_t = lv_t + " " + IntToString(PointPathingCost(UnitGetPosition(go_eTruck), UnitGetPosition(go_eHell[lv_i])));
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ezerg") {
        // ezerg <n>: n infested Terrans of the enemy (player 3) next to the truck, free (not script controlled): they attack what they see that is an enemy
        lv_n = StringToInt(lp_a);
        lv_i = 0;
        while (lv_i < lv_n) {
            UnitCreate(1, "InfestedTerranCampaign", 0, 3, PointWithOffset(UnitGetPosition(go_eTruck), 4.0 + IntToFixed(lv_i), 0.0), 270.0);
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EZERG " + IntToString(lv_n) + " enemies next to the truck, truck life " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropLife, c_unitPropCurrent), 0));
        return true;
    }

    if (lp_cmd == "etlife") {
        GhostOps_Ce0_Write("j", "ETLIFE truck life " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropLife, c_unitPropCurrent), 0) + " owner " + IntToString(UnitGetOwner(go_eTruck)) + " fuel " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent), 1) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eTruck)));
        return true;
    }

    if (lp_cmd == "estat") {
        lv_t = "ESTAT stage " + IntToString(go_eStage) + " night " + IntToString(BoolToInt(go_eIsNight)) + " scenes";
        lv_i = 0;
        while (lv_i < 6) {
            lv_t = lv_t + " " + IntToString(BoolToInt(go_eScene[lv_i]));
            lv_i += 1;
        }

        lv_t = lv_t + " | truck ";
        if (UnitIsAlive(go_eTruck)) {
            lv_t = lv_t + "owner " + IntToString(UnitGetOwner(go_eTruck)) + " fuel " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent), 1) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eTruck));
        }
        else {
            lv_t = lv_t + "dead/none";
        }

        lv_t = lv_t + " | hellions";
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                lv_t = lv_t + " [" + FixedToString(UnitGetPropertyFixed(go_eHell[lv_i], c_unitPropEnergy, c_unitPropCurrent), 1) + " dry=" + IntToString(BoolToInt(go_eHellDry[lv_i])) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eHell[lv_i])) + "]";
            }
            else {
                lv_t = lv_t + " [dead]";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "eship") {
        lv_t = "ESHIP made " + IntToString(BoolToInt(go_eShipMade)) + " dead " + IntToString(BoolToInt(go_eShipDead)) + " away " + IntToString(BoolToInt(go_eShipAway)) + " open " + IntToString(BoolToInt(go_eNightOpen));
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_t = lv_t + " life " + FixedToString(UnitGetPropertyFixed(go_eShip, c_unitPropLife, c_unitPropCurrent), 0) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)) + " cargo " + IntToString(UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive)) + " hidden " + IntToString(BoolToInt(UnitTestState(go_eShip, c_unitStateHidden)));
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "eprot") {
        lv_t = "EPROT";
        lv_i = 0;
        while (lv_i < go_eProtN) {
            lv_t = lv_t + " [" + UnitGetType(go_eProt[lv_i]) + " alive " + IntToString(BoolToInt(UnitIsAlive(go_eProt[lv_i]))) + " shield " + IntToString(UnitBehaviorCount(go_eProt[lv_i], "GhostOpsDayShield")) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eProt[lv_i])) + "]";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "eghost") {
        lv_t = "EGHOST";
        lv_g = UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + " [energy " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent), 1) + " cloak " + IntToString(BoolToInt(GhostOps_CloakOn(lv_u))) + " life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + "]";
            lv_i += 1;
        }

        lv_t = lv_t + " drain " + CatalogFieldValueGet(c_gameCatalogBehavior, "GhostCloak", "Modification.VitalRegenArray[Energy]", 1) + " pnNet " + FixedToString(go_pnNet, 2);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ecloak") {
        lv_g = UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_n) {
            UnitIssueOrder(UnitGroupUnit(lv_g, lv_i), Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "ECLOAK ordered " + IntToString(lv_n));
        return true;
    }

    if (lp_cmd == "efuel") {
        // efuel <v>: every hellion gets the fuel v (a test shortcut)
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                UnitSetPropertyFixed(go_eHell[lv_i], c_unitPropEnergy, StringToFixed(lp_a));
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EFUEL set " + lp_a);
        return true;
    }

    if ((lp_cmd == "etph") || (lp_cmd == "etpm") || (lp_cmd == "etpg") || (lp_cmd == "etpf") || (lp_cmd == "etpt")) {
        // etph|etpm|etpg|etpf|etpt <x> <y>: all Hellions / Marines / Ghosts / Firebats / the Truck(owned) of the player are put around (x, y)
        GhostOps_Ce0_Move(lp_cmd, true, lp_a, lp_b);
        return true;
    }

    if ((lp_cmd == "egoh") || (lp_cmd == "egom") || (lp_cmd == "egog") || (lp_cmd == "egof") || (lp_cmd == "egot")) {
        GhostOps_Ce0_Move(lp_cmd, false, lp_a, lp_b);
        return true;
    }

    if (lp_cmd == "eshipload") {
        // eshipload <n>: n Marines are put next to the transport and the transport is ordered to load them (the stock Load order)
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_g = UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
            lv_n = UnitGroupCount(lv_g, c_unitCountAll);
            lv_c = StringToInt(lp_a);
            lv_i = 1;
            while ((lv_i <= lv_n) && (lv_i <= lv_c)) {
                lv_u = UnitGroupUnit(lv_g, lv_i);
                UnitSetPosition(lv_u, PointWithOffset(UnitGetPosition(go_eShip), 2.0 + IntToFixed(lv_i % 3), 0.0), false);
                UnitIssueOrder(go_eShip, OrderTargetingUnit(AbilityCommand(GhostOps_Epi_ShipAbil(), 0), lv_u), c_orderQueueAddToEnd);
                lv_i += 1;
            }

            GhostOps_Ce0_Write("j", "ESHIPLOAD ordered " + IntToString(lv_c));
        }

        return true;
    }

    if (lp_cmd == "eshipfill") {
        // eshipfill <n>: scenario fallback of a boarding that the real clicks did not finish: marines near the ship are loaded (the stock Load order, scripted) until the cargo holds n; nothing is done when it already does
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_c = StringToInt(lp_a) - UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive);
            lv_g = UnitGroup("Marine", 1, RegionCircle(UnitGetPosition(go_eShip), 30.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
            lv_n = UnitGroupCount(lv_g, c_unitCountAll);
            lv_i = 1;
            while ((lv_i <= lv_n) && (lv_c > 0)) {
                lv_u = UnitGroupUnit(lv_g, lv_i);
                if (!UnitIsAlive(lv_u)) {
                    lv_i += 1;
                }
                else {
                    UnitIssueOrder(go_eShip, OrderTargetingUnit(AbilityCommand(GhostOps_Epi_ShipAbil(), 0), lv_u), c_orderQueueAddToEnd);
                    lv_c -= 1;
                    lv_i += 1;
                }
            }

            GhostOps_Ce0_Write("j", "ESHIPFILL ordered, cargo was " + IntToString(UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive)));
        }

        return true;
    }

    if (lp_cmd == "eshipgo") {
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitIssueOrder(go_eShip, OrderTargetingPoint(AbilityCommand("move", 0), Point(StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "ESHIPGO ordered to " + lp_a + "," + lp_b);
        }

        return true;
    }

    if (lp_cmd == "eshipunl") {
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitIssueOrder(go_eShip, OrderTargetingPoint(AbilityCommand(GhostOps_Epi_ShipAbil(), 2), Point(StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "ESHIPUNL unload ordered at " + lp_a + "," + lp_b);
        }

        return true;
    }

    if (lp_cmd == "ehurtship") {
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitSetPropertyFixed(go_eShip, c_unitPropLife, StringToFixed(lp_a));
            GhostOps_Ce0_Write("j", "EHURTSHIP life set " + lp_a);
        }

        return true;
    }

    if (lp_cmd == "ekillship") {
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitKill(go_eShip);
        }

        return true;
    }

    if (lp_cmd == "ekilltruck") {
        if (UnitIsAlive(go_eTruck)) {
            UnitKill(go_eTruck);
        }

        return true;
    }

    if (lp_cmd == "etruckmv") {
        // etruckmv <x> <y>: the truck (any owner) is ordered to move there: can it leave its place at all
        if (UnitIsAlive(go_eTruck)) {
            UnitIssueOrder(go_eTruck, OrderTargetingPoint(AbilityCommand("move", 0), Point(StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "ETRUCKMV truck at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eTruck)) + " owner " + IntToString(UnitGetOwner(go_eTruck)) + " ordered to " + lp_a + "," + lp_b + " orders " + IntToString(UnitOrderCount(go_eTruck)) + " speed " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropMovementSpeed, c_unitPropCurrent), 2));
        }
        else {
            GhostOps_Ce0_Write("j", "ETRUCKMV no truck");
        }

        return true;
    }

    if (lp_cmd == "egotruckhell") {
        // egotruckhell: the (captured) truck is ordered to drive to the first stopped hellion (the real route, no teleport)
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i]) && go_eHellDry[lv_i] && UnitIsAlive(go_eTruck)) {
                UnitIssueOrder(go_eTruck, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(go_eHell[lv_i])), c_orderQueueReplace);
                GhostOps_Ce0_Write("j", "EGOTRUCKHELL truck ordered to " + GhostOps_Ce0_Pt(UnitGetPosition(go_eHell[lv_i])));
                return true;
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EGOTRUCKHELL no stopped hellion");
        return true;
    }

    if (lp_cmd == "ecb") {
        // ecb <StructureType>: a container is created next to the first infested structure of the type and a Ghost shoots it (the real Snipe order): the life of the structure before / after
        lv_g = UnitGroup(lp_a, 3, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_u = UnitGroupUnit(lv_g, 1);
        if (lv_u == null) {
            GhostOps_Ce0_Write("j", "ECB no structure of the type " + lp_a);
            return true;
        }

        lv_p = UnitGetPosition(lv_u);
        UnitCreate(1, "GhostOpsFuelContainer", c_unitCreateIgnorePlacement, 0, PointWithOffset(lv_p, 3.0, 0.0), 270.0);
        lv_k = UnitLastCreated();
        UnitSetPosition(GhostOps_Ce0_First("Ghost"), PointWithOffset(lv_p, 9.0, 0.0), false);
        Wait(1.0, c_timeGame);
        lv_t = "ECB " + lp_a + " life before " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " shield " + IntToString(UnitBehaviorCount(lv_u, "GhostOpsDayShield"));
        UnitIssueOrder(GhostOps_Ce0_First("Ghost"), OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_k), c_orderQueueReplace);
        Wait(5.0, c_timeGame);
        lv_t = lv_t + " container alive " + IntToString(BoolToInt(UnitIsAlive(lv_k))) + " after " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " alive " + IntToString(BoolToInt(UnitIsAlive(lv_u)));
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if ((lp_cmd == "eselfb") || (lp_cmd == "eselscv")) {
        // eselfb / eselscv: the first Firebat / SCV is selected and the camera is on him (the next real keys / clicks come from the player's side)
        if (lp_cmd == "eselfb") {
            lv_u = GhostOps_Ce0_First("Firebat");
        } else {
            lv_u = GhostOps_Ce0_First("SCV");
        }

        if ((lp_cmd == "eselscv") && (lp_a == "fix")) {
            // a fixed starting point, so that the same real click always lands on the same free place
            UnitSetPosition(lv_u, Point(72.6, 87.5), false);
            UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        }

        UnitClearSelection(1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "ESEL " + lp_cmd + " selected at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1));
        return true;
    }

    if (lp_cmd == "eselmar") {
        // eselmar: a Marine is created 3 cells from the first container and SELECTED, the camera is on the container (the attack command is then given with the real keys / mouse)
        if (GhostOps_Hanson_ContAlive() < 1) {
            GhostOps_Ce0_Write("j", "ESELMAR no container");
            return true;
        }

        lv_p = UnitGetPosition(GhostOps_Hanson_ContNth(0));
        UnitCreate(1, "Marine", 0, 1, PointWithOffset(lv_p, -3.0, 0.0), 270.0);
        UnitClearSelection(1);
        UnitSelect(UnitLastCreated(), 1, true);
        CameraPan(1, lv_p, 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "ESELMAR marine selected, camera on the container");
        return true;
    }

    if (lp_cmd == "econt") {
        lv_i = 0;
        lv_t = "";
        while (lv_i < GhostOps_Hanson_ContAlive()) {
            if (UnitIsAlive(GhostOps_Hanson_ContNth(lv_i))) {
                lv_t = lv_t + "(" + FixedToString(PointGetX(UnitGetPosition(GhostOps_Hanson_ContNth(lv_i))), 1) + "," + FixedToString(PointGetY(UnitGetPosition(GhostOps_Hanson_ContNth(lv_i))), 1) + ") ";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "ECONT placed " + IntToString(GhostOps_Hanson_ContAlive()) + " alive " + lv_t + "| turret kits left " + IntToString(GhostOps_Hanson_KitsLeft()));
        return true;
    }

    if (lp_cmd == "eturrets") {
        lv_g = UnitGroup("MissileTurret", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_t = "";
        lv_i = 1;
        while (lv_i <= UnitGroupCount(lv_g, c_unitCountAll)) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + "(" + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1) + " life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " build " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLifePercent, c_unitPropCurrent), 0) + "%) ";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "ETURRETS " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " " + lv_t + "kits left " + IntToString(GhostOps_Hanson_KitsLeft()));
        return true;
    }

    if (lp_cmd == "eselt") {
        lv_u = GhostOps_Ce0_First("MissileTurret");
        UnitClearSelection(1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "ESELT turret selected at " + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1));
        return true;
    }

    if (lp_cmd == "edum") {
        // edum <dx> <dy>: a 3x3 grid of paused enemy Ultralisks around the point (turret + offset), the aim point of the salvo test
        lv_u = GhostOps_Ce0_First("MissileTurret");
        go_ce0Aim = PointWithOffset(UnitGetPosition(lv_u), StringToFixed(lp_a), StringToFixed(lp_b));
        go_ce0DumN = 0;
        lv_i = -1;
        while (lv_i <= 1) {
            lv_j = -1;
            while (lv_j <= 1) {
                UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, 3, PointWithOffset(go_ce0Aim, 1.4 * IntToFixed(lv_i), 1.4 * IntToFixed(lv_j)), 270.0);
                go_ce0Dum[go_ce0DumN] = UnitLastCreated();
                go_ce0DumLife[go_ce0DumN] = UnitGetPropertyFixed(UnitLastCreated(), c_unitPropLife, c_unitPropCurrent);
                go_ce0DumN += 1;
                lv_j += 1;
            }

            lv_i += 1;
        }

        lv_n = 0;
        while (lv_n < go_ce0DumN) {
            libNtve_gf_PauseUnit(go_ce0Dum[lv_n], true);
            lv_n += 1;
        }

        // the own fighters are paused (they would shoot the dummies and spoil the damage figures of the salvo); the turret and the SCV stay free
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (!UnitGroupLoopDone()) {
            if (UnitGetType(UnitGroupLoopCurrent()) != "SCV") {
                libNtve_gf_PauseUnit(UnitGroupLoopCurrent(), true);
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();

        GhostOps_Ce0_Write("j", "EDUM " + IntToString(go_ce0DumN) + " dummies at " + FixedToString(PointGetX(go_ce0Aim), 1) + "," + FixedToString(PointGetY(go_ce0Aim), 1));
        return true;
    }

    if (lp_cmd == "edmg") {
        lv_n = 0;
        lv_c = 0;
        lv_t = "";
        while (lv_n < go_ce0DumN) {
            if (UnitIsAlive(go_ce0Dum[lv_n])) {
                lv_k = go_ce0Dum[lv_n];
                if (UnitGetPropertyFixed(lv_k, c_unitPropLife, c_unitPropCurrent) < go_ce0DumLife[lv_n]) {
                    lv_c += 1;
                }

                lv_t = lv_t + FixedToString(go_ce0DumLife[lv_n] - UnitGetPropertyFixed(lv_k, c_unitPropLife, c_unitPropCurrent), 0) + " ";
            } else {
                lv_c += 1;
                lv_t = lv_t + "dead ";
            }

            lv_n += 1;
        }

        GhostOps_Ce0_Write("j", "EDMG damaged " + IntToString(lv_c) + " of " + IntToString(go_ce0DumN) + " | " + lv_t);
        return true;
    }

    if (lp_cmd == "eval") {
        // the salvo order of the first turret at the aim point WITHOUT giving it: 1 = ready, 0 = cooling down
        lv_u = GhostOps_Ce0_First("MissileTurret");
        GhostOps_Ce0_Write("j", "EVAL ready " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("GhostOpsTurretSalvo", 0), go_ce0Aim)))) + " ability " + IntToString(GhostOps_Ce0_B(UnitAbilityExists(lv_u, "GhostOpsTurretSalvo"))) + " game time " + FixedToString(GameGetMissionTime(), 1));
        return true;
    }

    if (lp_cmd == "eair") {
        // eair: a paused enemy Mutalisk 4 cells from the first turret (the automatic anti-air fire must kill / hurt it); eair with a = "life" reports it
        if (lp_a == "life") {
            if (UnitIsAlive(go_ce0Air)) {
                GhostOps_Ce0_Write("j", "EAIR alive life " + FixedToString(UnitGetPropertyFixed(go_ce0Air, c_unitPropLife, c_unitPropCurrent), 0));
            } else {
                GhostOps_Ce0_Write("j", "EAIR dead");
            }

            return true;
        }

        lv_u = GhostOps_Ce0_First("MissileTurret");
        UnitCreate(1, "Mutalisk", c_unitCreateIgnorePlacement, 3, PointWithOffset(UnitGetPosition(lv_u), 4.0, 0.0), 270.0);
        go_ce0Air = UnitLastCreated();
        libNtve_gf_PauseUnit(go_ce0Air, true);
        GhostOps_Ce0_Write("j", "EAIR created life " + FixedToString(UnitGetPropertyFixed(go_ce0Air, c_unitPropLife, c_unitPropCurrent), 0));
        return true;
    }

    if ((lp_cmd == "ebgrid") || (lp_cmd == "ebuildb")) {
        // ebgrid: which places around the Command Center accept a Bunker order of the first SCV (the free places of the next scenario); ebuildb <dx> <dy>: that SCV builds a Bunker at the offset
        lv_u = GhostOps_Ce0_First("SCV");
        lv_k = GhostOps_Ce0_First("CommandCenter");
        lv_j = -1;
        lv_i = 0;
        while (lv_i < 24) {
            if (CatalogFieldValueGet(c_gameCatalogAbil, "TerranBuild", "InfoArray[" + IntToString(lv_i) + "].Unit", 1) == "Bunker") {
                lv_j = lv_i;
            }

            lv_i += 1;
        }

        if (lp_cmd == "ebuildb") {
            UnitIssueOrder(lv_u, OrderTargetingPoint(AbilityCommand("TerranBuild", lv_j), PointWithOffset(UnitGetPosition(lv_k), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "EBUILDB order index " + IntToString(lv_j) + " at " + lp_a + "," + lp_b);
            return true;
        }

        lv_t = "EBGRID index " + IntToString(lv_j) + " valid:";
        lv_n = -14;
        while (lv_n <= 14) {
            lv_c = -14;
            while (lv_c <= 14) {
                if (UnitOrderIsValid(lv_u, OrderTargetingPoint(AbilityCommand("TerranBuild", lv_j), PointWithOffset(UnitGetPosition(lv_k), IntToFixed(lv_n), IntToFixed(lv_c))))) {
                    lv_t = lv_t + " " + IntToString(lv_n) + "," + IntToString(lv_c);
                }

                lv_c += 4;
            }

            lv_n += 4;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "geo") {
        // geo: the path cost from our base to both infested Command Centers and to the candidate places of the gas truck, with passability and the connection
        GhostOps_Ce0_Write("j", "GEO base->northCC cost " + IntToString(PointPathingCost(Point(73.5, 91.5), Point(111.5, 156.5))) + " conn " + IntToString(GhostOps_Ce0_B(PointPathingIsConnected(Point(73.5, 91.5), Point(111.5, 156.5)))) + " | base->southCC cost " + IntToString(PointPathingCost(Point(73.5, 91.5), Point(115.5, 31.5))) + " conn " + IntToString(GhostOps_Ce0_B(PointPathingIsConnected(Point(73.5, 91.5), Point(115.5, 31.5)))));
        return true;
    }

    if (lp_cmd == "geop") {
        // geop <x> <y>: passability, the connection with our base and the path cost of one point
        GhostOps_Ce0_Write("j", "GEOP (" + lp_a + "," + lp_b + ") passable " + IntToString(GhostOps_Ce0_B(PointPathingPassable(Point(StringToFixed(lp_a), StringToFixed(lp_b))))) + " conn " + IntToString(GhostOps_Ce0_B(PointPathingIsConnected(Point(73.5, 91.5), Point(StringToFixed(lp_a), StringToFixed(lp_b))))) + " cost " + IntToString(PointPathingCost(Point(73.5, 91.5), Point(StringToFixed(lp_a), StringToFixed(lp_b)))));
        return true;
    }

    if (lp_cmd == "escvat") {
        // escvat <x> <y>: the NEXT SCV of the group (a counter, a new one every call) is put at the point, stopped, selected, the camera on him: the next real keys (B, U, click) build from there
        go_ce0ScvN += 1;
        lv_u = UnitGroupUnit(UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), go_ce0ScvN);
        UnitSetPosition(lv_u, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
        UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        UnitClearSelection(1);
        UnitSelect(lv_u, 1, true);
        CameraPan(1, UnitGetPosition(lv_u), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "ESCVAT scv " + IntToString(go_ce0ScvN) + " at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "eenemy") {
        // eenemy: the enemy fighters (players 2..4) within 45 cells of the Command Center and the kills of the Marines, Bunkers and Ghosts of the player: did the attack come, and who stopped it
        lv_k = GhostOps_Ce0_First("CommandCenter");
        lv_c = 0;
        lv_i = 2;
        while (lv_i <= 4) {
            lv_c += UnitGroupCount(UnitGroup(null, lv_i, RegionCircle(UnitGetPosition(lv_k), 45.0), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
            lv_i += 1;
        }

        lv_n = 0;
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            lv_n += FixedToInt(UnitGetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropKills, c_unitPropCurrent));
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "EENEMY enemy fighters within 45 of the base " + IntToString(lv_c) + " | kills of the living units of the player " + IntToString(lv_n) + " | CC life " + FixedToString(UnitGetPropertyFixed(lv_k, c_unitPropLife, c_unitPropCurrent), 0));
        return true;
    }

    if (lp_cmd == "ebunk") {
        // the bunkers of the player: place, life, how many Marines inside; the bunker kits (ordered / spent / consumed / reserved / left)
        lv_g = UnitGroup("Bunker", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_t = "";
        lv_i = 1;
        while (lv_i <= UnitGroupCount(lv_g, c_unitCountAll)) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + "(" + FixedToString(PointGetX(UnitGetPosition(lv_u)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_u)), 1) + " life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " inside " + IntToString(UnitGroupCount(UnitCargoGroup(lv_u), c_unitCountAlive)) + ") ";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EBUNK " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " " + lv_t + "| radar ghost1 " + IntToString(UnitBehaviorCount(GhostOps_Ce0_First("Ghost"), "HeroDetectorRadar")) + " | kits ordered " + IntToString(go_hBkOrdered) + " spent " + IntToString(go_hBkSpent) + " consumed " + IntToString(go_hBkConsumed) + " reserved " + IntToString(GhostOps_Hanson_KitsReservedF(1)) + " left " + IntToString(GhostOps_Hanson_KitsLeftF(1)));
        return true;
    }

    if (lp_cmd == "eloadb") {
        // eloadb: the four next Marines of the group go into every finished bunker by the ordinary right-click order
        lv_g = UnitGroup("Bunker", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_c = 0;
        lv_n = 0;
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            lv_u = UnitGroupLoopCurrent();
            if (!UnitTestState(lv_u, c_unitStateUnderConstruction)) {
                lv_j = 0;
                while (lv_j < 4) {
                    lv_n += 1;
                    lv_k = UnitGroupUnit(UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), lv_n);
                    if (lv_k != null) {
                        UnitIssueOrder(lv_k, OrderTargetingUnit(AbilityCommand("smart", 0), lv_u), c_orderQueueReplace);
                        lv_c += 1;
                    }

                    lv_j += 1;
                }
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "ELOADB orders given to " + IntToString(lv_c) + " Marines");
        return true;
    }

    if (lp_cmd == "ezone") {
        // ezone <x> <y>: is the point inside the supply zone
        GhostOps_Ce0_Write("j", "EZONE " + lp_a + "," + lp_b + " in " + IntToString(BoolToInt(GhostOps_Epi_InZone(Point(StringToFixed(lp_a), StringToFixed(lp_b))))) + " zoneOn " + IntToString(BoolToInt(go_eZoneOn)));
        return true;
    }

    if (lp_cmd == "ezonechk") {
        // ezonechk: every structure of the player and every hellion / marine / ghost / scv / firebat / medic of the player: inside the supply zone or not (the zone must hold the whole original base)
        lv_t = "EZC outside:";
        lv_c = 0;
        lv_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_n) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            if (!GhostOps_Epi_InZone(UnitGetPosition(lv_u))) {
                lv_c += 1;
                if (lv_c <= 12) {
                    lv_t = lv_t + " " + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
                }
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t + " | of " + IntToString(lv_n) + " units of the player " + IntToString(lv_c) + " outside | dock " + IntToString(BoolToInt(GhostOps_Epi_InZone(go_eDock))) + " base " + IntToString(BoolToInt(GhostOps_Epi_InZone(go_eBase))));
        return true;
    }

    if (lp_cmd == "ebar") {
        // ebar: the barrels of the Hercules: charges (max / use / left / regen), the saved counters, the barrels in the air
        lv_t = "EBAR on " + IntToString(BoolToInt(go_bdOn)) + " ship " + IntToString(BoolToInt(go_eShipMade && UnitIsAlive(go_eShip)));
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_t = lv_t + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)) + " inZone " + IntToString(BoolToInt(GhostOps_Epi_InZone(UnitGetPosition(go_eShip)))) + " hidden " + IntToString(BoolToInt(UnitTestState(go_eShip, c_unitStateHidden)));
            lv_t = lv_t + " charges max " + FixedToString(UnitAbilityChargeInfo(go_eShip, AbilityCommand("GhostOpsDropBarrel", 0), c_unitAbilChargeCountMax), 1) + " use " + FixedToString(UnitAbilityChargeInfo(go_eShip, AbilityCommand("GhostOpsDropBarrel", 0), c_unitAbilChargeCountUse), 1)
                + " left " + FixedToString(UnitAbilityChargeInfo(go_eShip, AbilityCommand("GhostOpsDropBarrel", 0), c_unitAbilChargeCountLeft), 1) + " regenLeft " + FixedToString(UnitAbilityChargeInfo(go_eShip, AbilityCommand("GhostOpsDropBarrel", 0), c_unitAbilChargeRegenLeft), 1);
        }

        lv_t = lv_t + " | left " + IntToString(GhostOps_Epi_BarrelsLeft()) + " drops " + IntToString(go_bdDrops) + " blasts " + IntToString(go_bdBlasts) + " refills " + IntToString(go_bdRefills) + " out " + IntToString(BoolToInt(go_bdOut)) + " air";
        lv_i = 0;
        while (lv_i < 4) {
            lv_t = lv_t + " " + IntToString(BoolToInt(go_bdLive[lv_i]));
            lv_i += 1;
        }

        lv_i = 0;
        while (lv_i < 4) {
            if (go_bdLive[lv_i]) {
                lv_t = lv_t + " | barrel" + IntToString(lv_i) + " no " + IntToString(go_bdNo[lv_i]) + " lands at " + GhostOps_Ce0_Pt(go_bdPos[lv_i]);
            }

            lv_i += 1;
        }

        lv_t = lv_t + " contBlasts " + IntToString(go_hContBlasts);
        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ebdrop") {
        // ebdrop <x> <y>: the ship is ORDERED (scripted order) to drop a barrel at the point
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitIssueOrder(go_eShip, OrderTargetingPoint(AbilityCommand("GhostOpsDropBarrel", 0), Point(StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "EBDROP ordered at " + lp_a + "," + lp_b + " orders " + IntToString(UnitOrderCount(go_eShip)));
        }

        return true;
    }

    if (lp_cmd == "eshipat") {
        // eshipat <x> <y>: the ship is put at the point (scenario preparation, not a control check)
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitSetPosition(go_eShip, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
            GhostOps_Ce0_Write("j", "ESHIPAT put at " + lp_a + "," + lp_b);
        }

        return true;
    }

    if (lp_cmd == "ekillnear") {
        // ekillnear <x> <y>: scenario preparation: the free enemy fighters (player 3, not structures) within 18 cells of the point are removed: the natural night infested of the area are not part of this control check
        lv_c = 0;
        lv_g = UnitGroup(null, 3, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 18.0), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitKill(UnitGroupLoopCurrent());
            lv_c += 1;
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "EKILLNEAR removed " + IntToString(lv_c));
        return true;
    }

    if (lp_cmd == "enear") {
        // enear <x> <y>: every enemy / neutral unit and structure within 12 cells of the point (type, position, life)
        lv_t = "ENEAR within 12 of " + lp_a + "," + lp_b + ":";
        lv_i = 2;
        while (lv_i <= 4) {
            lv_g = UnitGroup(null, lv_i, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
            lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
            lv_j = 1;
            while ((lv_j <= lv_n) && (lv_j <= 16)) {
                lv_u = UnitGroupUnit(lv_g, lv_j);
                lv_t = lv_t + " p" + IntToString(lv_i) + ":" + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
                lv_j += 1;
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "einvmar") {
        // einvmar: scenario preparation of a control check: the Marines of the player are invulnerable (the squad must survive the swarm at the site so that the boarding and the flight home can be checked)
        lv_g = UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitSetState(UnitGroupLoopCurrent(), c_unitStateInvulnerable, true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "EINVMAR marines invulnerable " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "egather") {
        // egather <x> <y>: scenario preparation: four Marines of the player (those within 25 cells of the point) stand at (x-5,y+2) (x-5,y-2) (x+5,y+2) (x+5,y-2) and the camera is on (x,y); on the screen the point (x,y) is at client (514, 378), 46 px per cell in x and 38 px per cell in y (measured with th2r7_cal)
        lv_p = Point(StringToFixed(lp_a), StringToFixed(lp_b));
        lv_g = UnitGroup("Marine", 1, RegionCircle(lv_p, 25.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_i = 1;
        while (lv_i <= 4) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            if (lv_i == 1) {
                UnitSetPosition(lv_u, PointWithOffset(lv_p, -5.0, 2.0), false);
            }
            else if (lv_i == 2) {
                UnitSetPosition(lv_u, PointWithOffset(lv_p, -5.0, -2.0), false);
            }
            else if (lv_i == 3) {
                UnitSetPosition(lv_u, PointWithOffset(lv_p, 5.0, 2.0), false);
            }
            else {
                UnitSetPosition(lv_u, PointWithOffset(lv_p, 5.0, -2.0), false);
            }

            UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            go_ce0Sq[lv_i - 1] = lv_u;
            lv_i += 1;
        }

        CameraPan(1, lv_p, 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "EGATHER found " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " marines; four marines around " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "eselshipq") {
        // eselshipq: only the ship is selected (the camera does not move)
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitClearSelection(1);
            UnitSelect(go_eShip, 1, true);
            GhostOps_Ce0_Write("j", "ESELSHIPQ ship selected at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)));
        }

        return true;
    }

    if (lp_cmd == "emedivac") {
        // emedivac <x> <y>: control experiment for the boarding clicks: a stock Medivac of the player is made at the point and selected (nothing else is changed); emedcargo reports its cargo
        if (lp_b == "x") {
            UnitCreate(1, "Hercules", c_unitCreateIgnorePlacement, 1, Point(StringToFixed(lp_a), 104.0), 270.0);
        }
        else {
            UnitCreate(1, "Medivac", c_unitCreateIgnorePlacement, 1, Point(StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        }

        go_ce0Air = UnitLastCreated();
        UnitClearSelection(1);
        UnitSelect(go_ce0Air, 1, true);
        GhostOps_Ce0_Write("j", "EMEDIVAC made at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "emedcargo") {
        GhostOps_Ce0_Write("j", "EMEDCARGO cargo " + IntToString(UnitGroupCount(UnitCargoGroup(go_ce0Air), c_unitCountAlive)) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_ce0Air)));
        return true;
    }

    if (lp_cmd == "esq4") {
        // esq4: the four marines of the raid squad (marked by egather): alive / dead, life, at which point, on the ship or not; the ship: life and place
        lv_t = "ESQ4";
        lv_c = 0;
        lv_i = 0;
        while (lv_i < 4) {
            lv_u = go_ce0Sq[lv_i];
            if (lv_u == null) {
                lv_t = lv_t + " [none]";
            }
            else if (!UnitIsAlive(lv_u)) {
                lv_t = lv_t + " [dead]";
            }
            else {
                lv_c += 1;
                lv_t = lv_t + " [life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(lv_u)) + "]";
            }

            lv_i += 1;
        }

        lv_t = lv_t + " alive " + IntToString(lv_c);
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_t = lv_t + " | ship life " + FixedToString(UnitGetPropertyFixed(go_eShip, c_unitPropLife, c_unitPropCurrent), 0) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)) + " cargo " + IntToString(UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive)) + " inZone " + IntToString(BoolToInt(GhostOps_Epi_InZone(UnitGetPosition(go_eShip))));
        }
        else {
            lv_t = lv_t + " | ship lost";
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ecamship") {
        // ecamship: the camera on the ship (the player scrolls to it; no selection change)
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            CameraPan(1, UnitGetPosition(go_eShip), 0.0, -1.0, 10.0, false);
            GhostOps_Ce0_Write("j", "ECAMSHIP camera at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)));
        }

        return true;
    }

    if (lp_cmd == "eselship") {
        // eselship: the ship is selected and the camera is on it (scenario preparation; the casting itself is done with real keys)
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitClearSelection(1);
            UnitSelect(go_eShip, 1, true);
            CameraPan(1, UnitGetPosition(go_eShip), 0.0, -1.0, 10.0, false);
            GhostOps_Ce0_Write("j", "ESELSHIP selected at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)));
        }

        return true;
    }

    if (lp_cmd == "ehinv") {
        // ehinv: the hellions become invulnerable (scenario preparation of the fuel checks: the enemy outside the base must not kill the test units)
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                UnitSetState(go_eHell[lv_i], c_unitStateInvulnerable, true);
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EHINV hellions invulnerable");
        return true;
    }

    if (lp_cmd == "efuelinfo") {
        // efuelinfo: the fuel of every hellion with its position and whether it is inside the zone
        lv_t = "EFI";
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                lv_t = lv_t + " [" + FixedToString(UnitGetPropertyFixed(go_eHell[lv_i], c_unitPropEnergy, c_unitPropCurrent), 1) + " dry " + IntToString(BoolToInt(go_eHellDry[lv_i])) + " zone " + IntToString(BoolToInt(GhostOps_Epi_InZone(UnitGetPosition(go_eHell[lv_i])))) + " at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eHell[lv_i])) + "]";
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ebdum") {
        // ebdum <x> <y>: a 3x3 grid of paused enemy Ultralisks at the absolute point (the aim of a dropped barrel); edmg reads the damage
        go_ce0Aim = Point(StringToFixed(lp_a), StringToFixed(lp_b));
        go_ce0DumN = 0;
        lv_i = -1;
        while (lv_i <= 1) {
            lv_j = -1;
            while (lv_j <= 1) {
                UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, 3, PointWithOffset(go_ce0Aim, 1.4 * IntToFixed(lv_i), 1.4 * IntToFixed(lv_j)), 270.0);
                go_ce0Dum[go_ce0DumN] = UnitLastCreated();
                go_ce0DumLife[go_ce0DumN] = UnitGetPropertyFixed(UnitLastCreated(), c_unitPropLife, c_unitPropCurrent);
                libNtve_gf_PauseUnit(UnitLastCreated(), true);
                go_ce0DumN += 1;
                lv_j += 1;
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EBDUM " + IntToString(go_ce0DumN) + " dummies at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "eshipstop") {
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            UnitIssueOrder(go_eShip, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "ESHIPSTOP stop ordered, orders " + IntToString(UnitOrderCount(go_eShip)));
        }

        return true;
    }

    if (lp_cmd == "eshipnow") {
        // eshipnow: the night transport arrives now (scenario preparation: the arrival is the normal one, only the wait for the second night is skipped)
        if (go_eShipOn) {
            go_eNightOpen = true;
            go_eWarned = false;
            go_eWarnAt = GameGetMissionTime() + 100000.0;
            GhostOps_Epi_ShipOpen();
            GhostOps_Ce0_Write("j", "ESHIPNOW the transport is on the map");
        }

        return true;
    }

    if (lp_cmd == "etruckown") {
        // etruckown: the truck becomes the player's (scenario preparation of a fuel check; the real capture is checked in th2r6_truck)
        if (UnitIsAlive(go_eTruck)) {
            UnitSetOwner(go_eTruck, 1, true);
            go_eStage = 3;
            GhostOps_Ce0_Write("j", "ETRUCKOWN truck is the player's, stage 3");
        }

        return true;
    }

    if (lp_cmd == "etruckat") {
        if (UnitIsAlive(go_eTruck)) {
            UnitSetPosition(go_eTruck, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
            GhostOps_Ce0_Write("j", "ETRUCKAT put at " + lp_a + "," + lp_b);
        }

        return true;
    }

    if (lp_cmd == "etrnear") {
        // etrnear: what the map has around the truck place (enemy / neutral units and structures within 16 cells), counted by type
        lv_t = "ETRNEAR within 16 of the truck:";
        lv_i = 2;
        while (lv_i <= 4) {
            lv_g = UnitGroup(null, lv_i, RegionCircle(UnitGetPosition(go_eTruck), 16.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
            lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
            lv_j = 1;
            while ((lv_j <= lv_n) && (lv_j <= 14)) {
                lv_u = UnitGroupUnit(lv_g, lv_j);
                if (lv_u != go_eTruck) {
                    lv_t = lv_t + " p" + IntToString(lv_i) + ":" + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u));
                }

                lv_j += 1;
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "ehealtruck") {
        if (UnitIsAlive(go_eTruck)) {
            UnitSetPropertyFixed(go_eTruck, c_unitPropLife, UnitGetPropertyFixed(go_eTruck, c_unitPropLifeMax, c_unitPropCurrent));
            GhostOps_Ce0_Write("j", "EHEALTRUCK life " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropLife, c_unitPropCurrent), 0));
        }

        return true;
    }

    if (lp_cmd == "ekillzerg") {
        // ekillzerg: the free enemy fighters (player 3, not structures) within 22 cells of the truck are removed (the end of the vulnerability test)
        lv_c = 0;
        lv_g = UnitGroup(null, 3, RegionCircle(UnitGetPosition(go_eTruck), 22.0), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitKill(UnitGroupLoopCurrent());
            lv_c += 1;
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "EKILLZERG removed " + IntToString(lv_c));
        return true;
    }

    if (lp_cmd == "ebsite") {
        // ebsite <x> <y>: scenario preparation of a landing site: 12 paused enemy infested Terrans (player 3) in a ring of radius 2.5 around the point; ebsitec counts the living ones
        go_ce0Aim = Point(StringToFixed(lp_a), StringToFixed(lp_b));
        go_ce0DumN = 0;
        lv_i = 0;
        while (lv_i < 12) {
            UnitCreate(1, "InfestedTerranCampaign", c_unitCreateIgnorePlacement, 3, PointWithOffsetPolar(go_ce0Aim, 2.5, IntToFixed(lv_i) * 30.0), 270.0);
            go_ce0Dum[go_ce0DumN] = UnitLastCreated();
            libNtve_gf_PauseUnit(UnitLastCreated(), true);
            go_ce0DumN += 1;
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EBSITE 12 paused infested at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "ebsitec") {
        lv_c = 0;
        lv_n = 0;
        while (lv_n < go_ce0DumN) {
            if (UnitIsAlive(go_ce0Dum[lv_n])) {
                lv_c += 1;
            }

            lv_n += 1;
        }

        GhostOps_Ce0_Write("j", "EBSITEC alive " + IntToString(lv_c) + " of " + IntToString(go_ce0DumN));
        return true;
    }

    if (lp_cmd == "eaa") {
        // eaa: scenario preparation of the anti-air of the route: two enemy Spore Crawlers (they shoot air); eaakill removes them (the "AA of the route destroyed in advance" step); eaac counts the living enemy Spore Crawlers
        UnitCreate(1, "SporeCrawler", c_unitCreateIgnorePlacement, 3, Point(94.0, 99.0), 270.0);
        UnitCreate(1, "SporeCrawler", c_unitCreateIgnorePlacement, 3, Point(100.0, 96.0), 270.0);
        GhostOps_Ce0_Write("j", "EAA 2 spore crawlers created on the route");
        return true;
    }

    if (lp_cmd == "eaakill") {
        lv_g = UnitGroup("SporeCrawler", 3, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_c = UnitGroupCount(lv_g, c_unitCountAlive);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitKill(UnitGroupLoopCurrent());
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "EAAKILL removed " + IntToString(lv_c));
        return true;
    }

    if (lp_cmd == "eaac") {
        GhostOps_Ce0_Write("j", "EAAC enemy spore crawlers alive " + IntToString(UnitGroupCount(UnitGroup("SporeCrawler", 3, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "etgt") {
        // etgt <x> <y>: the enemy structure nearest to the point (the raid target): type, position, life
        lv_g = UnitGroup(null, 3, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 6.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
        lv_t = "ETGT structures within 6 of " + lp_a + "," + lp_b + ": " + IntToString(lv_n);
        lv_i = 1;
        while ((lv_i <= lv_n) && (lv_i <= 4)) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            lv_t = lv_t + " [" + UnitGetType(lv_u) + "@" + GhostOps_Ce0_Pt(UnitGetPosition(lv_u)) + " life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + "]";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "esquad") {
        // esquad <x> <y>: the marines of the player: how many are within 8 of the point, how many are on the ship, how many in all
        lv_g = UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_c = 0;
        lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
        lv_g = UnitGroup("Marine", 1, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 8.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_c = UnitGroupCount(lv_g, c_unitCountAlive);
        lv_t = "ESQUAD marines " + IntToString(lv_n) + " within 8 of " + lp_a + "," + lp_b + ": " + IntToString(lv_c);
        if (go_eShipMade && UnitIsAlive(go_eShip)) {
            lv_t = lv_t + " | ship at " + GhostOps_Ce0_Pt(UnitGetPosition(go_eShip)) + " cargo " + IntToString(UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive)) + " inZone " + IntToString(BoolToInt(GhostOps_Epi_InZone(UnitGetPosition(go_eShip)))) + " life " + FixedToString(UnitGetPropertyFixed(go_eShip, c_unitPropLife, c_unitPropCurrent), 0);
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "eselsq") {
        // eselsq <x> <y>: selects the marines within 8 of the point and puts the camera there (scenario preparation of the selection; the orders are given with the keys and the mouse)
        UnitClearSelection(1);
        lv_g = UnitGroup("Marine", 1, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 8.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitSelect(UnitGroupLoopCurrent(), 1, true);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        CameraPan(1, Point(StringToFixed(lp_a), StringToFixed(lp_b)), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "ESELSQ selected " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "ecam") {
        CameraPan(1, Point(StringToFixed(lp_a), StringToFixed(lp_b)), 0.0, -1.0, 10.0, false);
        return true;
    }

    if (lp_cmd == "espd") {
        GameSetSpeedValue(StringToInt(lp_a));
        GhostOps_Ce0_Write("j", "ESPD " + lp_a);
        return true;
    }

    if (lp_cmd == "eclock") {
        GhostOps_Ce0_Write("j", "ECLOCK mission time " + FixedToString(GameGetMissionTime(), 1) + " night " + IntToString(BoolToInt(go_eIsNight)) + "/" + IntToString(go_eNightNo));
        return true;
    }

    if (lp_cmd == "eselhell") {
        UnitClearSelection(1);
        lv_i = 0;
        while (lv_i < go_eHellN) {
            if (UnitIsAlive(go_eHell[lv_i])) {
                UnitSelect(go_eHell[lv_i], 1, true);
            }

            lv_i += 1;
        }

        return true;
    }

    if (lp_cmd == "eatkprot") {
        // eatkprot: the first Marine of the player attacks the first protected building (the day explanation scene)
        lv_u = GhostOps_Ce0_First("Marine");
        if ((lv_u != null) && (go_eProtN > 0)) {
            UnitSetPosition(lv_u, PointWithOffset(UnitGetPosition(go_eProt[0]), 6.0, 0.0), false);
            UnitIssueOrder(lv_u, OrderTargetingUnit(AbilityCommand("attack", 0), go_eProt[0]), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "EATKPROT marine ordered to attack the protected " + UnitGetType(go_eProt[0]));
        }

        return true;
    }

    if (lp_cmd == "ekillall") {
        // ekillall: every infested structure that the original victory counts (player 3, structure, PreventDefeat) is killed (the dev way to reach the standard victory chain)
        lv_g = UnitGroup(null, 3, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure) | (1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_n) {
            UnitKill(UnitGroupUnit(lv_g, lv_i));
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EKILLALL " + IntToString(lv_n) + " counted structures killed");
        return true;
    }

    if (lp_cmd == "ecount") {
        lv_g = UnitGroup(null, 3, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure) | (1 << c_targetFilterPreventDefeat), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        GhostOps_Ce0_Write("j", "ECOUNT structures the victory counts: " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)));
        return true;
    }

    return false;
}

