// CE-0 probe: THanson01 specific state and commands (development only; compiled only with the config key "ce0").
//
// Turret-kit experiment (NOT a rule of any playable profile, no price): which real events does the game give for a structure built by an
// SCV, so that the contract's kit rule "N ordered = N free builds; start reserves, cancel returns, completion spends, death of a finished
// turret returns nothing" can be implemented? All counters are saved globals (they travel with a save, like any gameplay state).
int go_kOrdered;
int go_kReserved;
int go_kSpent;
int go_kLostUnfinished;       // reserved kits whose turret was destroyed before it was finished (the rule for them is an open question)
unit[8] go_kUnit;
int[8] go_kState;             // 0 free, 1 constructing, 2 complete, 3 destroyed unfinished, 4 destroyed complete, 5 cancelled
int go_kBuildIdx;
bool go_kStarted;
trigger go_kCreatedTrig;
trigger go_kStartTrig;
trigger go_kCancelTrig;
trigger go_kCompleteTrig;
trigger go_kDiedTrig;

int GhostOps_Ce0_KitSlot (unit lp_u) {
    int lv_i;

    lv_i = 0;
    while (lv_i < 8) {
        if ((go_kState[lv_i] != 0) && (go_kUnit[lv_i] == lp_u)) {
            return lv_i;
        }

        lv_i += 1;
    }

    return -1;
}

int GhostOps_Ce0_KitNewSlot (unit lp_u) {
    int lv_i;

    lv_i = 0;
    while (lv_i < 8) {
        if (go_kState[lv_i] == 0) {
            go_kUnit[lv_i] = lp_u;
            return lv_i;
        }

        lv_i += 1;
    }

    return -1;
}

int GhostOps_Ce0_KitFree () {
    return go_kOrdered - go_kReserved - go_kSpent;
}

void GhostOps_Ce0_KitGate () {
    if (go_hKitOn) {
        // the turret kits of the mission module own the gate of the turret: the old probe must not close it
        return;
    }

    TechTreeUnitAllow(1, "MissileTurret", GhostOps_Ce0_KitFree() > 0);
}

string GhostOps_Ce0_KitText () {
    string lv_s;
    int lv_i;

    lv_s = "kits ordered=" + IntToString(go_kOrdered) + " reserved=" + IntToString(go_kReserved) + " spent=" + IntToString(go_kSpent);
    lv_s = lv_s + " lostUnfinished=" + IntToString(go_kLostUnfinished) + " free=" + IntToString(GhostOps_Ce0_KitFree()) + " slots=";
    lv_i = 0;
    while (lv_i < 8) {
        lv_s = lv_s + IntToString(go_kState[lv_i]);
        lv_i += 1;
    }

    return lv_s;
}

// every event is logged with what the engine says about its unit: this is the measurement
void GhostOps_Ce0_KitEventLog (string lp_what) {
    unit lv_u;
    unit lv_p;
    string lv_t;

    lv_u = EventUnit();
    lv_p = EventUnitProgressUnit();
    lv_t = "KIT " + lp_what + ": event unit type=" + UnitGetType(lv_u) + " progress unit type=" + UnitGetType(lv_p);
    lv_t = lv_t + " objectType=" + EventUnitProgressObjectType() + " slot=" + IntToString(GhostOps_Ce0_KitSlot(lv_p));
    if (lv_p != null) {
        lv_t = lv_t + " progress unit alive=" + IntToString(GhostOps_Ce0_B(UnitIsAlive(lv_p))) + " life=" + FixedToString(UnitGetPropertyFixed(lv_p, c_unitPropLife, c_unitPropCurrent), 1);
    }

    GhostOps_Ce0_Write("j", lv_t + " | " + GhostOps_Ce0_KitText());
}

bool GhostOps_Ce0_KitCreated (bool lp_test, bool lp_run) {
    unit lv_u;
    int lv_slot;
    string lv_t;

    if (!lp_run) {
        return true;
    }

    lv_u = EventUnitCreatedUnit();
    if ((UnitGetType(lv_u) != "MissileTurret") || (UnitGetOwner(lv_u) != 1)) {
        return true;
    }

    lv_slot = GhostOps_Ce0_KitNewSlot(lv_u);
    lv_t = "KIT created by SCV: slot " + IntToString(lv_slot) + " free before=" + IntToString(GhostOps_Ce0_KitFree());
    lv_t = lv_t + " life=" + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 1);
    lv_t = lv_t + " minerals=" + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals));
    if (lv_slot >= 0) {
        go_kState[lv_slot] = 1;
        go_kReserved += 1;
    }

    GhostOps_Ce0_Write("j", lv_t + " | " + GhostOps_Ce0_KitText());
    GhostOps_Ce0_KitGate();
    return true;
}

bool GhostOps_Ce0_KitStart (bool lp_test, bool lp_run) {
    if (!lp_run) {
        return true;
    }

    GhostOps_Ce0_KitEventLog("progress START");
    return true;
}

bool GhostOps_Ce0_KitCancel (bool lp_test, bool lp_run) {
    int lv_slot;

    if (!lp_run) {
        return true;
    }

    lv_slot = GhostOps_Ce0_KitSlot(EventUnitProgressUnit());
    if ((lv_slot >= 0) && (go_kState[lv_slot] == 1)) {
        go_kState[lv_slot] = 5;
        go_kReserved -= 1;
    }

    GhostOps_Ce0_KitEventLog("progress CANCEL");
    GhostOps_Ce0_KitGate();
    return true;
}

bool GhostOps_Ce0_KitComplete (bool lp_test, bool lp_run) {
    int lv_slot;

    if (!lp_run) {
        return true;
    }

    lv_slot = GhostOps_Ce0_KitSlot(EventUnitProgressUnit());
    if ((lv_slot >= 0) && (go_kState[lv_slot] == 1)) {
        go_kState[lv_slot] = 2;
        go_kReserved -= 1;
        go_kSpent += 1;
    }

    GhostOps_Ce0_KitEventLog("progress COMPLETE");
    GhostOps_Ce0_KitGate();
    return true;
}

bool GhostOps_Ce0_KitDied (bool lp_test, bool lp_run) {
    unit lv_u;
    int lv_slot;
    string lv_t;

    if (!lp_run) {
        return true;
    }

    lv_u = EventUnit();
    if (UnitGetType(lv_u) != "MissileTurret") {
        return true;
    }

    lv_slot = GhostOps_Ce0_KitSlot(lv_u);
    lv_t = "KIT died: slot=" + IntToString(lv_slot);
    if (lv_slot >= 0) {
        lv_t = lv_t + " was state " + IntToString(go_kState[lv_slot]);
        if (go_kState[lv_slot] == 1) {
            go_kState[lv_slot] = 3;
            go_kReserved -= 1;
            go_kLostUnfinished += 1;
        }
        else if (go_kState[lv_slot] == 2) {
            go_kState[lv_slot] = 4;
        }
    }

    GhostOps_Ce0_Write("j", lv_t + " | " + GhostOps_Ce0_KitText());
    GhostOps_Ce0_KitGate();
    return true;
}

string GhostOps_Ce0_Extra () {
    string lv_s;
    int lv_i;
    int lv_alive;

    lv_alive = 0;
    lv_i = 0;
    while (lv_i < go_hTurretCount) {
        if ((go_hTurret[lv_i] != null) && UnitIsAlive(go_hTurret[lv_i])) {
            lv_alive += 1;
        }

        lv_i += 1;
    }

    lv_s = "han cmd=" + IntToString(go_hCmdState) + " phase=" + IntToString(go_hPhase) + " sent=" + IntToString(go_hSent);
    lv_s = lv_s + " saved=" + IntToString(go_hSaved) + " killed=" + IntToString(go_hKilled) + " idx=" + IntToString(go_hEscort);
    lv_s = lv_s + " waves=" + IntToString(go_hWaves) + " turrets=" + IntToString(lv_alive);
    lv_s = lv_s + " | " + GhostOps_Ce0_KitText();
    return lv_s;
}

void GhostOps_Ce0_MissionStart () {
    if (go_kStarted) {
        return;
    }

    go_kStarted = true;
    go_kCreatedTrig = TriggerCreate("GhostOps_Ce0_KitCreated");
    TriggerAddEventUnitCreated(go_kCreatedTrig, null, "TerranBuild", null);
    go_kStartTrig = TriggerCreate("GhostOps_Ce0_KitStart");
    TriggerAddEventUnitConstructProgress(go_kStartTrig, null, c_unitProgressStageStart);
    go_kCancelTrig = TriggerCreate("GhostOps_Ce0_KitCancel");
    TriggerAddEventUnitConstructProgress(go_kCancelTrig, null, c_unitProgressStageCancel);
    go_kCompleteTrig = TriggerCreate("GhostOps_Ce0_KitComplete");
    TriggerAddEventUnitConstructProgress(go_kCompleteTrig, null, c_unitProgressStageComplete);
    go_kDiedTrig = TriggerCreate("GhostOps_Ce0_KitDied");
    TriggerAddEventUnitDied(go_kDiedTrig, null);
}

unit GhostOps_Ce0_First (string lp_type) {
    return UnitGroupUnit(UnitGroup(lp_type, 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0), 1);
}

// Blast test (dev): a cluster around the placed container i: enemy ground biological (Zergling), enemy armored (Roach), the heavy Ultralisk, an enemy air unit (Mutalisk),
// own Marine, allied Marine (player 4), colonist (player 4), own Supply Depot, and a Zergling outside the radius as control. Lives are logged before / after.
unit[10] go_nbU;
string[10] go_nbT;

string GhostOps_Ce0_NbLife (unit lp_u) {
    if ((lp_u == null) || !UnitIsAlive(lp_u)) {
        return "dead";
    }

    return FixedToString(UnitGetPropertyFixed(lp_u, c_unitPropLife, c_unitPropCurrent), 0);
}

void GhostOps_Ce0_NbLog (string lp_tag) {
    string lv_s;
    int lv_i;

    lv_s = "";
    lv_i = 0;
    while (lv_i < 10) {
        lv_s = lv_s + go_nbT[lv_i] + ":" + GhostOps_Ce0_NbLife(go_nbU[lv_i]) + " ";
        lv_i += 1;
    }

    GhostOps_Ce0_Write("j", "NB " + lp_tag + " " + lv_s);
}

void GhostOps_Ce0_NbMake (int lp_i, string lp_type, int lp_owner, point lp_pos) {
    go_nbT[lp_i] = lp_type + "#" + IntToString(lp_owner);
    UnitCreate(1, lp_type, 0, lp_owner, lp_pos, 270.0);
    go_nbU[lp_i] = UnitLastCreated();
}

// Resource probe (dev): what the player has and what the SCVs do. nres = one line now; nresmon = a line every 30 s of game time (gas, minerals, SCVs, refineries).
trigger go_nrMon;

void GhostOps_Ce0_NresLine () {
    unitgroup lv_scv;
    unitgroup lv_ref;
    unit lv_r;
    int lv_i;
    string lv_t;

    lv_scv = UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_ref = UnitGroup("Refinery", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_t = "";
    lv_i = 1;
    while (lv_i <= UnitGroupCount(lv_ref, c_unitCountAlive)) {
        lv_r = UnitGroupUnit(lv_ref, lv_i);
        lv_t = lv_t + "(" + FixedToString(PointGetX(UnitGetPosition(lv_r)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_r)), 0) + ") ";
        lv_i += 1;
    }

    GhostOps_Ce0_Write("j", "NRES t " + FixedToString(GameGetMissionTime(), 0) + " gas " + IntToString(PlayerGetPropertyInt(1, c_playerPropVespene)) + " min " + IntToString(PlayerGetPropertyInt(1, c_playerPropMinerals)) + " mined gas " + IntToString(PlayerGetPropertyInt(1, c_playerPropVespeneCollected)));
    GhostOps_Ce0_Write("j", "NRES scvs " + IntToString(UnitGroupCount(lv_scv, c_unitCountAlive)) + " refineries " + IntToString(UnitGroupCount(lv_ref, c_unitCountAlive)) + " at " + lv_t);
}

bool GhostOps_Ce0_NresTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    GhostOps_Ce0_NresLine();
    return true;
}

bool GhostOps_Ce0_FastCancel (bool lp_testConds, bool lp_runActions) {
    unit lv_f;

    if (!lp_runActions) {
        return true;
    }

    lv_f = GhostOps_Ce0_First("Firebat");
    UnitIssueOrder(lv_f, OrderTargetingPoint(AbilityCommand("GhostOpsPlaceContainer", 0), PointWithOffset(UnitGetPosition(lv_f), 2.0, 0.0)), c_orderQueueReplace);
    Wait(0.05, c_timeGame);
    UnitIssueOrder(lv_f, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    GhostOps_Ce0_Write("j", "NFAST order given and cancelled 0.05 s later");
    return true;
}

bool GhostOps_Ce0_MissionCmd (string lp_cmd, string lp_a, string lp_b) {
    unit lv_scv;
    unit lv_cc;
    point lv_p;
    int lv_i;
    string lv_t;
    unitgroup lv_g;

    if (lp_cmd == "nship") {
        // the convoy reaches the colony ship: every unit of the colonists' player is put 4 cells from the ship region and ordered to move into it (the original then loads, counts and removes them)
        lv_g = UnitGroup(null, 4, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        lv_i = 0;
        UnitGroupLoopBegin(lv_g);
        while (!UnitGroupLoopDone()) {
            // only the units the original sent with the convoy (it marks them with custom value 0 = 21)
            if (UnitGetCustomValue(UnitGroupLoopCurrent(), 0) == 21.0) {
                UnitSetPosition(UnitGroupLoopCurrent(), PointWithOffset(RegionGetCenter(RegionFromId(2)), -4.0, 0.0), false);
                UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingPoint(AbilityCommand("move", 0), RegionGetCenter(RegionFromId(2))), c_orderQueueReplace);
                lv_i += 1;
            }

            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "NSHIP " + IntToString(lv_i) + " units sent to the ship");
        return true;
    }

    if (lp_cmd == "nblast") {
        lv_p = UnitGetPosition(go_hCont[StringToInt(lp_a)]);
        // the Ghosts stand 8 cells away (outside their own rifle range): the cluster can only be changed by the explosion
        UnitSetPosition(GhostOps_SquadUnit(0), PointWithOffset(lv_p, -8.0, 0.0), false);
        UnitSetPosition(GhostOps_SquadUnit(1), PointWithOffset(lv_p, -8.0, 1.5), false);
        GhostOps_Ce0_NbMake(0, "Zergling", 6, PointWithOffset(lv_p, 1.0, 0.0));
        GhostOps_Ce0_NbMake(1, "Roach", 6, PointWithOffset(lv_p, -1.0, 0.0));
        GhostOps_Ce0_NbMake(2, "Ultralisk", 6, PointWithOffset(lv_p, 0.0, 1.6));
        GhostOps_Ce0_NbMake(3, "Mutalisk", 6, PointWithOffset(lv_p, 0.0, -1.0));
        GhostOps_Ce0_NbMake(4, "Marine", 1, PointWithOffset(lv_p, 1.5, 1.5));
        GhostOps_Ce0_NbMake(5, "Marine", 4, PointWithOffset(lv_p, -1.5, 1.5));
        GhostOps_Ce0_NbMake(6, "Civilian", 4, PointWithOffset(lv_p, -1.5, -1.5));
        GhostOps_Ce0_NbMake(7, "SupplyDepot", 1, PointWithOffset(lv_p, 2.4, -2.0));
        GhostOps_Ce0_NbMake(8, "Zergling", 6, PointWithOffset(lv_p, 4.6, 0.0));
        GhostOps_Ce0_NbMake(9, "Marine", 1, PointWithOffset(lv_p, 0.0, -2.6));
        // a clean scene: the cluster is paused (nobody fights anybody) and the Ghosts hold their fire; only the explosion (and the shot at the container) can change a life
        lv_i = 0;
        while (lv_i < 10) {
            libNtve_gf_PauseUnit(go_nbU[lv_i], true);
            lv_i += 1;
        }

        UnitIssueOrder(GhostOps_SquadUnit(0), Order(AbilityCommand("GhostHoldFire", 0)), c_orderQueueReplace);
        UnitIssueOrder(GhostOps_SquadUnit(1), Order(AbilityCommand("GhostHoldFire", 0)), c_orderQueueReplace);
        GhostOps_Ce0_NbLog("before");
        return true;
    }

    if (lp_cmd == "nafter") {
        GhostOps_Ce0_NbLog("after");
        return true;
    }

    if (lp_cmd == "nbunk") {
        lv_scv = GhostOps_Ce0_First("Firebat");
        UnitCreate(1, "SupplyDepot", 0, 1, PointWithOffset(UnitGetPosition(lv_scv), StringToFixed(lp_a), StringToFixed(lp_b)), 270.0);
        GhostOps_Ce0_Write("j", "NBUNK depots of player 1 now " + IntToString(UnitGroupCount(UnitGroup("SupplyDepot", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)) + " at " + FixedToString(PointGetX(UnitGetPosition(UnitLastCreated())), 1) + "," + FixedToString(PointGetY(UnitGetPosition(UnitLastCreated())), 1));
        return true;
    }

    if (lp_cmd == "nused") {
        go_hContUsed = StringToInt(lp_a);
        GhostOps_Ce0_Write("j", "NUSED shared limit used set to " + lp_a);
        return true;
    }

    if (lp_cmd == "nres") {
        GhostOps_Ce0_NresLine();
        return true;
    }

    if (lp_cmd == "nresmon") {
        go_nrMon = TriggerCreate("GhostOps_Ce0_NresTick");
        TriggerAddEventTimePeriodic(go_nrMon, 30.0, c_timeGame);
        GhostOps_Ce0_NresLine();
        return true;
    }

    if (lp_cmd == "nharv") {
        // nharv <n>: n SCVs are ordered to harvest from the first Refinery of the player (the number of gas workers of the measurement)
        lv_cc = GhostOps_Ce0_First("Refinery");
        lv_i = 1;
        while (lv_i <= StringToInt(lp_a)) {
            UnitIssueOrder(UnitGroupUnit(UnitGroup("SCV", 1, RegionEntireMap(), GhostOps_Ce0_Live(), 0), lv_i), OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), lv_cc), c_orderQueueReplace);
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "NHARV harvest order sent to " + lp_a + " SCVs");
        return true;
    }

    if (lp_cmd == "nhp") {
        // the real health of the Zerg types of the installed game (the Snipe numbers are judged against these, not against any table)
        lv_t = "Zergling Baneling Roach Hydralisk Mutalisk Ultralisk Queen Infestor Corruptor BroodLord Overlord Drone";
        lv_i = 1;
        while (lv_i <= 12) {
            UnitCreate(1, StringWord(lv_t, lv_i), 0, 6, Point(20.0 + (3.0 * lv_i), 20.0), 270.0);
            GhostOps_Ce0_Write("j", "NHP " + StringWord(lv_t, lv_i) + " life " + FixedToString(UnitGetPropertyFixed(UnitLastCreated(), c_unitPropLife, c_unitPropCurrent), 0) + "/" + FixedToString(UnitGetPropertyFixed(UnitLastCreated(), c_unitPropLifeMax, c_unitPropCurrent), 0));
            UnitRemove(UnitLastCreated());
            lv_i += 1;
        }

        return true;
    }

    if (lp_cmd == "nabil") {
        lv_scv = GhostOps_Ce0_First("Firebat");
        lv_t = "";
        lv_i = 0;
        while (lv_i < UnitAbilityCount(lv_scv)) {
            lv_t = lv_t + UnitAbilityGet(lv_scv, lv_i) + " ";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "NABIL firebat abilities: " + lv_t);
        GhostOps_Ce0_Write("j", "NABIL place exists " + IntToString(GhostOps_Ce0_B(UnitAbilityExists(lv_scv, "GhostOpsPlaceContainer"))) + " enabled " + IntToString(GhostOps_Ce0_B(UnitAbilityCheck(lv_scv, "GhostOpsPlaceContainer", true))) + " range " + FixedToString(UnitAbilityEffectInstantGetRange(lv_scv, "GhostOpsPlaceContainer"), 1));
        GhostOps_Ce0_Write("j", "NABIL type " + UnitGetType(lv_scv) + " owner " + IntToString(UnitGetOwner(lv_scv)) + " cooldown-free valid-move " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(lv_scv), 2.0, 0.0))))));
        return true;
    }

    if (lp_cmd == "ncu") {
        // direct creation (no effect, no ability) of the barrel and of the container; catalog fields of the container
        lv_scv = GhostOps_Ce0_First("Firebat");
        GhostOps_Ce0_Write("j", "NCU catalog container LifeMax " + CatalogFieldValueGet(c_gameCatalogUnit, "GhostOpsFuelContainer", "LifeMax", 1) + " | barrel LifeMax " + CatalogFieldValueGet(c_gameCatalogUnit, "ExplodingBarrelLarge", "LifeMax", 1) + " | abil range " + CatalogFieldValueGet(c_gameCatalogAbil, "GhostOpsPlaceContainer", "Range", 1));
        UnitCreate(1, "ExplodingBarrelLarge", 0, 0, PointWithOffset(UnitGetPosition(lv_scv), -3.0, 0.0), 270.0);
        GhostOps_Ce0_Write("j", "NCU barrel made " + IntToString(GhostOps_Ce0_B(UnitLastCreated() != null)));
        UnitCreate(1, "GhostOpsFuelContainer", 0, 1, PointWithOffset(UnitGetPosition(lv_scv), -2.0, 2.0), 270.0);
        GhostOps_Ce0_Write("j", "NCU container made " + IntToString(GhostOps_Ce0_B(UnitLastCreated() != null)) + " effect " + CatalogFieldValueGet(c_gameCatalogEffect, "GhostOpsContainerCreate", "SpawnUnit", 1));
        return true;
    }

    if (lp_cmd == "ncat") {
        // which stock units exist in the data of THIS map (the container needs a parent / model that exists): life of a few candidates, models by their variation count
        lv_t = "ExplodingBarrelLarge ExplodingBarrelMedium PalletGas PalletMinerals TerrazineCanister TankerTruck GasCanister CargoTruckUnitBarrels AutoTurret Hut MineralField Refinery SupplyDepot";
        lv_i = 1;
        while (lv_i <= 13) {
            GhostOps_Ce0_Write("j", "NCAT unit " + StringWord(lv_t, lv_i) + " LifeMax [" + CatalogFieldValueGet(c_gameCatalogUnit, StringWord(lv_t, lv_i), "LifeMax", 1) + "]");
            lv_i += 1;
        }

        return true;
    }

    if (lp_cmd == "ncu2") {
        // does UnitCreate work at all at this place, for a known unit and for ours (counted by type afterwards, not by UnitLastCreated)
        lv_scv = GhostOps_Ce0_First("Firebat");
        lv_t = "Marine SupplyDepot ExplodingBarrelLarge GhostOpsFuelContainer";
        lv_i = 1;
        while (lv_i <= 4) {
            UnitCreate(1, StringWord(lv_t, lv_i), 0, 1, PointWithOffset(UnitGetPosition(lv_scv), -2.0, 1.0 + (2.5 * lv_i)), 270.0);
            GhostOps_Ce0_Write("j", "NCU2 " + StringWord(lv_t, lv_i) + " alive of any owner " + IntToString(UnitGroupCount(UnitGroup(StringWord(lv_t, lv_i), c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)));
            lv_i += 1;
        }

        return true;
    }

    if (lp_cmd == "nkillref") {
        UnitKill(GhostOps_Ce0_First("Refinery"));
        GhostOps_Ce0_Write("j", "NKILLREF refinery killed; refinery allowed to build " + IntToString(GhostOps_Ce0_B(TechTreeUnitIsAllowed(1, "Refinery"))));
        return true;
    }

    if (lp_cmd == "nunlock") {
        TechTreeUnitAllow(1, "GhostOpsFuelContainer", true);
        GhostOps_Ce0_Write("j", "NUNLOCK container allowed again; unit allowed " + IntToString(GhostOps_Ce0_B(TechTreeUnitIsAllowed(1, "GhostOpsFuelContainer"))));
        return true;
    }

    if (lp_cmd == "ncreate") {
        // the effect alone (no ability, no order): is the unit / the effect itself fine?
        lv_scv = GhostOps_Ce0_First("Firebat");
        UnitCreateEffectPoint(lv_scv, "GhostOpsContainerCreate", PointWithOffset(UnitGetPosition(lv_scv), StringToFixed(lp_a), StringToFixed(lp_b)));
        GhostOps_Ce0_Write("j", "NCREATE effect run; containers alive " + IntToString(UnitGroupCount(UnitGroup("GhostOpsFuelContainer", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "norders") {
        lv_scv = GhostOps_Ce0_First("Firebat");
        lv_t = "orders " + IntToString(UnitOrderCount(lv_scv));
        if (UnitOrderCount(lv_scv) > 0) {
            lv_t = lv_t + " first " + AbilityCommandGetAbility(OrderGetAbilityCommand(UnitOrder(lv_scv, 0)));
        }

        GhostOps_Ce0_Write("j", "NORDERS " + lv_t + " pos " + FixedToString(PointGetX(UnitGetPosition(lv_scv)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_scv)), 1));
        return true;
    }

    if (lp_cmd == "nstat") {
        // prepared detonations: the numbers that matter (gas, limit, placed, blasts, convoy state) and the ghosts / firebats
        GhostOps_Ce0_Write("j", "NSTAT gas " + IntToString(GhostOps_Hanson_Gas()) + " used " + IntToString(go_hContUsed) + "/" + IntToString(go_hContLimit) + " placed " + IntToString(go_hContN) + " blasts " + IntToString(go_hContBlasts) + " cmd " + IntToString(go_hCmdState) + " story " + IntToString(go_hStoryState));
        GhostOps_Ce0_Write("j", "NSTAT convoy sent " + IntToString(go_hSent) + " escort " + IntToString(go_hEscort) + " phase " + IntToString(go_hPhase) + " saved " + IntToString(go_hSaved) + " killed " + IntToString(go_hKilled) + " gate " + IntToString(GhostOps_Hanson_B(go_hGateOpen)));
        if (go_hKitOn) {
            GhostOps_Ce0_Write("j", "NSTAT kits ordered " + IntToString(go_hKitOrdered) + " spent " + IntToString(go_hKitSpent) + " consumed " + IntToString(go_hKitConsumed) + " reserved " + IntToString(GhostOps_Hanson_KitsReserved()) + " left " + IntToString(GhostOps_Hanson_KitsLeft()));
        }

        GhostOps_Ce0_Write("j", "NSTAT ghosts " + IntToString(UnitGroupCount(UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)) + " firebats " + IntToString(UnitGroupCount(UnitGroup("Firebat", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)) + " containers alive " + IntToString(UnitGroupCount(UnitGroup("GhostOpsFuelContainer", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)));
        return true;
    }

    if (lp_cmd == "nallow") {
        // nallow: the turret is allowed by hand and the order validity is measured at once, then with each other build index
        TechTreeUnitAllow(1, "MissileTurret", true);
        lv_scv = GhostOps_Ce0_First("SCV");
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        lv_p = PointWithOffset(UnitGetPosition(lv_cc), -2.0, -6.0);
        lv_t = "NALLOW scv " + UnitGetType(lv_scv) + " cc " + UnitGetType(lv_cc);
        lv_i = 0;
        while (lv_i < 8) {
            lv_t = lv_t + " " + IntToString(lv_i) + "=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", lv_i), lv_p))));
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t + " | turret unit exists in catalog: " + CatalogFieldValueGet(c_gameCatalogUnit, "MissileTurret", "CostResource[Minerals]", 1));
        return true;
    }

    if (lp_cmd == "nkits") {
        GhostOps_Ce0_Write("j", "NKITS ordered " + IntToString(go_hKitOrdered) + " spent " + IntToString(go_hKitSpent) + " consumed " + IntToString(go_hKitConsumed) + " reserved " + IntToString(GhostOps_Hanson_KitsReserved()) + " left " + IntToString(GhostOps_Hanson_KitsLeft()));
        return true;
    }

    if (lp_cmd == "killhurt") {
        // killhurt <slot>: the unfinished turret of the probe slot is damaged (life 1) and, 0.6 s later, killed: a DESTROYED construction (a plain kill looks like a cancel)
        lv_i = StringToInt(lp_a);
        if (lv_i < 0) {
            // -1: the last probe slot that is under construction
            lv_i = 7;
            while ((lv_i >= 0) && (go_kState[lv_i] != 1)) {
                lv_i -= 1;
            }
        }

        if ((lv_i >= 0) && (lv_i < 8) && (go_kUnit[lv_i] != null) && UnitIsAlive(go_kUnit[lv_i])) {
            UnitSetPropertyFixed(go_kUnit[lv_i], c_unitPropLife, 1.0);
            Wait(0.6, c_timeGame);
            UnitKill(go_kUnit[lv_i]);
            GhostOps_Ce0_Write("j", "KILLHURT slot " + lp_a + " damaged and killed");
        }

        return true;
    }

    if (lp_cmd == "ngas") {
        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, StringToInt(lp_a));
        GhostOps_Ce0_Write("j", "NGAS gas set to " + IntToString(GhostOps_Hanson_Gas()));
        return true;
    }

    if (lp_cmd == "nplace") {
        // nplace <dx> <dy>: the first Firebat is ordered to place a container at the offset from himself (the real ability order)
        lv_scv = GhostOps_Ce0_First("Firebat");
        UnitIssueOrder(lv_scv, OrderTargetingPoint(AbilityCommand("GhostOpsPlaceContainer", 0), PointWithOffset(UnitGetPosition(lv_scv), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "NPLACE ordered at offset " + lp_a + "," + lp_b + " from the firebat at " + FixedToString(PointGetX(UnitGetPosition(lv_scv)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_scv)), 1) + " ability enabled valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("GhostOpsPlaceContainer", 0), PointWithOffset(UnitGetPosition(lv_scv), StringToFixed(lp_a), StringToFixed(lp_b)))))));
        return true;
    }

    if (lp_cmd == "nrifle") {
        // nrifle <i> <ghost>: the ordinary attack order (the rifle, not Snipe) of a Ghost on the i-th container
        UnitIssueOrder(GhostOps_SquadUnit(StringToInt(lp_b)), OrderTargetingUnit(AbilityCommand("attack", 0), go_hCont[StringToInt(lp_a)]), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "NRIFLE ghost " + lp_b + " ordered to attack container " + lp_a);
        return true;
    }

    if (lp_cmd == "nfast") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_FastCancel"), true, false);
        return true;
    }

    if (lp_cmd == "ncancel") {
        // the player cancels the placement (Esc / right click = another order): the Firebat is ordered to stop
        UnitIssueOrder(GhostOps_Ce0_First("Firebat"), Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "NCANCEL stop ordered");
        return true;
    }

    if (lp_cmd == "nmodels") {
        // a row of stock units (owner 0) in front of the camera: which of them have a real model in this install and which show the grey placeholder dome
        lv_scv = GhostOps_Ce0_First("Firebat");
        lv_p = PointWithOffset(UnitGetPosition(lv_scv), -4.0, 6.0);
        lv_t = "GasCanister PalletGas ExplodingBarrelLarge TerrazineCanister GhostOpsFuelContainer SupplyDepot ColonistHut";
        lv_i = 1;
        while (lv_i <= 7) {
            UnitCreate(1, StringWord(lv_t, lv_i), 0, 0, PointWithOffset(lv_p, 2.5 * lv_i, 0.0), 270.0);
            lv_i += 1;
        }

        CameraPan(1, PointWithOffset(lv_p, 10.0, 0.0), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "NMODELS row of " + lv_t);
        return true;
    }

    if (lp_cmd == "nselfb") {
        // the first Firebat is selected (like a click on him) and the camera is centred on him: the next real key / mouse actions are given from the player's side
        lv_scv = GhostOps_Ce0_First("Firebat");
        UnitClearSelection(1);
        UnitSelect(lv_scv, 1, true);
        CameraPan(1, UnitGetPosition(lv_scv), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "NSELFB firebat selected at " + FixedToString(PointGetX(UnitGetPosition(lv_scv)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_scv)), 1));
        return true;
    }

    if (lp_cmd == "nconts") {
        lv_i = 0;
        lv_t = "";
        while (lv_i < go_hContN) {
            if (UnitIsAlive(go_hCont[lv_i])) {
                lv_t = lv_t + "(" + FixedToString(PointGetX(UnitGetPosition(go_hCont[lv_i])), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_hCont[lv_i])), 1) + ") ";
            }

            lv_i += 1;
        }

        lv_scv = GhostOps_Ce0_First("Firebat");
        GhostOps_Ce0_Write("j", "NCONTS alive " + lv_t + "| firebat at " + FixedToString(PointGetX(UnitGetPosition(lv_scv)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(lv_scv)), 1) + " orders " + IntToString(UnitOrderCount(lv_scv)));
        return true;
    }

    if (lp_cmd == "nselmarine") {
        // nselmarine <i>: an own Marine 3 cells from container i is created and SELECTED (the player then gives the attack command with the real keys / mouse); the camera is on the container
        lv_p = UnitGetPosition(go_hCont[StringToInt(lp_a)]);
        UnitCreate(1, "Marine", 0, 1, PointWithOffset(lv_p, -3.0, 0.0), 270.0);
        UnitClearSelection(1);
        UnitSelect(UnitLastCreated(), 1, true);
        CameraPan(1, lv_p, 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "NSELMARINE marine selected, camera on container " + lp_a);
        return true;
    }

    if (lp_cmd == "nmarine") {
        // nmarine <i>: an own Marine (not a Ghost) is created 3 cells from container i and ordered to attack it with the ordinary attack
        lv_p = UnitGetPosition(go_hCont[StringToInt(lp_a)]);
        UnitCreate(1, "Marine", 0, 1, PointWithOffset(lv_p, -3.0, 0.0), 270.0);
        lv_scv = UnitLastCreated();
        UnitIssueOrder(lv_scv, OrderTargetingUnit(AbilityCommand("attack", 0), go_hCont[StringToInt(lp_a)]), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "NMARINE marine ordered to attack container " + lp_a + " valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingUnit(AbilityCommand("attack", 0), go_hCont[StringToInt(lp_a)])))));
        return true;
    }

    if (lp_cmd == "ncam") {
        CameraPan(1, UnitGetPosition(go_hCont[StringToInt(lp_a)]), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "NCAM camera on container " + lp_a);
        return true;
    }

    if (lp_cmd == "nshoot") {
        // nshoot <i>: Ghost 0 shoots the i-th placed container (the real Snipe order)
        UnitIssueOrder(GhostOps_SquadUnit(0), OrderTargetingUnit(AbilityCommand("Snipe", 0), go_hCont[StringToInt(lp_a)]), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "NSHOOT ghost 0 ordered to snipe container " + lp_a + " valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(GhostOps_SquadUnit(0), OrderTargetingUnit(AbilityCommand("Snipe", 0), go_hCont[StringToInt(lp_a)])))));
        return true;
    }

    if (lp_cmd == "enter") {
        // the Ghost walks into the settlement: the escort phase starts (as in the scripted test)
        UnitSetPosition(GhostOps_SquadUnit(0), RegionGetCenter(RegionFromId(29)), false);
        GhostOps_Ce0_Write("j", "ENTER settlement");
        return true;
    }

    if (lp_cmd == "click") {
        TriggerExecute(go_hClickTrig, true, false);
        GhostOps_Ce0_Write("j", "CLICK executed (trigger, not the real button)");
        return true;
    }

    if (lp_cmd == "kitinit") {
        // kitinit N: N kits ordered; the gate allows the turret while a kit is free; the cost of the turret is set to 0 for this test
        go_kOrdered = StringToInt(lp_a);
        GhostOps_Ce0_KitGate();
        lv_t = "KITINIT set cost ok=" + IntToString(GhostOps_Ce0_B(CatalogFieldValueSet(c_gameCatalogUnit, "MissileTurret", "CostResource[Minerals]", 1, "0")));
        lv_t = lv_t + " cost now=" + CatalogFieldValueGet(c_gameCatalogUnit, "MissileTurret", "CostResource[Minerals]", 1);
        GhostOps_Ce0_Write("j", lv_t + " | " + GhostOps_Ce0_KitText());
        return true;
    }

    if (lp_cmd == "ebay") {
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        UnitCreate(1, "EngineeringBay", 0, 1, PointWithOffset(UnitGetPosition(lv_cc), -9.0, 7.0), 270.0);
        GhostOps_Ce0_Write("j", "EBAY created for the test fixture (the requirement of the turret)");
        return true;
    }

    if (lp_cmd == "abil") {
        // which TerranBuild index builds the turret, and is the order valid
        lv_scv = GhostOps_Ce0_First("SCV");
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        lv_p = PointWithOffset(UnitGetPosition(lv_cc), 8.0, -6.0);
        lv_i = 0;
        go_kBuildIdx = -1;
        while (lv_i < 24) {
            lv_t = CatalogFieldValueGet(c_gameCatalogAbil, "TerranBuild", "InfoArray[" + IntToString(lv_i) + "].Unit", 1);
            if (lv_t == "MissileTurret") {
                go_kBuildIdx = lv_i;
            }

            lv_i += 1;
        }

        lv_t = "ABIL turret build index=" + IntToString(go_kBuildIdx);
        if (go_kBuildIdx >= 0) {
            lv_t = lv_t + " order valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", go_kBuildIdx), lv_p))));
            lv_t = lv_t + " cost=" + CatalogFieldValueGet(c_gameCatalogUnit, "MissileTurret", "CostResource[Minerals]", 1);
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "grid") {
        // which places near the Command Center accept a turret order (for the next build commands)
        lv_scv = GhostOps_Ce0_First("SCV");
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        lv_t = "GRID valid dx,dy:";
        lv_i = 0;
        while (lv_i < 40) {
            lv_p = PointWithOffset(UnitGetPosition(lv_cc), -14.0 + 4.0 * IntToFixed(lv_i % 8), -14.0 + 4.0 * IntToFixed(lv_i / 8));
            if (UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", go_kBuildIdx), lv_p))) {
                lv_t = lv_t + " " + FixedToString(-14.0 + 4.0 * IntToFixed(lv_i % 8) - 8.0, 0) + "," + FixedToString(-14.0 + 4.0 * IntToFixed(lv_i / 8) + 6.0, 0);
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", lv_t);
        return true;
    }

    if (lp_cmd == "build") {
        // build [dx dy]: the first SCV builds a turret near the Command Center
        lv_scv = GhostOps_Ce0_First("SCV");
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        lv_p = PointWithOffset(UnitGetPosition(lv_cc), 8.0 + StringToFixed(lp_a), -6.0 + StringToFixed(lp_b));
        if (go_kBuildIdx < 0) {
            GhostOps_Ce0_Write("j", "BUILD refused: run abil first");
            return true;
        }

        lv_t = "BUILD order valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", go_kBuildIdx), lv_p))));
        GhostOps_Ce0_Write("j", lv_t + " kits free=" + IntToString(GhostOps_Ce0_KitFree()));
        UnitIssueOrder(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", go_kBuildIdx), lv_p), c_orderQueueReplace);
        return true;
    }

    if ((lp_cmd == "buildcancel") || (lp_cmd == "buildkill")) {
        // buildcancel|buildkill <delay>: the first SCV starts a turret at (-10,0), after <delay> game seconds the unfinished turret is cancelled
        // (the structure's own cancel command, tried as BuildInProgress 0 and 1) or killed; everything is measured by the progress / died events
        lv_scv = GhostOps_Ce0_First("SCV");
        lv_cc = GhostOps_Ce0_First("CommandCenter");
        lv_p = PointWithOffset(UnitGetPosition(lv_cc), -2.0, -6.0);
        UnitIssueOrder(lv_scv, OrderTargetingPoint(AbilityCommand("TerranBuild", go_kBuildIdx), lv_p), c_orderQueueReplace);
        Wait(3.0, c_timeGame);
        lv_i = 7;
        while ((lv_i >= 0) && ((go_kState[lv_i] != 1) || (go_kUnit[lv_i] == null))) {
            lv_i -= 1;
        }

        if (lv_i < 0) {
            GhostOps_Ce0_Write("j", "BUILDCANCEL: no turret under construction after 3 s");
            return true;
        }

        Wait(StringToFixed(lp_a), c_timeGame);
        lv_t = "BUILDCANCEL slot " + IntToString(lv_i) + " valid BuildInProgress 0=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_kUnit[lv_i], Order(AbilityCommand("BuildInProgress", 0)))));
        lv_t = lv_t + " 1=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_kUnit[lv_i], Order(AbilityCommand("BuildInProgress", 1)))));
        GhostOps_Ce0_Write("j", lv_t);
        if (lp_cmd == "buildkill") {
            UnitKill(go_kUnit[lv_i]);
        }
        else if (UnitOrderIsValid(go_kUnit[lv_i], Order(AbilityCommand("BuildInProgress", 1)))) {
            UnitIssueOrder(go_kUnit[lv_i], Order(AbilityCommand("BuildInProgress", 1)), c_orderQueueReplace);
        }
        else {
            UnitIssueOrder(go_kUnit[lv_i], Order(AbilityCommand("BuildInProgress", 0)), c_orderQueueReplace);
        }

        return true;
    }

    if (lp_cmd == "sel") {
        // sel <slot>: the camera goes to the turret and it is selected (then the Escape key = the player's real cancel of a building under construction)
        lv_i = StringToInt(lp_a);
        if (lv_i < 0) {
            lv_i = 7;
            while ((lv_i >= 0) && (go_kState[lv_i] != 1)) {
                lv_i -= 1;
            }
        }

        if ((lv_i >= 0) && (lv_i < 8) && (go_kUnit[lv_i] != null) && UnitIsAlive(go_kUnit[lv_i])) {
            CameraPan(1, UnitGetPosition(go_kUnit[lv_i]), 0.0, -1.0, 10.0, false);
            UnitSelect(go_kUnit[lv_i], 1, true);
            GhostOps_Ce0_Write("j", "SEL slot " + lp_a);
        }

        return true;
    }

    if (lp_cmd == "cancelbuild") {
        // the player's cancel of the unfinished turret (the command of the structure itself)
        lv_i = StringToInt(lp_a);
        if (lv_i < 0) {
            lv_i = 7;
            while ((lv_i >= 0) && (go_kState[lv_i] != 1)) {
                lv_i -= 1;
            }
        }

        if ((lv_i >= 0) && (lv_i < 8) && (go_kUnit[lv_i] != null) && UnitIsAlive(go_kUnit[lv_i])) {
            UnitIssueOrder(go_kUnit[lv_i], Order(AbilityCommand("CancelBuilding", 0)), c_orderQueueReplace);
            GhostOps_Ce0_Write("j", "CANCEL ordered for slot " + lp_a + " (CancelBuilding 0)");
        }

        return true;
    }

    if (lp_cmd == "killturret") {
        lv_i = StringToInt(lp_a);
        if ((lv_i >= 0) && (lv_i < 8) && (go_kUnit[lv_i] != null) && UnitIsAlive(go_kUnit[lv_i])) {
            UnitKill(go_kUnit[lv_i]);
            GhostOps_Ce0_Write("j", "KILL ordered for slot " + lp_a);
        }

        return true;
    }

    return false;
}
