//==================================================================================================
// GhostOps adapter: The Outlaws (TRaynor02). All mission specific knowledge lives here.
// Player 1 is the human player. The mission calls GhostOps_OnMissionStart() right after it
// has started gt_StartGame, i.e. after the intro sequence (see adapter.json for the anchor).
// The other hooks of adapter.json call the GhostOps_Tac_* functions of the tactical module; they do
// nothing unless the tactical variant is built (go_tacEnabled).
//
// Tactical variant, story scene (all in game time, delays from the configuration):
//   stage 0  wait first_delay, then (after the original talk has left the queue) the Adjutant message "Alarm"
//   stage 1  Adjutant message on screen
//   stage 2  wait second_delay after its end
//   stage 8  Swann message queued (it waits behind any original talk); when it really starts the transport is created
//   stage 3  Swann message + the transport with the two Ghosts flies in (created at the start of the message, Ghosts inside)
//   stage 4  unloaded: text, task, tips; the transport leaves
//   stage 5  transport on its way out, removed at the edge of the map
//   stage 7  done
// The stage is a global (saved with the game); a periodic trigger drives it, so a loaded game goes on from the same stage.
// The messages are portrait transmissions with a short voice clip each (Adjutant "Alarm", Swann, one Ghost line; clips are imported by the
// build, config key audio.clips); the details stay in the text and the on-screen duration is explicit, so it does not depend on the clip.
// stage 2 starts when the Adjutant transmission is over (portrait, text, sound), the Swann message follows second_delay seconds later.
//==================================================================================================
trigger go_scTrig;
unit go_scShip;
point go_scLanding;
bool go_scBusy;
fixed go_scMsgEnd;

// The lines are shown in the subtitle message area by the script itself: a transmission with a sound link shows its subtitle only when the
// player's subtitle option is on (it is off by default), and the explanation must never depend on that option.
void GhostOps_Scene_Say (text lp_speaker, text lp_line) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, lp_speaker + StringToText(": ") + lp_line);
}

// The voice clips use the same wrapper as the original talks: unit voices are lowered while a clip plays.
void GhostOps_Scene_VoiceBegin () {
    libCamp_gf_SetAllSoundChannelVolumesCampaign(1);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
}

void GhostOps_Scene_VoiceEnd () {
    libCamp_gf_SetAllSoundChannelVolumesCampaign(2);
}

// A free place for the transport on the start base: the first of the map's own drop points without a structure of the player nearby.
point GhostOps_Scene_Landing () {
    int lv_i;
    point lv_p;
    point lv_first;

    lv_first = PointFromId(32);
    lv_i = 0;
    while (lv_i < 6) {
        if (lv_i == 0) {
            lv_p = PointFromId(32);
        }
        else if (lv_i == 1) {
            lv_p = PointFromId(688);
        }
        else if (lv_i == 2) {
            lv_p = PointFromId(1025);
        }
        else if (lv_i == 3) {
            lv_p = PointFromId(1105);
        }
        else if (lv_i == 4) {
            lv_p = PointFromId(1112);
        }
        else {
            lv_p = PointFromId(1110);
        }

        if (UnitGroupCount(UnitGroup(null, 1, RegionCircle(lv_p, 3.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) == 0) {
            return lv_p;
        }

        lv_i += 1;
    }

    return lv_first;
}

void GhostOps_Scene_AddTips (int lp_from, int lp_to) {
    int lv_i;

    lv_i = lp_from;
    while (lv_i <= lp_to) {
        if (lv_i == 1) {
            HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsTac_Tip1Title"), StringExternal("Param/Value/GhostOpsTac_Tip1Text"), StringExternal("Param/Value/GhostOpsTac_Tip1Title"), "Assets\\Textures\\ui_icon_attention.dds");
        }
        else if (lv_i == 2) {
            HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsTac_Tip2Title"), StringExternal("Param/Value/GhostOpsTac_Tip2Text"), StringExternal("Param/Value/GhostOpsTac_Tip2Title"), "Assets\\Textures\\ui_icon_attention.dds");
        }
        else if (lv_i == 3) {
            HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsTac_Tip3Title"), StringExternal("Param/Value/GhostOpsTac_Tip3Text"), StringExternal("Param/Value/GhostOpsTac_Tip3Title"), "Assets\\Textures\\ui_icon_attention.dds");
        }
        else {
            HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsTac_Tip4Title"), StringExternal("Param/Value/GhostOpsTac_Tip4Text"), StringExternal("Param/Value/GhostOpsTac_Tip4Title"), "Assets\\Textures\\ui_icon_attention.dds");
        }

        lv_i += 1;
    }
}

void GhostOps_Scene_SendTransport ();

// Messages queue behind the original talk (TriggerQueueEnter) and never interrupt it. Every scene plays lines of the line table (config tactical.lines): the speaker's
// portrait, the text in the subtitle area (larger style for explanations) and the portrait's talking animation for the line's seconds (a voice clip of the line, when the
// config names one, drives the lip-sync instead of the silent drivers).
void GhostOps_Line (string lp_id) {
    int lv_i;
    int lv_k;
    int lv_grp;
    string lv_spk;
    string lv_model;
    string lv_name;

    lv_i = -1;
    lv_k = 0;
    while (lv_k < go_lnCount) {
        if (go_lnId[lv_k] == lp_id) {
            lv_i = lv_k;
        }

        lv_k += 1;
    }

    if (lv_i < 0) {
        return;
    }

    lv_spk = go_lnSpk[lv_i];
    if (lv_spk == "raynor") {
        lv_model = "RaynorCommanderPortrait";
        lv_grp = 0;
        lv_name = "RaynorName";
    }
    else if (lv_spk == "swann") {
        lv_model = "SwannPortrait";
        lv_grp = 1;
        lv_name = "SwannName";
    }
    else if (lv_spk == "adjutant") {
        lv_model = "AdjutantPortrait_L";
        lv_grp = 4;
        lv_name = "AlertTitle";
    }
    else {
        lv_model = "GhostPortrait";
        lv_grp = 5;
        lv_name = "GhostName";
    }

    GhostOps_Scene_Say(StringExternal("Param/Value/GhostOpsTac_" + lv_name), StringExternal("Param/Value/GhostOpsTac_L_" + lp_id));
    if (go_lnClip[lv_i] != "") {
        GhostOps_Scene_VoiceBegin();
        GhostOps_ClipStep(lv_model, lv_grp, go_lnClip[lv_i], go_lnSec[lv_i]);
        GhostOps_Scene_VoiceEnd();
    }
    else {
        GhostOps_Talk(lv_model, lv_grp, go_lnSec[lv_i]);
    }
}

bool GhostOps_Scene_AlertMsg (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    go_scBusy = true;
    GhostOps_Tac_Log("scene: alert message on screen");
    GhostOps_Line("ALERT_CLIP");
    GhostOps_Line("ALERT_TEXT");
    go_scBusy = false;
    if (go_tacScStage == 1) {
        go_tacScStage = 2;
        go_tacScT = GameGetMissionTime();
        GhostOps_Scene_AddTips(1, 1);
    }

    GhostOps_Tac_Log("scene: alert message finished (the pause before Swann starts now)");
    TriggerQueueExit();
    return true;
}

// Raynor after the alarm: what happened and what stays (queued behind the original talk, inside the pause before Swann; said once).
bool GhostOps_Scene_RaynorMsg (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Tac_Log("scene: Raynor message on screen");
    GhostOps_Line("RAYNOR_INFECT");
    GhostOps_Line("RAYNOR_RESOURCES");
    GhostOps_Tac_Log("scene: Raynor message finished");
    TriggerQueueExit();
    return true;
}

bool GhostOps_Scene_SwannMsg (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    if (go_tacScStage == 8) {
        go_tacScStage = 3;
        go_tacScT = GameGetMissionTime();
        GhostOps_Scene_SendTransport();
    }

    GhostOps_Tac_Log("scene: Swann message on screen");
    GhostOps_Line("SWANN_ARRIVAL");
    GhostOps_Tac_Log("scene: Swann message finished");
    TriggerQueueExit();
    return true;
}

// One short Ghost line when the unloading is over (said once for the pair; go_tacGhostSaid is set by the caller), then the two roles.
bool GhostOps_Scene_GhostMsg (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Tac_Log("scene: Ghost line on screen");
    GhostOps_Line("GHOST_READY");
    GhostOps_Line("GHOST_ROLES");
    go_tacFindT = GameGetMissionTime();
    go_tacGhostDone = true;
    GhostOps_Tac_Log("scene: Ghost line finished");
    TriggerQueueExit();
    return true;
}

// "Find the rebels": after the landing scenes, unless the original discovery of the rebels has already happened. The position is NOT shown (no ping, no fog reveal).
bool GhostOps_Scene_FindMsg (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    if ((go_tacFindSt == 2) || go_tacRebelsFound) {
        go_tacFindSt = 2;
        TriggerQueueExit();
        return true;
    }

    GhostOps_Tac_Log("scene: find the rebels");
    if (!go_tacObjFindMade) {
        go_tacObjFindMade = true;
        ObjectiveCreate(StringExternal("Param/Value/GhostOpsTac_FindObjectiveTitle"), StringExternal("Param/Value/GhostOpsTac_FindObjectiveText"), c_objectiveStateActive, false);
        go_tacObjFind = ObjectiveLastCreated();
    }

    GhostOps_Line("RAYNOR_FIND");
    go_tacFindSt = 2;
    TriggerQueueExit();
    return true;
}

// Called by the ORIGINAL discovery of the rebels (gt_RebelsTriggeredQ): the "find" task is done, the old request is never said afterwards.
void GhostOps_Scene_OnRebelsFound () {
    if (!go_tacEnabled) {
        return;
    }

    go_tacRebelsFound = true;
    if (go_tacObjFindMade) {
        ObjectiveSetState(go_tacObjFind, c_objectiveStateCompleted);
    }

    GhostOps_Tac_Log("scene: rebels found (original trigger)");
}

// The rebels were handed over (the original dialogue is over, this scene is queued behind it): Raynor says what to do with the rescued units and the Barracks.
// The home base is shown on the minimap, then the Barracks; nothing is moved for the player.
unit GhostOps_Scene_RebelBarracks () {
    unitgroup lv_g;
    int lv_n;
    int lv_i;
    unit lv_u;
    unit lv_best;
    fixed lv_d;
    fixed lv_bestD;

    lv_g = UnitGroup("Barracks", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
    lv_best = null;
    lv_bestD = -1.0;
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), Point(go_tacZoneX, go_tacZoneY));
        if (lv_d > lv_bestD) {
            lv_bestD = lv_d;
            lv_best = lv_u;
        }

        lv_i += 1;
    }

    if ((lv_best == null) || (lv_bestD < (go_tacZoneR + 4.0))) {
        return null;
    }

    // the lift-off and the landing are standard abilities of the Barracks: make sure the campaign tech rules do not hide them
    TechTreeAbilityAllow(1, AbilityCommand("BarracksLiftOff", 0), true);
    TechTreeAbilityAllow(1, AbilityCommand("BarracksLand", 0), true);
    return lv_best;
}

bool GhostOps_Scene_RebelHintMsg (bool lp_testConds, bool lp_runActions) {
    unit lv_barracks;

    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    if (go_tacMeetSt == 2) {
        TriggerQueueExit();
        return true;
    }

    GhostOps_Tac_Log("scene: rebel meeting, the original talk is over");
    lv_barracks = GhostOps_Scene_RebelBarracks();
    GhostOps_Line("REBEL_MEET_1");
    MinimapPing(PlayerGroupAll(), Point(go_tacZoneX, go_tacZoneY), go_tacHintPing, Color(0.00, 100.00, 40.00));
    if (lv_barracks != null) {
        GhostOps_Line("REBEL_MEET_2");
        MinimapPing(PlayerGroupAll(), UnitGetPosition(lv_barracks), go_tacHintPing, Color(100.00, 70.00, 0.00));
    }

    go_tacMeetSt = 2;
    go_tacMeetT = GameGetMissionTime();
    GhostOps_Tac_Log("scene: rebel meeting finished");
    TriggerQueueExit();
    return true;
}

// Hook of the original hand-over dialogue (gt_RebelsRescuedQ): once, after the original lines.
void GhostOps_Scene_OnRebelsRescued () {
    if (!go_tacEnabled || !go_tacHints || go_tacHintSaid) {
        return;
    }

    go_tacHintSaid = true;
    GhostOps_Scene_OnRebelsFound();
    go_tacMeetSt = 1;
    go_tacMeetT = GameGetMissionTime();
    go_tacRescueT = go_tacMeetT;
    TriggerExecute(TriggerCreate("GhostOps_Scene_RebelHintMsg"), true, false);
}

// Rescued fighters (units, not buildings) that are alive / stand in the defence zone with a margin.
int GhostOps_Scene_RescuedAlive (bool lp_inZoneOnly) {
    int lv_n;
    int lv_i;
    int lv_c;
    unit lv_u;

    lv_c = 0;
    lv_n = UnitGroupCount(go_tacRescued, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_u = UnitGroupUnit(go_tacRescued, lv_i);
        if ((lv_u != null) && UnitIsAlive(lv_u) && !UnitFilterMatch(lv_u, 1, UnitFilter((1 << c_targetFilterStructure), 0, 0, 0))) {
            if (!lp_inZoneOnly || (DistanceBetweenPoints(UnitGetPosition(lv_u), Point(go_tacZoneX, go_tacZoneY)) <= (go_tacZoneR + 3.0))) {
                lv_c += 1;
            }
        }

        lv_i += 1;
    }

    return lv_c;
}

// The plan is told when the rescued fighters stand under the cover of our base (enough of them) and nobody fights there for a few seconds; when they are all dead
// after a short pause; and anyway after the maximum wait (never waiting for ever).
bool GhostOps_Scene_PlanReady (fixed lp_now) {
    int lv_r;
    int lv_near;
    int lv_need;
    bool lv_calm;

    lv_r = GhostOps_Scene_RescuedAlive(false);
    if (lv_r == 0) {
        return (lp_now - go_tacMeetT) >= go_tacPlanDeadDelay;
    }

    if ((lp_now - go_tacMeetT) >= go_tacPlanMaxWait) {
        return true;
    }

    lv_near = GhostOps_Scene_RescuedAlive(true);
    lv_need = FixedToInt((go_tacPlanShare * IntToFixed(lv_r)) + 0.99);
    if (lv_need < 1) {
        lv_need = 1;
    }

    lv_calm = (UnitGroupCount(UnitGroupAlliance(1, c_unitAllianceEnemy, RegionCircle(Point(go_tacZoneX, go_tacZoneY), go_tacZoneR + 8.0), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) == 0);
    if ((lv_near >= lv_need) && lv_calm) {
        if (go_tacPlanCalmT < 0.0) {
            go_tacPlanCalmT = lp_now;
        }

        return (lp_now - go_tacPlanCalmT) >= go_tacPlanCalm;
    }

    go_tacPlanCalmT = -1.0;
    return false;
}

// The operation plan: grenades and the missile as a SUGGESTED tactic (all of it stays available before and after). The lines fit the state at this moment.
bool GhostOps_Scene_PlanMsg (bool lp_testConds, bool lp_runActions) {
    int lv_ammo;
    bool lv_rebels;
    bool lv_missileUsed;
    bool lv_missileLost;

    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    if (go_tacPlanSt == 2) {
        TriggerQueueExit();
        return true;
    }

    lv_rebels = (GhostOps_Scene_RescuedAlive(false) > 0);
    lv_ammo = 0;
    if (go_tacGrenade && GhostOps_Tac_Alive(go_tacOperative)) {
        lv_ammo = go_tacGrenadeAmmo;
    }

    lv_missileUsed = (go_tacLaunches > 0);
    lv_missileLost = (go_tacState == 6) && !lv_missileUsed;
    GhostOps_Tac_Log("scene: operation plan, charges " + IntToString(lv_ammo) + " rebels " + IntToString(GhostOps_Scene_RescuedAlive(false)) + " launches " + IntToString(go_tacLaunches));
    GhostOps_Line("PLAN_INTRO");
    if (lv_ammo >= 2) {
        GhostOps_Line("PLAN_GRENADE_2");
    }
    else if (lv_ammo == 1) {
        GhostOps_Line("PLAN_GRENADE_1");
    }

    if (lv_missileUsed) {
        GhostOps_Line("PLAN_NUKE_USED");
    }
    else if (!lv_missileLost) {
        if (lv_ammo > 0) {
            if (lv_rebels) {
                GhostOps_Line("PLAN_NUKE_REBELS");
            }
            else {
                GhostOps_Line("PLAN_NUKE_ALONE");
            }
        }
        else {
            if (lv_rebels) {
                GhostOps_Line("PLAN_NUKE_REBELS_NG");
            }
            else {
                GhostOps_Line("PLAN_NUKE_ALONE_NG");
            }
        }
    }

    go_tacPlanSt = 2;
    TriggerQueueExit();
    return true;
}

// The transport with the two Ghosts (the only way the squad reaches the map in this variant).
void GhostOps_Scene_SendTransport () {
    go_scLanding = GhostOps_Scene_Landing();
    libNtve_gf_CreateUnitsAtPoint2(1, "SpecialOpsDropship", 0, 1, PointFromId(472));
    go_scShip = UnitLastCreated();
    UnitSetState(go_scShip, c_unitStateSelectable, false);
    UnitSetState(go_scShip, c_unitStateTargetable, false);
    UnitSetState(go_scShip, c_unitStateUsingSupply, false);
    GhostOps_SpawnOperativesInCargo(1, go_scShip);
    GhostOps_Tac_OnGhostsDelivered(GhostOps_SquadUnit(0), GhostOps_SquadUnit(1));
    UnitIssueOrder(go_scShip, OrderTargetingPoint(AbilityCommand("SpecOpsDropshipTransport", 2), go_scLanding), c_orderQueueReplace);
    UnitIssueOrder(go_scShip, OrderTargetingPoint(AbilityCommand("move", 0), RegionGetCenter(RegionFromId(31))), c_orderQueueAddToEnd);
    MinimapPing(PlayerGroupAll(), go_scLanding, 8.0, Color(0.00, 60.00, 100.00));
    GhostOps_Tac_Log("scene: transport sent");
}

void GhostOps_Scene_Unloaded () {
    ObjectiveCreate(StringExternal("Param/Value/GhostOpsTac_ObjectiveTitle"), StringExternal("Param/Value/GhostOpsTac_ObjectiveText"), c_objectiveStateActive, false);
    GhostOps_Scene_AddTips(2, 4);
    GhostOps_Tac_DrawRoles();
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsTac_ArrivalText"));
    GhostOps_Tac_Log("scene: ghosts unloaded");
    if (!go_tacGhostSaid) {
        go_tacGhostSaid = true;
        TriggerExecute(TriggerCreate("GhostOps_Scene_GhostMsg"), true, false);
    }

}

bool GhostOps_Scene_Tick (bool lp_testConds, bool lp_runActions) {
    fixed lv_now;

    if (!lp_runActions) {
        return true;
    }

    if (go_tacEnded) {
        return true;
    }

    lv_now = GameGetMissionTime();
    if (go_tacScStage == 0) {
        if ((lv_now - go_tacScT) >= go_tacStoryFirst) {
            go_tacScStage = 1;
            go_scMsgEnd = lv_now + go_tacStoryAlertLen + 120.0;
            TriggerExecute(TriggerCreate("GhostOps_Scene_AlertMsg"), true, false);
        }
    }
    else if (go_tacScStage == 1) {
        // watchdog (for example after a load): the message is never shown twice, the scene goes on
        if (lv_now > go_scMsgEnd) {
            go_tacScStage = 2;
            go_tacScT = lv_now;
        }
    }
    else if (go_tacScStage == 2) {
        if (!go_tacRaynorSaid && ((lv_now - go_tacScT) >= go_tacStoryRaynorDelay)) {
            go_tacRaynorSaid = true;
            TriggerExecute(TriggerCreate("GhostOps_Scene_RaynorMsg"), true, false);
        }

        if ((lv_now - go_tacScT) >= go_tacStorySecond) {
            go_tacScStage = 8;
            go_tacScT = lv_now;
            GhostOps_Tac_Log("scene: Swann queued");
            TriggerExecute(TriggerCreate("GhostOps_Scene_SwannMsg"), true, false);
        }
    }
    else if (go_tacScStage == 8) {
        // watchdog (for example after a load cut the waiting message): the transport comes anyway
        if ((lv_now - go_tacScT) > 120.0) {
            go_tacScStage = 3;
            go_tacScT = lv_now;
            GhostOps_Scene_SendTransport();
        }
    }
    else if (go_tacScStage == 3) {
        if (!GhostOps_Tac_Alive(go_scShip)) {
            // the transport is gone: whoever was inside is lost with it; nothing is created again
            go_tacScStage = 7;
        }
        else if (UnitGroupCount(UnitCargoGroup(go_scShip), c_unitCountAlive) == 0) {
            go_tacScStage = 4;
            go_tacScT = lv_now;
            GhostOps_Scene_Unloaded();
        }
        else if ((lv_now - go_tacScT) > 150.0) {
            // an unfinished delivery (for example a loaded game): order the unloading again
            UnitIssueOrder(go_scShip, OrderTargetingPoint(AbilityCommand("SpecOpsDropshipTransport", 2), go_scLanding), c_orderQueueReplace);
            UnitIssueOrder(go_scShip, OrderTargetingPoint(AbilityCommand("move", 0), RegionGetCenter(RegionFromId(31))), c_orderQueueAddToEnd);
            go_tacScT = lv_now;
        }
    }
    else if (go_tacScStage == 4) {
        // the Ghosts are out: the transport has done its job and is removed at the edge of the map (never earlier than its leaving)
        if (!GhostOps_Tac_Alive(go_scShip)) {
            go_tacScStage = 7;
        }
        else if ((DistanceBetweenPoints(UnitGetPosition(go_scShip), RegionGetCenter(RegionFromId(31))) < 8.0) || ((lv_now - go_tacScT) > 90.0)) {
            UnitRemove(go_scShip);
            go_tacScStage = 7;
            GhostOps_Tac_Log("scene: transport removed");
        }
    }

    // a load can cut the Ghost scene before it ends: the scenes that follow it must not wait for ever
    if (go_tacGhostSaid && !go_tacGhostDone && (go_tacScStage >= 4) && ((lv_now - go_tacScT) > 60.0)) {
        go_tacGhostDone = true;
        go_tacFindT = lv_now;
    }

    // "find the rebels": after the landing scenes (a loaded game that lost the queued scene starts it again)
    if (go_tacGhostDone && (go_tacFindSt != 2)) {
        if (go_tacRebelsFound) {
            go_tacFindSt = 2;
        }
        else if ((go_tacFindSt == 0) && ((lv_now - go_tacFindT) >= go_tacFindDelay)) {
            go_tacFindSt = 1;
            go_tacFindT = lv_now;
            TriggerExecute(TriggerCreate("GhostOps_Scene_FindMsg"), true, false);
        }
        else if ((go_tacFindSt == 1) && ((lv_now - go_tacFindT) > 90.0)) {
            go_tacFindSt = 0;
            go_tacFindT = lv_now - go_tacFindDelay;
        }
    }

    // the meeting scene lost with a load goes on; the plan comes when the rescued stand under the cover of the base
    if ((go_tacMeetSt == 1) && ((lv_now - go_tacMeetT) > 120.0)) {
        go_tacMeetT = lv_now;
        TriggerExecute(TriggerCreate("GhostOps_Scene_RebelHintMsg"), true, false);
    }

    if (go_tacMeetSt == 2) {
        if (go_tacPlanSt == 0) {
            if (GhostOps_Scene_PlanReady(lv_now)) {
                go_tacPlanSt = 1;
                go_tacPlanT = lv_now;
                TriggerExecute(TriggerCreate("GhostOps_Scene_PlanMsg"), true, false);
            }
        }
        else if ((go_tacPlanSt == 1) && ((lv_now - go_tacPlanT) > 120.0)) {
            go_tacPlanSt = 0;
            go_tacMeetT = lv_now - go_tacPlanMaxWait;
        }
    }

    return true;
}

// ---- New victory (config tactical.victory): every enemy production building of the listed types is destroyed ----
// The tail of the script (adapters/traynor02/tail.galaxy) knows the original mission variables: it tells whether the mission is over and fires the ORIGINAL victory
// (objective, campaign victory sequence, hooks) exactly once. The original victory trigger stays as it is (everything of the enemy dead = victory too).
bool GhostOps_Tac_GameIsOver ();
void GhostOps_Tac_VictoryFire ();

int GhostOps_Victory_Count () {
    int lv_i;
    int lv_n;

    lv_n = 0;
    lv_i = 0;
    while (lv_i < go_tacVicCount) {
        lv_n += UnitGroupCount(UnitGroup(go_tacVicType[lv_i], 2, RegionEntireMap(), GhostOps_Tac_LiveFilter(), 0), c_unitCountAlive);
        lv_i += 1;
    }

    return lv_n;
}

bool GhostOps_Victory_Tick (bool lp_testConds, bool lp_runActions) {
    int lv_n;

    if (!lp_runActions) {
        return true;
    }

    if (go_tacEnded || GhostOps_Tac_GameIsOver()) {
        return true;
    }

    lv_n = GhostOps_Victory_Count();
    if (lv_n > 0) {
        go_tacVicSeen = true;
    }

    if (lv_n != go_tacVicLeft) {
        go_tacVicLeft = lv_n;
        ObjectiveSetDescription(go_tacVicObj, StringExternal("Param/Value/GhostOpsTac_VictoryText") + StringToText(" ") + IntToText(lv_n));
        if (lv_n > 0) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsTac_VictoryLeft") + IntToText(lv_n));
        }
    }

    if (go_tacVicSeen && (lv_n == 0)) {
        TriggerEnable(TriggerGetCurrent(), false);
        ObjectiveSetState(go_tacVicObj, c_objectiveStateCompleted);
        GhostOps_Tac_Log("victory: no listed production building left");
        GhostOps_Tac_VictoryFire();
    }

    return true;
}

void GhostOps_Victory_Start () {
    if (!go_tacVictory || (go_tacVicTrig != null)) {
        return;
    }

    ObjectiveCreate(StringExternal("Param/Value/GhostOpsTac_VictoryTitle"), StringExternal("Param/Value/GhostOpsTac_VictoryText"), c_objectiveStateActive, false);
    go_tacVicObj = ObjectiveLastCreated();
    go_tacVicLeft = -1;
    go_tacVicTrig = TriggerCreate("GhostOps_Victory_Tick");
    TriggerAddEventTimePeriodic(go_tacVicTrig, 1.0, c_timeGame);
}

void GhostOps_OnMissionStart () {
    unit lv_operative;

    // the intro branches of the mission reach this hook once; the squad must still never be created twice
    if (!GhostOps_ClaimStart()) {
        return;
    }

    GhostOps_ApplyTacticalConfig();
    GhostOps_Init();
    GhostOps_SetPlayerCovered(1, true);
    if (go_tacEnabled) {
        // the Ghosts come later, by transport (see the scene above)
        GhostOps_Tac_Start();
        GhostOps_Victory_Start();
        go_tacScStage = 0;
        go_tacScT = GameGetMissionTime();
        go_tacPlanCalmT = -1.0;
        go_scTrig = TriggerCreate("GhostOps_Scene_Tick");
        TriggerAddEventTimePeriodic(go_scTrig, 0.5, c_timeGame);
    }
    else {
        lv_operative = GhostOps_SpawnOperatives(1, CameraInfoGetTarget(CameraInfoFromId(1117)));
        if (lv_operative != null) {
            UnitSelect(lv_operative, 1, true);
        }
    }

    GhostOps_Start();
    GhostOps_ReportProfile();
    GhostOps_ReportDifficulty(1);
}
