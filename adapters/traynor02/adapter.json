    },
    {
      "function": "gt_VictoryDominionOutpostCompleted_Func",
      "after": "gv_gameOver = true;",
      "call": "GhostOps_Ce0_OnVictory();"
    },
    {
      "function": "gt_DefeatBaseDead_Func",
      "after": "gv_gameOver = true;",
      "call": "GhostOps_Ce0_OnDefeat();"
    }
  ],
  "campaign_hooks": [
    {
