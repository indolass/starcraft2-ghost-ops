// CE-0 probe: TRaynor02 specific state and commands (development only; compiled only with the config key "ce0").
void GhostOps_Scene_OnRebelsRescued ();
void GhostOps_Scene_OnRebelsFound ();
int GhostOps_Scene_RescuedAlive (bool lp_inZoneOnly);

int go_apImpacts;

bool GhostOps_Ce0_Alive (unit lp_u) {
    if (lp_u == null) {
        return false;
    }

    return UnitIsAlive(lp_u);
}

string GhostOps_Ce0_Extra () {
    string lv_s;

    lv_s = "tac stage=" + IntToString(go_tacScStage) + " state=" + IntToString(go_tacState);
    lv_s = lv_s + " nukes=" + IntToString(TechTreeUnitCount(1, "Nuke", c_techCountCompleteOnly));
    lv_s = lv_s + " ships=" + IntToString(UnitGroupCount(UnitGroup("SpecialOpsDropship", c_playerAny, RegionEntireMap(), GhostOps_Ce0_Live(), 0), c_unitCountAlive));
    lv_s = lv_s + " spotter=" + IntToString(GhostOps_Ce0_B(GhostOps_Ce0_Alive(go_tacSpotter)));
    lv_s = lv_s + " operative=" + IntToString(GhostOps_Ce0_B(GhostOps_Ce0_Alive(go_tacOperative)));
    lv_s = lv_s + " ghostsaid=" + IntToString(GhostOps_Ce0_B(go_tacGhostSaid));
    lv_s = lv_s + " ended=" + IntToString(GhostOps_Ce0_B(go_tacEnded));
    return lv_s;
}

void GhostOps_Ce0_MissionStart () {
}

// Bunker test: an enemy Bunker with two enemy Marines inside; the Operative throws the grenade at it; the log shows what happens second by second.
bool GhostOps_Ce0_BunkerTest (bool lp_testConds, bool lp_runActions) {
    unit lv_bunker;
    unitgroup lv_marines;
    int lv_i;
    point lv_pos;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = PointWithOffset(UnitGetPosition(go_tacOperative), 8.0, 0.0);
    UnitCreate(1, "Bunker", 0, 2, lv_pos, 270.0);
    lv_bunker = UnitLastCreated();
    UnitCreate(2, "Marine", 0, 2, PointWithOffset(lv_pos, 0.0, -2.0), 270.0);
    lv_marines = UnitLastCreatedGroup();
    UnitGroupLoopBegin(lv_marines);
    while (UnitGroupLoopCurrent() != null) {
        UnitIssueOrder(UnitGroupLoopCurrent(), OrderTargetingUnit(AbilityCommand("smart", 0), lv_bunker), c_orderQueueReplace);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    Wait(5.0, c_timeGame);
    GhostOps_Ce0_Write("j", "BT before: bunker life " + FixedToString(UnitGetPropertyFixed(lv_bunker, c_unitPropLife, c_unitPropCurrent), 0) + " cargo " + IntToString(UnitGroupCount(UnitCargoGroup(lv_bunker), c_unitCountAlive)) + " marines alive " + IntToString(UnitGroupCount(lv_marines, c_unitCountAlive)));
    UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos), c_orderQueueReplace);
    lv_i = 0;
    while (lv_i < 14) {
        Wait(0.5, c_timeGame);
        lv_i += 1;
        GhostOps_Ce0_Write("j", "BT +" + IntToString(lv_i) + " half-s: bunker alive " + IntToString(GhostOps_Ce0_B(GhostOps_Ce0_Alive(lv_bunker))) + " marines alive " + IntToString(UnitGroupCount(lv_marines, c_unitCountAlive)) + " ammo " + IntToString(go_tacGrenadeAmmo) + " op life " + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropLife, c_unitPropCurrent), 0));
    }

    GhostOps_Ce0_Write("j", "BT end: ammo " + IntToString(go_tacGrenadeAmmo) + " impacts " + IntToString(go_apImpacts) + " | operative valid for a further shot " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos)))) + " | ability enabled-state via valid on spotter " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos)))));
    return true;
}

// Grenade test 2: three enemy Hellions in a cluster, two enemy Marines and an enemy SCV beside them (all on hold position), an own armed-off Marine too. One grenade, then the lives of every unit.
string GhostOps_Ce0_Lives (unitgroup lp_g) {
    string lv_t;
    int lv_i;

    lv_t = "";
    lv_i = 1;
    while (lv_i <= UnitGroupCount(lp_g, c_unitCountAll)) {
        lv_t = lv_t + FixedToString(UnitGetPropertyFixed(UnitGroupUnit(lp_g, lv_i), c_unitPropLife, c_unitPropCurrent), 0) + (" ");
        lv_i += 1;
    }

    return lv_t;
}

bool GhostOps_Ce0_GrenadeTest (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_h;
    unitgroup lv_m;
    unitgroup lv_s;
    unitgroup lv_own;
    point lv_pos;
    int lv_i;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = PointWithOffset(UnitGetPosition(go_tacOperative), 8.0, 0.0);
    UnitCreate(3, "Hellion", 0, 2, lv_pos, 270.0);
    lv_h = UnitLastCreatedGroup();
    UnitCreate(2, "Marine", 0, 2, PointWithOffset(lv_pos, 0.0, 1.2), 270.0);
    lv_m = UnitLastCreatedGroup();
    UnitCreate(1, "SCV", 0, 2, PointWithOffset(lv_pos, 0.0, -1.2), 270.0);
    lv_s = UnitLastCreatedGroup();
    UnitCreate(1, "Marine", 0, 1, PointWithOffset(lv_pos, 1.2, 0.0), 270.0);
    lv_own = UnitLastCreatedGroup();
    UnitGroupLoopBegin(lv_own);
    while (UnitGroupLoopCurrent() != null) {
        UnitWeaponRemove(UnitGroupLoopCurrent(), "GuassRifle");
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_m);
    while (UnitGroupLoopCurrent() != null) {
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_h);
    while (UnitGroupLoopCurrent() != null) {
        UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    Wait(1.0, c_timeGame);
    GhostOps_Ce0_Write("j", "GT before: hellions " + IntToString(UnitGroupCount(lv_h, c_unitCountAlive)) + " lives " + GhostOps_Ce0_Lives(lv_h) + "| enemy marines lives " + GhostOps_Ce0_Lives(lv_m) + "| enemy scv lives " + GhostOps_Ce0_Lives(lv_s) + "| own marine lives " + GhostOps_Ce0_Lives(lv_own));
    UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos), c_orderQueueReplace);
    Wait(9.0, c_timeGame);
    GhostOps_Ce0_Write("j", "GT after: hellions alive " + IntToString(UnitGroupCount(lv_h, c_unitCountAlive)) + " | enemy marines alive " + IntToString(UnitGroupCount(lv_m, c_unitCountAlive)) + " lives " + GhostOps_Ce0_Lives(lv_m) + "| enemy scv alive " + IntToString(UnitGroupCount(lv_s, c_unitCountAlive)) + " lives " + GhostOps_Ce0_Lives(lv_s) + "| own marine alive " + IntToString(UnitGroupCount(lv_own, c_unitCountAlive)) + " lives " + GhostOps_Ce0_Lives(lv_own) + "| ammo " + IntToString(go_tacGrenadeAmmo)
        + " | impacts " + IntToString(go_apImpacts) + " | operative valid for a further shot " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos)))) + " spotter valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos)))));
    return true;
}

// Grenade test 3: three enemy Hellions, an enemy Marauder (biological, armored), and OWN vehicle and SCV in the same cluster; lives of everything before / after one grenade.
bool GhostOps_Ce0_GrenadeTest3 (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_h;
    unitgroup lv_m;
    unitgroup lv_oh;
    unitgroup lv_os;
    unitgroup lv_ot;
    point lv_pos;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = PointWithOffset(UnitGetPosition(go_tacOperative), 8.0, 0.0);
    UnitCreate(3, "Hellion", 0, 2, lv_pos, 270.0);
    lv_h = UnitLastCreatedGroup();
    UnitCreate(1, "Marauder", 0, 2, PointWithOffset(lv_pos, 0.0, 1.2), 270.0);
    lv_m = UnitLastCreatedGroup();
    UnitCreate(1, "Hellion", 0, 1, PointWithOffset(lv_pos, 1.2, 0.0), 270.0);
    lv_oh = UnitLastCreatedGroup();
    UnitCreate(1, "SCV", 0, 1, PointWithOffset(lv_pos, 0.0, -1.2), 270.0);
    lv_os = UnitLastCreatedGroup();
    UnitCreate(1, "SiegeTank", 0, 1, PointWithOffset(lv_pos, -1.2, -1.2), 270.0);
    lv_ot = UnitLastCreatedGroup();
    UnitGroupLoopBegin(lv_oh);
    while (UnitGroupLoopCurrent() != null) {
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_os);
    while (UnitGroupLoopCurrent() != null) {
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_ot);
    while (UnitGroupLoopCurrent() != null) {
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_h);
    while (UnitGroupLoopCurrent() != null) {
        UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    UnitGroupLoopBegin(lv_m);
    while (UnitGroupLoopCurrent() != null) {
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLifeMax, 1000.0);
        UnitSetPropertyFixed(UnitGroupLoopCurrent(), c_unitPropLife, 1000.0);
        UnitIssueOrder(UnitGroupLoopCurrent(), Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    Wait(0.3, c_timeGame);
    GhostOps_Ce0_Write("j", "GT3 before: enemy hellions " + GhostOps_Ce0_Lives(lv_h) + "| enemy marauder " + GhostOps_Ce0_Lives(lv_m) + "| OWN hellion " + GhostOps_Ce0_Lives(lv_oh) + "| OWN scv " + GhostOps_Ce0_Lives(lv_os) + "| OWN tank " + GhostOps_Ce0_Lives(lv_ot));
    UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos), c_orderQueueReplace);
    Wait(9.0, c_timeGame);
    GhostOps_Ce0_Write("j", "GT3 after: enemy hellions alive " + IntToString(UnitGroupCount(lv_h, c_unitCountAlive)) + " | enemy marauder " + GhostOps_Ce0_Lives(lv_m) + "| OWN hellion " + GhostOps_Ce0_Lives(lv_oh) + "| OWN scv " + GhostOps_Ce0_Lives(lv_os) + "| OWN tank " + GhostOps_Ce0_Lives(lv_ot) + "| ammo " + IntToString(go_tacGrenadeAmmo) + " impacts " + IntToString(go_apImpacts));
    return true;
}

// Nuke geometry test (dev): the Spotter is put at distance go_nkD1 from the entrance bunker (35,77) on the line towards the start base, the Operative at go_nkD2 (0 = not moved);
// both are cloaked, then the Spotter is ordered to aim at the bunker; the log says whether the aiming starts without a step and what the enemies near do.
fixed go_nkD1;
fixed go_nkD2;

point GhostOps_Ce0_NkPoint (fixed lp_d) {
    return Point(34.5 + (0.749 * lp_d), 76.5 - (0.662 * lp_d));
}

string GhostOps_Ce0_Near (unit lp_u) {
    unitgroup lv_g;
    string lv_t;
    int lv_p;
    unit lv_e;

    lv_t = "";
    lv_p = 2;
    while (lv_p <= 8) {
        lv_g = UnitGroup(null, lv_p, RegionCircle(UnitGetPosition(lp_u), 13.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            lv_e = UnitGroupLoopCurrent();
            lv_t = lv_t + "P" + IntToString(lv_p) + ":" + UnitGetType(lv_e) + "@" + FixedToString(PointGetX(UnitGetPosition(lv_e)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_e)), 0) + " ";
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        lv_p += 1;
    }

    return lv_t;
}

string GhostOps_Ce0_NkState (string lp_tag) {
    return lp_tag + " spotter at " + FixedToString(PointGetX(UnitGetPosition(go_tacSpotter)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacSpotter)), 1) + " life " + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropLife, c_unitPropCurrent), 0) + " cloaked " + IntToString(GhostOps_Ce0_B(UnitTestState(go_tacSpotter, c_unitStateCloaked))) + " channel " + IntToString(GhostOps_Ce0_B(go_tacChannel)) + " state " + IntToString(go_tacState) + " hold " + IntToString(GhostOps_Ce0_B(UnitHasBehavior(go_tacSpotter, "GhostOpsAimHold")))
        + " | operative life " + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropLife, c_unitPropCurrent), 0) + " cloaked " + IntToString(GhostOps_Ce0_B(UnitTestState(go_tacOperative, c_unitStateCloaked))) + " at " + FixedToString(PointGetX(UnitGetPosition(go_tacOperative)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacOperative)), 1) + " | spotter to bunker " + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_tacSpotter), Point(34.5, 76.5)), 1);
}

bool GhostOps_Ce0_NukeGeo (bool lp_testConds, bool lp_runActions) {
    point lv_t;

    if (!lp_runActions) {
        return true;
    }

    lv_t = Point(34.5, 76.5);
    UnitSetPosition(go_tacSpotter, GhostOps_Ce0_NkPoint(go_nkD1), false);
    if (go_nkD2 > 0.0) {
        UnitSetPosition(go_tacOperative, GhostOps_Ce0_NkPoint(go_nkD2), false);
    }

    UnitIssueOrder(go_tacSpotter, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    UnitIssueOrder(go_tacOperative, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    Wait(1.5, c_timeGame);
    GhostOps_Ce0_Write("j", "NK near spotter: " + GhostOps_Ce0_Near(go_tacSpotter) + "| near operative: " + GhostOps_Ce0_Near(go_tacOperative));
    GhostOps_Ce0_Write("j", "NK " + GhostOps_Ce0_NkState("placed") + " | target visible " + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, lv_t))) + " order valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), lv_t)))));
    UnitIssueOrder(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), lv_t), c_orderQueueReplace);
    Wait(2.0, c_timeGame);
    GhostOps_Ce0_Write("j", "NK " + GhostOps_Ce0_NkState("2 s after the aim order") + " | near spotter: " + GhostOps_Ce0_Near(go_tacSpotter) + "| near operative: " + GhostOps_Ce0_Near(go_tacOperative));
    Wait(2.0, c_timeGame);
    GhostOps_Ce0_Write("j", "NK " + GhostOps_Ce0_NkState("4 s after the aim order") + " | near spotter: " + GhostOps_Ce0_Near(go_tacSpotter));
    UnitIssueOrder(go_tacSpotter, Order(AbilityCommand("TacNukeStrike", 1)), c_orderQueueReplace);
    Wait(1.5, c_timeGame);
    GhostOps_Ce0_Write("j", "NK " + GhostOps_Ce0_NkState("after cancel"));
    return true;
}

// Vision scan (dev): the Operative walks along the line bunker -> start base in steps of one cell; the log says from where the strike point (the bunker) is visible to the player.
bool GhostOps_Ce0_NukeScan (bool lp_testConds, bool lp_runActions) {
    fixed lv_d;
    string lv_t;

    if (!lp_runActions) {
        return true;
    }

    UnitIssueOrder(go_tacOperative, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    lv_t = "";
    lv_d = 4.0;
    while (lv_d <= 14.0) {
        UnitSetPosition(go_tacOperative, GhostOps_Ce0_NkPoint(lv_d), false);
        Wait(0.4, c_timeGame);
        lv_t = lv_t + FixedToString(lv_d, 0) + ":" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, Point(34.5, 76.5)))) + " ";
        lv_d += 1.0;
    }

    GhostOps_Ce0_Write("j", "NS bunker point visible from the Operative at distance d (1 = yes): " + lv_t + "| operative life " + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropLife, c_unitPropCurrent), 0));
    return true;
}

// Cancel test: the grenade is ordered and the order is replaced by "stop" before the shot; the charge must stay.
bool GhostOps_Ce0_CancelTest (bool lp_testConds, bool lp_runActions) {
    point lv_pos;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = PointWithOffset(UnitGetPosition(go_tacOperative), 8.0, 0.0);
    GhostOps_Ce0_Write("j", "CT ammo before " + IntToString(go_tacGrenadeAmmo));
    UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), lv_pos), c_orderQueueReplace);
    Wait(0.25, c_timeGame);
    UnitIssueOrder(go_tacOperative, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    Wait(2.5, c_timeGame);
    GhostOps_Ce0_Write("j", "CT ammo after the cancelled order " + IntToString(go_tacGrenadeAmmo));
    return true;
}

// Snipe test: energy 0 for both Ghosts, independent cooldowns (the data of TRaynor02 tactical: cost 0, cooldown 5).
bool GhostOps_Ce0_SnipeTest (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_m;
    unit[6] lv_t;
    int lv_i;
    point lv_pos;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = PointWithOffset(UnitGetPosition(go_tacOperative), 9.0, 0.0);
    lv_i = 0;
    while (lv_i < 6) {
        UnitCreate(1, "Marine", 0, 2, PointWithOffset(lv_pos, 0.0, IntToFixed(lv_i) - 2.5), 270.0);
        lv_t[lv_i] = UnitLastCreated();
        UnitIssueOrder(lv_t[lv_i], Order(AbilityCommand("move", 2)), c_orderQueueReplace);
        UnitSetPropertyFixed(lv_t[lv_i], c_unitPropLife, 200.0);
        UnitSetPropertyFixed(lv_t[lv_i], c_unitPropLifeMax, 200.0);
        lv_i += 1;
    }

    UnitSetPropertyFixed(go_tacSpotter, c_unitPropEnergy, 0.0);
    UnitSetPropertyFixed(go_tacOperative, c_unitPropEnergy, 0.0);
    UnitIssueOrder(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[4]), c_orderQueueReplace);
    UnitIssueOrder(go_tacOperative, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[5]), c_orderQueueReplace);
    Wait(1.2, c_timeGame);
    GhostOps_Ce0_Write("j", "SN both ordered at 0 energy in the same instant: targets 4 / 5 life " + FixedToString(UnitGetPropertyFixed(lv_t[4], c_unitPropLife, c_unitPropCurrent), 0) + " / " + FixedToString(UnitGetPropertyFixed(lv_t[5], c_unitPropLife, c_unitPropCurrent), 0) + " energies " + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropEnergy, c_unitPropCurrent), 1) + " / " + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropEnergy, c_unitPropCurrent), 1));
    UnitSetPropertyFixed(go_tacSpotter, c_unitPropEnergy, 0.0);
    UnitSetPropertyFixed(go_tacOperative, c_unitPropEnergy, 0.0);
    GhostOps_Ce0_Write("j", "SN at EXACTLY 0 energy: ghost1 valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[0])))) + " ghost2 valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacOperative, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[1])))) + " energy " + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropEnergy, c_unitPropCurrent), 1));
    Wait(0.6, c_timeGame);
    GhostOps_Ce0_Write("j", "SN energy " + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropEnergy, c_unitPropCurrent), 1) + "/" + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropEnergy, c_unitPropCurrent), 1) + " (0 energy, regen 20/s is not on a cloak-free unit? see value)");
    GhostOps_Ce0_Write("j", "SN t0: ghost1 valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[0])))));
    UnitIssueOrder(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[0]), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    GhostOps_Ce0_Write("j", "SN t+1: target0 life " + FixedToString(UnitGetPropertyFixed(lv_t[0], c_unitPropLife, c_unitPropCurrent), 0) + " | ghost2 valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacOperative, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[1])))) + " ghost1 again valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[2])))));
    UnitIssueOrder(go_tacOperative, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[1]), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    GhostOps_Ce0_Write("j", "SN t+2: target1 life " + FixedToString(UnitGetPropertyFixed(lv_t[1], c_unitPropLife, c_unitPropCurrent), 0) + " | ghost1 valid (cooldown 5 s, 2 s used) " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[2])))));
    Wait(3.6, c_timeGame);
    GhostOps_Ce0_Write("j", "SN t+5.6: ghost1 valid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[2])))) + " ghost2 valid (cooldown from t+1) " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacOperative, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[3])))));
    UnitIssueOrder(go_tacSpotter, OrderTargetingUnit(AbilityCommand("Snipe", 0), lv_t[2]), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    GhostOps_Ce0_Write("j", "SN end: target2 life " + FixedToString(UnitGetPropertyFixed(lv_t[2], c_unitPropLife, c_unitPropCurrent), 0) + " energy " + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropEnergy, c_unitPropCurrent), 1));
    return true;
}

// Grenade flight trace (dev): times of the launch effect and of the impact search effect, a counter of the impacts.
trigger go_apLaunchTrig;
trigger go_apImpactTrig;

bool GhostOps_Ce0_ApLaunchTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    GhostOps_Ce0_Write("j", "APT LAUNCH at game time " + FixedToString(GameGetMissionTime(), 2) + " ammo " + IntToString(go_tacGrenadeAmmo));
    return true;
}

bool GhostOps_Ce0_ApImpactTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    go_apImpacts += 1;
    GhostOps_Ce0_Write("j", "APT IMPACT #" + IntToString(go_apImpacts) + " at game time " + FixedToString(GameGetMissionTime(), 2) + " ammo " + IntToString(go_tacGrenadeAmmo));
    return true;
}

// Wave trace (dev): every 20 s the fighters of the Dominion players 2 and 5: all, near the rebel base, near our base, near the wave gather point, the nearest one to our base, and the Barracks.
trigger go_wvTick;

bool GhostOps_Ce0_WvTick (bool lp_testConds, bool lp_runActions) {
    int lv_p;
    int lv_n;
    int lv_i;
    int lv_total;
    int lv_reb;
    int lv_home;
    int lv_gat;
    unitgroup lv_g;
    unit lv_u;
    fixed lv_d;
    fixed lv_best;
    unit lv_b;

    if (!lp_runActions) {
        return true;
    }

    lv_total = 0;
    lv_reb = 0;
    lv_home = 0;
    lv_gat = 0;
    lv_best = 9999.0;
    lv_p = 2;
    while (lv_p <= 5) {
        if ((lv_p == 2) || (lv_p == 5)) {
            lv_g = UnitGroup(null, lv_p, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0);
            lv_n = UnitGroupCount(lv_g, c_unitCountAlive);
            lv_total += lv_n;
            lv_i = 1;
            while (lv_i <= lv_n) {
                lv_u = UnitGroupUnit(lv_g, lv_i);
                if (DistanceBetweenPoints(UnitGetPosition(lv_u), Point(41.5, 26.5)) < 20.0) {
                    lv_reb += 1;
                }

                lv_d = DistanceBetweenPoints(UnitGetPosition(lv_u), Point(go_tacZoneX, go_tacZoneY));
                if (lv_d < 30.0) {
                    lv_home += 1;
                }

                if (lv_d < lv_best) {
                    lv_best = lv_d;
                }

                if (DistanceBetweenPoints(UnitGetPosition(lv_u), PointFromId(292)) < 14.0) {
                    lv_gat += 1;
                }

                lv_i += 1;
            }
        }

        lv_p += 1;
    }

    lv_b = UnitFromId(149);
    GhostOps_Ce0_Write("j", "WV fighters total=" + IntToString(lv_total) + " near rebel base=" + IntToString(lv_reb) + " near our base=" + IntToString(lv_home) + " at wave gather point=" + IntToString(lv_gat) + " nearest to our base=" + FixedToString(lv_best, 0) + " | barracks " + UnitGetType(lv_b) + " owner " + IntToString(UnitGetOwner(lv_b)) + " at " + FixedToString(PointGetX(UnitGetPosition(lv_b)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(lv_b)), 0) + " alive " + IntToString(GhostOps_Ce0_B(GhostOps_Ce0_Alive(lv_b))));
    return true;
}

bool GhostOps_Ce0_MissionCmd (string lp_cmd, string lp_a, string lp_b) {
    unitgroup lv_g;
    string lv_t;
    int lv_i;
    unit lv_u;

    if (lp_cmd == "aim") {
        // the spotter aims the strike at a point 11 cells north of himself, away from the base (his own blast radius is 8; he does not move)
        UnitIssueOrder(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), PointWithOffset(UnitGetPosition(go_tacSpotter), 0.0, -11.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "AIM ordered at " + FixedToString(PointGetX(UnitGetPosition(go_tacSpotter)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacSpotter)) - 11.0, 1));
        return true;
    }

    if (lp_cmd == "cancel") {
        UnitIssueOrder(go_tacSpotter, Order(AbilityCommand("TacNukeStrike", 1)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "CANCEL ordered");
        return true;
    }

    if (lp_cmd == "txo") {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(1);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink(lp_a, 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(2);
        GhostOps_Ce0_Write("j", "TX original " + lp_a);
        return true;
    }

    if (lp_cmd == "txm") {
        TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_a), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), lp_b, null, null, null, 5.0, c_transmissionDurationSet, true);
        GhostOps_Ce0_Write("j", "TX model " + lp_a + " anim " + lp_b);
        return true;
    }

    if (lp_cmd == "msg") {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Raynor: standard text sample of the subtitle area, long enough to wrap around the screen width maybe twice for the size comparison here."));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<s val=" + "\"" + lp_a + "\"" + ">Raynor: styled text sample " + lp_a + ", long enough to wrap around the screen width maybe twice for the size comparison here.</s>"));
        return true;
    }

    if (lp_cmd == "sel") {
        UnitClearSelection(1);
        if (lp_a == "1") {
            UnitSelect(go_tacSpotter, 1, true);
        }
        else if (lp_a == "2") {
            UnitSelect(go_tacOperative, 1, true);
        }
        else {
            UnitSelect(go_tacSpotter, 1, true);
            UnitSelect(go_tacOperative, 1, true);
        }

        return true;
    }

    if (lp_cmd == "gs") {
        GhostOps_Ce0_Write("j", "GS spotter energy=" + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropEnergy, c_unitPropCurrent), 1) + " cloaked=" + IntToString(GhostOps_Ce0_B(UnitTestState(go_tacSpotter, c_unitStateCloaked))) + " cloakbuff=" + IntToString(GhostOps_Ce0_B(UnitHasBehavior(go_tacSpotter, "GhostCloak"))) + " hold=" + IntToString(GhostOps_Ce0_B(UnitHasBehavior(go_tacSpotter, "GhostOpsAimHold"))) + " channel=" + IntToString(GhostOps_Ce0_B(go_tacChannel)) + " life=" + FixedToString(UnitGetPropertyFixed(go_tacSpotter, c_unitPropLife, c_unitPropCurrent), 1)
            + " | operative energy=" + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropEnergy, c_unitPropCurrent), 1) + " cloaked=" + IntToString(GhostOps_Ce0_B(UnitTestState(go_tacOperative, c_unitStateCloaked))) + " life=" + FixedToString(UnitGetPropertyFixed(go_tacOperative, c_unitPropLife, c_unitPropCurrent), 1) + " | ammo=" + IntToString(go_tacGrenadeAmmo) + " state=" + IntToString(go_tacState));
        return true;
    }

    if (lp_cmd == "spawn") {
        // spawn <type> <player>: 3 units 8 cells east of the Operative
        UnitGroupLoopBegin(UnitCreate(3, lp_a, 0, 2, PointWithOffset(UnitGetPosition(go_tacOperative), StringToFixed(lp_b), 0.0), 270.0));
        while (UnitGroupLoopCurrent() != null) {
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "SPAWNED 3 " + lp_a + " of player " + lp_b + " 8 cells east of the Operative");
        return true;
    }

    if (lp_cmd == "ap") {
        // the Operative throws the grenade at a point (dx, dy) from himself
        UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("GhostOpsArmorPiercing", 0), PointWithOffset(UnitGetPosition(go_tacOperative), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "AP ordered at " + lp_a + "," + lp_b + " valid-ammo=" + IntToString(go_tacGrenadeAmmo));
        return true;
    }

    if (lp_cmd == "en") {
        lv_g = UnitGroup(null, 2, RegionCircle(UnitGetPosition(go_tacOperative), 22.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_t = "";
        lv_i = 1;
        while ((lv_i <= UnitGroupCount(lv_g, c_unitCountAlive)) && (lv_i <= 14)) {
            lv_t = lv_t + UnitGetType(UnitGroupUnit(lv_g, lv_i)) + ":" + FixedToString(UnitGetPropertyFixed(UnitGroupUnit(lv_g, lv_i), c_unitPropLife, c_unitPropCurrent), 0) + " ";
            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "EN count " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + ": " + lv_t);
        return true;
    }

    if (lp_cmd == "bunker") {
        UnitCreate(1, "Bunker", 0, 2, PointWithOffset(UnitGetPosition(go_tacOperative), StringToFixed(lp_a), 0.0), 270.0);
        lv_u = UnitLastCreated();
        UnitCreate(2, "Marine", 0, 2, PointWithOffset(UnitGetPosition(go_tacOperative), StringToFixed(lp_a), -3.0), 270.0);
        UnitGroupLoopBegin(UnitLastCreatedGroup());
        while (UnitGroupLoopCurrent() != null) {
            UnitIssueOrder(lv_u, OrderTargetingUnit(AbilityCommand("BunkerTransport", 0), UnitGroupLoopCurrent()), c_orderQueueAddToEnd);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        GhostOps_Ce0_Write("j", "BUNKER created, life " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent), 0) + " max " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropLifeMax, c_unitPropCurrent), 0));
        return true;
    }

    if (lp_cmd == "mv") {
        UnitIssueOrder(go_tacOperative, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffset(UnitGetPosition(go_tacOperative), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "MOVE ordered by " + lp_a + "," + lp_b + " from " + FixedToString(PointGetX(UnitGetPosition(go_tacOperative)), 0) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacOperative)), 0));
        return true;
    }

    if (lp_cmd == "pos") {
        GhostOps_Ce0_Write("j", "POS operative " + FixedToString(PointGetX(UnitGetPosition(go_tacOperative)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacOperative)), 1) + " spotter " + FixedToString(PointGetX(UnitGetPosition(go_tacSpotter)), 1) + "," + FixedToString(PointGetY(UnitGetPosition(go_tacSpotter)), 1));
        return true;
    }

    if (lp_cmd == "tp") {
        UnitSetPosition(go_tacOperative, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
        GhostOps_Ce0_Write("j", "TELEPORT operative to " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "tp1") {
        UnitSetPosition(go_tacSpotter, Point(StringToFixed(lp_a), StringToFixed(lp_b)), false);
        GhostOps_Ce0_Write("j", "TELEPORT spotter to " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "zr") {
        go_tacZoneR = StringToFixed(lp_a);
        GhostOps_Ce0_Write("j", "ZONE radius set to " + lp_a);
        return true;
    }

    if (lp_cmd == "bt") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_BunkerTest"), true, false);
        return true;
    }

    if (lp_cmd == "gt") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_GrenadeTest"), true, false);
        return true;
    }

    if (lp_cmd == "gt3") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_GrenadeTest3"), true, false);
        return true;
    }

    if (lp_cmd == "nkt") {
        go_nkD1 = StringToFixed(lp_a);
        go_nkD2 = StringToFixed(lp_b);
        TriggerExecute(TriggerCreate("GhostOps_Ce0_NukeGeo"), true, false);
        return true;
    }

    if (lp_cmd == "nks") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_NukeScan"), true, false);
        return true;
    }

    if (lp_cmd == "killm") {
        // kills one Marine of the player (a lost test fighter), logs how many are left
        lv_g = UnitGroup("Marine", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        if (UnitGroupCount(lv_g, c_unitCountAlive) > 0) {
            UnitKill(UnitGroupUnit(lv_g, 1));
        }

        GhostOps_Ce0_Write("j", "KILLM marines before " + IntToString(UnitGroupCount(lv_g, c_unitCountAlive)) + " (one was killed if > 0)");
        return true;
    }

    if (lp_cmd == "found") {
        GhostOps_Scene_OnRebelsFound();
        return true;
    }

    if (lp_cmd == "resc") {
        // runs the actions of the ORIGINAL rescue trigger (the conditions are skipped): hand-over, response wave, original dialogue, then our meeting scene
        TriggerExecute(TriggerCreate("gt_RebelsCompleteQ_Func"), false, false);
        GhostOps_Ce0_Write("j", "RESC original rescue trigger executed");
        return true;
    }

    if (lp_cmd == "killr") {
        // kills the rescued fighters (units, not buildings)
        lv_i = 1;
        while (lv_i <= UnitGroupCount(go_tacRescued, c_unitCountAll)) {
            lv_u = UnitGroupUnit(go_tacRescued, lv_i);
            if ((lv_u != null) && UnitIsAlive(lv_u) && !UnitFilterMatch(lv_u, 1, UnitFilter((1 << c_targetFilterStructure), 0, 0, 0))) {
                UnitKill(lv_u);
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "KILLR rescued fighters killed");
        return true;
    }

    if (lp_cmd == "setl") {
        go_tacLaunches = StringToInt(lp_a);
        GhostOps_Ce0_Write("j", "SETL launches " + lp_a);
        return true;
    }

    if (lp_cmd == "setammo") {
        go_tacGrenadeAmmo = StringToInt(lp_a);
        GhostOps_Ce0_Write("j", "SETAMMO charges " + lp_a);
        return true;
    }

    if (lp_cmd == "scs") {
        GhostOps_Ce0_Write("j", "SCS find " + IntToString(go_tacFindSt) + " meet " + IntToString(go_tacMeetSt) + " plan " + IntToString(go_tacPlanSt) + " found " + IntToString(GhostOps_Ce0_B(go_tacRebelsFound)) + " ghostdone " + IntToString(GhostOps_Ce0_B(go_tacGhostDone)) + " rescued alive " + IntToString(GhostOps_Scene_RescuedAlive(false)) + " in zone " + IntToString(GhostOps_Scene_RescuedAlive(true)) + " charges " + IntToString(go_tacGrenadeAmmo) + " launches " + IntToString(go_tacLaunches) + " state " + IntToString(go_tacState) + " calmT " + FixedToString(go_tacPlanCalmT, 1) + " rescueT " + FixedToString(go_tacRescueT, 1));
        return true;
    }

    if (lp_cmd == "planreset") {
        // forces the plan scene again (dev): the maximum wait counts as over
        go_tacPlanSt = 0;
        go_tacMeetSt = 2;
        go_tacMeetT = GameGetMissionTime() - go_tacPlanMaxWait - 1.0;
        GhostOps_Ce0_Write("j", "PLANRESET plan scene will run again");
        return true;
    }

    if (lp_cmd == "home") {
        // moves the rescued fighters under the cover of the base (dev)
        lv_i = 1;
        while (lv_i <= UnitGroupCount(go_tacRescued, c_unitCountAll)) {
            lv_u = UnitGroupUnit(go_tacRescued, lv_i);
            if ((lv_u != null) && UnitIsAlive(lv_u) && !UnitFilterMatch(lv_u, 1, UnitFilter((1 << c_targetFilterStructure), 0, 0, 0))) {
                UnitSetPosition(lv_u, Point(go_tacZoneX + IntToFixed(lv_i % 5) - 2.0, go_tacZoneY + 6.0 + IntToFixed(lv_i / 5)), false);
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "HOME rescued fighters moved into the zone");
        return true;
    }

    if (lp_cmd == "ct") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_CancelTest"), true, false);
        return true;
    }

    if (lp_cmd == "aim2") {
        GhostOps_Ce0_Write("j", "AIM2 valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), PointWithOffset(UnitGetPosition(go_tacSpotter), StringToFixed(lp_a), StringToFixed(lp_b)))))) + " visible=" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, PointWithOffset(UnitGetPosition(go_tacSpotter), StringToFixed(lp_a), StringToFixed(lp_b))))));
        UnitIssueOrder(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), PointWithOffset(UnitGetPosition(go_tacSpotter), StringToFixed(lp_a), StringToFixed(lp_b))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "AIM2 ordered by " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "cl") {
        UnitIssueOrder(go_tacSpotter, Order(AbilityCommand("GhostCloak", StringToInt(lp_a))), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "CLOAK order " + lp_a + " (0 on, 1 off)");
        return true;
    }

    if (lp_cmd == "cat") {
        GhostOps_Ce0_Write("j", "CAT nuke range " + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Range", 1) + " flags " + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Flags[RequireTargetVision]", 1) + " | AP range " + CatalogFieldValueGet(c_gameCatalogAbil, "GhostOpsArmorPiercing", "Range", 1) + " | snipe cd " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Cooldown.TimeUse", 1) + " cost " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Vital[Energy]", 1) + " | nuke effect " + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Effect[0]", 1));
        return true;
    }

    if (lp_cmd == "cat2") {
        GhostOps_Ce0_Write("j", "CAT2 Range[0]=" + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Range[0]", 1) + " Range=" + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "Range", 1) + " snipe Range=" + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Range", 1) + " snipe Range[0]=" + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Range[0]", 1) + " EMP Range=" + CatalogFieldValueGet(c_gameCatalogAbil, "EMP", "Range", 1) + " Calldown=" + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "CalldownEffect", 1) + " AP Range[0]=" + CatalogFieldValueGet(c_gameCatalogAbil, "GhostOpsArmorPiercing", "Range[0]", 1) + " AP CastIntro=" + CatalogFieldValueGet(c_gameCatalogAbil, "GhostOpsArmorPiercing", "CastIntroTime", 1) + " nuke abil FinishTime=" + CatalogFieldValueGet(c_gameCatalogAbil, "TacNukeStrike", "FinishTime", 1));
        return true;
    }

    if (lp_cmd == "aimop") {
        GhostOps_Ce0_Write("j", "AIMOP valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), UnitGetPosition(go_tacOperative))))) + " visible=" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, UnitGetPosition(go_tacOperative)))) + " distance " + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_tacSpotter), UnitGetPosition(go_tacOperative)), 1));
        UnitIssueOrder(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), UnitGetPosition(go_tacOperative)), c_orderQueueReplace);
        return true;
    }

    if (lp_cmd == "aimb") {
        GhostOps_Ce0_Write("j", "AIMB valid=" + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), Point(34.5, 76.5))))) + " visible=" + IntToString(GhostOps_Ce0_B(VisIsVisibleForPlayer(1, Point(34.5, 76.5)))) + " spotter distance " + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_tacSpotter), Point(34.5, 76.5)), 1) + " operative distance " + FixedToString(DistanceBetweenPoints(UnitGetPosition(go_tacOperative), Point(34.5, 76.5)), 1));
        UnitIssueOrder(go_tacSpotter, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), Point(34.5, 76.5)), c_orderQueueReplace);
        return true;
    }

    if (lp_cmd == "clo") {
        UnitIssueOrder(go_tacOperative, Order(AbilityCommand("GhostCloak", StringToInt(lp_a))), c_orderQueueReplace);
        return true;
    }

    if (lp_cmd == "sn") {
        TriggerExecute(TriggerCreate("GhostOps_Ce0_SnipeTest"), true, false);
        return true;
    }

    if (lp_cmd == "own149") {
        // simulate the hand-over of the rebel Barracks (map object 149) to the player
        UnitSetOwner(UnitFromId(149), 1, true);
        GhostOps_Ce0_Write("j", "OWN149 type " + UnitGetType(UnitFromId(149)) + " owner " + IntToString(UnitGetOwner(UnitFromId(149))) + " at " + FixedToString(PointGetX(UnitGetPosition(UnitFromId(149))), 1) + "," + FixedToString(PointGetY(UnitGetPosition(UnitFromId(149))), 1));
        return true;
    }

    if (lp_cmd == "lift") {
        GhostOps_Ce0_Write("j", "LIFT valid before the scene's tech rule " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(UnitFromId(149), Order(AbilityCommand("BarracksLiftOff", 0))))));
        UnitIssueOrder(UnitFromId(149), Order(AbilityCommand("BarracksLiftOff", 0)), c_orderQueueReplace);
        return true;
    }

    if (lp_cmd == "liftstate") {
        GhostOps_Ce0_Write("j", "LIFTSTATE type " + UnitGetType(UnitFromId(149)) + " flying " + IntToString(GhostOps_Ce0_B(UnitFilterMatch(UnitFromId(149), 1, UnitFilter((1 << c_targetFilterAir), 0, 0, 0)))) + " orders " + IntToString(UnitOrderCount(UnitFromId(149))) + " landvalid " + IntToString(GhostOps_Ce0_B(UnitOrderIsValid(UnitFromId(149), OrderTargetingPoint(AbilityCommand("BarracksLand", 0), Point(100.0, 30.0))))));
        return true;
    }

    if (lp_cmd == "hint") {
        GhostOps_Scene_OnRebelsRescued();
        GhostOps_Ce0_Write("j", "HINT requested, said=" + IntToString(GhostOps_Ce0_B(go_tacHintSaid)));
        return true;
    }

    if (lp_cmd == "apt") {
        go_apLaunchTrig = TriggerCreate("GhostOps_Ce0_ApLaunchTick");
        TriggerAddEventPlayerEffectUsed(go_apLaunchTrig, 1, "GhostOpsAPLaunch");
        go_apImpactTrig = TriggerCreate("GhostOps_Ce0_ApImpactTick");
        TriggerAddEventPlayerEffectUsed(go_apImpactTrig, 1, "GhostOpsAPSearch");
        GhostOps_Ce0_Write("j", "APT trace on");
        return true;
    }

    if (lp_cmd == "spd") {
        GameSetSpeedValue(StringToInt(lp_a));
        GhostOps_Ce0_Write("j", "SPD game speed value " + IntToString(GameGetSpeedValue()) + " factor " + FixedToString(GameGetSpeed(), 2));
        return true;
    }

    if (lp_cmd == "apn") {
        GhostOps_Ce0_Write("j", "APN impacts " + IntToString(go_apImpacts) + " ammo " + IntToString(go_tacGrenadeAmmo) + " panel " + IntToString(go_pnGrenades));
        return true;
    }

    if (lp_cmd == "mvget") {
        GhostOps_Ce0_Write("j", "MVGET " + lp_a + " = " + CatalogFieldValueGet(c_gameCatalogMover, "PunisherGrenadesWeapon", lp_a, 1));
        return true;
    }

    if (lp_cmd == "mvset") {
        CatalogFieldValueSet(c_gameCatalogMover, "PunisherGrenadesWeapon", lp_a, 1, lp_b);
        GhostOps_Ce0_Write("j", "MVSET " + lp_a + " := " + lp_b + " now " + CatalogFieldValueGet(c_gameCatalogMover, "PunisherGrenadesWeapon", lp_a, 1));
        return true;
    }

    if (lp_cmd == "cam") {
        CameraPan(1, Point(StringToFixed(lp_a), StringToFixed(lp_b)), 0.0, -1.0, 10.0, false);
        GhostOps_Ce0_Write("j", "CAM at " + lp_a + "," + lp_b);
        return true;
    }

    if (lp_cmd == "enp") {
        // enemy units (players 2..5, 8) within radius 14 of a point: type counts
        lv_t = "";
        lv_i = 2;
        while (lv_i <= 8) {
            lv_g = UnitGroup(null, lv_i, RegionCircle(Point(StringToFixed(lp_a), StringToFixed(lp_b)), 14.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
            if (UnitGroupCount(lv_g, c_unitCountAlive) > 0) {
                lv_t = lv_t + "P" + IntToString(lv_i) + ": ";
                UnitGroupLoopBegin(lv_g);
                while (UnitGroupLoopCurrent() != null) {
                    lv_t = lv_t + UnitGetType(UnitGroupLoopCurrent()) + "@" + FixedToString(PointGetX(UnitGetPosition(UnitGroupLoopCurrent())), 0) + "," + FixedToString(PointGetY(UnitGetPosition(UnitGroupLoopCurrent())), 0) + " ";
                    UnitGroupLoopStep();
                }

                UnitGroupLoopEnd();
            }

            lv_i += 1;
        }

        GhostOps_Ce0_Write("j", "ENP around " + lp_a + "," + lp_b + " r14: " + lv_t);
        return true;
    }

    if (lp_cmd == "wv") {
        go_wvTick = TriggerCreate("GhostOps_Ce0_WvTick");
        TriggerAddEventTimePeriodic(go_wvTick, 20.0, c_timeGame);
        GhostOps_Ce0_Write("j", "WV trace on (every 20 s)");
        return true;
    }

    if (lp_cmd == "flyhome") {
        UnitIssueOrder(UnitFromId(149), OrderTargetingPoint(AbilityCommand("move", 0), Point(93.0, 36.0)), c_orderQueueReplace);
        GhostOps_Ce0_Write("j", "BARRACKS ordered to fly to our base");
        return true;
    }

    if (lp_cmd == "win") {
        // the original victory trigger (our hook inside it reads the resources before the standard victory sequence)
        GhostOps_Ce0_Write("j", "WIN trigger executed");
        TriggerExecute(TriggerCreate("gt_VictoryDominionOutpostCompleted_Func"), false, false);
        return true;
    }

    return false;
}
