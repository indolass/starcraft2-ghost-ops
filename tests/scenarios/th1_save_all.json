{
 "name": "th1_save_all",
 "mission": "thanson01",
 "preset": "sniper_next_ce0_dev",
 "why": "compact save/load of the new mechanics",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "ngas 300",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nplace 1.5 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nplace 0 3.5",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "enter",
   "wait": 1.5
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "cmd 2",
   "every": 10,
   "timeout": 420
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "save",
   "name": "CE0_TH1_X"
  },
  {
   "op": "cmd",
   "text": "nshoot 0",
   "wait": 1.5
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "blasts 1",
   "every": 4,
   "timeout": 60
  },
  {
   "op": "cmd",
   "text": "click",
   "wait": 1.5
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "gas 150 used 2/12 placed 2 blasts 1 cmd 3",
   "every": 4,
   "timeout": 60
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "load",
   "name": "CE0_TH1_X"
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "click",
   "wait": 1.5
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "cmd 3",
   "every": 4,
   "timeout": 60
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "save",
   "name": "CE0_TH1_Y"
  },
  {
   "op": "load",
   "name": "CE0_TH1_Y"
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NSTAT gas 250 used 2/12 placed 2 blasts 0 cmd 2",
   "note": "saved state: containers, gas, waiting convoy"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas 150 used 2/12 placed 2 blasts 1 cmd 3",
   "note": "before the load: blast done + trip paid"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas 150 used 2/12 placed 2 blasts 0 cmd 3",
   "note": "after the load and sending again: one charge, blasts back to the saved 0"
  },
  {
   "op": "expect",
   "regex": "NSTAT convoy sent 2",
   "note": "never two convoys",
   "absent": true
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "stop"
  }
 ]
}