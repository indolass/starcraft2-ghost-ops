{
 "name": "tr02_load_aiming",
 "mission": "traynor02",
 "preset": "tactical_next_dev",
 "why": "save/load during the aiming channel",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "ammo",
   "grep": "AMMO grenade charges 2",
   "every": 4,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "aimc",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 5
  },
  {
   "op": "cmd",
   "text": "ammo",
   "wait": 1.5
  },
  {
   "op": "save",
   "name": "CE0_TR2_C"
  },
  {
   "op": "load",
   "name": "CE0_TR2_C"
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "ammo",
   "wait": 1.5
  },
  {
   "op": "until",
   "grep": "STATE tac 4|STATE tac 5",
   "cmd": "ammo",
   "every": 4,
   "timeout": 60
  },
  {
   "op": "sleep",
   "s": 12
  },
  {
   "op": "cmd",
   "text": "ammo",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "STATE tac [45] launches 1",
   "note": "the strike went on after the load, one launch"
  },
  {
   "op": "stop"
  }
 ]
}
