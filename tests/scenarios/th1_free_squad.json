{
 "name": "th1_free_squad",
 "mission": "thanson01",
 "preset": "sniper_next_free_ce0_dev",
 "why": "the free test squad appears once; the rest of the variant is the prepared-detonations one",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "ngas 0",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nselfb",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "snap",
   "wait": 1.5
  },
  {
   "op": "shot",
   "file": "free1.png"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas",
   "note": "information"
  },
  {
   "op": "expect",
   "regex": "Marine",
   "note": "information"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "free test squad",
   "count": 1,
   "note": "one free squad creation"
  },
  {
   "op": "stop"
  }
 ]
}