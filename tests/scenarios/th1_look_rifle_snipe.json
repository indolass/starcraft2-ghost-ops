{
 "name": "th1_look_rifle_snipe",
 "mission": "thanson01",
 "preset": "sniper_next_ce0_dev",
 "why": "model look, first-hit detonation by a rifle shot and by Snipe",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "ngas 300",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nplace 2 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nplace -2 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "ncam 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "shot",
   "file": "th1_containers_look.png"
  },
  {
   "op": "cmd",
   "text": "nblast 0",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nrifle 0 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 5
  },
  {
   "op": "cmd",
   "text": "nafter",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nshoot 1",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 1
  },
  {
   "op": "shot",
   "file": "th1_blast_moment.png"
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NB (before|after)",
   "note": "cluster around container 0 before / after ONE rifle shot"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas [0-9]+ used 2/12 placed 2 blasts 2",
   "note": "two containers, one blast each (rifle and Snipe)"
  },
  {
   "op": "stop"
  }
 ]
}