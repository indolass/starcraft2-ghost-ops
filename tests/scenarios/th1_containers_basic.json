{
 "name": "th1_containers_basic",
 "mission": "thanson01",
 "preset": "sniper_next_ce0_dev",
 "why": "container placement: charge, refusal on a structure, no gas, shared limit",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "ngas 200",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nplace 1.5 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nbunk 3 0",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nplace 3 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ngas 10",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 1
  },
  {
   "op": "cmd",
   "text": "nplace -1.5 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ngas 200",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nused 11",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 1
  },
  {
   "op": "cmd",
   "text": "nplace -1.5 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nplace 0 -1.5",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NSTAT gas",
   "note": "all stat lines (information)"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas 175 used 1/12 placed 1",
   "note": "one container placed, 25 gas charged"
  },
  {
   "op": "expect",
   "regex": "NSTAT gas 175 used 1/12 placed 1",
   "note": "refused on a structure: nothing charged"
  },
  {
   "op": "expect",
   "regex": "used 12/12 placed 3",
   "note": "the last slot of the shared limit used"
  },
  {
   "op": "expect",
   "regex": "used 13",
   "note": "never above the limit",
   "absent": true
  },
  {
   "op": "stop"
  }
 ]
}