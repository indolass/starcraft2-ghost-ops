{
 "name": "load_cooldown",
 "mission": "traynor03",
 "preset": "defence_next_dev",
 "why": "load on the cooldown",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap"
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "cmd",
   "text": "bld 5 8"
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "bld 5 12"
  },
  {
   "op": "until",
   "grep": "spent B 0 T 2",
   "cmd": "dst",
   "every": 4,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "salvon"
  },
  {
   "op": "cmd",
   "text": "nofoe"
  },
  {
   "op": "cmd",
   "text": "pausem"
  },
  {
   "op": "cmd",
   "text": "amset -10 0"
  },
  {
   "op": "cmd",
   "text": "amgrid 3.0"
  },
  {
   "op": "mark"
  },
  {
   "op": "cmd",
   "text": "amsv 1"
  },
  {
   "op": "save",
   "name": "CE0_CD"
  },
  {
   "op": "cmd",
   "text": "amval 1"
  },
  {
   "op": "load",
   "name": "CE0_CD"
  },
  {
   "op": "sleep",
   "s": 1
  },
  {
   "op": "cmd",
   "text": "amval 1"
  },
  {
   "op": "until",
   "grep": "AMVAL turret 1 ready 1",
   "cmd": "amval 1",
   "every": 1,
   "timeout": 40
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "amr 2.5"
  },
  {
   "op": "cmd",
   "text": "amhist"
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "expect",
   "regex": "AMVAL turret 1 ready 0",
   "note": "still cooling down right after the load"
  },
  {
   "op": "expect",
   "regex": "AMVAL turret 1 ready 1",
   "note": "ready again after the cooldown"
  },
  {
   "op": "expect",
   "regex": "AMHIST x1=\\d+ x2=\\d+ x3=\\d+ x4=\\d+ x5=\\d+ x6=0",
   "note": "at most 5 hits on a target: the load did not repeat the salvo"
  },
  {
   "op": "stop"
  }
 ]
}
