{
 "name": "th1_gas_probe",
 "mission": "thanson01",
 "preset": "sniper_next_ce0_dev",
 "why": "what the player has and earns by himself (gas, minerals, SCVs, refineries) every 30 s",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "nres",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "nresmon",
   "wait": 1.5
  },
  {
   "op": "until",
   "grep": "NRES t 6[0-9][0-9]",
   "every": 20,
   "timeout": 600
  },
  {
   "op": "expect",
   "regex": "NRES",
   "note": "resources over time (no orders given)"
  },
  {
   "op": "stop"
  }
 ]
}
