{
 "name": "th1r3_core",
 "mission": "thanson01",
 "preset": "sniper_next_r3_ce0_dev",
 "why": "r3 compiles; extra SCVs and the story at the handover",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "nscv",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "enter",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 6
  },
  {
   "op": "cmd",
   "text": "nscv",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 25
  },
  {
   "op": "cmd",
   "text": "nscv",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NSCV",
   "note": "SCVs and the story state after the handover"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": ".",
   "note": "Hanson log"
  },
  {
   "op": "stop"
  }
 ]
}