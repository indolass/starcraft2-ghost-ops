{
 "name": "tr02_missile_look",
 "mission": "traynor02",
 "preset": "tactical_next_dev",
 "why": "the projectile has a visible missile model, trail and explosion",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "ammo",
   "grep": "AMMO grenade charges 2",
   "every": 4,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "apt",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "tp 88 28",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "cam 91 28.5",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "spd 0",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ap 6 0",
   "wait": 0.05
  },
  {
   "op": "burst",
   "file": "b",
   "n": 24,
   "gap": 0
  },
  {
   "op": "cmd",
   "text": "apn",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "APT (LAUNCH|IMPACT)",
   "note": "the shot happened"
  },
  {
   "op": "stop"
  }
 ]
}