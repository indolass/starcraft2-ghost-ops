{
 "name": "th1_convoy_cycle",
 "mission": "thanson01",
 "preset": "sniper_next_ce0_dev",
 "why": "one full convoy cycle: first trip done -> next prepared -> ready, waits -> 100 gas once -> sent",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "ngas 300",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "enter",
   "wait": 1.5
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "cmd 2 ",
   "every": 10,
   "timeout": 420
  },
  {
   "op": "cmd",
   "text": "click",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 12
  },
  {
   "op": "cmd",
   "text": "nship",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 15
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NSHIP|NSTAT convoy",
   "note": "after the ship (information)"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": ".",
   "note": "Hanson log after the ship (information)"
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "cmd 1 ",
   "every": 8,
   "timeout": 420
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "cmd 2 ",
   "every": 5,
   "timeout": 300
  },
  {
   "op": "sleep",
   "s": 15
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "click",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "click",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "convoy|fuel|command|phase",
   "note": "Hanson log (information)"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "fuel paid",
   "count": 2,
   "note": "fuel paid exactly twice in the whole cycle (once per convoy)"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "command: convoy [0-9] sent",
   "count": 2,
   "note": "two sends, no more"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "convoy ready, waiting",
   "count": 2,
   "note": "two ready announcements, no repeats"
  },
  {
   "op": "stop"
  }
 ]
}