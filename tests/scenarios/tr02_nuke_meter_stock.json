{
 "name": "tr02_nuke_meter_stock",
 "mission": "traynor02",
 "preset": "ce0_dev",
 "why": "measured damage of the stock / mission NukeDamage by type and distance (stock)",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "ammo",
