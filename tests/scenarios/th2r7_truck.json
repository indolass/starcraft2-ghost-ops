{
 "name": "th2r7_truck",
 "mission": "thanson02",
 "preset": "epidemic_free_r7_ce0_dev",
 "why": "Epidemic r7: the gas truck of Area 7: found not captured, ignored by enemies before the capture, close capture, save / load, attacked after the capture, drives out to the base zone",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETR truck",
   "cmd": "etr",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "pass 1",
   "note": "the place is passable"
  },
  {
   "op": "expect",
   "regex": "owner 0 seen 0",
   "note": "free and not found at the start"
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETRNEAR",
   "cmd": "etrnear",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "ETRNEAR",
   "note": "the infested units and structures that the map has around the truck place"
  },
  {
   "op": "cmd",
   "text": "ecam 100 68",
   "wait": 1.0
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "burst",
   "file": "f0_site.png",
   "n": 2,
   "gap": 0.5
  },
  {
   "op": "cmd",
   "text": "etpm 90 68",
   "wait": 2.0
  },
  {
   "op": "sleep",
   "s": 5
  },
  {
   "op": "burst",
   "file": "f0b_detected.png",
   "n": 2,
   "gap": 0.5
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETR truck",
   "cmd": "etr",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "owner 0 seen 1",
   "note": "a fighter in the big area: the truck is found, NOT captured"
  },
  {
   "op": "cmd",
   "text": "ezerg 3",
   "wait": 2.0
  },
  {
   "op": "sleep",
   "s": 10
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETLIFE",
   "cmd": "etlife",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "life 150 owner 0",
   "note": "enemies next to the free truck ignore it: no damage, still nobody owns it"
  },
  {
   "op": "save",
   "name": "CE0_TH2R7_T1"
  },
  {
   "op": "load",
   "name": "CE0_TH2R7_T1"
  },
  {
   "op": "sleep",
   "s": 4
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETR truck",
   "cmd": "etr",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "owner 0 seen 1 stage [0-9]",
   "note": "after a load: still free"
  },
  {
   "op": "cmd",
   "text": "egom 100.1 68.4",
   "wait": 2.0
  },
  {
   "op": "sleep",
   "s": 16
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETLIFE",
   "cmd": "etlife",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "owner 1",
   "note": "a fighter walked right up: captured"
  },
  {
   "op": "burst",
   "file": "f1_captured.png",
   "n": 3,
   "gap": 0.5
  },
  {
   "op": "save",
   "name": "CE0_TH2R7_T2"
  },
  {
   "op": "load",
   "name": "CE0_TH2R7_T2"
  },
  {
   "op": "sleep",
   "s": 4
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETLIFE",
   "cmd": "etlife",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "owner 1 fuel 490",
   "note": "after a load: still ours, the fuel is not doubled"
  },
  {
   "op": "cmd",
   "text": "etpm 74 100",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "etpg 74 100",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ezerg 1",
   "wait": 2.0
  },
  {
   "op": "sleep",
   "s": 6
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ETLIFE",
   "cmd": "etlife",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "life ([0-9]|[0-9][0-9]|1[0-4][0-9]) owner 1",
   "note": "after the capture the enemies attack the truck (life below 150)"
  },
  {
   "op": "burst",
   "file": "f2_attacked.png",
   "n": 2,
   "gap": 0.5
  },
  {
   "op": "cmd",
   "text": "ehealtruck",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ekillzerg",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "etruckmv 73.5 100",
   "wait": 2.0
  },
  {
   "op": "until",
   "cmd": "estat",
   "grep": "stage 4",
   "every": 8,
   "timeout": 160
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "grep": "ESTAT",
   "cmd": "estat",
   "every": 3,
   "timeout": 100
  },
  {
   "op": "expect",
   "regex": "stage 4",
   "note": "the truck drove out of Area 7 to the base zone: good fuel at the base"
  },
  {
   "op": "burst",
   "file": "f3_at_base.png",
   "n": 2,
   "gap": 0.5
  },
  {
   "op": "stop"
  }
 ]
}