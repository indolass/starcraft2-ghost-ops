{
 "name": "tr02_load_in_flight_rt",
 "mission": "traynor02",
 "preset": "tactical_next_dev",
 "why": "save/load with the projectile in flight (slowed at run time)",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "ammo",
   "grep": "AMMO grenade charges 2",
   "every": 4,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "apt",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "apspd 3 6",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ap 6 6",
   "wait": 0.5
  },
  {
   "op": "save",
   "name": "CE0_TR2_B"
  },
  {
   "op": "load",
   "name": "CE0_TR2_B"
  },
  {
   "op": "sleep",
   "s": 0.5
  },
  {
   "op": "cmd",
   "text": "apn",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 8
  },
  {
   "op": "cmd",
   "text": "apn",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "ammo",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "APN impacts 1 ammo 1 panel 1",
   "note": "one impact and one charge after a load during the flight"
  },
  {
   "op": "expect",
   "regex": "APN impacts 2",
   "note": "no second impact",
   "absent": true
  },
  {
   "op": "stop"
  }
 ]
}