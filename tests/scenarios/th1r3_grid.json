{
 "name": "th1r3_grid",
 "mission": "thanson01",
 "preset": "sniper_next_r3_ce0_dev",
 "why": "free places for a turret near the Command Center",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "enter",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 25
  },
  {
   "op": "cmd",
   "text": "abil",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "grid",
   "wait": 3
  },
  {
   "op": "cmd",
   "text": "nselscv",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 2
  },
  {
   "op": "cmd",
   "text": "nscv",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "GRID|NSELSCV|ABIL|NSCV",
   "note": "the places for a turret, the SCV"
  },
  {
   "op": "stop"
  }
 ]
}