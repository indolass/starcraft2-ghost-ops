{
 "name": "th1_kits_save",
 "mission": "thanson01",
 "preset": "sniper_next_r2_ce0_dev",
 "why": "a load returns the kit counters and the construction to the saved moment",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 6
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "nstat",
   "grep": "NSTAT ghosts 2 firebats 2",
   "every": 5,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "enter",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 25
  },
  {
   "op": "cmd",
   "text": "abil",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "build -2 0",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 6
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "save",
   "name": "CE0_TH1_KITS"
  },
  {
   "op": "cmd",
   "text": "sel -1",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 1
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "load",
   "name": "CE0_TH1_KITS"
  },
  {
   "op": "sleep",
   "s": 3
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "sleep",
   "s": 40
  },
  {
   "op": "cmd",
   "text": "nstat",
   "wait": 1.5
  },
  {
   "op": "expect",
   "regex": "NSTAT kits",
   "note": "information"
  },
  {
   "op": "expect_def",
   "bank": "GhostOpsDevHanson",
   "regex": "kit|turret|construction",
   "note": "Hanson kit log (information)"
  },
  {
   "op": "stop"
  }
 ]
}