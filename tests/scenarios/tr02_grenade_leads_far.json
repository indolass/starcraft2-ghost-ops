{
 "name": "tr02_grenade_leads_far",
 "mission": "traynor02",
 "preset": "tactical_next_dev",
 "why": "the projectile does not chase a single hellion",
 "steps": [
  {
   "op": "start"
  },
  {
   "op": "wait_snap",
   "settle": 8
  },
  {
   "op": "key",
   "keys": [
    "ESC"
   ]
  },
  {
   "op": "mark"
  },
  {
   "op": "until",
   "cmd": "ammo",
   "grep": "AMMO grenade charges 2",
   "every": 4,
   "timeout": 150
  },
  {
   "op": "cmd",
   "text": "apt",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "gm -8",
   "wait": 1.5
  },
  {
   "op": "until",
   "grep": "GM lead -8.0 after",
   "every": 4,
   "timeout": 40
  },
  {
   "op": "cmd",
   "text": "setammo 2",
   "wait": 1.5
  },
  {
   "op": "cmd",
   "text": "gm 14",
   "wait": 1.5
  },
  {
   "op": "until",
   "grep": "GM lead 14.0 after",
   "every": 4,
   "timeout": 40
  },
  {
   "op": "expect",
   "regex": "GM lead",
   "note": "targets that already left / arrive after the impact survive: no homing"
  },
  {
   "op": "stop"
  }
 ]
}
