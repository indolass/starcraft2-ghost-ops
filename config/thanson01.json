          "lines": [
            {
              "id": "SWANN_GHOSTS_1",
              "speaker": "swann",
              "seconds": 4.0,
              "text": {
                "ru": "Подшаманил маскировку — теперь заряд не жрёт.",
                "en": "Tinkered with the cloak - it no longer eats charge."
              }
            },
            {
              "id": "SWANN_GHOSTS_2",
              "speaker": "swann",
              "seconds": 4.5,
              "text": {
                "ru": "И винтовки подкрутил: тяжёлых тварей снимайте ими.",
                "en": "And I tuned the rifles: take down the heavy brutes with them."
              }
            },
            {
              "id": "SWANN_GHOSTS_3",
              "speaker": "swann",
              "seconds": 4.0,
              "text": {
                "ru": "Только берегите железо, экспериментальное ещё.",
                "en": "Just take care of the gear, it is still experimental."
              }
            },
            {
              "id": "SWANN_BOXES_1",
              "speaker": "swann",
              "seconds": 4.0,
              "text": {
                "ru": "Огнемётчикам выдал банки с горючей смесью.",
                "en": "I gave the Firebats cans of fuel mixture."
              }
            },
            {
              "id": "SWANN_BOXES_2",
              "speaker": "swann",
              "seconds": 5.0,
              "text": {
                "ru": "Расставьте у дороги, а призраки подожгут точным выстрелом.",
                "en": "Place them by the road, and the Ghosts will set them off with a precise shot."
              }
            },
            {
              "id": "SWANN_BOXES_3",
              "speaker": "swann",
              "seconds": 4.5,
              "text": {
                "ru": "Только людей сначала отведите — рванёт прилично.",
                "en": "Just move people away first - it goes off with a bang."
              }
            },
            {
              "id": "HARD_WARNING",
              "speaker": "swann",
              "seconds": 4.5,
              "text": {
                "ru": "И учтите: на этой сложности взрыв опасен и для своих.",
                "en": "And mind this: on this difficulty the blast hurts your own side too."
              }
            },
            {
              "id": "RAYNOR_PLAN_1",
              "speaker": "raynor",
              "seconds": 4.0,
              "text": {
                "ru": "Сначала разведайте дорогу и подготовьте засады.",
                "en": "First scout the road and prepare the ambushes."
              }
            },
            {
              "id": "RAYNOR_PLAN_2",
              "speaker": "raynor",
              "seconds": 3.5,
              "text": {
                "ru": "Колонна выйдет по нашему приказу.",
                "en": "The convoy leaves on our order."
              }
            },
            {
              "id": "RAYNOR_PLAN_3",
              "speaker": "raynor",
              "seconds": 5.0,
              "text": {
                "ru": "Потом держитесь рядом и не подпускайте тварей к людям.",
                "en": "Then stay close and keep the creatures away from the people."
              }
            },
            {
              "id": "RAYNOR_FUEL",
              "speaker": "raynor",
              "seconds": 4.5,
              "text": {
                "ru": "И следите за газом: на каждый рейс нужна заправка.",
                "en": "And watch the gas: every trip needs fuel."
              }
            }
          ],
