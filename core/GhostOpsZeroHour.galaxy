    GhostOps_ZH_Log("scene: Raynor after the intro");
    GhostOps_ZH_Say("Param/Value/GhostOpsZH_RaynorName", "Param/Value/GhostOpsZH_RaynorText");
    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel("RaynorCommanderPortrait"), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", null, null, null, go_zhRaynorLen, c_transmissionDurationSet, true);
    TriggerQueueExit();
    return true;
}

