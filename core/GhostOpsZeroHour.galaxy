// hooks in the three rebel intro functions and the three rescued functions of the original: said once
void GhostOps_ZH_OnRebelCall () {
    if (!go_zhEnabled || go_zhRebelCallSaid) {
        return;
    }

    go_zhRebelCallSaid = true;
    TriggerExecute(TriggerCreate("GhostOps_ZH_RebelMsg"), true, false);
}

void GhostOps_ZH_OnRescue () {
    if (!go_zhEnabled || go_zhRescueSaid) {
        return;
    }

    go_zhRescueSaid = true;
    TriggerExecute(TriggerCreate("GhostOps_ZH_RescueMsg"), true, false);
}

bool GhostOps_ZH_SceneTick (bool lp_testConds, bool lp_runActions) {
    fixed lv_now;

    if (!lp_runActions) {
        return true;
    }

    lv_now = GameGetMissionTime();
    if (go_zhSceneStage == 0) {
        if ((lv_now - go_zhSceneT) >= go_zhIntroDelay) {
            go_zhSceneStage = 1;
            go_zhSceneT = lv_now;
            TriggerExecute(TriggerCreate("GhostOps_ZH_RaynorMsg"), true, false);
        }
    }
    else if (go_zhSceneStage == 1) {
        if ((lv_now - go_zhSceneT) >= go_zhHornerDelay) {
            go_zhSceneStage = 2;
            go_zhSceneT = lv_now;
            TriggerExecute(TriggerCreate("GhostOps_ZH_HornerMsg"), true, false);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Start (called once from the adapter at the end of the original intro; a loaded game never reaches it again)
//--------------------------------------------------------------------------------------------------
void GhostOps_ZH_Start () {
    int lv_i;

    if (go_zhStarted) {
        return;
    }

    go_zhStarted = true;
    GhostOps_ApplyZeroHourConfig();
    if (!go_zhEnabled) {
        return;
    }

    GhostOps_ZH_Log("start; order marines " + IntToString(go_zhOrdMarines) + " bunkers " + IntToString(go_zhOrdBunkers) + " turrets " + IntToString(go_zhOrdTurrets) + " scvs " + IntToString(go_zhOrdScvs));
    GhostOps_ZH_ApplyOrder();
    go_zhDead = 0;
    lv_i = 0;
    while (lv_i < go_zhTargetCount) {
        go_zhTargetDead[lv_i] = false;
        lv_i += 1;
    }

    HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsZH_Tip1Title"), StringExternal("Param/Value/GhostOpsZH_Tip1Text"), StringExternal("Param/Value/GhostOpsZH_Tip1Title"), "Assets\\Textures\\ui_icon_attention.dds");
    HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsZH_Tip2Title"), StringExternal("Param/Value/GhostOpsZH_Tip2Text"), StringExternal("Param/Value/GhostOpsZH_Tip2Title"), "Assets\\Textures\\ui_icon_attention.dds");
    HelpPanelAddTip(PlayerGroupAll(), StringExternal("Param/Value/GhostOpsZH_Tip3Title"), StringExternal("Param/Value/GhostOpsZH_Tip3Text"), StringExternal("Param/Value/GhostOpsZH_Tip3Title"), "Assets\\Textures\\ui_icon_attention.dds");
    ObjectiveCreate(StringExternal("Param/Value/GhostOpsZH_ObjTitle"), StringExternal("Param/Value/GhostOpsZH_ObjText"), c_objectiveStateActive, true);
    go_zhObjective = ObjectiveLastCreated();
    GhostOps_ZH_ObjectiveText();
    go_zhSceneT = GameGetMissionTime();
    go_zhLastPing = GameGetMissionTime() - go_zhPingEvery + 20.0;
    if (go_zhLockProduction) {
        GhostOps_ZH_LockTick(true, true);
        go_zhLockTrig = TriggerCreate("GhostOps_ZH_LockTick");
        TriggerAddEventTimePeriodic(go_zhLockTrig, 1.0, c_timeGame);
    }

    go_zhTick = TriggerCreate("GhostOps_ZH_Tick");
    TriggerAddEventTimePeriodic(go_zhTick, 1.0, c_timeGame);
    go_zhSceneTick = TriggerCreate("GhostOps_ZH_SceneTick");
    TriggerAddEventTimePeriodic(go_zhSceneTick, 0.5, c_timeGame);
}
