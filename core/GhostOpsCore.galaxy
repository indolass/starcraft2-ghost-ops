//==================================================================================================
// GhostOps Core (MIT). Mission independent: no mission names, player numbers or unit ids of
// a particular map. Mission adapters register covered players and call GhostOps_Start().
// Configuration values (go_cfg*) are set by the generated GhostOps_ApplyConfig().
//
// SquadManager: go_operatives is the registry of operatives. Everything that treats the regular
//   army differently from operatives asks GhostOps_IsOperative(), never a unit type name.
// BaseSupport (default): regular non-structure units of covered players get Blizzard's hidden
//   behavior DamageDealtDouble (x2) or DamageDealtMega (x3). Nothing else about them changes, so
//   the enemy AI keeps attacking them. Each unit gets the behavior at most once.
// Experimental: invulnerable allies (the old protection model). Off by default and refused by
//   the build together with a damage multiplier above 1.
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// State
//--------------------------------------------------------------------------------------------------
bool go_initialized;
int go_cfgDamageMultiplier;
bool go_cfgInvulnerableAllies;
int go_cfgSquadSize;
string[6] go_cfgSquadType;
bool go_cfgStartHoldFire;
bool go_cfgGhostPermanentCloak;
bool go_cfgGhostStartCloaked;
bool go_cfgNoVoice;                  // build without added voice: GhostOps_Voice() returns no sound
bool go_cfgShowDifficulty;
int go_cfgExpectedDifficulty;
int go_cfgFragileCount;
string[4] go_cfgFragileType;
fixed[4] go_cfgFragileLife;
bool go_missionStarted;
bool go_cfgShowTuning;
bool go_cfgHasProfile;
text go_cfgPresetText;
int go_initDifficulty;
trigger go_fragileTrigger;
trigger go_startStateTrigger;
bool[16] go_playerCovered;
unitgroup go_operatives;
unit[6] go_squadUnit;
unitgroup go_supported;
unitgroup go_protected;
string go_supportBehavior;
trigger go_scanTrigger;

void GhostOps_ApplyConfig ();
void GhostOps_ApplyAbilityRestrictions (int lp_player);

//--------------------------------------------------------------------------------------------------
// Setup
//--------------------------------------------------------------------------------------------------
// Talk drivers: SILENT clips whose only job is the mouth of a portrait (a portrait moves its lips only while a sound with a lip-sync animation plays).
// Groups: 0 Raynor, 1 Swann, 2 Horner, 3 marine, 4 Adjutant, 5 Ghost (the same order as TALK_GROUPS in tools/build.py). Not voice: kept in a build without added voice.
string[24] go_talkId;
fixed[24] go_talkLen;
int[8] go_talkFirst;
int[8] go_talkCount;
int go_talkTurn;

// The portrait of lp_model talks for lp_total seconds: a chain of silent lip-sync pieces of the speaker group, the last one shortened to fit.
void GhostOps_Talk (string lp_model, int lp_group, fixed lp_total) {
    fixed lv_left;
    fixed lv_len;
    int lv_k;

    lv_left = lp_total;
    if (go_talkCount[lp_group] == 0) {
        TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_model), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", null, null, null, lv_left, c_transmissionDurationSet, true);
        return;
    }

    while (lv_left > 0.3) {
        lv_k = go_talkFirst[lp_group] + (go_talkTurn % go_talkCount[lp_group]);
        go_talkTurn += 1;
        lv_len = go_talkLen[lv_k];
        if ((lv_left - lv_len) < 1.2) {
            lv_len = lv_left;
        }

        TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_model), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", SoundLink(go_talkId[lv_k], 0), null, null, lv_len, c_transmissionDurationSet, true);
        lv_left -= lv_len;
    }
}

//--------------------------------------------------------------------------------------------------
// Status panel of the specialists (independent of the selection): one row per Ghost with the name / role, the state and an energy bar.
// States (real, from the current energy and the real net change per second under the cloak - no separate timer):
//   "<name> - cloak: N s" (game seconds; orange at about 3 s, red at 1 s), "Cloak: infinity" (a free permanent cloak),
//   "aiming - the cloak drain is paused" (set by the tactical module), "Recovery: P%" (cloak off, energy not full), "ready", "died".
// Configuration: GhostOps_ApplyPanelConfig (generated). Without the config key "panel" the panel does not exist.
//--------------------------------------------------------------------------------------------------
unit GhostOps_SquadUnit (int lp_index);
bool go_pnEnabled;
int go_pnCount;
fixed go_pnNet;                  // net energy change per second under the cloak (negative = the cloak costs energy)
fixed go_pnRegen;
bool go_pnPermanent;
bool go_pnHold;                  // the strike channel pauses the cloak drain (written by the tactical module)
int go_pnGrenades;               // charges left of the armor-piercing grenade (written by the tactical module); -1 = the mission has none
int go_pnGrenadeSlot;            // squad index of the grenadier
int go_pnGrenadeMax;             // charges the grenadier had at the start (for the line "N/M")
int go_pnHoldSlot;               // squad index of the unit whose cloak drain is paused (the Spotter)
trigger go_pnLoadTrig;
int go_pnDialog;
int[6] go_pnLabel;
int[6] go_pnBar;
int go_pnFoot;
bool go_pnBuilt;
trigger go_pnTrig;

void GhostOps_ApplyPanelConfig ();

// The cloak is ON (the ability is toggled on): true also while an enemy detector shows the unit (the cloak state flag alone goes false then, the buff stays and keeps costing energy).
bool GhostOps_CloakOn (unit lp_unit) {
    if (lp_unit == null) {
        return false;
    }

    return UnitHasBehavior(lp_unit, "GhostCloak") || UnitTestState(lp_unit, c_unitStateCloaked);
}

text GhostOps_Panel_Color (string lp_rgb, text lp_text) {
    return StringToText("<c val=" + "\"" + lp_rgb + "\"" + ">") + lp_text + StringToText("</c>");
}

void GhostOps_Panel_Build () {
    int lv_i;
    int lv_h;

    if (go_pnBuilt) {
        return;
    }

    go_pnBuilt = true;
    lv_h = (46 * go_pnCount) + 30;
    DialogCreate(500, lv_h, c_anchorTopRight, 14, 118, false);
    go_pnDialog = DialogLastCreated();
    DialogSetImage(go_pnDialog, "Assets\\Textures\\ui_ingame_blackmask.dds");
    DialogSetImageVisible(go_pnDialog, true);
    DialogSetTransparency(go_pnDialog, 35.0);
    DialogSetVisible(go_pnDialog, PlayerGroupAll(), true);
    lv_i = 0;
    while (lv_i < go_pnCount) {
        DialogControlCreate(go_pnDialog, c_triggerControlTypeLabel);
        go_pnLabel[lv_i] = DialogControlLastCreated();
        DialogControlSetSize(go_pnLabel[lv_i], PlayerGroupAll(), 484, 26);
        DialogControlSetPosition(go_pnLabel[lv_i], PlayerGroupAll(), c_anchorTopLeft, 8, 4 + (46 * lv_i));
        DialogControlSetPropertyAsString(go_pnLabel[lv_i], c_triggerControlPropertyStyle, PlayerGroupAll(), "MissionTimePanel");
        DialogControlCreate(go_pnDialog, c_triggerControlTypeProgressBar);
        go_pnBar[lv_i] = DialogControlLastCreated();
        DialogControlSetSize(go_pnBar[lv_i], PlayerGroupAll(), 484, 12);
        DialogControlSetPosition(go_pnBar[lv_i], PlayerGroupAll(), c_anchorTopLeft, 8, 30 + (46 * lv_i));
        DialogControlSetPropertyAsFixed(go_pnBar[lv_i], c_triggerControlPropertyMinValue, PlayerGroupAll(), 0.0);
        DialogControlSetPropertyAsFixed(go_pnBar[lv_i], c_triggerControlPropertyMaxValue, PlayerGroupAll(), 100.0);
        lv_i += 1;
    }

    DialogControlCreate(go_pnDialog, c_triggerControlTypeLabel);
    go_pnFoot = DialogControlLastCreated();
    DialogControlSetSize(go_pnFoot, PlayerGroupAll(), 484, 20);
    DialogControlSetPosition(go_pnFoot, PlayerGroupAll(), c_anchorTopLeft, 8, 6 + (46 * go_pnCount));
    DialogControlSetPropertyAsString(go_pnFoot, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    DialogControlSetPropertyAsText(go_pnFoot, c_triggerControlPropertyText, PlayerGroupAll(), GhostOps_Panel_Color("9aa6b8", StringExternal("Param/Value/GhostOpsPanel_Footer")));
}

// A loaded game destroys the dialogs of the script: the panel is built again by the next tick.
bool GhostOps_Panel_Loaded (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    if (go_pnBuilt) {
        DialogDestroy(go_pnDialog);
        go_pnBuilt = false;
    }

    return true;
}

bool GhostOps_Panel_Tick (bool lp_testConds, bool lp_runActions) {
    int lv_i;
    unit lv_u;
    fixed lv_e;
    fixed lv_m;
    fixed lv_rem;
    text lv_line;
    string lv_rgb;
    bool lv_any;

    if (!lp_runActions) {
        return true;
    }

    lv_any = false;
    lv_i = 0;
    while (lv_i < go_pnCount) {
        if (GhostOps_SquadUnit(lv_i) != null) {
            lv_any = true;
        }

        lv_i += 1;
    }

    if (!lv_any) {
        return true;
    }

    GhostOps_Panel_Build();
    lv_i = 0;
    while (lv_i < go_pnCount) {
        lv_u = GhostOps_SquadUnit(lv_i);
        lv_rgb = "ffffff";
        if (lv_u == null) {
            DialogControlSetVisible(go_pnLabel[lv_i], PlayerGroupAll(), false);
            DialogControlSetVisible(go_pnBar[lv_i], PlayerGroupAll(), false);
        }
        else if (!UnitIsAlive(lv_u)) {
            DialogControlSetVisible(go_pnLabel[lv_i], PlayerGroupAll(), true);
            DialogControlSetVisible(go_pnBar[lv_i], PlayerGroupAll(), true);
            DialogControlSetPropertyAsFixed(go_pnBar[lv_i], c_triggerControlPropertyValue, PlayerGroupAll(), 0.0);
            lv_line = GhostOps_Panel_Color("808080", StringExternal("Param/Value/GhostOpsPanel_Name" + IntToString(lv_i)) + StringToText(" - ") + StringExternal("Param/Value/GhostOpsPanel_Dead"));
            DialogControlSetPropertyAsText(go_pnLabel[lv_i], c_triggerControlPropertyText, PlayerGroupAll(), lv_line);
        }
        else {
            DialogControlSetVisible(go_pnLabel[lv_i], PlayerGroupAll(), true);
            DialogControlSetVisible(go_pnBar[lv_i], PlayerGroupAll(), true);
            lv_e = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent);
            lv_m = UnitGetPropertyFixed(lv_u, c_unitPropEnergyMax, c_unitPropCurrent);
            if (lv_m < 1.0) {
                lv_m = 1.0;
            }

            DialogControlSetPropertyAsFixed(go_pnBar[lv_i], c_triggerControlPropertyValue, PlayerGroupAll(), (100.0 * lv_e) / lv_m);
            if (GhostOps_CloakOn(lv_u)) {
                if (go_pnPermanent || (go_pnNet >= 0.0)) {
                    lv_line = StringExternal("Param/Value/GhostOpsPanel_Infinite");
                }
                else if (go_pnHold && (lv_i == go_pnHoldSlot)) {
                    lv_line = StringExternal("Param/Value/GhostOpsPanel_Hold");
                    lv_rgb = "6fd0ff";
                }
                else {
                    lv_rem = lv_e / (0.0 - go_pnNet);
                    if (lv_rem <= 1.0) {
                        lv_rgb = "ff4040";
                    }
                    else if (lv_rem <= 3.0) {
                        lv_rgb = "ffa030";
                    }

                    lv_line = StringExternal("Param/Value/GhostOpsPanel_Cloak") + StringToText(": ") + IntToText(FixedToInt(lv_rem + 0.99)) + StringToText(" ") + StringExternal("Param/Value/GhostOpsPanel_Seconds");
                }
            }
            else if (lv_e >= (lv_m - 0.5)) {
                lv_line = StringExternal("Param/Value/GhostOpsPanel_Ready");
            }
            else {
                lv_line = StringExternal("Param/Value/GhostOpsPanel_Regen") + StringToText(": ") + IntToText(FixedToInt((100.0 * lv_e) / lv_m)) + StringToText("%");
            }

            lv_line = StringExternal("Param/Value/GhostOpsPanel_Name" + IntToString(lv_i)) + StringToText(" - ") + lv_line;
            DialogControlSetPropertyAsText(go_pnLabel[lv_i], c_triggerControlPropertyText, PlayerGroupAll(), GhostOps_Panel_Color(lv_rgb, lv_line));
        }

        lv_i += 1;
    }

    // the charges of the grenade live in the footer line (a row of the panel must stay short); the number is the real charge counter of the module, read every tick,
    // so the line is the same with any selection. A dead grenadier is shown as dead.
    if (go_pnGrenades >= 0) {
        if (GhostOps_SquadUnit(go_pnGrenadeSlot) != null && !UnitIsAlive(GhostOps_SquadUnit(go_pnGrenadeSlot))) {
            lv_line = StringExternal("Param/Value/GhostOpsPanel_Name" + IntToString(go_pnGrenadeSlot)) + StringToText(" - ") + StringExternal("Param/Value/GhostOpsPanel_Dead");
            lv_rgb = "808080";
        }
        else {
            lv_line = StringExternal("Param/Value/GhostOpsPanel_Name" + IntToString(go_pnGrenadeSlot)) + StringToText(" - ") + StringExternal("Param/Value/GhostOpsPanel_Grenades") + StringToText(": ") + IntToText(go_pnGrenades);
            if (go_pnGrenadeMax > 0) {
                lv_line = lv_line + StringToText("/") + IntToText(go_pnGrenadeMax);
            }

            lv_rgb = "9aa6b8";
            if (go_pnGrenades <= 0) {
                lv_rgb = "ff7070";
            }
        }

        DialogControlSetPropertyAsText(go_pnFoot, c_triggerControlPropertyText, PlayerGroupAll(), GhostOps_Panel_Color(lv_rgb, lv_line));
    }

    return true;
}

void GhostOps_Panel_Start () {
    GhostOps_ApplyPanelConfig();
    if (!go_pnEnabled) {
        return;
    }

    go_pnTrig = TriggerCreate("GhostOps_Panel_Tick");
    TriggerAddEventTimePeriodic(go_pnTrig, 0.25, c_timeGame);
    go_pnLoadTrig = TriggerCreate("GhostOps_Panel_Loaded");
    TriggerAddEventLoadGameDone(go_pnLoadTrig);
}

// One short original line with its own sound (and the lip-sync of the original line); a build without added voice shows the same step with a silent talk animation.
void GhostOps_ClipStep (string lp_model, int lp_group, string lp_clip, fixed lp_seconds) {
    if (go_cfgNoVoice) {
        GhostOps_Talk(lp_model, lp_group, lp_seconds);
        return;
    }

    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_model), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", SoundLink(lp_clip, 0), null, null, lp_seconds, c_transmissionDurationSet, true);
}

// The same with a ready sound link (a scene that keeps its clips in variables).
void GhostOps_ClipStepLink (string lp_model, int lp_group, soundlink lp_link, fixed lp_seconds) {
    if (go_cfgNoVoice) {
        GhostOps_Talk(lp_model, lp_group, lp_seconds);
        return;
    }

    TransmissionSend(PlayerGroupAll(), TransmissionSourceFromModel(lp_model), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), "Talk", lp_link, null, null, lp_seconds, c_transmissionDurationSet, true);
}

// The voice clips of the maps go through this (SoundLink is a soundlink): a build without added voice (--no-voice) gets no sound (the portrait, the subtitle and the text stay).
soundlink GhostOps_Voice (string lp_id) {
    if (go_cfgNoVoice) {
        return null;
    }

    return SoundLink(lp_id, 0);
}

string GhostOps_BehaviorFor (int lp_multiplier) {
    if (lp_multiplier == 2) {
        return "DamageDealtDouble";
    }

    if (lp_multiplier == 3) {
        return "DamageDealtMega";
    }

    return "";
}

void GhostOps_Init () {
    int i;

    if (go_initialized) {
        return;
    }

    go_initialized = true;
    go_operatives = UnitGroupEmpty();
    go_supported = UnitGroupEmpty();
    go_protected = UnitGroupEmpty();
    i = 0;
    while (i < 16) {
        go_playerCovered[i] = false;
        i += 1;
    }

    GhostOps_ApplyConfig();
    // The two models are never combined; the build refuses it, this guards a hand-edited script.
    if ((go_cfgDamageMultiplier > 1) && go_cfgInvulnerableAllies) {
        go_cfgInvulnerableAllies = false;
    }

    go_supportBehavior = GhostOps_BehaviorFor(go_cfgDamageMultiplier);
}

void GhostOps_SetPlayerCovered (int lp_player, bool lp_covered) {
    if ((lp_player < 0) || (lp_player > 15)) {
        return;
    }

    go_playerCovered[lp_player] = lp_covered;
}

//--------------------------------------------------------------------------------------------------
// SquadManager (registry of operatives)
//--------------------------------------------------------------------------------------------------
void GhostOps_RegisterOperative (unit lp_unit) {
    if (lp_unit == null) {
        return;
    }

    UnitGroupAdd(go_operatives, lp_unit);
}

// The operative created for squad slot lp_index (0 based, same order as the configured squad).
unit GhostOps_SquadUnit (int lp_index) {
    if ((lp_index < 0) || (lp_index > 5)) {
        return null;
    }

    return go_squadUnit[lp_index];
}

bool GhostOps_IsOperative (unit lp_unit) {
    return UnitGroupHasUnit(go_operatives, lp_unit);
}

//--------------------------------------------------------------------------------------------------
// BaseSupport: damage multiplier for the regular army
//--------------------------------------------------------------------------------------------------
void GhostOps_SupportUnit (unit lp_unit) {
    if (lp_unit == null) {
        return;
    }

    if (go_supportBehavior == "") {
        return;
    }

    if (GhostOps_IsOperative(lp_unit)) {
        return;
    }

    if (UnitGroupHasUnit(go_supported, lp_unit)) {
        return;
    }

    UnitBehaviorAdd(lp_unit, go_supportBehavior, lp_unit, 1);
    UnitGroupAdd(go_supported, lp_unit);
}

// Removes the behavior from every unit that received it.
void GhostOps_ClearSupport () {
    int lv_i;
    unit lv_unit;

    lv_i = UnitGroupCount(go_supported, c_unitCountAll);
    while (lv_i >= 1) {
        lv_unit = UnitGroupUnit(go_supported, lv_i);
        if (lv_unit != null) {
            UnitBehaviorRemove(lv_unit, go_supportBehavior, 1);
        }

        lv_i -= 1;
    }

    UnitGroupClear(go_supported);
}

//--------------------------------------------------------------------------------------------------
// Experimental: invulnerable allies (old model, off by default)
//--------------------------------------------------------------------------------------------------
void GhostOps_ShieldUnit (unit lp_unit) {
    if (lp_unit == null) {
        return;
    }

    if (GhostOps_IsOperative(lp_unit)) {
        return;
    }

    if (UnitGroupHasUnit(go_protected, lp_unit)) {
        return;
    }

    // Units the mission made invulnerable itself are left alone and never released by us.
    if (UnitTestState(lp_unit, c_unitStateInvulnerable)) {
        return;
    }

    UnitSetState(lp_unit, c_unitStateInvulnerable, true);
    UnitGroupAdd(go_protected, lp_unit);
}

void GhostOps_ReleaseShield () {
    int lv_i;
    unit lv_unit;

    lv_i = UnitGroupCount(go_protected, c_unitCountAll);
    while (lv_i >= 1) {
        lv_unit = UnitGroupUnit(go_protected, lv_i);
        if (lv_unit != null) {
            UnitSetState(lv_unit, c_unitStateInvulnerable, false);
        }

        lv_i -= 1;
    }

    UnitGroupClear(go_protected);
}

//--------------------------------------------------------------------------------------------------
// Scanning (also covers units that appear later: reinforcements, trained and rescued units)
//--------------------------------------------------------------------------------------------------
void GhostOps_ScanPlayer (int lp_player) {
    unitgroup lv_group;
    int lv_count;
    int lv_i;

    // Structures are not buffed automatically (bunkers would double the bonus together with the
    // marines inside); they are only considered by the experimental shield.
    if (go_supportBehavior != "") {
        lv_group = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_group, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_count) {
            GhostOps_SupportUnit(UnitGroupUnit(lv_group, lv_i));
            lv_i += 1;
        }
    }

    if (go_cfgInvulnerableAllies) {
        lv_group = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_group, c_unitCountAll);
        lv_i = 1;
        while (lv_i <= lv_count) {
            GhostOps_ShieldUnit(UnitGroupUnit(lv_group, lv_i));
            lv_i += 1;
        }
    }
}

void GhostOps_ScanAll () {
    int lv_p;

    lv_p = 0;
    while (lv_p < 16) {
        if (go_playerCovered[lv_p]) {
            GhostOps_ScanPlayer(lv_p);
        }

        lv_p += 1;
    }
}

bool GhostOps_ScanTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    GhostOps_ScanAll();
    return true;
}

//--------------------------------------------------------------------------------------------------
// Fragile units: the configured unit type of covered players has its MAXIMUM life lowered (so that
// healing cannot raise it again). Units of other players are never touched. The scan runs every
// 0.2 s, which is faster than any unit created by the mission can reach a fight.
//--------------------------------------------------------------------------------------------------
void GhostOps_FragileScan () {
    unitgroup lv_group;
    int lv_p;
    int lv_k;
    int lv_count;
    int lv_i;
    unit lv_unit;

    lv_p = 0;
    while (lv_p < 16) {
        if (go_playerCovered[lv_p]) {
            lv_k = 0;
            while (lv_k < go_cfgFragileCount) {
            lv_group = UnitGroup(go_cfgFragileType[lv_k], lv_p, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
            lv_count = UnitGroupCount(lv_group, c_unitCountAll);
            lv_i = 1;
            while (lv_i <= lv_count) {
                lv_unit = UnitGroupUnit(lv_group, lv_i);
                if ((lv_unit != null) && (UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent) > go_cfgFragileLife[lv_k])) {
                    UnitSetPropertyFixed(lv_unit, c_unitPropLifeMax, go_cfgFragileLife[lv_k]);
                    UnitSetPropertyFixed(lv_unit, c_unitPropLife, go_cfgFragileLife[lv_k]);
                }

                lv_i += 1;
            }
            lv_k += 1;
            }
        }

        lv_p += 1;
    }
}

bool GhostOps_FragileTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    GhostOps_FragileScan();
    return true;
}

// Adapters call this first in their start hook: the mission may reach the hook through more than one
// scenario branch (for example watching or skipping an intro), the squad must appear exactly once.
bool GhostOps_ClaimStart () {
    if (go_missionStarted) {
        return false;
    }

    go_missionStarted = true;
    return true;
}

// Called from an early hook before the mission initialises its difficulty-dependent triggers.
void GhostOps_CaptureInit () {
    go_initDifficulty = PlayerDifficulty(1);
}

// Entry point for a future menu: 1 = original damage, 2 = double, 3 = triple.
void GhostOps_SetDamageMultiplier (int lp_multiplier) {
    if ((lp_multiplier < 1) || (lp_multiplier > 3)) {
        return;
    }

    GhostOps_ClearSupport();
    go_cfgDamageMultiplier = lp_multiplier;
    go_supportBehavior = GhostOps_BehaviorFor(lp_multiplier);
    GhostOps_ScanAll();
}

// Starts the periodic scan.
void GhostOps_Start () {
    GhostOps_Panel_Start();
    go_scanTrigger = TriggerCreate("GhostOps_ScanTick");
    TriggerAddEventTimePeriodic(go_scanTrigger, 1.0, c_timeGame);
    GhostOps_ScanAll();
    if (go_cfgFragileCount > 0) {
        go_fragileTrigger = TriggerCreate("GhostOps_FragileTick");
        TriggerAddEventTimePeriodic(go_fragileTrigger, 0.2, c_timeGame);
        GhostOps_FragileScan();
    }
}

//--------------------------------------------------------------------------------------------------
// Diagnostics
//--------------------------------------------------------------------------------------------------
// Shows the campaign difficulty the mission really runs on (1 casual, 2 normal, 3 hard, 4 brutal).
// The message is repeated every 10 seconds for one minute so that it can be read and photographed.
int go_difficultyShown;
trigger go_difficultyTrigger;

// Reads the values the game actually uses (catalog), so the Owner can see a map's Ghost tuning in game.
string GhostOps_TuningText () {
    return " | Ghost energy max " + CatalogFieldValueGet(c_gameCatalogUnit, "Ghost", "EnergyMax", 1)
        + ", regen " + CatalogFieldValueGet(c_gameCatalogUnit, "Ghost", "EnergyRegenRate", 1)
        + ", cloak drain " + CatalogFieldValueGet(c_gameCatalogBehavior, "GhostCloak", "Modification.VitalRegenArray[Energy]", 1)
        + ", cloak cost " + CatalogFieldValueGet(c_gameCatalogAbil, "GhostCloak", "Cost[0].Vital[Energy]", 1)
        + ", Snipe cost " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Vital[Energy]", 1)
        + ", cast " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "CastIntroTime", 1)
        + ", cooldown " + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Cooldown.TimeUse", 1)
        + " (" + CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Cost[0].Cooldown.Location", 1) + ")"
        + ", damage " + CatalogFieldValueGet(c_gameCatalogEffect, "SnipeDamage", "Amount", 1);
}

void GhostOps_ShowDifficultyMessage (int lp_player) {
    string lv_text;

    lv_text = "Ghost Ops diagnostics | PlayerDifficulty at init = " + IntToString(go_initDifficulty) + ", now = " + IntToString(PlayerDifficulty(lp_player)) + " (expected " + IntToString(go_cfgExpectedDifficulty) + "; 0 = not captured); PersonalCloaking = " + IntToString(TechTreeUpgradeCount(lp_player, "PersonalCloaking", c_techCountCompleteOnly));
    if (go_cfgShowTuning) {
        lv_text = lv_text + GhostOps_TuningText();
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringToText(lv_text));
}

bool GhostOps_DifficultyTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    GhostOps_ShowDifficultyMessage(1);
    go_difficultyShown += 1;
    if (go_difficultyShown >= 6) {
        TriggerDestroy(go_difficultyTrigger);
    }

    return true;
}

// One short message naming the Ghost Ops profile of this mission start. The text comes from the map's
// string table (StringExternal), because Galaxy source must stay plain ASCII (a Cyrillic literal breaks the compile).
void GhostOps_ReportProfile () {
    if (!go_cfgHasProfile) {
        return;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, go_cfgPresetText);
}

void GhostOps_ReportDifficulty (int lp_player) {
    if (!go_cfgShowDifficulty) {
        return;
    }

    GhostOps_ShowDifficultyMessage(lp_player);
    go_difficultyTrigger = TriggerCreate("GhostOps_DifficultyTick");
    TriggerAddEventTimePeriodic(go_difficultyTrigger, 10.0, c_timeReal);
}

//--------------------------------------------------------------------------------------------------
// Operatives
//--------------------------------------------------------------------------------------------------
// Standard Ghosts need the campaign upgrade PersonalCloaking before GhostCloak can be used; the
// Crius Suit upgrade PermanentCloakGhost (Blizzard's own) makes their cloak free of energy cost.
// Both are player level: any other Ghost of the same player is affected as well.
void GhostOps_GrantGhostTech (int lp_player) {
    TechTreeUpgradeAddLevel(lp_player, "PersonalCloaking", 1);
    // The campaign enables tech tree restrictions; make sure the plain cloak commands are allowed.
    TechTreeAbilityAllow(lp_player, AbilityCommand("GhostCloak", 0), true);
    TechTreeAbilityAllow(lp_player, AbilityCommand("GhostCloak", 1), true);
    if (go_cfgGhostPermanentCloak) {
        TechTreeUpgradeAddLevel(lp_player, "PermanentCloakGhost", 1);
    }
}

bool GhostOps_SquadHasGhost () {
    int lv_i;

    lv_i = 0;
    while (lv_i < go_cfgSquadSize) {
        if (go_cfgSquadType[lv_i] == "Ghost") {
            return true;
        }

        lv_i += 1;
    }

    return false;
}

// Start state of every operative (a moment after creation so that upgrades are in effect):
// hold fire for all of them, cloak on for standard Ghosts. Only Blizzard's own abilities are used.
bool GhostOps_StartStateTick (bool lp_testConds, bool lp_runActions) {
    int lv_i;
    int lv_count;
    unit lv_unit;

    if (!lp_runActions) {
        return true;
    }

    lv_count = UnitGroupCount(go_operatives, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_count) {
        lv_unit = UnitGroupUnit(go_operatives, lv_i);
        if (lv_unit != null) {
            // Medics have no weapon and no hold-fire command; they keep their automatic healing.
            if (go_cfgStartHoldFire && (UnitGetType(lv_unit) != "Medic")) {
                UnitIssueOrder(lv_unit, Order(AbilityCommand("GhostHoldFire", 0)), c_orderQueueAddToEnd);
            }

            if (go_cfgGhostStartCloaked && (UnitGetType(lv_unit) == "Ghost")) {
                UnitIssueOrder(lv_unit, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueAddToEnd);
            }
        }

        lv_i += 1;
    }

    return true;
}

// Creates the configured squad for a player and returns the first operative. Existing units of the
// player are never replaced or retyped: the operatives are added on top. Every operative is
// registered before the first BaseSupport scan, so none of them receives the army bonus.
unit GhostOps_SpawnOperatives (int lp_player, point lp_origin) {
    int lv_i;
    int lv_fighters;
    int lv_support;
    unit lv_first;
    point lv_pos;

    lv_first = null;
    lv_fighters = 0;
    lv_support = 0;
    if (GhostOps_SquadHasGhost()) {
        GhostOps_GrantGhostTech(lp_player);
    }

    GhostOps_ApplyAbilityRestrictions(lp_player);

    lv_i = 0;
    while (lv_i < go_cfgSquadSize) {
        // Fighters stand in a row at the origin, medics in a second row behind them (south).
        if (go_cfgSquadType[lv_i] == "Medic") {
            lv_pos = PointWithOffset(lp_origin, 1.0 + (2.0 * lv_support), -2.5);
            lv_support += 1;
        }
        else {
            lv_pos = PointWithOffset(lp_origin, 2.0 * lv_fighters, 0.0);
            lv_fighters += 1;
        }

        UnitCreate(1, go_cfgSquadType[lv_i], 0, lp_player, lv_pos, 270.0);
        GhostOps_RegisterOperative(UnitLastCreated());
        go_squadUnit[lv_i] = UnitLastCreated();
        if (lv_first == null) {
            lv_first = UnitLastCreated();
        }

        lv_i += 1;
    }

    go_startStateTrigger = TriggerCreate("GhostOps_StartStateTick");
    TriggerAddEventTimeElapsed(go_startStateTrigger, 0.5, c_timeGame);
    return lv_first;
}

// The same squad, but created inside a transport that the adapter flies in later. The operatives are registered
// at once (before any scan), exactly as with GhostOps_SpawnOperatives; returns the first of them.
unit GhostOps_SpawnOperativesInCargo (int lp_player, unit lp_carrier) {
    int lv_i;
    unit lv_first;

    lv_first = null;
    if (GhostOps_SquadHasGhost()) {
        GhostOps_GrantGhostTech(lp_player);
    }

    GhostOps_ApplyAbilityRestrictions(lp_player);
    lv_i = 0;
    while (lv_i < go_cfgSquadSize) {
        UnitCargoCreate(lp_carrier, go_cfgSquadType[lv_i], 1);
        GhostOps_RegisterOperative(UnitCargoLastCreated());
        go_squadUnit[lv_i] = UnitCargoLastCreated();
        if (lv_first == null) {
            lv_first = UnitCargoLastCreated();
        }

        lv_i += 1;
    }

    go_startStateTrigger = TriggerCreate("GhostOps_StartStateTick");
    TriggerAddEventTimeElapsed(go_startStateTrigger, 0.5, c_timeGame);
    return lv_first;
}
