//--------------------------------------------------------------------------------------------------
// Ghost ability "Detector analysis", early-warning mode (config key detector_analysis.early_warning; reusable by any mission whose profile enables it). Used together with
// core/GhostOpsDetector.galaxy in its permanent mode (every Ghost carries the radar, no dependence on the selection).
//
// Why the stock circle comes late (data of the installed game, liberty / campaign data): the Hero Detector Radar (Nova mechanic) applies its buff only to detectors that satisfy the
// search filter "Visible,Detector" within 25, and the circle actor lives on that detector unit. A detector is "Visible" only when the player sees it, and the Ghost's own sight
// (about 11) is about the detection radius (10..12): the circle shows up when the Ghost is already at the edge of the detection. A detector in the fog never gets the circle.
//
// This mode makes the detector visible EARLIER and only that: every 0.2 s, for every living Ghost, the script looks for enemy detectors (the unit behaviors Detector10/11/12: a detector that
// died or lost its detection no longer carries them) within (its detection radius + the warning margin) of the Ghost and reveals a small patch (2 cells) around exactly that detector for
// half a second. The stock radar then puts its buff on the visible detector and the circle of the real detection radius is drawn on it; it follows a moving detector because the patch
// is placed at its current position every tick. The map and the rest of the enemy army are NOT revealed; the detector itself is seen while it is a danger for the Ghost (the price of the
// method, to be stated plainly). The radar searches 25 cells around the Ghost, so radius 12 + margin 13 is the limit of the margin. A loaded game just continues (a trigger is saved).
//--------------------------------------------------------------------------------------------------
fixed go_daeMargin;
trigger go_daeTrig;
int go_daeTicks;   // diagnostics read by the probes: ticks, Ghosts seen in the last tick, detectors revealed in the last tick
int go_daeGhosts;
int go_daeFound;

bool GhostOps_DAE_IsDetector (unit lp_det) {
    return (UnitBehaviorCount(lp_det, "Detector10") > 0) || (UnitBehaviorCount(lp_det, "Detector11") > 0) || (UnitBehaviorCount(lp_det, "Detector12") > 0);
}

fixed GhostOps_DAE_Radius (unit lp_det) {
    if (UnitBehaviorCount(lp_det, "Detector12") > 0) {
        return 12.0;
    }

    if (UnitBehaviorCount(lp_det, "Detector10") > 0) {
        return 10.0;
    }

    return 11.0;
}

// One Ghost: every enemy detector within (its radius + the margin) of the point is revealed for half a second. A separate function with ONE group loop: a group loop inside a group loop of
// the same function stops the outer loop after its first unit (measured in the game: the second Ghost was never looked at).
void GhostOps_DAE_Scan (point lp_p) {
    unitgroup lv_s;
    unit lv_d;

    lv_s = UnitGroupSearch(null, c_playerAny, lp_p, 12.0 + go_daeMargin + 2.0, UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_s);
    while (UnitGroupLoopCurrent() != null) {
        lv_d = UnitGroupLoopCurrent();
        if (UnitIsAlive(lv_d) && UnitFilterMatch(lv_d, 1, UnitFilterStr("Enemy;Dead,Hidden,Stasis")) && GhostOps_DAE_IsDetector(lv_d)) {
            if (DistanceBetweenPoints(lp_p, UnitGetPosition(lv_d)) <= (GhostOps_DAE_Radius(lv_d) + go_daeMargin)) {
                go_daeFound += 1;
                VisRevealArea(1, RegionCircle(UnitGetPosition(lv_d), 2.0), 0.5, false);
            }
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
}

bool GhostOps_DAE_Tick (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_g;
    point[8] lv_gp;
    int lv_n;
    int lv_i;

    if (!lp_runActions) {
        return true;
    }

    go_daeTicks += 1;
    go_daeFound = 0;
    // the positions of the living Ghosts first (one loop), then one scan each (no nested group loops)
    lv_n = 0;
    lv_g = UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_g);
    while ((UnitGroupLoopCurrent() != null) && (lv_n < 8)) {
        lv_gp[lv_n] = UnitGetPosition(UnitGroupLoopCurrent());
        lv_n += 1;
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    go_daeGhosts = lv_n;
    lv_i = 0;
    while (lv_i < lv_n) {
        GhostOps_DAE_Scan(lv_gp[lv_i]);
        lv_i += 1;
    }

    return true;
}

void GhostOps_ApplyDetectorEarlyConfig ();

void GhostOps_DAE_Start () {
    GhostOps_ApplyDetectorEarlyConfig();
    if (go_daeTrig != null) {
        return;
    }

    go_daeTrig = TriggerCreate("GhostOps_DAE_Tick");
    TriggerAddEventTimePeriodic(go_daeTrig, 0.2, c_timeGame);
}
