//==================================================================================================
// GhostOps module: THanson02 "Outbreak" (Epidemic), free test version (config key "epidemic"; see config/thanson02.json and docs/MISSION_ROADMAP.md).
//
// What this module adds to the ORIGINAL mission (the original intro, scenes, day / night cycle, infestation, waves and the victory "all infested structures destroyed" are kept):
//   * hellion FUEL: the Swann hellions (and the extra ones of the test squad) carry fuel as the ENERGY bar of the unit (shown by the engine in the selection panel and in the group
//     grid). Fuel is spent by the distance really driven. An empty hellion stops (buff GhostOpsNoFuel) but keeps shooting, being repaired and being refuelled. At the base the
//     local gas fills only a part of the tank (poor quality); the first time a hellion runs dry far from the base a one-time scene (Swann, Tychus) points at the abandoned gas truck;
//   * the GAS TRUCK (stock TankerTruck): abandoned, neutral (nobody attacks it), a few infested defenders around it. Infantry of the player that comes close captures it once. Its
//     energy bar is the stock of good fuel; it refuels hellions standing near it automatically (the fuel really leaves the truck). Brought back to the base it makes the local fuel
//     good (full tanks at the base) and can be refilled there for gas;
//   * DAY / NIGHT: hooks of the original cycle: a few big infested structures are protected by day (damage shield, labelled, explained once by Hanson) and vulnerable by night; the
//     Ghosts have a free cloak by day and a limited one by night; ONE night transport (stock Medivac) comes at night, must be kept alive and leaves after the dawn;
//   * a compact HUD (fuel of the selected hellions, the truck stock).
// Revision 7 adds: the SUPPLY ZONE (the perimeter of the original base as a polygon: inside it the movement of a hellion costs no fuel and an empty hellion refills up to the available
// limit; the same zone is "the base" of the truck and of the Hercules) and the BARREL DROP of the Hercules (a button with two charges: the ship flies to the point, a barrel falls, the existing
// container blast explodes at the impact; the charges come back only in the supply zone).
// Everything that is saved is a global of this module (units, counters, scene flags); a load restores the state, dialogs and text tags are rebuilt by the load handler.
//==================================================================================================
bool go_eEnabled;
bool go_eDebug;
int go_eLogN;
bank go_eBank;

// ---- configuration (generated by GhostOps_ApplyEpidemicConfig)
point go_eBase;
fixed go_eBaseR;
fixed go_eTank;
fixed go_ePerCell;
fixed go_eFillPoor;
fixed go_eFillGood;
fixed go_eBaseRate;
fixed go_eFieldR;
fixed go_eFieldRate;
fixed go_eMaxStep;
point go_eTruckAt;
string go_eShipType;            // the transport unit of the profile ("" = the stock Medivac of the earlier revisions); a Hercules carries 30 and its passengers are rescued in pods when it is destroyed
fixed go_eTruckFuelMax;
fixed go_eTruckFuel0;
fixed go_eCapR;
int go_eCapN;
bool go_eCapClose;            // revision 6: the truck is free until a ground fighter stands right next to it (go_eCapR); coming into the big area only marks it as found
fixed go_eDetectR;
bool go_eTruckSeen;
fixed go_eGasToFuel;
fixed go_eTruckBaseRate;
fixed go_eRevealR;
fixed go_eRevealSec;
int go_eDefTerran;
int go_eDefCivil;
fixed go_eDefR;
int go_eExtraHell;
fixed go_eNightNet;
fixed go_eDayNet;
fixed go_eRegen;
int go_eProtMax;
int go_eProtTypeN;
string[8] go_eProtType;
bool go_eShipOn;
int go_eShipFirstNight;
point go_eDock;
fixed go_eDockR;
fixed go_eWarnSec;
int go_eHudX;
int go_eHudY;
int go_eHudW;
int go_eHudH;
fixed go_eDevDay;                // development only (epidemic.dev_cycle): a shorter day / night so that a short scenario crosses the transitions
fixed go_eDevNight;
bool go_eZoneOn;                // revision 7: the base is a polygon (the perimeter of the original base); without it the circle go_eBase / go_eBaseR
int go_eZoneN;
fixed[24] go_eZoneX;
fixed[24] go_eZoneY;
bool go_bdOn;                   // revision 7: the barrel drop of the Hercules
int go_bdMax;                   // barrels of one flight
fixed go_bdFall;                // seconds from the release to the impact (the flight time of the missile mover); a barrel that has not arrived 2.5 s later than that explodes anyway (a lost missile never keeps a slot)
void GhostOps_ApplyEpidemicConfig ();
int GhostOps_Epi_BarrelsLeft ();

// ---- saved state
int go_eStage;                  // 0 start, 1 first dry hellion far from the base seen, 2 the truck was announced, 3 captured, 4 brought to the base (good fuel at the base)
bool[8] go_eScene;              // 0 gas (Swann), 1 truck (Tychus), 2 captured (Swann), 3 base fuel (Swann), 4 night transport (Swann), 5 protected buildings (Hanson)
unit go_eTruck;
bool go_eTruckLost;
fixed go_eGasAcc;
int go_eObj;
bool go_eObjMade;
unit[16] go_eHell;
point[16] go_eHellPos;
bool[16] go_eHellDry;
int go_eHellN;
unit[8] go_eProt;
int go_eProtN;
bool[8] go_eProtTagOn;
int[8] go_eProtTag;
bool go_eIsNight;
int go_eNightNo;
unit go_eShip;
bool go_eShipMade;
bool go_eShipDead;
bool go_eShipAway;
bool go_eNightOpen;
fixed go_eWarnAt;
bool go_eWarned;
fixed go_eLastTime;
int go_eTickN;
int go_eHud;
int go_eHudL1;
int go_eHudL2;
trigger go_eTickTrig;
trigger go_eLoadTrig;
trigger go_eAttackTrig;
unit[4] go_bdSrc;               // the barrels in the air: the ship, the falling dummy, the point, the moment of the impact (saved with the game: a load neither repeats nor loses an explosion)
int go_bdSeq;                   // the order of the drops: the impacts are told apart by it (the first drop lands first: the same flight time)
int[4] go_bdNo;
trigger go_bdImpTrig;
point[4] go_bdPos;
fixed[4] go_bdAt;
bool[4] go_bdLive;
bool go_bdOut;                  // the ship has been outside the supply zone since its last drop or refill: only a RETURN refills the barrels
int go_bdDrops;
int go_bdBlasts;
int go_bdRefills;
int go_eHudL3;
trigger go_bdCastTrig;
trigger go_bdTickTrig;

void GhostOps_Epi_Log (string lp_text) {
    if (!go_eDebug) {
        return;
    }

    go_eBank = BankLoad("GhostOpsDevEpi", 1);
    go_eLogN += 1;
    BankValueSetFromString(go_eBank, "log", "e" + IntToString(go_eLogN), FixedToString(GameGetMissionTime(), 2) + " " + lp_text);
    BankSave(go_eBank);
}

//--------------------------------------------------------------------------------------------------
// Scenes (portrait with the talking animation + readable text; once; queued behind the original talks, so the original timers and the AI are never held)
//--------------------------------------------------------------------------------------------------
void GhostOps_Epi_Line (string lp_id, string lp_spk, fixed lp_sec) {
    string lv_model;
    int lv_grp;
    string lv_name;

    if (lp_spk == "tychus") {
        lv_model = "TychusPortrait";
        lv_grp = 6;
        lv_name = "TychusName";
    }
    else if (lp_spk == "hanson") {
        lv_model = "HansonPortrait";
        lv_grp = 7;
        lv_name = "HansonName";
    }
    else {
        lv_model = "SwannPortrait";
        lv_grp = 1;
        lv_name = "SwannName";
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/GhostOpsE_" + lv_name) + StringToText(": ") + StringExternal("Param/Value/GhostOpsE_L_" + lp_id));
    GhostOps_Talk(lv_model, lv_grp, lp_sec);
}

void GhostOps_Epi_ObjectiveTruck () {
    if (go_eObjMade) {
        return;
    }

    go_eObjMade = true;
    ObjectiveCreate(StringExternal("Param/Value/GhostOpsE_ObjTruckTitle"), StringExternal("Param/Value/GhostOpsE_ObjTruckText"), c_objectiveStateActive, false);
    go_eObj = ObjectiveLastCreated();
}

// Scene 0 + 1: the local gas is bad, the abandoned truck is the answer; then the mark, a short local reveal and the objective.
bool GhostOps_Epi_SceneFuel (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: bad gas (Swann)");
    GhostOps_Epi_Line("GAS", "swann", 8.0);
    Wait(1.0, c_timeGame);
    GhostOps_Epi_Log("scene: abandoned truck (Tychus)");
    GhostOps_Epi_Line("TRUCK", "tychus", 8.0);
    go_eStage = 2;
    GhostOps_Epi_ObjectiveTruck();
    if (UnitIsAlive(go_eTruck)) {
        VisRevealArea(1, RegionCircle(UnitGetPosition(go_eTruck), go_eRevealR), go_eRevealSec, false);
        MinimapPing(PlayerGroupSingle(1), UnitGetPosition(go_eTruck), 6.0, Color(100.00, 80.00, 0.00));
    }

    TriggerQueueExit();
    return true;
}

bool GhostOps_Epi_SceneCapture (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: truck captured, how refuelling works (Swann)");
    GhostOps_Epi_Line("CAPTURE", "swann", 9.0);
    TriggerQueueExit();
    return true;
}

