//==================================================================================================
// GhostOps module: THanson02 "Outbreak" (Epidemic), free test version (config key "epidemic"; see config/thanson02.json and docs/MISSION_ROADMAP.md).
//
// What this module adds to the ORIGINAL mission (the original intro, scenes, day / night cycle, infestation, waves and the victory "all infested structures destroyed" are kept):
//   * hellion FUEL: the Swann hellions (and the extra ones of the test squad) carry fuel as the ENERGY bar of the unit (shown by the engine in the selection panel and in the group
//     grid). Fuel is spent by the distance really driven. An empty hellion stops (buff GhostOpsNoFuel) but keeps shooting, being repaired and being refuelled. At the base the
//     local gas fills only a part of the tank (poor quality); the first time a hellion runs dry far from the base a one-time scene (Swann, Tychus) points at the abandoned gas truck;
//   * the GAS TRUCK (stock TankerTruck): abandoned, neutral (nobody attacks it), a few infested defenders around it. Infantry of the player that comes close captures it once. Its
//     energy bar is the stock of good fuel; it refuels hellions standing near it automatically (the fuel really leaves the truck). Brought back to the base it makes the local fuel
//     good (full tanks at the base) and can be refilled there for gas;
//   * DAY / NIGHT: hooks of the original cycle: a few big infested structures are protected by day (damage shield, labelled, explained once by Hanson) and vulnerable by night; the
//     Ghosts have a free cloak by day and a limited one by night; ONE night transport (stock Medivac) comes at night, must be kept alive and leaves after the dawn;
//   * a compact HUD (fuel of the selected hellions, the truck stock).
// Everything that is saved is a global of this module (units, counters, scene flags); a load restores the state, dialogs and text tags are rebuilt by the load handler.
//==================================================================================================
bool go_eEnabled;
bool go_eDebug;
int go_eLogN;
bank go_eBank;

// ---- configuration (generated by GhostOps_ApplyEpidemicConfig)
point go_eBase;
fixed go_eBaseR;
fixed go_eTank;
fixed go_ePerCell;
fixed go_eFillPoor;
fixed go_eFillGood;
fixed go_eBaseRate;
fixed go_eFieldR;
fixed go_eFieldRate;
fixed go_eMaxStep;
point go_eTruckAt;
string go_eShipType;            // the transport unit of the profile ("" = the stock Medivac of the earlier revisions); a Hercules carries 30 and its passengers are rescued in pods when it is destroyed
fixed go_eTruckFuelMax;
fixed go_eTruckFuel0;
fixed go_eCapR;
int go_eCapN;
fixed go_eGasToFuel;
fixed go_eTruckBaseRate;
fixed go_eRevealR;
fixed go_eRevealSec;
int go_eDefTerran;
int go_eDefCivil;
fixed go_eDefR;
int go_eExtraHell;
fixed go_eNightNet;
fixed go_eDayNet;
fixed go_eRegen;
int go_eProtMax;
int go_eProtTypeN;
string[8] go_eProtType;
bool go_eShipOn;
int go_eShipFirstNight;
point go_eDock;
fixed go_eDockR;
fixed go_eWarnSec;
int go_eHudX;
int go_eHudY;
int go_eHudW;
int go_eHudH;
fixed go_eDevDay;                // development only (epidemic.dev_cycle): a shorter day / night so that a short scenario crosses the transitions
fixed go_eDevNight;
void GhostOps_ApplyEpidemicConfig ();

// ---- saved state
int go_eStage;                  // 0 start, 1 first dry hellion far from the base seen, 2 the truck was announced, 3 captured, 4 brought to the base (good fuel at the base)
bool[8] go_eScene;              // 0 gas (Swann), 1 truck (Tychus), 2 captured (Swann), 3 base fuel (Swann), 4 night transport (Swann), 5 protected buildings (Hanson)
unit go_eTruck;
bool go_eTruckLost;
fixed go_eGasAcc;
int go_eObj;
bool go_eObjMade;
unit[16] go_eHell;
point[16] go_eHellPos;
bool[16] go_eHellDry;
int go_eHellN;
unit[8] go_eProt;
int go_eProtN;
bool[8] go_eProtTagOn;
int[8] go_eProtTag;
bool go_eIsNight;
int go_eNightNo;
unit go_eShip;
bool go_eShipMade;
bool go_eShipDead;
bool go_eShipAway;
bool go_eNightOpen;
fixed go_eWarnAt;
bool go_eWarned;
fixed go_eLastTime;
int go_eTickN;
int go_eHud;
int go_eHudL1;
int go_eHudL2;
trigger go_eTickTrig;
trigger go_eLoadTrig;
trigger go_eAttackTrig;

void GhostOps_Epi_Log (string lp_text) {
    if (!go_eDebug) {
        return;
    }

    go_eBank = BankLoad("GhostOpsDevEpi", 1);
    go_eLogN += 1;
    BankValueSetFromString(go_eBank, "log", "e" + IntToString(go_eLogN), FixedToString(GameGetMissionTime(), 2) + " " + lp_text);
    BankSave(go_eBank);
}

//--------------------------------------------------------------------------------------------------
// Scenes (portrait with the talking animation + readable text; once; queued behind the original talks, so the original timers and the AI are never held)
//--------------------------------------------------------------------------------------------------
void GhostOps_Epi_Line (string lp_id, string lp_spk, fixed lp_sec) {
    string lv_model;
    int lv_grp;
    string lv_name;

    if (lp_spk == "tychus") {
        lv_model = "TychusPortrait";
        lv_grp = 6;
        lv_name = "TychusName";
    }
    else if (lp_spk == "hanson") {
        lv_model = "HansonPortrait";
        lv_grp = 7;
        lv_name = "HansonName";
    }
    else {
        lv_model = "SwannPortrait";
        lv_grp = 1;
        lv_name = "SwannName";
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/GhostOpsE_" + lv_name) + StringToText(": ") + StringExternal("Param/Value/GhostOpsE_L_" + lp_id));
    GhostOps_Talk(lv_model, lv_grp, lp_sec);
}

void GhostOps_Epi_ObjectiveTruck () {
    if (go_eObjMade) {
        return;
    }

    go_eObjMade = true;
    ObjectiveCreate(StringExternal("Param/Value/GhostOpsE_ObjTruckTitle"), StringExternal("Param/Value/GhostOpsE_ObjTruckText"), c_objectiveStateActive, false);
    go_eObj = ObjectiveLastCreated();
}

// Scene 0 + 1: the local gas is bad, the abandoned truck is the answer; then the mark, a short local reveal and the objective.
bool GhostOps_Epi_SceneFuel (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: bad gas (Swann)");
    GhostOps_Epi_Line("GAS", "swann", 8.0);
    Wait(1.0, c_timeGame);
    GhostOps_Epi_Log("scene: abandoned truck (Tychus)");
    GhostOps_Epi_Line("TRUCK", "tychus", 8.0);
    go_eStage = 2;
    GhostOps_Epi_ObjectiveTruck();
    if (UnitIsAlive(go_eTruck)) {
        VisRevealArea(1, RegionCircle(UnitGetPosition(go_eTruck), go_eRevealR), go_eRevealSec, false);
        MinimapPing(PlayerGroupSingle(1), UnitGetPosition(go_eTruck), 6.0, Color(100.00, 80.00, 0.00));
    }

    TriggerQueueExit();
    return true;
}

bool GhostOps_Epi_SceneCapture (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: truck captured, how refuelling works (Swann)");
    GhostOps_Epi_Line("CAPTURE", "swann", 9.0);
    TriggerQueueExit();
    return true;
}

bool GhostOps_Epi_SceneBase (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: local fuel prepared (Swann)");
    GhostOps_Epi_Line("BASE", "swann", 9.0);
    TriggerQueueExit();
    return true;
}

bool GhostOps_Epi_SceneShip (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: night transport (Swann)");
    GhostOps_Epi_Line("SHIP", "swann", 9.0);
    TriggerQueueExit();
    return true;
}

bool GhostOps_Epi_SceneProt (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    GhostOps_Epi_Log("scene: protected buildings (Hanson)");
    GhostOps_Epi_Line("PROT", "hanson", 8.0);
    TriggerQueueExit();
    return true;
}

void GhostOps_Epi_Scene (int lp_id) {
    if (go_eScene[lp_id]) {
        return;
    }

    go_eScene[lp_id] = true;
    if (lp_id == 0) {
        go_eScene[1] = true;
        TriggerExecute(TriggerCreate("GhostOps_Epi_SceneFuel"), true, false);
    }
    else if (lp_id == 2) {
        TriggerExecute(TriggerCreate("GhostOps_Epi_SceneCapture"), true, false);
    }
    else if (lp_id == 3) {
        TriggerExecute(TriggerCreate("GhostOps_Epi_SceneBase"), true, false);
    }
    else if (lp_id == 4) {
        TriggerExecute(TriggerCreate("GhostOps_Epi_SceneShip"), true, false);
    }
    else if (lp_id == 5) {
        TriggerExecute(TriggerCreate("GhostOps_Epi_SceneProt"), true, false);
    }
}

//--------------------------------------------------------------------------------------------------
// HUD
//--------------------------------------------------------------------------------------------------
void GhostOps_Epi_CreateHud () {
    DialogCreate(go_eHudW, go_eHudH, c_anchorTopLeft, go_eHudX, go_eHudY, false);
    go_eHud = DialogLastCreated();
    DialogControlCreate(go_eHud, c_triggerControlTypeLabel);
    go_eHudL1 = DialogControlLastCreated();
    DialogControlSetSize(go_eHudL1, PlayerGroupAll(), go_eHudW, go_eHudH / 2);
    DialogControlSetPosition(go_eHudL1, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogControlSetPropertyAsString(go_eHudL1, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    DialogControlCreate(go_eHud, c_triggerControlTypeLabel);
    go_eHudL2 = DialogControlLastCreated();
    DialogControlSetSize(go_eHudL2, PlayerGroupAll(), go_eHudW, go_eHudH / 2);
    DialogControlSetPosition(go_eHudL2, PlayerGroupAll(), c_anchorTopLeft, 0, go_eHudH / 2);
    DialogControlSetPropertyAsString(go_eHudL2, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    DialogSetVisible(go_eHud, PlayerGroupAll(), true);
}

void GhostOps_Epi_UpdateHud () {
    int lv_i;
    int lv_sel;
    int lv_dry;
    int lv_all;
    fixed lv_min;
    fixed lv_e;
    text lv_a;
    text lv_b;

    if (go_eHud == c_invalidDialogId) {
        return;
    }

    lv_sel = 0;
    lv_dry = 0;
    lv_all = 0;
    lv_min = 100000.0;
    lv_i = 0;
    while (lv_i < go_eHellN) {
        if (UnitIsAlive(go_eHell[lv_i])) {
            lv_all += 1;
            lv_e = UnitGetPropertyFixed(go_eHell[lv_i], c_unitPropEnergy, c_unitPropCurrent);
            if (go_eHellDry[lv_i]) {
                lv_dry += 1;
            }

            if (UnitIsSelected(go_eHell[lv_i], 1)) {
                lv_sel += 1;
                if (lv_e < lv_min) {
                    lv_min = lv_e;
                }
            }
        }

        lv_i += 1;
    }

    if (lv_all == 0) {
        lv_a = StringToText("");
    }
    else if (lv_sel > 0) {
        lv_a = StringExternal("Param/Value/GhostOpsE_HudSel") + StringToText(": ") + IntToText(lv_sel) + StringToText("  |  ") + StringExternal("Param/Value/GhostOpsE_HudMin") + StringToText(" ") + IntToText(FixedToInt(lv_min + 0.5)) + StringToText(" / ") + IntToText(FixedToInt(go_eTank));
    }
    else {
        lv_a = StringExternal("Param/Value/GhostOpsE_HudAll") + StringToText(": ") + IntToText(lv_all) + StringToText("  |  ") + StringExternal("Param/Value/GhostOpsE_HudDry") + StringToText(": ") + IntToText(lv_dry);
    }

    lv_b = StringToText("");
    if (go_eStage >= 2) {
        if (go_eTruckLost || !UnitIsAlive(go_eTruck)) {
            lv_b = StringExternal("Param/Value/GhostOpsE_HudTruckLost");
        }
        else if (UnitGetOwner(go_eTruck) != 1) {
            lv_b = StringExternal("Param/Value/GhostOpsE_HudTruckFree");
        }
        else {
            lv_b = StringExternal("Param/Value/GhostOpsE_HudTruck") + StringToText(": ") + IntToText(FixedToInt(UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent) + 0.5)) + StringToText(" / ") + IntToText(FixedToInt(go_eTruckFuelMax));
        }
    }

    DialogControlSetPropertyAsText(go_eHudL1, c_triggerControlPropertyText, PlayerGroupAll(), lv_a);
    DialogControlSetPropertyAsText(go_eHudL2, c_triggerControlPropertyText, PlayerGroupAll(), lv_b);
}

//--------------------------------------------------------------------------------------------------
// Hellion fuel
//--------------------------------------------------------------------------------------------------
fixed GhostOps_Epi_BaseTarget () {
    if (go_eStage >= 4) {
        return go_eTank * go_eFillGood;
    }

    return go_eTank * go_eFillPoor;
}

void GhostOps_Epi_Register () {
    unitgroup lv_g;
    unit lv_u;
    int lv_k;
    int lv_slot;
    bool lv_known;

    lv_g = UnitGroup("Hellion", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_g);
    while (UnitGroupLoopCurrent() != null) {
        lv_u = UnitGroupLoopCurrent();
        lv_known = false;
        lv_slot = -1;
        lv_k = 0;
        while (lv_k < go_eHellN) {
            if (go_eHell[lv_k] == lv_u) {
                lv_known = true;
            }

            lv_k += 1;
        }

        if (!lv_known) {
            lv_k = 0;
            while ((lv_k < go_eHellN) && (lv_slot < 0)) {
                if (!UnitIsAlive(go_eHell[lv_k])) {
                    lv_slot = lv_k;
                }

                lv_k += 1;
            }

            if ((lv_slot < 0) && (go_eHellN < 16)) {
                lv_slot = go_eHellN;
                go_eHellN += 1;
            }

            if (lv_slot >= 0) {
                go_eHell[lv_slot] = lv_u;
                go_eHellPos[lv_slot] = UnitGetPosition(lv_u);
                go_eHellDry[lv_slot] = false;
                UnitSetPropertyFixed(lv_u, c_unitPropEnergy, GhostOps_Epi_BaseTarget());
                GhostOps_Epi_Log("hellion registered, fuel " + FixedToString(UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent), 1) + " of " + FixedToString(go_eTank, 0));
            }
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
}

void GhostOps_Epi_Fuel (fixed lp_dt) {
    int lv_i;
    int lv_j;
    unit lv_u;
    point lv_p;
    fixed lv_d;
    fixed lv_e;
    fixed lv_t;
    fixed lv_give;
    fixed lv_truckFuel;
    bool lv_truckOk;
    bool lv_atBase;

    GhostOps_Epi_Register();
    lv_truckOk = (go_eStage >= 3) && !go_eTruckLost && UnitIsAlive(go_eTruck) && (UnitGetOwner(go_eTruck) == 1);
    lv_i = 0;
    while (lv_i < go_eHellN) {
        lv_u = go_eHell[lv_i];
        if (UnitIsAlive(lv_u)) {
            lv_p = UnitGetPosition(lv_u);
            lv_d = DistanceBetweenPoints(lv_p, go_eHellPos[lv_i]);
            go_eHellPos[lv_i] = lv_p;
            if (lv_d > go_eMaxStep) {
                lv_d = 0.0;
            }

            lv_e = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, c_unitPropCurrent);
            lv_atBase = (DistanceBetweenPoints(lv_p, go_eBase) <= go_eBaseR);
            lv_e = lv_e - (lv_d * go_ePerCell);
            // the base: local gas fills the tank up to the quality of the day (poor, later good)
            lv_t = GhostOps_Epi_BaseTarget();
            if (lv_atBase && (lv_e < lv_t)) {
                lv_e = lv_e + (go_eBaseRate * lp_dt);
                if (lv_e > lv_t) {
                    lv_e = lv_t;
                }
            }

            // the field: a captured truck standing near gives good fuel (the fuel really leaves the truck)
            if (lv_truckOk && (lv_e < go_eTank) && (DistanceBetweenPoints(lv_p, UnitGetPosition(go_eTruck)) <= go_eFieldR)) {
                lv_truckFuel = UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent);
                lv_give = go_eFieldRate * lp_dt;
                if (lv_give > (go_eTank - lv_e)) {
                    lv_give = go_eTank - lv_e;
                }

                if (lv_give > lv_truckFuel) {
                    lv_give = lv_truckFuel;
                }

                if (lv_give > 0.0) {
                    lv_e = lv_e + lv_give;
                    UnitSetPropertyFixed(go_eTruck, c_unitPropEnergy, lv_truckFuel - lv_give);
                }
            }

            if (lv_e < 0.0) {
                lv_e = 0.0;
            }

            if (lv_e > go_eTank) {
                lv_e = go_eTank;
            }

            UnitSetPropertyFixed(lv_u, c_unitPropEnergy, lv_e);
            if ((lv_e <= 0.05) && !go_eHellDry[lv_i]) {
                go_eHellDry[lv_i] = true;
                UnitBehaviorAdd(lv_u, "GhostOpsNoFuel", lv_u, 1);
                UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                GhostOps_Epi_Log("hellion out of fuel, " + FixedToString(DistanceBetweenPoints(lv_p, go_eBase), 1) + " from the base");
                if (!lv_atBase && (DistanceBetweenPoints(lv_p, go_eBase) > (go_eBaseR + 4.0)) && (go_eStage < 3)) {
                    GhostOps_Epi_Scene(0);
                }
            }
            else if ((lv_e > 1.0) && go_eHellDry[lv_i]) {
                go_eHellDry[lv_i] = false;
                UnitBehaviorRemove(lv_u, "GhostOpsNoFuel", 1);
                GhostOps_Epi_Log("hellion has fuel again");
            }
        }

        lv_i += 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The gas truck
//--------------------------------------------------------------------------------------------------
int GhostOps_Epi_InfantryNear (point lp_p, fixed lp_r) {
    unitgroup lv_g;
    int lv_n;

    lv_n = 0;
    lv_g = UnitGroup("Marine", 1, RegionCircle(lp_p, lp_r), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n += UnitGroupCount(lv_g, c_unitCountAlive);
    lv_g = UnitGroup("Firebat", 1, RegionCircle(lp_p, lp_r), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n += UnitGroupCount(lv_g, c_unitCountAlive);
    lv_g = UnitGroup("Medic", 1, RegionCircle(lp_p, lp_r), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n += UnitGroupCount(lv_g, c_unitCountAlive);
    lv_g = UnitGroup("Ghost", 1, RegionCircle(lp_p, lp_r), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_n += UnitGroupCount(lv_g, c_unitCountAlive);
    return lv_n;
}

void GhostOps_Epi_MakeTruck () {
    int lv_i;
    unit lv_u;

    UnitCreate(1, "TankerTruck", 0, 0, go_eTruckAt, 270.0);
    go_eTruck = UnitLastCreated();
    UnitSetPropertyFixed(go_eTruck, c_unitPropEnergy, go_eTruckFuel0);
    UnitSetState(go_eTruck, c_unitStateTooltipable, true);
    lv_i = 0;
    while (lv_i < go_eDefTerran) {
        UnitCreate(1, "InfestedTerranCampaign", 0, 3, PointWithOffsetPolar(go_eTruckAt, go_eDefR, 40.0 + (IntToFixed(lv_i) * (360.0 / IntToFixed(go_eDefTerran + go_eDefCivil)))), 270.0);
        AISetUnitScriptControlled(UnitLastCreated(), true);
        lv_i += 1;
    }

    lv_i = 0;
    while (lv_i < go_eDefCivil) {
        UnitCreate(1, "InfestedCivilian", 0, 3, PointWithOffsetPolar(go_eTruckAt, go_eDefR + 1.5, 200.0 + (IntToFixed(lv_i) * (360.0 / IntToFixed(go_eDefTerran + go_eDefCivil)))), 270.0);
        AISetUnitScriptControlled(UnitLastCreated(), true);
        lv_i += 1;
    }

    GhostOps_Epi_Log("truck created, defenders " + IntToString(go_eDefTerran + go_eDefCivil));
}

void GhostOps_Epi_Truck (fixed lp_dt) {
    fixed lv_f;
    fixed lv_add;
    int lv_gas;
    int lv_spend;

    if (go_eTruckLost) {
        return;
    }

    if (!UnitIsAlive(go_eTruck)) {
        go_eTruckLost = true;
        if (go_eStage >= 3) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsE_MsgTruckLost"));
        }

        GhostOps_Epi_Log("truck lost");
        return;
    }

    // the circle of the refuelling radius: only while the player has the truck selected
    if ((UnitGetOwner(go_eTruck) == 1) && UnitIsSelected(go_eTruck, 1)) {
        if (UnitBehaviorCount(go_eTruck, "GhostOpsTruckShow") == 0) {
            UnitBehaviorAdd(go_eTruck, "GhostOpsTruckShow", go_eTruck, 1);
        }
    }
    else if (UnitBehaviorCount(go_eTruck, "GhostOpsTruckShow") > 0) {
        UnitBehaviorRemove(go_eTruck, "GhostOpsTruckShow", 1);
    }

    // the capture: infantry of the player near the free truck, once
    if (UnitGetOwner(go_eTruck) != 1) {
        if (GhostOps_Epi_InfantryNear(UnitGetPosition(go_eTruck), go_eCapR) >= go_eCapN) {
            UnitSetOwner(go_eTruck, 1, true);
            go_eStage = 3;
            go_eScene[0] = true;
            go_eScene[1] = true;
            if (go_eObjMade) {
                ObjectiveSetState(go_eObj, c_objectiveStateCompleted);
            }

            GhostOps_Epi_Log("truck captured, fuel " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent), 1));
            GhostOps_Epi_Scene(2);
        }

        return;
    }

    // back at the base: the local fuel becomes good (once), and the truck can be refilled for the gas of the map
    if (DistanceBetweenPoints(UnitGetPosition(go_eTruck), go_eBase) <= go_eBaseR) {
        if (go_eStage < 4) {
            go_eStage = 4;
            GhostOps_Epi_Log("truck at the base: good fuel prepared");
            GhostOps_Epi_Scene(3);
        }

        lv_f = UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent);
        if (lv_f < go_eTruckFuelMax) {
            lv_add = go_eTruckBaseRate * lp_dt;
            if (lv_add > (go_eTruckFuelMax - lv_f)) {
                lv_add = go_eTruckFuelMax - lv_f;
            }

            lv_gas = PlayerGetPropertyInt(1, c_playerPropVespene);
            if ((lv_add / go_eGasToFuel) > IntToFixed(lv_gas)) {
                lv_add = IntToFixed(lv_gas) * go_eGasToFuel;
            }

            if (lv_add > 0.0) {
                go_eGasAcc += lv_add / go_eGasToFuel;
                lv_spend = FixedToInt(go_eGasAcc);
                if (lv_spend >= 1) {
                    go_eGasAcc -= IntToFixed(lv_spend);
                    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSubtract, lv_spend);
                }

                UnitSetPropertyFixed(go_eTruck, c_unitPropEnergy, lv_f + lv_add);
            }
        }
    }
}

// the mark of the truck stays on the minimap until it is captured
void GhostOps_Epi_Mark () {
    if ((go_eStage >= 2) && (go_eStage < 3) && !go_eTruckLost && UnitIsAlive(go_eTruck)) {
        MinimapPing(PlayerGroupSingle(1), UnitGetPosition(go_eTruck), 2.5, Color(100.00, 80.00, 0.00));
    }
}

//--------------------------------------------------------------------------------------------------
// Day / night: Ghost cloak, protected buildings, the night transport
//--------------------------------------------------------------------------------------------------
void GhostOps_Epi_ApplyCloak (bool lp_night) {
    fixed lv_net;

    if (lp_night) {
        lv_net = go_eNightNet;
    }
    else {
        lv_net = go_eDayNet;
    }

    // the cloak modification is (net - regen) of the unit: the free cloak of the day is net 0, the night cloak costs energy
    CatalogFieldValueSet(c_gameCatalogBehavior, "GhostCloak", "Modification.VitalRegenArray[Energy]", 1, FixedToString(lv_net - go_eRegen, 3));
    go_pnNet = lv_net;
    GhostOps_Epi_Log("ghost cloak net per second " + FixedToString(lv_net, 2));
}

void GhostOps_Epi_ProtTags () {
    int lv_i;
    text lv_t;

    lv_i = 0;
    while (lv_i < go_eProtN) {
        if (UnitIsAlive(go_eProt[lv_i])) {
            if (!go_eProtTagOn[lv_i]) {
                if (go_eIsNight) {
                    lv_t = StringExternal("Param/Value/GhostOpsE_ProtNight");
                }
                else {
                    lv_t = StringExternal("Param/Value/GhostOpsE_ProtDay");
                }

                go_eProtTag[lv_i] = TextTagCreate(lv_t, 22, UnitGetPosition(go_eProt[lv_i]), 2.0, true, false, PlayerGroupAll());
                TextTagAttachToUnit(go_eProtTag[lv_i], go_eProt[lv_i], 3.0);
                go_eProtTagOn[lv_i] = true;
            }
        }
        else if (go_eProtTagOn[lv_i]) {
            TextTagDestroy(go_eProtTag[lv_i]);
            go_eProtTagOn[lv_i] = false;
        }

        lv_i += 1;
    }
}

void GhostOps_Epi_ProtSet (bool lp_night) {
    int lv_i;

    lv_i = 0;
    while (lv_i < go_eProtN) {
        if (UnitIsAlive(go_eProt[lv_i])) {
            // the shield (a damage response of 100%) instead of the invulnerable state: the structure can still be ATTACKED (the first attempt by day is noticed and explained), the weapons just do nothing
            if (!lp_night) {
                if (UnitBehaviorCount(go_eProt[lv_i], "GhostOpsDayShield") == 0) {
                    UnitBehaviorAdd(go_eProt[lv_i], "GhostOpsDayShield", go_eProt[lv_i], 1);
                }
            }
            else if (UnitBehaviorCount(go_eProt[lv_i], "GhostOpsDayShield") > 0) {
                UnitBehaviorRemove(go_eProt[lv_i], "GhostOpsDayShield", 1);
            }
        }

        if (go_eProtTagOn[lv_i]) {
            TextTagDestroy(go_eProtTag[lv_i]);
            go_eProtTagOn[lv_i] = false;
        }

        lv_i += 1;
    }

    GhostOps_Epi_ProtTags();
}

bool GhostOps_Epi_ProtAttacked (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    if (!go_eIsNight) {
        GhostOps_Epi_Scene(5);
    }

    return true;
}

void GhostOps_Epi_ProtChoose () {
    unitgroup lv_g;
    int lv_t;
    int lv_n;
    int lv_i;
    unit lv_u;

    go_eProtN = 0;
    lv_t = 0;
    while ((lv_t < go_eProtTypeN) && (go_eProtN < go_eProtMax) && (go_eProtN < 8)) {
        lv_g = UnitGroup(go_eProtType[lv_t], 3, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        lv_n = UnitGroupCount(lv_g, c_unitCountAll);
        lv_i = 1;
        while ((lv_i <= lv_n) && (go_eProtN < go_eProtMax) && (go_eProtN < 8)) {
            lv_u = UnitGroupUnit(lv_g, lv_i);
            go_eProt[go_eProtN] = lv_u;
            go_eProtTagOn[go_eProtN] = false;
            TriggerAddEventUnitAttacked(go_eAttackTrig, UnitRefFromUnit(lv_u));
            go_eProtN += 1;
            lv_i += 1;
        }

        lv_t += 1;
    }

    GhostOps_Epi_Log("protected by day: " + IntToString(go_eProtN) + " structures");
}

void GhostOps_Epi_ShipPark () {
    if (!go_eShipMade || go_eShipDead || go_eShipAway) {
        return;
    }

    go_eShipAway = true;
    UnitSelect(go_eShip, 1, false);
    UnitSetPosition(go_eShip, go_eDock, false);
    UnitSetState(go_eShip, c_unitStateHidden, true);
    libNtve_gf_PauseUnit(go_eShip, true);
    GhostOps_Epi_Log("transport leaves until the next night, health " + FixedToString(UnitGetPropertyFixed(go_eShip, c_unitPropLife, c_unitPropCurrent), 0));
}

string GhostOps_Epi_ShipType () {
    if (go_eShipType == "") {
        return "Medivac";
    }

    return go_eShipType;
}

string GhostOps_Epi_ShipAbil () {
    if (go_eShipType == "Hercules") {
        return "HerculesTransport";
    }

    return "MedivacTransport";
}

void GhostOps_Epi_ShipOpen () {
    if (go_eShipDead) {
        return;
    }

    if (!go_eShipMade) {
        UnitCreate(1, GhostOps_Epi_ShipType(), 0, 1, go_eDock, 270.0);
        go_eShip = UnitLastCreated();
        go_eShipMade = true;
        GhostOps_Epi_Log("transport arrives (first time)");
    }
    else if (go_eShipAway) {
        UnitSetPosition(go_eShip, go_eDock, false);
        UnitSetState(go_eShip, c_unitStateHidden, false);
        libNtve_gf_PauseUnit(go_eShip, false);
        go_eShipAway = false;
        GhostOps_Epi_Log("transport arrives again, health " + FixedToString(UnitGetPropertyFixed(go_eShip, c_unitPropLife, c_unitPropCurrent), 0));
    }

    UnitAbilityEnable(go_eShip, GhostOps_Epi_ShipAbil(), true);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsE_MsgShipHere"));
    GhostOps_Epi_Scene(4);
}

void GhostOps_Epi_Ship () {
    int lv_cargo;
    bool lv_home;

    if (!go_eShipOn || !go_eShipMade || go_eShipDead) {
        return;
    }

    if (!UnitIsAlive(go_eShip)) {
        go_eShipDead = true;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsE_MsgShipLost"));
        GhostOps_Epi_Log("transport lost");
        return;
    }

    if (go_eShipAway) {
        return;
    }

    if (go_eNightOpen) {
        if (!go_eWarned && (GameGetMissionTime() >= go_eWarnAt)) {
            go_eWarned = true;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsE_MsgDawn"));
            GhostOps_Epi_Log("dawn warning");
        }

        return;
    }

    // after the dawn: no new rides; the ride in progress may end (passengers are never thrown out, never teleported); an empty transport at the base leaves
    lv_cargo = UnitGroupCount(UnitCargoGroup(go_eShip), c_unitCountAlive);
    lv_home = (DistanceBetweenPoints(UnitGetPosition(go_eShip), go_eDock) <= go_eDockR);
    UnitAbilityEnable(go_eShip, GhostOps_Epi_ShipAbil(), lv_cargo > 0);
    if (lv_home && (lv_cargo == 0)) {
        GhostOps_Epi_ShipPark();
    }
}

// the hooks of the original day / night cycle (adapter.json)
void GhostOps_Epi_OnNight (int lp_no, fixed lp_len) {
    if (!go_eEnabled) {
        return;
    }

    go_eIsNight = true;
    go_eNightNo = lp_no;
    GhostOps_Epi_ApplyCloak(true);
    GhostOps_Epi_ProtSet(true);
    if (go_eShipOn && (lp_no >= go_eShipFirstNight)) {
        go_eNightOpen = true;
        go_eWarned = false;
        go_eWarnAt = GameGetMissionTime() + lp_len - go_eWarnSec;
        GhostOps_Epi_ShipOpen();
    }

    GhostOps_Epi_Log("night " + IntToString(lp_no) + " length " + FixedToString(lp_len, 0));
}

void GhostOps_Epi_OnDay (int lp_no, fixed lp_len) {
    if (!go_eEnabled) {
        return;
    }

    go_eIsNight = false;
    GhostOps_Epi_ApplyCloak(false);
    GhostOps_Epi_ProtSet(false);
    go_eNightOpen = false;
    GhostOps_Epi_Log("day " + IntToString(lp_no) + " length " + FixedToString(lp_len, 0));
}

// the hook after the original drops Swann's hellions: the extra hellions of the free test squad (a finite number, never refilled)
void GhostOps_Epi_ExtraHellions (point lp_at) {
    if (!go_eEnabled || (go_eExtraHell <= 0)) {
        return;
    }

    UnitCreate(go_eExtraHell, "Hellion", 0, 1, lp_at, 270.0);
    GhostOps_Epi_Log("extra hellions of the test squad: " + IntToString(go_eExtraHell));
}

//--------------------------------------------------------------------------------------------------
// The tick, the load handler, the start
//--------------------------------------------------------------------------------------------------
bool GhostOps_Epi_Tick (bool lp_testConds, bool lp_runActions) {
    fixed lv_now;
    fixed lv_dt;

    if (!lp_runActions) {
        return true;
    }

    lv_now = GameGetMissionTime();
    lv_dt = lv_now - go_eLastTime;
    if ((lv_dt <= 0.0) || (lv_dt > 2.0)) {
        lv_dt = 0.25;
    }

    go_eLastTime = lv_now;
    go_eTickN += 1;
    GhostOps_Epi_Fuel(lv_dt);
    GhostOps_Epi_Truck(lv_dt);
    GhostOps_Epi_Ship();
    GhostOps_Epi_ProtTags();
    if ((go_eTickN % 2) == 0) {
        GhostOps_Epi_UpdateHud();
    }

    if ((go_eTickN % 40) == 0) {
        GhostOps_Epi_Mark();
    }

    return true;
}

bool GhostOps_Epi_OnLoad (bool lp_testConds, bool lp_runActions) {
    int lv_i;

    if (!lp_runActions) {
        return true;
    }

    // the dialogs and text tags were destroyed by the load: they are built again (never doubled)
    if (go_eHud != c_invalidDialogId) {
        DialogDestroy(go_eHud);
    }

    go_eHud = c_invalidDialogId;
    lv_i = 0;
    while (lv_i < 8) {
        go_eProtTagOn[lv_i] = false;
        lv_i += 1;
    }

    GhostOps_Epi_CreateHud();
    GhostOps_Epi_Log("loaded game: stage " + IntToString(go_eStage) + ", hellions " + IntToString(go_eHellN) + ", truck fuel " + FixedToString(UnitGetPropertyFixed(go_eTruck, c_unitPropEnergy, c_unitPropCurrent), 1) + ", night " + IntToString(BoolToInt(go_eIsNight)));
    return true;
}

void GhostOps_Epi_Start () {
    GhostOps_ApplyEpidemicConfig();
    if (!go_eEnabled) {
        return;
    }

    go_eHud = c_invalidDialogId;
    go_eLastTime = GameGetMissionTime();
    go_eAttackTrig = TriggerCreate("GhostOps_Epi_ProtAttacked");
    GhostOps_Epi_ApplyCloak(false);
    GhostOps_Epi_MakeTruck();
    GhostOps_Epi_ProtChoose();
    GhostOps_Epi_ProtSet(false);
    GhostOps_Epi_CreateHud();
    go_eTickTrig = TriggerCreate("GhostOps_Epi_Tick");
    TriggerAddEventTimePeriodic(go_eTickTrig, 0.25, c_timeGame);
    go_eLoadTrig = TriggerCreate("GhostOps_Epi_OnLoad");
    TriggerAddEventLoadGameDone(go_eLoadTrig);
    GhostOps_Epi_Log("started: base fuel poor " + FixedToString(go_eFillPoor, 2) + ", tank " + FixedToString(go_eTank, 0));
}
