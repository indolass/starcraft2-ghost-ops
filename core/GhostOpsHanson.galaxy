//==================================================================================================
// GhostOps module: THanson01 "Evacuation" - sniper cover (config key "hanson"; see config/thanson01.json).
//
// What this module does (everything else of the mission is the original):
//   * a finite squad: one Ghost (created by the core, GhostOps_SpawnOperatives) at the start of the playable part;
//   * a development lock: the player cannot train, build, research or hire (TechTreeUnitAllow / UpgradeAllow, derived
//     from what the player's own unit types can produce, so mercenaries and add-ons are covered too);
//   * ready Missile Turrets around the settlement (positions in the config);
//   * the convoy command: the original starts a trip as soon as the colonists are gathered
//     (gt_ConvoySpawned_Func); the hook GhostOps_Hanson_Hold() in front of the trip's first action holds it until the
//     player presses the button "Send convoy", then the original function runs from its beginning exactly once.
// Nothing here touches balance of the original units, the colonist logic, the attacks or the victory / defeat rules.
//==================================================================================================
bool go_hEnabled;
bool go_hDebug;
bool go_hLock;
bool go_hCommand;
fixed go_hGhostX;
fixed go_hGhostY;
int go_hTurretCount;
fixed[24] go_hTurretX;
fixed[24] go_hTurretY;
int go_hTurretOwner;
int go_hBtnW;
int go_hBtnH;
int go_hBtnOffX;
int go_hBtnOffY;
bool go_hTurretsMade;
unit[24] go_hTurret;
// convoy command: 0 not started yet, 1 preparing, 2 ready (waiting for the player), 3 trip
int go_hCmdState;
bool go_hGateOpen;
trigger go_hGateTrig;
int go_hDlg;
int go_hBtn;
int go_hLbl;
trigger go_hClickTrig;
trigger go_hLoadTrig;
trigger go_hLockTrig;
// values of the original mission, delivered once a second by the hook GhostOps_Hanson_Probe
int go_hPhase;
int go_hEscort;
int go_hSent;
int go_hSaved;
int go_hKilled;
int go_hWaves;
int go_hLastPhase;
bank go_hBank;
int go_hLogN;
int go_hLockTypes;
string[48] go_hLockSeen;

// ---- prepared detonations (config keys hanson.containers / convoy_fuel / hud / lines; all off in the old profile) ----
bool go_hContOn;
bool go_hAllowRefinery;        // the one exception of the development lock: the gas source may be rebuilt
bool go_hGasWarned;            // the "gas source lost" message was shown (saved with the game)
bool go_hFuelOn;
bool go_hContStrBonus;
int go_hContLimit;
int go_hContCost;
int go_hContOwner;
fixed go_hContMinFree;
fixed go_hContRange;           // the Firebat places only within this range of his own position (an order further away is cancelled at once, the Firebat does not walk)
trigger go_hContFarTrig;
fixed go_hContFriendHard;
fixed go_hContFriendOther;
int go_hFuelCost;
// free test squad (config hanson.free_squad): extra Marines at the start, a finite squad
int go_hFreeMarines;
// turret kits (config hanson.turret_kits): the ordered number of Missile Turrets may be built by the SCVs for free (catalog cost 0), never more.
// Start of construction reserves a kit, cancelling frees it, completion spends it, the death of a finished turret returns nothing, the death of an unfinished one
// (not cancelled by the player: damage or an enemy next to it) consumes the kit. Every counter is a saved global, so a load restores them.
bool go_hKitOn;
int go_hKitOrdered;
int go_hKitSpent;
int go_hKitConsumed;
int go_hTrkN;
unit[24] go_hTrk;
int[24] go_hTrkState;
fixed[24] go_hTrkLife;
point[24] go_hTrkPos;
fixed[24] go_hTrkHurtAt;
int[24] go_hTrkFam;
// second family of kits (config hanson.bunker_kits): the ordered number of Bunkers, the same rule as the turrets
bool go_hBkOn;
int go_hBkOrdered;
int go_hBkSpent;
int go_hBkConsumed;
int[2] go_hKitShownF;
int[2] go_hObjK;
bool[2] go_hObjKMade;
trigger go_hKitTrig;
int GhostOps_Hanson_KitsLeft ();
int GhostOps_Hanson_KitsLeftF (int lp_fam);
// extra SCVs of the preorder / the free test (config hanson.turret_kits.order.scvs): created once when the base is handed over
int go_hExtraScvs;
bool go_hScvsMade;
// the new rifle shot (config ghost_tuning.snipe.rifle_shot): a click always gives a shot (a hit or a miss), see GhostOps_Hanson_ShotExec
bool go_hShotOn;
fixed go_hShotRange;
fixed go_hShotAssist;
int go_hShotCount;
int go_hHudL3;
int go_hHudLines;
fixed go_hLastShotAt;
bool go_hStoryEvent;           // the story starts by the event "base handed over" (the original scene is over) instead of a fixed time
fixed go_hStoryAfter;          // seconds between the end of the original scene and the first line
int go_hHudX;
int go_hHudY;
int go_hHudW;
int go_hHudH;
int go_hHudDlg;
int go_hHudL1;
int go_hHudL2;
// saved with the game: how many containers were really placed (the shared limit), the placed ones, the detonations
int go_hContUsed;
int go_hContBlasts;
trigger go_hContCreatedTrig;
trigger go_hContDiedTrig;
trigger go_hContTickTrig;
// story lines (config hanson.lines): stable ids, speaker, on-screen seconds; the text of a line is the string GhostOpsH_L_<id>
int go_hLnCount;
string[16] go_hLnId;
string[16] go_hLnSpk;
fixed[16] go_hLnSec;
fixed go_hStoryFirst;
fixed go_hStoryGap;
int go_hStoryState;
trigger go_hStoryTrig;

void GhostOps_HansonTest_Start ();
void GhostOps_HansonTest_Probe ();

//--------------------------------------------------------------------------------------------------
// Helpers
//--------------------------------------------------------------------------------------------------
int GhostOps_Hanson_B (bool lp_v) {
    if (lp_v) {
        return 1;
    }

    return 0;
}

void GhostOps_Hanson_Log (string lp_text) {
    if (!go_hDebug) {
        return;
    }

    if (go_hBank == null) {
        go_hBank = BankLoad("GhostOpsDevHanson", 1);
    }

    go_hLogN += 1;
    BankValueSetFromString(go_hBank, "log", "e" + IntToString(go_hLogN), FixedToString(GameGetMissionTime(), 2) + " " + lp_text);
    BankSave(go_hBank);
}

//--------------------------------------------------------------------------------------------------
// The live containers are found by type (no array, no fixed number of places: the limit of a container is only the gas)
//--------------------------------------------------------------------------------------------------
text GhostOps_Hanson_ShotLine ();

unitgroup GhostOps_Hanson_ContGroup () {
    return UnitGroup("GhostOpsFuelContainer", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
}

int GhostOps_Hanson_ContAlive () {
    return UnitGroupCount(GhostOps_Hanson_ContGroup(), c_unitCountAlive);
}

// the n-th (0-based) live container (the probes); null when there is none
unit GhostOps_Hanson_ContNth (int lp_n) {
    unitgroup lv_g;

    lv_g = GhostOps_Hanson_ContGroup();
    if ((lp_n < 0) || (lp_n >= UnitGroupCount(lv_g, c_unitCountAlive))) {
        return null;
    }

    return UnitGroupUnit(lv_g, lp_n + 1);
}

//--------------------------------------------------------------------------------------------------
// Gas, messages, the HUD lines (containers / fuel)
//--------------------------------------------------------------------------------------------------
int GhostOps_Hanson_Gas () {
    return PlayerGetPropertyInt(1, c_playerPropVespene);
}

void GhostOps_Hanson_Say (string lp_key) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_" + lp_key));
}

void GhostOps_Hanson_SayNumber (string lp_key, int lp_n) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_" + lp_key) + StringToText(" ") + IntToText(lp_n));
}

void GhostOps_Hanson_UpdateHud () {
    text lv_l1;
    text lv_l2;
    int lv_gas;

    if ((go_hHudDlg == c_invalidDialogId) || (!go_hContOn && !go_hFuelOn && !go_hShotOn)) {
        return;
    }

    lv_gas = GhostOps_Hanson_Gas();
    lv_l1 = StringExternal("Param/Value/GhostOpsH_HudGas") + StringToText(": ") + IntToText(lv_gas);
    if (go_hFuelOn) {
        lv_l1 = lv_l1 + StringToText("  |  ") + StringExternal("Param/Value/GhostOpsH_HudFuelPrice") + StringToText(": ") + IntToText(go_hFuelCost);
        if (lv_gas < go_hFuelCost) {
            lv_l1 = lv_l1 + StringToText(" (") + StringExternal("Param/Value/GhostOpsH_HudShort") + StringToText(" ") + IntToText(go_hFuelCost - lv_gas) + StringToText(")");
        }
    }

    lv_l2 = StringToText("");
    if (go_hContOn && (go_hContLimit > 0)) {
        lv_l2 = StringExternal("Param/Value/GhostOpsH_HudContainers") + StringToText(": ") + StringExternal("Param/Value/GhostOpsH_HudLeft") + StringToText(" ") + IntToText(go_hContLimit - go_hContUsed) + StringToText(" ") + StringExternal("Param/Value/GhostOpsH_HudOf") + StringToText(" ") + IntToText(go_hContLimit)
            + StringToText("  |  ") + StringExternal("Param/Value/GhostOpsH_HudPrice") + StringToText(": ") + IntToText(go_hContCost);
        if ((go_hContLimit - go_hContUsed) > 0 && lv_gas < go_hContCost) {
            lv_l2 = lv_l2 + StringToText(" (") + StringExternal("Param/Value/GhostOpsH_HudNoGasForBox") + StringToText(")");
        }
    }
    else if (go_hContOn) {
        // no shared stock: the only limit is the gas. The line shows the price and how many the gas of the moment allows.
        lv_l2 = StringExternal("Param/Value/GhostOpsH_HudContainers") + StringToText(": ") + StringExternal("Param/Value/GhostOpsH_HudPrice") + StringToText(" ") + IntToText(go_hContCost)
            + StringToText("  |  ") + StringExternal("Param/Value/GhostOpsH_HudCanPlace") + StringToText(": ") + IntToText(lv_gas / go_hContCost);
        if (lv_gas < go_hContCost) {
            lv_l2 = lv_l2 + StringToText(" (") + StringExternal("Param/Value/GhostOpsH_HudNoGasForBox") + StringToText(")");
        }
    }

    DialogControlSetPropertyAsText(go_hHudL1, c_triggerControlPropertyText, PlayerGroupAll(), lv_l1);
    DialogControlSetPropertyAsText(go_hHudL2, c_triggerControlPropertyText, PlayerGroupAll(), lv_l2);
    if (go_hShotOn && (go_hHudL3 != c_invalidDialogId)) {
        DialogControlSetPropertyAsText(go_hHudL3, c_triggerControlPropertyText, PlayerGroupAll(), GhostOps_Hanson_ShotLine());
    }
}

//--------------------------------------------------------------------------------------------------
// Development lock
//--------------------------------------------------------------------------------------------------
// Everything the given unit type can produce (units, structures, add-ons, upgrades, hired mercenaries) is forbidden for player 1.
void GhostOps_Hanson_LockType (string lp_type) {
    int lv_i;
    int lv_n;

    lv_n = TechTreeUnitProducesUnitCount(lp_type);
    lv_i = 0;
    while (lv_i < lv_n) {
        TechTreeUnitAllow(1, TechTreeUnitProducesUnit(lp_type, lv_i), false);
        lv_i += 1;
    }

    lv_n = TechTreeUnitProducesUpgradeCount(lp_type);
    lv_i = 0;
    while (lv_i < lv_n) {
        TechTreeUpgradeAllow(1, TechTreeUnitProducesUpgrade(lp_type, lv_i), false);
        lv_i += 1;
    }
}

// The types of a Terran base that the derived lock may miss (aliases, suppressed buttons): always forbidden for player 1.
void GhostOps_Hanson_LockFixed () {
    string[28] lv_types;
    int lv_i;

    lv_types[0] = "CommandCenter";
    lv_types[1] = "OrbitalCommand";
    lv_types[2] = "PlanetaryFortress";
    lv_types[3] = "SupplyDepot";
    lv_types[4] = "Refinery";
    lv_types[5] = "Barracks";
    lv_types[6] = "EngineeringBay";
    lv_types[7] = "MissileTurret";
    lv_types[8] = "Bunker";
    lv_types[9] = "SensorTower";
    lv_types[10] = "GhostAcademy";
    lv_types[11] = "Factory";
    lv_types[12] = "Starport";
    lv_types[13] = "MercCompound";
    lv_types[14] = "Armory";
    lv_types[15] = "FusionCore";
    lv_types[16] = "SCV";
    lv_types[17] = "Marine";
    lv_types[18] = "Marauder";
    lv_types[19] = "Reaper";
    lv_types[20] = "Firebat";
    lv_types[21] = "Medic";
    lv_types[22] = "Ghost";
    lv_types[23] = "BarracksTechLab";
    lv_types[24] = "BarracksReactor";
    lv_types[25] = "AutomatedRefinery";
    lv_types[26] = "PerditionTurret";
    lv_types[27] = "HiveMindEmulator";
    lv_i = 0;
    while (lv_i < 28) {
        TechTreeUnitAllow(1, lv_types[lv_i], false);
        lv_i += 1;
    }
}

bool GhostOps_Hanson_LockTick (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_group;
    unit lv_unit;
    string lv_type;
    int lv_i;
    int lv_k;
    int lv_n;
    bool lv_seen;

    if (!lp_runActions) {
        return true;
    }

    GhostOps_Hanson_LockFixed();
    if (go_hContOn) {
        TechTreeUnitAllow(1, "GhostOpsFuelContainer", true);
    }

    if (go_hAllowRefinery) {
        // the only source of gas of this variant is one Refinery: losing it must not be a dead end, so rebuilding it (75 minerals, an SCV) stays possible
        TechTreeUnitAllow(1, "Refinery", true);
    }

    if (go_hKitOn) {
        // the second exception of the lock: the ordered turrets (the kit tick keeps this in step with the kits left)
        TechTreeUnitAllow(1, "MissileTurret", GhostOps_Hanson_KitsLeft() > 0);
    }

    if (go_hBkOn) {
        TechTreeUnitAllow(1, "Bunker", GhostOps_Hanson_KitsLeftF(1) > 0);
    }

    if (go_hContOn) {
        // the container is produced by the Firebats' ability (the lock derives "everything a unit can produce" and would forbid it): it is the one allowed exception
        TechTreeUnitAllow(1, "GhostOpsFuelContainer", true);
    }

    lv_group = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_n = UnitGroupCount(lv_group, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_unit = UnitGroupUnit(lv_group, lv_i);
        lv_type = UnitGetType(lv_unit);
        lv_seen = false;
        lv_k = 0;
        while (lv_k < go_hLockTypes) {
            if (go_hLockSeen[lv_k] == lv_type) {
                lv_seen = true;
                break;
            }

            lv_k += 1;
        }

        if (!lv_seen && go_hLockTypes < 48) {
            go_hLockSeen[go_hLockTypes] = lv_type;
            go_hLockTypes += 1;
            GhostOps_Hanson_LockType(lv_type);
            GhostOps_Hanson_Log("lock: " + lv_type + " produces " + IntToString(TechTreeUnitProducesUnitCount(lv_type)) + " units, " + IntToString(TechTreeUnitProducesUpgradeCount(lv_type)) + " upgrades");
        }

        lv_i += 1;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Turrets
//--------------------------------------------------------------------------------------------------
bool GhostOps_Hanson_TurretDied (bool lp_testConds, bool lp_runActions) {
    unit lv_k;
    string lv_who;

    if (!lp_runActions) {
        return true;
    }

    lv_who = "unknown";
    lv_k = EventUnitDamageSourceUnit();
    if (lv_k != null) {
        lv_who = UnitGetType(lv_k) + " of player " + IntToString(UnitGetOwner(lv_k));
    }

    GhostOps_Hanson_Log("turret lost at (" + FixedToString(PointGetX(UnitGetPosition(EventUnit())), 1) + ", " + FixedToString(PointGetY(UnitGetPosition(EventUnit())), 1) + "), killer " + lv_who);
    return true;
}

void GhostOps_Hanson_MakeTurrets () {
    trigger lv_died;

    int lv_i;

    if (go_hTurretsMade) {
        return;
    }

    go_hTurretsMade = true;
    lv_i = 0;
    while (lv_i < go_hTurretCount) {
        UnitCreate(1, "MissileTurret", 0, go_hTurretOwner, Point(go_hTurretX[lv_i], go_hTurretY[lv_i]), 270.0);
        go_hTurret[lv_i] = UnitLastCreated();
        if (go_hDebug) {
            lv_died = TriggerCreate("GhostOps_Hanson_TurretDied");
            TriggerAddEventUnitDied(lv_died, UnitRefFromUnit(go_hTurret[lv_i]));
        }

        lv_i += 1;
    }

    GhostOps_Hanson_Log("turrets created: " + IntToString(go_hTurretCount));
    lv_i = 0;
    while (lv_i < go_hTurretCount) {
        GhostOps_Hanson_Log("   turret " + IntToString(lv_i) + " asked (" + FixedToString(go_hTurretX[lv_i], 1) + ", " + FixedToString(go_hTurretY[lv_i], 1) + ") placed (" + FixedToString(PointGetX(UnitGetPosition(go_hTurret[lv_i])), 1) + ", " + FixedToString(PointGetY(UnitGetPosition(go_hTurret[lv_i])), 1) + ")");
        lv_i += 1;
    }

}

//--------------------------------------------------------------------------------------------------
// Convoy command (the button)
//--------------------------------------------------------------------------------------------------
void GhostOps_Hanson_UpdateUI () {
    if (!go_hCommand || (go_hDlg == c_invalidDialogId) || (go_hBtn == c_invalidDialogId)) {
        return;
    }

    if (go_hCmdState == 2) {
        if (go_hFuelOn && (GhostOps_Hanson_Gas() < go_hFuelCost)) {
            // ready, but the gas of the trip is missing: the shortage is shown, the button waits
            DialogControlSetPropertyAsText(go_hBtn, c_triggerControlPropertyText, PlayerGroupAll(), StringExternal("Param/Value/GhostOpsH_NeedGas") + StringToText(" ") + IntToText(go_hFuelCost - GhostOps_Hanson_Gas()));
            DialogControlSetEnabled(go_hBtn, PlayerGroupAll(), false);
        }
        else if (go_hFuelOn) {
            DialogControlSetPropertyAsText(go_hBtn, c_triggerControlPropertyText, PlayerGroupAll(), StringExternal("Param/Value/GhostOpsH_BtnReady") + StringToText(" - ") + IntToText(go_hFuelCost) + StringToText(" ") + StringExternal("Param/Value/GhostOpsH_GasUnit"));
            DialogControlSetEnabled(go_hBtn, PlayerGroupAll(), true);
        }
        else {
            DialogControlSetPropertyAsText(go_hBtn, c_triggerControlPropertyText, PlayerGroupAll(), StringExternal("Param/Value/GhostOpsH_BtnReady"));
            DialogControlSetEnabled(go_hBtn, PlayerGroupAll(), true);
        }
    }
    else if (go_hCmdState == 3) {
        DialogControlSetPropertyAsText(go_hBtn, c_triggerControlPropertyText, PlayerGroupAll(), StringExternal("Param/Value/GhostOpsH_BtnActive"));
        DialogControlSetEnabled(go_hBtn, PlayerGroupAll(), false);
    }
    else {
        DialogControlSetPropertyAsText(go_hBtn, c_triggerControlPropertyText, PlayerGroupAll(), StringExternal("Param/Value/GhostOpsH_BtnPreparing"));
        DialogControlSetEnabled(go_hBtn, PlayerGroupAll(), false);
    }
}

// The dialog is not part of a saved game: it is created again after a load (and at the start).
void GhostOps_Hanson_CreateUI () {
    if (!go_hCommand) {
        return;
    }

    DialogCreate(go_hBtnW, go_hBtnH, c_anchorTopLeft, go_hBtnOffX, go_hBtnOffY, false);
    go_hDlg = DialogLastCreated();
    DialogControlCreate(go_hDlg, c_triggerControlTypeButton);
    go_hBtn = DialogControlLastCreated();
    DialogControlSetSize(go_hBtn, PlayerGroupAll(), go_hBtnW, go_hBtnH);
    DialogControlSetPosition(go_hBtn, PlayerGroupAll(), c_anchorCenter, 0, 0);
    DialogControlSetVisible(go_hBtn, PlayerGroupAll(), true);
    DialogSetVisible(go_hDlg, PlayerGroupAll(), true);
    go_hClickTrig = TriggerCreate("GhostOps_Hanson_OnClick");
    TriggerAddEventDialogControl(go_hClickTrig, c_playerAny, go_hBtn, c_triggerControlEventTypeClick);
    GhostOps_Hanson_UpdateUI();
    GhostOps_Hanson_Log("ui created, state " + IntToString(go_hCmdState));
}

// The two HUD lines (gas / trip price, containers left / price) in a dialog of their own below the button; created again after a load.
void GhostOps_Hanson_CreateHud () {
    if (!go_hContOn && !go_hFuelOn && !go_hShotOn) {
        return;
    }

    go_hHudLines = 2;
    if (go_hShotOn) {
        go_hHudLines = 3;
    }

    DialogCreate(go_hHudW, (go_hHudH / 2) * go_hHudLines, c_anchorTopLeft, go_hHudX, go_hHudY, false);
    go_hHudDlg = DialogLastCreated();
    DialogControlCreate(go_hHudDlg, c_triggerControlTypeLabel);
    go_hHudL1 = DialogControlLastCreated();
    DialogControlSetSize(go_hHudL1, PlayerGroupAll(), go_hHudW, go_hHudH / 2);
    DialogControlSetPosition(go_hHudL1, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogControlSetPropertyAsString(go_hHudL1, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    DialogControlCreate(go_hHudDlg, c_triggerControlTypeLabel);
    go_hHudL2 = DialogControlLastCreated();
    DialogControlSetSize(go_hHudL2, PlayerGroupAll(), go_hHudW, go_hHudH / 2);
    DialogControlSetPosition(go_hHudL2, PlayerGroupAll(), c_anchorTopLeft, 0, go_hHudH / 2);
    DialogControlSetPropertyAsString(go_hHudL2, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    go_hHudL3 = c_invalidDialogId;
    if (go_hShotOn) {
        DialogControlCreate(go_hHudDlg, c_triggerControlTypeLabel);
        go_hHudL3 = DialogControlLastCreated();
        DialogControlSetSize(go_hHudL3, PlayerGroupAll(), go_hHudW, go_hHudH / 2);
        DialogControlSetPosition(go_hHudL3, PlayerGroupAll(), c_anchorTopLeft, 0, go_hHudH);
        DialogControlSetPropertyAsString(go_hHudL3, c_triggerControlPropertyStyle, PlayerGroupAll(), "AlertItem");
    }

    DialogSetVisible(go_hHudDlg, PlayerGroupAll(), true);
    GhostOps_Hanson_UpdateHud();
}

bool GhostOps_Hanson_OnLoad (bool lp_testConds, bool lp_runActions) {
    int lv_i;

    if (!lp_runActions) {
        return true;
    }

    if (go_hDlg != c_invalidDialogId) {
        DialogDestroy(go_hDlg);
    }

    go_hDlg = c_invalidDialogId;
    go_hBtn = c_invalidDialogId;
    if (go_hHudDlg != c_invalidDialogId) {
        DialogDestroy(go_hHudDlg);
    }

    go_hHudDlg = c_invalidDialogId;
    // the text tags were destroyed by the load: the mark of every live container is cleared, the tick draws one per container again (never doubled)
    UnitGroupLoopBegin(GhostOps_Hanson_ContGroup());
    while (UnitGroupLoopCurrent() != null) {
        UnitSetCustomValue(UnitGroupLoopCurrent(), 0, 0.0);
        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();

    GhostOps_Hanson_CreateUI();
    GhostOps_Hanson_CreateHud();
    GhostOps_Hanson_Log("loaded game: state " + IntToString(go_hCmdState) + ", gate open " + IntToString(GhostOps_Hanson_B(go_hGateOpen)) + ", ghosts " + IntToString(UnitGroupCount(UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive))
        + ", turrets " + IntToString(UnitGroupCount(UnitGroup("MissileTurret", go_hTurretOwner, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive)) + ", sent " + IntToString(go_hSent) + " index " + IntToString(go_hEscort));
    return true;
}

bool GhostOps_Hanson_OnClick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    // only a ready convoy can be sent, and only once: the state changes before anything else happens
    if ((go_hCmdState != 2) || go_hGateOpen) {
        return true;
    }

    if (go_hFuelOn) {
        // the fuel is paid ONCE, by the accepted command: without enough gas nothing changes (the convoy waits, nothing is taken); the state changes only after the payment
        if (GhostOps_Hanson_Gas() < go_hFuelCost) {
            GhostOps_Hanson_SayNumber("FuelShortMsg", go_hFuelCost - GhostOps_Hanson_Gas());
            GhostOps_Hanson_UpdateUI();
            GhostOps_Hanson_Log("command refused: gas " + IntToString(GhostOps_Hanson_Gas()) + " of " + IntToString(go_hFuelCost));
            return true;
        }

        PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSubtract, go_hFuelCost);
        GhostOps_Hanson_SayNumber("FuelPaidMsg", go_hFuelCost);
        GhostOps_Hanson_Log("fuel paid: " + IntToString(go_hFuelCost) + " gas, left " + IntToString(GhostOps_Hanson_Gas()));
    }

    go_hCmdState = 3;
    go_hGateOpen = true;
    GhostOps_Hanson_UpdateUI();
    GhostOps_Hanson_Log("command: convoy " + IntToString(go_hEscort) + " sent by the player");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_SentMsg"));
    TriggerExecute(go_hGateTrig, true, false);
    return true;
}

// Hook in gt_Gathercolonistspriortoevacuation_Func: a new trip starts to be prepared.
void GhostOps_Hanson_Preparing () {
    if (!go_hEnabled || !go_hCommand) {
        return;
    }

    go_hCmdState = 1;
    GhostOps_Hanson_UpdateUI();
    GhostOps_Hanson_Log("convoy preparing (index " + IntToString(go_hEscort) + ")");
}

// Hook in front of the first action of gt_ConvoySpawned_Func (the original start of a trip). True = hold the trip: the original
// function ends here and is executed again by the button; false = go on.
bool GhostOps_Hanson_Hold (trigger lp_trigger) {
    if (!go_hEnabled || !go_hCommand) {
        return false;
    }

    if (go_hGateOpen) {
        go_hGateOpen = false;
        GhostOps_Hanson_Log("convoy released");
        return false;
    }

    go_hGateTrig = lp_trigger;
    go_hCmdState = 2;
    GhostOps_Hanson_UpdateUI();
    PingCreate(PlayerGroupAll(), "PingSimple", PointFromId(3242), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 6.0);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_ReadyMsg"));
    GhostOps_Hanson_Log("convoy ready, waiting for the command");
    return true;
}

// Hook (once a second) with values of the original mission; also the test module's heartbeat.
void GhostOps_Hanson_Probe (int lp_phase, int lp_escort, int lp_sent, int lp_saved, int lp_killed, int lp_waves) {
    go_hPhase = lp_phase;
    go_hEscort = lp_escort;
    go_hSent = lp_sent;
    go_hSaved = lp_saved;
    go_hKilled = lp_killed;
    go_hWaves = lp_waves;
    if (go_hLastPhase != lp_phase) {
        go_hLastPhase = lp_phase;
        GhostOps_Hanson_Log("mission phase " + IntToString(lp_phase));
    }

    GhostOps_HansonTest_Probe();
}

//--------------------------------------------------------------------------------------------------
// Explosive containers: placement check and charge, detonation by a Ghost shot, the gate of the Firebats' ability, circles of selected containers
//--------------------------------------------------------------------------------------------------
// The cast of the Firebat's ability only chooses a point (a cancelled order never reaches this event); THIS function validates the place and creates the container: a refused
// placement creates nothing and charges nothing. Accepted: one gas price and one slot of the shared limit.
bool GhostOps_Hanson_ContCreated (bool lp_testConds, bool lp_runActions) {
    unit lv_u;
    point lv_pos;
    int lv_why;

    if (!lp_runActions) {
        return true;
    }

    lv_pos = EventUnitTargetPoint();
    GhostOps_Hanson_Log("container cast at (" + FixedToString(PointGetX(lv_pos), 1) + ", " + FixedToString(PointGetY(lv_pos), 1) + ")");
    lv_why = 0;
    if ((go_hContLimit > 0) && (go_hContUsed >= go_hContLimit)) {
        lv_why = 2;
    }
    else if (GhostOps_Hanson_Gas() < go_hContCost) {
        lv_why = 1;
    }
    else if ((EventUnit() != null) && (DistanceBetweenPoints(UnitGetPosition(EventUnit()), lv_pos) > (go_hContRange + 0.5))) {
        lv_why = 4;
    }
    else if (!PointPathingPassable(lv_pos)) {
        lv_why = 3;
    }
    else if (UnitGroupCount(UnitGroup(null, c_playerAny, RegionCircle(lv_pos, go_hContMinFree), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) > 0) {
        lv_why = 3;
    }
    else if (UnitGroupCount(UnitGroup("GhostOpsFuelContainer", c_playerAny, RegionCircle(lv_pos, 1.0), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) > 0) {
        // another container is already there: nothing is stacked on it and nothing is moved
        lv_why = 3;
    }

    if (lv_why != 0) {
        if (lv_why == 1) {
            GhostOps_Hanson_Say("PlaceFailGas");
        }
        else if (lv_why == 2) {
            GhostOps_Hanson_Say("PlaceFailLimit");
        }
        else if (lv_why == 4) {
            GhostOps_Hanson_Say("PlaceFarMsg");
        }
        else {
            GhostOps_Hanson_Say("PlaceFailSpot");
        }

        GhostOps_Hanson_Log("container refused (reason " + IntToString(lv_why) + "), nothing charged");
        return true;
    }

    UnitCreate(1, "GhostOpsFuelContainer", c_unitCreateIgnorePlacement, go_hContOwner, lv_pos, 270.0);
    lv_u = UnitLastCreated();
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSubtract, go_hContCost);
    UnitSetInfoText(lv_u, StringExternal("Param/Value/GhostOpsH_ContainerUnitName"), StringExternal("Param/Value/GhostOpsH_ContainerInfo"), StringExternal("Param/Value/GhostOpsH_ContainerInfo"));
    UnitSetState(lv_u, c_unitStateTooltipable, true);
    go_hContUsed += 1;
    GhostOps_Hanson_UpdateHud();
    GhostOps_Hanson_Log("container " + IntToString(go_hContUsed) + " (live " + IntToString(GhostOps_Hanson_ContAlive()) + ", limit " + IntToString(go_hContLimit) + ") placed at (" + FixedToString(PointGetX(lv_pos), 1) + ", " + FixedToString(PointGetY(lv_pos), 1) + "), gas left " + IntToString(GhostOps_Hanson_Gas()));
    return true;
}

// The detonation: a container that died from the shot of a Ghost explodes (nothing else makes it explode: no proximity, no timer, no other killer). The blast is two search
// effects created at its place; the explosion pictures are actors on the first one (they draw only).
bool GhostOps_Hanson_ContDied (bool lp_testConds, bool lp_runActions) {
    unit lv_u;
    unit lv_k;
    point lv_pos;

    if (!lp_runActions) {
        return true;
    }

    lv_u = EventUnit();
    if ((lv_u == null) || (UnitGetType(lv_u) != "GhostOpsFuelContainer")) {
        return true;
    }

    if (UnitGetCustomValue(lv_u, 0) > 0.5) {
        TextTagDestroy(FixedToInt(UnitGetCustomValue(lv_u, 0)));
        UnitSetCustomValue(lv_u, 0, 0.0);
    }

    lv_k = EventUnitDamageSourceUnit();
    lv_pos = UnitGetPosition(lv_u);
    if ((lv_k != null) && ((UnitGetOwner(lv_k) == 1) || (UnitGetOwner(lv_k) == 4))) {
        go_hContBlasts += 1;
        UnitCreateEffectPoint(lv_k, "GhostOpsCBlast", lv_pos);
        if (go_hContStrBonus) {
            UnitCreateEffectPoint(lv_k, "GhostOpsCBlastStr", lv_pos);
        }

        if (PlayerDifficulty(1) >= 3) {
            if (go_hContFriendHard > 0.0) {
                UnitCreateEffectPoint(lv_k, "GhostOpsCBlastOwnHard", lv_pos);
            }
        }
        else if (go_hContFriendOther > 0.0) {
            UnitCreateEffectPoint(lv_k, "GhostOpsCBlastOwnOther", lv_pos);
        }

        GhostOps_Hanson_Log("container exploded by a hit of " + UnitGetType(lv_k) + " at (" + FixedToString(PointGetX(lv_pos), 1) + ", " + FixedToString(PointGetY(lv_pos), 1) + "), blasts " + IntToString(go_hContBlasts));
    }
    else {
        GhostOps_Hanson_Log("container died without a Ghost shot: no explosion");
    }

    return true;
}

// An order given further than the placement range would make the Firebat walk across the map: it is cancelled at the moment it is queued (nothing is charged: the cast never executes).
bool GhostOps_Hanson_ContFar (bool lp_testConds, bool lp_runActions) {
    unit lv_u;

    if (!lp_runActions) {
        return true;
    }

    lv_u = EventUnit();
    if ((lv_u != null) && (DistanceBetweenPoints(UnitGetPosition(lv_u), EventUnitTargetPoint()) > (go_hContRange + 0.5))) {
        UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        GhostOps_Hanson_Say("PlaceFarMsg");
        GhostOps_Hanson_Log("container order refused: too far");
    }

    return true;
}

// Orders given by the player's mouse are not reported at the Queue stage: ten times a second every Firebat whose current order is the placement of a container
// further than the range is stopped before he has walked a cell (the same refusal as above, nothing charged).
bool GhostOps_Hanson_ContFarTick (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_g;
    unit lv_u;
    order lv_o;

    if (!lp_runActions) {
        return true;
    }

    lv_g = UnitGroup("Firebat", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_g);
    while (UnitGroupLoopCurrent() != null) {
        lv_u = UnitGroupLoopCurrent();
        if (UnitOrderCount(lv_u) > 0) {
            lv_o = UnitOrder(lv_u, 0);
            if ((AbilityCommandGetAbility(OrderGetAbilityCommand(lv_o)) == "GhostOpsPlaceContainer") && (DistanceBetweenPoints(UnitGetPosition(lv_u), OrderGetTargetPosition(lv_o)) > (go_hContRange + 0.5))) {
                UnitIssueOrder(lv_u, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                GhostOps_Hanson_Say("PlaceFarMsg");
                GhostOps_Hanson_Log("container order refused: too far (mouse order)");
            }
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    return true;
}

// Twice a second: the gate of the Firebats' ability (off when the gas or the shared limit is short: the HUD line says why), the circle of a SELECTED container, the HUD, the button.
bool GhostOps_Hanson_ContTick (bool lp_testConds, bool lp_runActions) {
    unitgroup lv_g;
    unit lv_u;
    bool lv_ok;

    if (!lp_runActions) {
        return true;
    }

    if (go_hContOn) {
        lv_ok = ((go_hContLimit <= 0) || (go_hContUsed < go_hContLimit)) && (GhostOps_Hanson_Gas() >= go_hContCost);
        lv_g = UnitGroup("Firebat", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_g);
        while (UnitGroupLoopCurrent() != null) {
            UnitAbilityEnable(UnitGroupLoopCurrent(), "GhostOpsPlaceContainer", lv_ok);
            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
        // every live container (found by type: no array, so there is no hidden number of places): the circle of a selected one, and the label "Explosive container"
        // (a text tag is a screen object, destroyed with the container; its id is kept in custom value 0 of the unit and cleared by a load, the next tick draws it again)
        UnitGroupLoopBegin(GhostOps_Hanson_ContGroup());
        while (UnitGroupLoopCurrent() != null) {
            lv_u = UnitGroupLoopCurrent();
            if (UnitIsAlive(lv_u)) {
                if (UnitIsSelected(lv_u, 1)) {
                    if (UnitBehaviorCount(lv_u, "GhostOpsContainerShow") == 0) {
                        UnitBehaviorAdd(lv_u, "GhostOpsContainerShow", lv_u, 1);
                    }
                }
                else if (UnitBehaviorCount(lv_u, "GhostOpsContainerShow") > 0) {
                    UnitBehaviorRemove(lv_u, "GhostOpsContainerShow", 1);
                }

                if (UnitGetCustomValue(lv_u, 0) < 0.5) {
                    TextTagCreate(StringExternal("Param/Value/GhostOpsH_ContainerTag"), 11, UnitGetPosition(lv_u), 0.0, true, false, PlayerGroupAll());
                    TextTagAttachToUnit(TextTagLastCreated(), lv_u, 1.3);
                    UnitSetCustomValue(lv_u, 0, IntToFixed(TextTagLastCreated()));
                }
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
    }

    // the gas source: no Refinery alive and not enough gas for a trip = a dead end unless the player knows; say it once (and again if the source comes back and is lost again)
    if (go_hFuelOn && go_hAllowRefinery) {
        if ((UnitGroupCount(UnitGroup("Refinery", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) == 0) && (UnitGroupCount(UnitGroup("SCV", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) > 0)
            && (GhostOps_Hanson_Gas() < go_hFuelCost) && (go_hSent > 0 || go_hCmdState > 0)) {
            if (!go_hGasWarned) {
                go_hGasWarned = true;
                GhostOps_Hanson_Say("GasSourceLost");
                GhostOps_Hanson_Log("gas source lost message shown");
            }
        }
        else {
            go_hGasWarned = false;
        }
    }

    GhostOps_Hanson_UpdateHud();
    GhostOps_Hanson_UpdateUI();
    return true;
}

//--------------------------------------------------------------------------------------------------
// The rifle shot (revision 3 of THanson01): the stock ability Snipe is re-aimed by the catalog (any point or unit may be clicked, the ability range is long so the Ghost never walks,
// the effect of the ability is a harmless marker that only starts the cooldown). THIS function does the shot when the cast executes:
//   1. a valid enemy clicked directly (or a container, directly only) in the range of the rifle: a shot at him;
//   2. otherwise the nearest valid VISIBLE enemy within the assistance radius of the click and within the range of the rifle (never a container): a shot at him;
//   3. otherwise a shot at the point (clamped to the range of the rifle on the line from the Ghost): a visible hit on the ground, no damage.
// Every executed shot, a miss too, has started the cooldown (the ability cost); one order of two selected Ghosts is one shot of one ready Ghost (the engine gives a targeted
// spell to one caster). The damage is the catalog effect SnipeDamage (single target, no area), no random number.
//--------------------------------------------------------------------------------------------------
bool GhostOps_Hanson_ShotEnemy (unit lp_u) {
    if ((lp_u == null) || !UnitIsAlive(lp_u)) {
        return false;
    }

    return UnitFilterMatch(lp_u, 1, UnitFilterStr("Enemy,Visible;Missile,Dead,Hidden,Structure,Stasis,Invulnerable"));
}

// The order of a click beyond the rifle range would make the stock ability walk the Ghost to the click until the range is met. At the START of the order (Execute stage) it is replaced
// by the same shot at the point of the click's direction inside the range (the Ghost stays). The shot itself is made when the cast COMPLETES (GhostOps_Hanson_ShotExec, Complete
// stage): a cancelled cast gives neither a shot nor a cooldown, and the cooldown of the ability starts with the real shot.
bool GhostOps_Hanson_ShotRedirect (bool lp_testConds, bool lp_runActions) {
    unit lv_g;
    point lv_a;
    point lv_gp;
    point lv_aim;
    fixed lv_d;

    if (!lp_runActions) {
        return true;
    }

    lv_g = EventUnit();
    if (EventUnitTargetUnit() != null) {
        lv_a = UnitGetPosition(EventUnitTargetUnit());
    }
    else {
        lv_a = EventUnitTargetPoint();
    }

    if ((lv_g == null) || (lv_a == null)) {
        return true;
    }

    lv_gp = UnitGetPosition(lv_g);
    lv_d = DistanceBetweenPoints(lv_gp, lv_a);
    if ((lv_d > go_hShotRange) && (UnitOrderCount(lv_g) <= 1)) {
        lv_aim = PointWithOffset(lv_gp, (PointGetX(lv_a) - PointGetX(lv_gp)) * (go_hShotRange - 0.3) / lv_d, (PointGetY(lv_a) - PointGetY(lv_gp)) * (go_hShotRange - 0.3) / lv_d);
        UnitIssueOrder(lv_g, OrderTargetingPoint(AbilityCommand("Snipe", 0), lv_aim), c_orderQueueReplace);
        GhostOps_Hanson_Log("shot: far click " + FixedToString(lv_d, 1) + " from the Ghost redirected to a shot inside the range");
    }

    return true;
}

bool GhostOps_Hanson_ShotExec (bool lp_testConds, bool lp_runActions) {
    unit lv_g;
    unit lv_t;
    unit lv_c;
    unit lv_u;
    point lv_a;
    point lv_aim;
    point lv_gp;
    fixed lv_d;
    fixed lv_best;
    fixed lv_x;
    bool lv_far;
    unitgroup lv_grp;

    if (!lp_runActions) {
        return true;
    }

    lv_g = EventUnit();
    lv_t = EventUnitTargetUnit();
    if (lv_t != null) {
        lv_a = UnitGetPosition(lv_t);
    }
    else {
        lv_a = EventUnitTargetPoint();
    }

    if ((lv_g == null) || (lv_a == null)) {
        return true;
    }

    lv_gp = UnitGetPosition(lv_g);
    lv_d = DistanceBetweenPoints(lv_gp, lv_a);
    go_hShotCount += 1;
    lv_aim = lv_a;
    lv_far = false;
    if (lv_d > go_hShotRange) {
        // the click is beyond the rifle: the Ghost does not walk, the shot flies the way of the click and ends at the range of the rifle
        lv_far = true;
        lv_aim = PointWithOffset(lv_gp, (PointGetX(lv_a) - PointGetX(lv_gp)) * go_hShotRange / lv_d, (PointGetY(lv_a) - PointGetY(lv_gp)) * go_hShotRange / lv_d);
    }

    lv_c = null;
    if ((lv_t != null) && !lv_far) {
        if (GhostOps_Hanson_ShotEnemy(lv_t) || ((UnitGetType(lv_t) == "GhostOpsFuelContainer") && UnitIsAlive(lv_t))) {
            lv_c = lv_t;
        }
    }

    if (lv_c == null) {
        lv_best = 9999.0;
        lv_grp = UnitGroupSearch(null, c_playerAny, lv_a, go_hShotAssist, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        UnitGroupLoopBegin(lv_grp);
        while (UnitGroupLoopCurrent() != null) {
            lv_u = UnitGroupLoopCurrent();
            if (GhostOps_Hanson_ShotEnemy(lv_u) && (DistanceBetweenPoints(lv_gp, UnitGetPosition(lv_u)) <= go_hShotRange)) {
                lv_x = DistanceBetweenPoints(lv_a, UnitGetPosition(lv_u));
                if (lv_x < lv_best) {
                    lv_best = lv_x;
                    lv_c = lv_u;
                }
            }

            UnitGroupLoopStep();
        }

        UnitGroupLoopEnd();
    }

    go_hLastShotAt = GameGetMissionTime();
    if (lv_c != null) {
        UnitCreateEffectUnit(lv_g, "SnipeDamage", lv_c);
        GhostOps_Hanson_Log("shot: hit " + UnitGetType(lv_c) + " (click " + FixedToString(lv_d, 1) + " from the Ghost at " + FixedToString(PointGetX(lv_gp), 1) + "," + FixedToString(PointGetY(lv_gp), 1) + ", direct " + IntToString(GhostOps_Hanson_B(lv_c == lv_t)) + ")");
    }
    else {
        UnitCreateEffectPoint(lv_g, "GhostOpsShotMiss", lv_aim);
        GhostOps_Hanson_Log("shot: miss at (" + FixedToString(PointGetX(lv_aim), 1) + ", " + FixedToString(PointGetY(lv_aim), 1) + "), click " + FixedToString(lv_d, 1) + " from the Ghost at " + FixedToString(PointGetX(lv_gp), 1) + "," + FixedToString(PointGetY(lv_gp), 1) + ", far " + IntToString(GhostOps_Hanson_B(lv_far)));
    }

    return true;
}

// The state line of the HUD: ready, or the seconds of the best cooldown among the living Ghosts.
text GhostOps_Hanson_ShotLine () {
    unitgroup lv_g;
    unit lv_u;
    fixed lv_best;
    fixed lv_cd;
    int lv_n;

    lv_best = 9999.0;
    lv_n = 0;
    lv_g = UnitGroup("Ghost", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupLoopBegin(lv_g);
    while (UnitGroupLoopCurrent() != null) {
        lv_u = UnitGroupLoopCurrent();
        if (UnitIsAlive(lv_u)) {
            lv_n += 1;
            lv_cd = UnitAbilityGetCooldown(lv_u, "Snipe", "Abil/Snipe");
            if (lv_cd < lv_best) {
                lv_best = lv_cd;
            }
        }

        UnitGroupLoopStep();
    }

    UnitGroupLoopEnd();
    if (lv_n == 0) {
        return StringToText("");
    }

    if (lv_best <= 0.05) {
        return StringExternal("Param/Value/GhostOpsH_HudShot") + StringToText(": ") + StringExternal("Param/Value/GhostOpsH_HudShotReady");
    }

    return StringExternal("Param/Value/GhostOpsH_HudShot") + StringToText(": ") + StringExternal("Param/Value/GhostOpsH_HudShotCd") + StringToText(" ") + FixedToText(lv_best, 1);
}

//--------------------------------------------------------------------------------------------------
// Story lines (portrait + text + talking animation, queued behind the original talk)
//--------------------------------------------------------------------------------------------------
void GhostOps_Hanson_Line (string lp_id, string lp_spk, fixed lp_sec) {
    string lv_model;
    string lv_name;
    int lv_grp;

    if (lp_spk == "raynor") {
        lv_model = "RaynorCommanderPortrait";
        lv_grp = 0;
        lv_name = "RaynorName";
    }
    else {
        lv_model = "SwannPortrait";
        lv_grp = 1;
        lv_name = "SwannName";
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/GhostOpsH_" + lv_name) + StringToText(": ") + StringExternal("Param/Value/GhostOpsH_L_" + lp_id));
    GhostOps_Talk(lv_model, lv_grp, lp_sec);
}

bool GhostOps_Hanson_StoryMsg (bool lp_testConds, bool lp_runActions) {
    int lv_i;

    if (!lp_runActions) {
        return true;
    }

    TriggerQueueEnter();
    if (go_hStoryEvent) {
        // the original scene of the handover is over (this runs behind it in the queue): a short pause, then our lines one after another
        Wait(go_hStoryAfter, c_timeGame);
    }

    lv_i = 0;
    while (lv_i < go_hLnCount) {
        // the warning about the own losses is only meant for the difficulties where own units really take damage
        if ((go_hLnId[lv_i] != "HARD_WARNING") || ((PlayerDifficulty(1) >= 3) && (go_hContFriendHard > 0.0))) {
            GhostOps_Hanson_Log("story line " + go_hLnId[lv_i]);
            GhostOps_Hanson_Line(go_hLnId[lv_i], go_hLnSpk[lv_i], go_hLnSec[lv_i]);
            Wait(go_hStoryGap, c_timeGame);
        }

        lv_i += 1;
    }

    go_hStoryState = 2;
    TriggerQueueExit();
    return true;
}

// Once, after the configured delay (the original intro and the first original talk come first through the same queue).
bool GhostOps_Hanson_StoryTick (bool lp_testConds, bool lp_runActions) {
    if (!lp_runActions) {
        return true;
    }

    if (go_hStoryEvent) {
        return true;
    }

    if ((go_hStoryState == 0) && (GameGetMissionTime() >= go_hStoryFirst)) {
        go_hStoryState = 1;
        TriggerExecute(TriggerCreate("GhostOps_Hanson_StoryMsg"), true, false);
    }

    return true;
}

// Hook at the end of the original scene of the base handover (gt_SwitchtoEscortPhaseQ, behind the original transmission): our explanations start now, never earlier.
void GhostOps_Hanson_StoryStart () {
    if (!go_hEnabled || !go_hStoryEvent || (go_hLnCount <= 0) || (go_hStoryState != 0)) {
        return;
    }

    go_hStoryState = 1;
    GhostOps_Hanson_Log("story: the original scene of the handover is over, our lines are queued");
    TriggerExecute(TriggerCreate("GhostOps_Hanson_StoryMsg"), true, false);
}

// The extra SCVs of the order (or of the free test): created once, next to the Command Center, when the base is handed over; the original then sends every SCV to the minerals.
void GhostOps_Hanson_BaseHanded () {
    unit lv_cc;
    int lv_i;

    if (!go_hEnabled || go_hScvsMade) {
        return;
    }

    go_hScvsMade = true;
    if (go_hExtraScvs <= 0) {
        return;
    }

    lv_cc = UnitGroupUnit(UnitGroup("CommandCenter", 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0), 1);
    if (lv_cc == null) {
        GhostOps_Hanson_Log("extra SCVs: no Command Center of the player");
        return;
    }

    lv_i = 0;
    while (lv_i < go_hExtraScvs) {
        UnitCreate(1, "SCV", c_unitCreateIgnorePlacement, 1, PointWithOffset(UnitGetPosition(lv_cc), -4.0 + IntToFixed(lv_i % 8) * 1.0, -5.0 - IntToFixed(lv_i / 8) * 1.0), 270.0);
        lv_i += 1;
    }

    GhostOps_Hanson_Log("extra SCVs created: " + IntToString(go_hExtraScvs));
}

//--------------------------------------------------------------------------------------------------
// Start (from the adapter, once)
//--------------------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------------------
// Kits (two families: 0 = Missile Turret, 1 = Bunker)
//--------------------------------------------------------------------------------------------------
string GhostOps_Hanson_FamType (int lp_fam) {
    if (lp_fam == 1) {
        return "Bunker";
    }

    return "MissileTurret";
}

string GhostOps_Hanson_FamPrefix (int lp_fam) {
    if (lp_fam == 1) {
        return "Bunker";
    }

    return "Kits";
}

bool GhostOps_Hanson_FamOn (int lp_fam) {
    if (lp_fam == 1) {
        return go_hBkOn;
    }

    return go_hKitOn;
}

int GhostOps_Hanson_FamOrdered (int lp_fam) {
    if (lp_fam == 1) {
        return go_hBkOrdered;
    }

    return go_hKitOrdered;
}

int GhostOps_Hanson_FamSpent (int lp_fam) {
    if (lp_fam == 1) {
        return go_hBkSpent;
    }

    return go_hKitSpent;
}

int GhostOps_Hanson_FamConsumed (int lp_fam) {
    if (lp_fam == 1) {
        return go_hBkConsumed;
    }

    return go_hKitConsumed;
}

void GhostOps_Hanson_FamAddSpent (int lp_fam) {
    if (lp_fam == 1) {
        go_hBkSpent += 1;
    }
    else {
        go_hKitSpent += 1;
    }
}

void GhostOps_Hanson_FamAddConsumed (int lp_fam) {
    if (lp_fam == 1) {
        go_hBkConsumed += 1;
    }
    else {
        go_hKitConsumed += 1;
    }
}

int GhostOps_Hanson_KitsReservedF (int lp_fam) {
    int lv_k;
    int lv_c;

    lv_c = 0;
    lv_k = 0;
    while (lv_k < go_hTrkN) {
        if ((go_hTrkState[lv_k] == 1) && (go_hTrkFam[lv_k] == lp_fam)) {
            lv_c += 1;
        }

        lv_k += 1;
    }

    return lv_c;
}

int GhostOps_Hanson_KitsReserved () {
    return GhostOps_Hanson_KitsReservedF(0);
}

int GhostOps_Hanson_KitsLeftF (int lp_fam) {
    return GhostOps_Hanson_FamOrdered(lp_fam) - GhostOps_Hanson_FamSpent(lp_fam) - GhostOps_Hanson_FamConsumed(lp_fam) - GhostOps_Hanson_KitsReservedF(lp_fam);
}

int GhostOps_Hanson_KitsLeft () {
    return GhostOps_Hanson_KitsLeftF(0);
}

bool GhostOps_Hanson_EnemyNear (point lp_pos) {
    int lv_p;

    lv_p = 2;
    while (lv_p <= 4) {
        if (UnitGroupCount(UnitGroup(null, lv_p, RegionCircle(lp_pos, 6.0), UnitFilter(0, 0, (1 << c_targetFilterStructure), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive) > 0) {
            return true;
        }

        lv_p += 1;
    }

    return false;
}

// The objective line of a family ("Kits: free N / M, under construction K") and the plain messages when a construction starts or is cancelled.
void GhostOps_Hanson_KitObjective (int lp_fam) {
    int lv_left;
    int lv_res;
    string lv_pfx;

    lv_pfx = GhostOps_Hanson_FamPrefix(lp_fam);
    lv_left = GhostOps_Hanson_KitsLeftF(lp_fam);
    lv_res = GhostOps_Hanson_KitsReservedF(lp_fam);
    if (!go_hObjKMade[lp_fam]) {
        go_hObjKMade[lp_fam] = true;
        ObjectiveCreate(StringExternal("Param/Value/GhostOpsH_" + lv_pfx + "Title"), StringExternal("Param/Value/GhostOpsH_" + lv_pfx + "Hint"), c_objectiveStateActive, false);
        go_hObjK[lp_fam] = ObjectiveLastCreated();
        go_hKitShownF[lp_fam] = -1;
    }

    if (lv_left != go_hKitShownF[lp_fam]) {
        if ((go_hKitShownF[lp_fam] > lv_left) && (lv_res > 0)) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_" + lv_pfx + "ReservedMsg") + StringToText(" ") + IntToText(lv_left));
        }
        else if ((go_hKitShownF[lp_fam] >= 0) && (go_hKitShownF[lp_fam] < lv_left)) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_" + lv_pfx + "FreedMsg") + StringToText(" ") + IntToText(lv_left));
        }

        go_hKitShownF[lp_fam] = lv_left;
    }

    ObjectiveSetName(go_hObjK[lp_fam], StringExternal("Param/Value/GhostOpsH_" + lv_pfx + "Title") + StringToText(": ") + IntToText(lv_left) + StringToText(" / ") + IntToText(GhostOps_Hanson_FamOrdered(lp_fam))
        + StringToText(" (") + StringExternal("Param/Value/GhostOpsH_KitsBuilding") + StringToText(" ") + IntToText(lv_res) + StringToText(")"));
}

int GhostOps_Hanson_FindTrk (unit lp_u) {
    int lv_k;

    lv_k = 0;
    while (lv_k < go_hTrkN) {
        if ((go_hTrkState[lv_k] != 0) && (go_hTrk[lv_k] == lp_u)) {
            return lv_k;
        }

        lv_k += 1;
    }

    return -1;
}

// A structure of the family that the tracker does not know yet (custom value 1 of the unit is 0) is a construction that has just started: it reserves a kit. Every structure is marked
// once, so a FINISHED one never needs a place of the tracker (the tracker holds only the constructions in progress) and the number of structures is not limited by an array.
void GhostOps_Hanson_KitScan (int lp_fam) {
    unitgroup lv_g;
    int lv_n;
    int lv_i;
    int lv_k;
    int lv_slot;
    unit lv_u;

    lv_g = UnitGroup(GhostOps_Hanson_FamType(lp_fam), 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_n = UnitGroupCount(lv_g, c_unitCountAll);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_u = UnitGroupUnit(lv_g, lv_i);
        if (UnitGetCustomValue(lv_u, 1) < 0.5) {
            UnitSetCustomValue(lv_u, 1, 1.0);
            if (GhostOps_Hanson_KitsLeftF(lp_fam) <= 0) {
                // over the kits (cost 0, so there is nothing to refund): the construction is cancelled on the spot
                if (UnitTestState(lv_u, c_unitStateUnderConstruction)) {
                    UnitIssueOrder(lv_u, Order(AbilityCommand("CancelBuilding", 0)), c_orderQueueReplace);
                }

                GhostOps_Hanson_Log("over the kits: a construction of " + GhostOps_Hanson_FamType(lp_fam) + " was cancelled");
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaDirective, StringExternal("Param/Value/GhostOpsH_" + GhostOps_Hanson_FamPrefix(lp_fam) + "Out"));
            }
            else if (UnitTestState(lv_u, c_unitStateUnderConstruction)) {
                lv_slot = -1;
                lv_k = 0;
                while ((lv_k < go_hTrkN) && (lv_slot < 0)) {
                    if (go_hTrkState[lv_k] == 0) {
                        lv_slot = lv_k;
                    }

                    lv_k += 1;
                }

                if ((lv_slot < 0) && (go_hTrkN < 24)) {
                    lv_slot = go_hTrkN;
                    go_hTrkN += 1;
                }

                if (lv_slot >= 0) {
                    go_hTrk[lv_slot] = lv_u;
                    go_hTrkFam[lv_slot] = lp_fam;
                    go_hTrkLife[lv_slot] = UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent);
                    go_hTrkPos[lv_slot] = UnitGetPosition(lv_u);
                    go_hTrkHurtAt[lv_slot] = -100.0;
                    go_hTrkState[lv_slot] = 1;
                    GhostOps_Hanson_Log("kit reserved (" + GhostOps_Hanson_FamType(lp_fam) + ")");
                }
            }
        }

        lv_i += 1;
    }
}

bool GhostOps_Hanson_KitTick (bool lp_testConds, bool lp_runActions) {
    int lv_k;
    int lv_f;
    unit lv_u;
    bool lv_valid;

    if (!lp_runActions) {
        return true;
    }

    lv_f = 0;
    while (lv_f < 2) {
        if (GhostOps_Hanson_FamOn(lv_f)) {
            GhostOps_Hanson_KitScan(lv_f);
        }

        lv_f += 1;
    }

    lv_k = 0;
    while (lv_k < go_hTrkN) {
        if (go_hTrkState[lv_k] != 0) {
            lv_u = go_hTrk[lv_k];
            lv_valid = UnitIsValid(lv_u) && (UnitGetType(lv_u) != "");
            if (lv_valid && UnitIsAlive(lv_u)) {
                // a drop of life between two ticks means damage: that tells a destroyed construction from a cancelled one
                if (UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent) < (go_hTrkLife[lv_k] - 0.01)) {
                    go_hTrkHurtAt[lv_k] = GameGetMissionTime();
                }

                go_hTrkLife[lv_k] = UnitGetPropertyFixed(lv_u, c_unitPropLife, c_unitPropCurrent);
                go_hTrkPos[lv_k] = UnitGetPosition(lv_u);
                if (!UnitTestState(lv_u, c_unitStateUnderConstruction)) {
                    // finished: the kit is spent and the place of the tracker is free again (the unit stays marked in its custom value)
                    GhostOps_Hanson_FamAddSpent(go_hTrkFam[lv_k]);
                    go_hTrkState[lv_k] = 0;
                    GhostOps_Hanson_Log("kit spent (construction finished, " + GhostOps_Hanson_FamType(go_hTrkFam[lv_k]) + ")");
                }
            }
            else {
                if ((GameGetMissionTime() - go_hTrkHurtAt[lv_k] < 4.0) || GhostOps_Hanson_EnemyNear(go_hTrkPos[lv_k])) {
                    // damaged or an enemy next to it: it was destroyed, the kit is gone; a cancelled construction is neither
                    GhostOps_Hanson_FamAddConsumed(go_hTrkFam[lv_k]);
                    GhostOps_Hanson_Log("unfinished structure destroyed: kit consumed (" + GhostOps_Hanson_FamType(go_hTrkFam[lv_k]) + ")");
                }
                else {
                    GhostOps_Hanson_Log("construction cancelled: kit freed (" + GhostOps_Hanson_FamType(go_hTrkFam[lv_k]) + ")");
                }

                go_hTrkState[lv_k] = 0;
            }
        }

        lv_k += 1;
    }

    // the build buttons follow the kits left
    if (go_hKitOn) {
        TechTreeUnitAllow(1, "MissileTurret", GhostOps_Hanson_KitsLeft() > 0);
        GhostOps_Hanson_KitObjective(0);
    }

    if (go_hBkOn) {
        TechTreeUnitAllow(1, "Bunker", GhostOps_Hanson_KitsLeftF(1) > 0);
        GhostOps_Hanson_KitObjective(1);
    }

    return true;
}

void GhostOps_Hanson_MakeFreeMarines () {
    int lv_i;

    lv_i = 0;
    while (lv_i < go_hFreeMarines) {
        UnitCreate(1, "Marine", 0, 1, Point(go_hGhostX - 3.0 - IntToFixed(lv_i % 6) * 1.1, go_hGhostY - 2.2 + IntToFixed(lv_i / 6) * 1.1), 270.0);
        lv_i += 1;
    }

    if (go_hFreeMarines > 0) {
        GhostOps_Hanson_Log("free test squad: " + IntToString(go_hFreeMarines) + " Marines created, a finite squad");
    }
}

void GhostOps_Hanson_Start () {
    go_hDlg = c_invalidDialogId;
    go_hHudDlg = c_invalidDialogId;
    GhostOps_Hanson_MakeTurrets();
    GhostOps_Hanson_MakeFreeMarines();
    if (go_hKitOn || go_hBkOn) {
        GhostOps_Hanson_Log("turret kits ordered: " + IntToString(go_hKitOrdered) + ", bunker kits ordered: " + IntToString(go_hBkOrdered));
        go_hKitTrig = TriggerCreate("GhostOps_Hanson_KitTick");
        TriggerAddEventTimePeriodic(go_hKitTrig, 0.25, c_timeGame);
        TriggerExecute(go_hKitTrig, true, true);
    }

    if (go_hLock) {
        GhostOps_Hanson_LockTick(true, true);
        go_hLockTrig = TriggerCreate("GhostOps_Hanson_LockTick");
        TriggerAddEventTimePeriodic(go_hLockTrig, 1.0, c_timeGame);
    }

    if (go_hCommand) {
        GhostOps_Hanson_CreateUI();
    }

    if (go_hCommand || go_hContOn || go_hFuelOn || go_hShotOn) {
        // the dialogs are built again after a load (the convoy button of THanson01, the gas / container line of both missions)
        go_hLoadTrig = TriggerCreate("GhostOps_Hanson_OnLoad");
        TriggerAddEventLoadGameDone(go_hLoadTrig);
    }

    GhostOps_Hanson_CreateHud();
    if (go_hContOn) {
        go_hContCreatedTrig = TriggerCreate("GhostOps_Hanson_ContCreated");
        TriggerAddEventUnitAbility(go_hContCreatedTrig, null, AbilityCommand("GhostOpsPlaceContainer", 0), c_unitAbilStageExecute, false);
        go_hContFarTrig = TriggerCreate("GhostOps_Hanson_ContFar");
        TriggerAddEventUnitAbility(go_hContFarTrig, null, AbilityCommand("GhostOpsPlaceContainer", 0), c_unitAbilStageQueue, false);
        TriggerAddEventTimePeriodic(TriggerCreate("GhostOps_Hanson_ContFarTick"), 0.1, c_timeGame);
        go_hContDiedTrig = TriggerCreate("GhostOps_Hanson_ContDied");
        TriggerAddEventUnitDied(go_hContDiedTrig, null);
    }

    if (go_hShotOn) {
        TriggerAddEventUnitAbility(TriggerCreate("GhostOps_Hanson_ShotRedirect"), null, AbilityCommand("Snipe", 0), c_unitAbilStageExecute, false);
        TriggerAddEventUnitAbility(TriggerCreate("GhostOps_Hanson_ShotExec"), null, AbilityCommand("Snipe", 0), c_unitAbilStageComplete, false);
    }

    if (go_hContOn || go_hFuelOn || go_hShotOn) {
        go_hContTickTrig = TriggerCreate("GhostOps_Hanson_ContTick");
        TriggerAddEventTimePeriodic(go_hContTickTrig, 0.25, c_timeGame);
    }

    if (go_hLnCount > 0) {
        go_hStoryTrig = TriggerCreate("GhostOps_Hanson_StoryTick");
        TriggerAddEventTimePeriodic(go_hStoryTrig, 1.0, c_timeGame);
    }

    GhostOps_HansonTest_Start();
}
